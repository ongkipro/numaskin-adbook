---
// One card for the whole storefront. The home grid grew its own with a
// rating, a sold count and a CTA while /produk had a cleaner one; two cards
// meant two answers to the same question. The wrapper below keeps the search
// hooks the filter script reads - the card has no business knowing them.
import ProductListItem from '../shared/ProductListItem.astro';
import Icon from '../shared/Icon.astro';

interface Product {
  slug: string;
  name: string;
  category: string;
  description: string;
  href: string;
  image: string;
  price: number;
  comparePrice?: number;
  ratingValue?: number;
  reviewCount?: number;
  soldCount?: number;
  variants?: Array<{ label: string; price: number }>;
}

interface Heading {
  eyebrow: string;
  title: string;
  description: string;
}

interface Props {
  products: Product[];
  heading: Heading;
}

const { products, heading } = Astro.props;



const formatPrice = (val: number) => `Rp${val.toLocaleString('id-ID')}`;
---

<section id="produk" class="bg-white px-4 py-10">
  {/* Install-owned heading: numaskin.id's centred eyebrow, serif title and
      cyan rule (DESIGN.md C3). */}
  <div class="mb-7 text-center">
    <span class="nm-label">{heading.eyebrow}</span>
    <h2 class="nm-serif mt-2 text-[26px] uppercase leading-tight text-[var(--nm-marine)] [text-wrap:balance]">{heading.title}</h2>
    <span class="nm-rule mt-3" aria-hidden="true"></span>
    <p class="mx-auto mt-3 max-w-[30rem] text-[13px] leading-6 text-[var(--nm-muted)]">{heading.description}</p>
  </div>

  <div class="mb-7 flex flex-col gap-3" hidden={products.length === 0}>
    <div class="relative w-full">
      <input
        type="text"
        id="catalog-search"
        placeholder="Cari produk pilihan Anda..."
        aria-label="Cari produk"
        class="min-h-12 w-full rounded-full border border-[var(--nm-border)] bg-[var(--nm-surface)] py-3 pl-11 pr-4 text-base text-[var(--nm-marine)] transition-colors placeholder:text-[var(--nm-muted)] focus:border-[var(--nm-cyan)] focus:bg-white focus:outline-none focus:ring-1 focus:ring-[color:var(--nm-cyan)]"
      />
      <Icon
        name="lucide:search"
        class="absolute left-4 top-1/2 h-4 w-4 -translate-y-1/2 text-[var(--nm-teal)]"
        aria-hidden="true"
      />
    </div>
  </div>

  {
    products.length === 0 && (
      <div class="rounded-xl border border-[var(--nm-border)] bg-[var(--nm-surface)] px-5 py-10 text-center">
        <p class="text-[13px] font-semibold text-[var(--nm-marine)]">Katalog sedang disiapkan</p>
        <p class="mx-auto mt-2 max-w-[26rem] text-[12px] leading-6 text-[var(--nm-muted)]">
          Belum ada produk yang diterbitkan. Produk akan muncul di sini setelah
          ditambahkan dan varian harganya diisi dari dashboard.
        </p>
      </div>
    )
  }

  <div id="product-grid" class="grid grid-cols-2 gap-x-3 gap-y-6" hidden={products.length === 0}>
    {
      products.map((product, idx) => (
        <div
          class:list={['product-card', idx >= 10 && 'hidden']}
          data-category={product.category}
          data-search={`${product.name} ${product.category} ${product.description}`.toLowerCase()}
          data-index={idx}
        >
          <ProductListItem
            product={{
              slug: product.slug,
              productName: product.name,
              heroImage: product.image,
              category: product.category,
              price: product.price,
              comparePrice: product.comparePrice,
              variants: product.variants ?? [],
            }}
            formatPrice={formatPrice}
          />
        </div>
      ))
    }
  </div>

  <div
    id="load-more-container"
    class="mt-8 flex flex-col items-center gap-3"
    hidden={products.length === 0}
  >
    <p id="catalog-status" class="text-[11px] font-normal text-[var(--nm-muted)]">
      Menampilkan <span id="product-visible-count">{Math.min(10, products.length)}</span> dari <span id="product-total-count">{products.length}</span> produk
    </p>
    {
      products.length > 10 && (
        <button
          type="button"
          id="load-more-btn"
          class="nm-btn cursor-pointer active:scale-[0.98]"
        >
          <span>Lihat Produk Lainnya</span>
          <Icon name="lucide:chevron-down" class="h-4 w-4" aria-hidden="true" />
        </button>
      )
    }
  </div>
</section>

<script>
  function initProductCatalog() {
    const searchInput = document.getElementById('catalog-search') as HTMLInputElement | null;
    const cards = document.querySelectorAll('.product-card') as NodeListOf<HTMLElement>;
    const loadMoreBtn = document.getElementById('load-more-btn');
    const visibleCountEl = document.getElementById('product-visible-count');
    const totalCountEl = document.getElementById('product-total-count');

    let currentSearch = '';
    let visibleLimit = 10;

    function filterAndRender() {
      let matchedCount = 0;
      let currentlyShown = 0;

      cards.forEach((card) => {
        const searchData = card.getAttribute('data-search') || '';
        const matchesSearch = !currentSearch || searchData.includes(currentSearch);
        if (matchesSearch) matchedCount++;

        // Toggle a class rather than writing `style.display`. Showing a card
        // with `display: flex` turned the wrapper into a flex container, which
        // sizes its `<article>` to max-content instead of the grid cell — so a
        // product with a short title rendered a narrower card, and the square
        // image box shrank its height to match.
        const show = matchesSearch && currentlyShown < visibleLimit;
        if (show) currentlyShown++;
        card.classList.toggle('hidden', !show);
      });

      if (visibleCountEl) visibleCountEl.textContent = String(currentlyShown);
      if (totalCountEl) totalCountEl.textContent = String(matchedCount);

      if (loadMoreBtn) {
        if (currentlyShown >= matchedCount) {
          loadMoreBtn.style.display = 'none';
        } else {
          loadMoreBtn.style.display = 'inline-flex';
        }
      }
    }

    searchInput?.addEventListener('input', (e) => {
      currentSearch = (e.target as HTMLInputElement).value.trim().toLowerCase();
      visibleLimit = 10;
      filterAndRender();
    });

    loadMoreBtn?.addEventListener('click', () => {
      visibleLimit += 10;
      filterAndRender();
    });

    filterAndRender();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initProductCatalog);
  } else {
    initProductCatalog();
  }
</script>
