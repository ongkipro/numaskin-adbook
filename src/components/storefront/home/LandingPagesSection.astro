---
interface LandingPage {
  title: string;
  excerpt: string;
  href?: string;
  crop?: string;
}

interface Heading {
  eyebrow: string;
  title: string;
  description: string;
}

interface Props {
  pages: LandingPage[];
  heading: Heading;
  /** The home page is a summary, not an index; the full list lives at /landing-page. */
  limit?: number;
}

const { pages, heading, limit = 5 } = Astro.props;
// Only the ones that go somewhere. A landing page with no href is a row the
// visitor can read but not open, which is worse than not listing it.
// Install-owned: a landing page that now redirects to its product page is the
// product, already on home; listing it here only repeated it as an "offer".
const linked = pages.filter((page) => Boolean(page.href) && !page.href?.startsWith('/produk/'));
const visible = linked.slice(0, limit);
const hasMore = linked.length > visible.length;
---

{
  linked.length > 0 && (
    <section id="halaman" class:list={['bg-[var(--nm-surface)] px-5', visible.length > 1 ? 'py-10' : 'py-6']}>
      {/* Install-owned heading (DESIGN.md C3). A single page gets a small label,
          not a full section title framing one link (review 2026-10-15). */}
      {visible.length > 1 ? (
        <div class="mb-5 text-center">
          <span class="nm-label">{heading.eyebrow}</span>
          <h2 class="nm-serif mt-2 text-[22px] uppercase leading-tight text-[var(--nm-marine)] [text-wrap:balance]">{heading.title}</h2>
          <span class="nm-rule mt-3" aria-hidden="true"></span>
          <p class="mt-3 text-xs font-normal leading-relaxed text-[var(--nm-muted)]">{heading.description}</p>
        </div>
      ) : (
        <h2 class="nm-label mb-2.5 !text-[var(--nm-marine)]">Halaman penawaran</h2>
      )}

      <ul class="flex flex-col overflow-hidden rounded-xl border border-[var(--nm-border)] bg-white">
        {visible.map((page) => (
          <li class="border-t border-[var(--nm-border)] first:border-t-0">
            <a
              href={page.href}
              class="flex min-h-14 items-center justify-between gap-3 px-4 py-3.5 transition-colors hover:bg-[var(--nm-surface)] focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-[color:var(--nm-cyan)]"
            >
              <span class="min-w-0">
                <span class="block truncate text-sm font-semibold text-[var(--nm-marine)]">{page.title}</span>
                {/* Install-owned: title only. The excerpt is the page's meta
                    description, which currently makes outcome claims
                    ("meredakan kemerahan"); the landing page itself is the
                    place to read them (DESIGN.md owner list). */}
              </span>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="size-4 shrink-0 text-[var(--nm-teal)]"
                aria-hidden="true"
              >
                <path d="m9 18 6-6-6-6" />
              </svg>
            </a>
          </li>
        ))}
      </ul>

      {hasMore && (
        <a
          href="/landing-page"
          class="nm-btn mt-4 w-full"
        >
          Lihat semua halaman
        </a>
      )}
    </section>
  )
}
