---

interface Slide {
  image: string;
  alt: string;
  badge: string;
  text: string;
}

interface Highlight {
  label: string;
  icon: string;
}
interface HeroContent {
  title: string;
  description: string;
  ratingLabel: string;
}

interface Props {
  slides: Slide[];
  highlights: Highlight[];
  content: HeroContent;
}

const { slides } = Astro.props;
---

<section class="bg-white">
  <h1 class="sr-only">{Astro.locals.tenant.name} — {Astro.locals.tenant.tagline}</h1>
  <div class="relative overflow-hidden bg-white">
    <div id="hero-track" class="flex transition-transform duration-700 ease-out will-change-transform">
      {
        slides.map((slide, index) => (
          <article class="relative min-w-full">
            <img
              src={slide.image}
              alt={`${slide.alt} - ${Astro.locals.tenant.name}`}
              title={slide.badge}
              width="600"
              height="600"
              class="aspect-square w-full object-cover object-center"
              loading={index === 0 ? 'eager' : 'lazy'}
              decoding={index === 0 ? 'sync' : 'async'}
              fetchpriority={index === 0 ? 'high' : undefined}
            />
            {/* Install-owned: the caption sits under the slide, not over it. The
                merchant's slide artwork carries its own headline, and an overlay
                caption made both unreadable (review 2026-10-15). */}
            <div class="bg-white px-5 pb-10 pt-3">
              <span class="nm-label nm-pill">{slide.badge}</span>
              <p class="mt-2 max-w-[24rem] text-[13px] font-semibold leading-5 text-[var(--nm-marine)]">
                {slide.text}
              </p>
            </div>
          </article>
        ))
      }
    </div>
    <div id="hero-dots" class="absolute bottom-2 left-5 z-10 flex items-end gap-2">
      {
        slides.map((_, index) => (
          <button
            type="button"
            aria-label={`Tampilkan slide ${index + 1}`}
            class={index === 0
              ? 'h-11 w-7 border-b-2 border-[#002b49] bg-transparent transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#269ba8]'
              : 'h-11 w-4 border-b border-[#5a6e7f]/50 bg-transparent transition-colors hover:border-[#002b49] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#269ba8]'}
          />
        ))
      }
    </div>
  </div>
</section>
