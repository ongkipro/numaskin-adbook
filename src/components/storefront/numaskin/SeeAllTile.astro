---
// Install-owned (numaskin-adbook, DESIGN.md §UX). The closing cell of a home
// grid with an odd count: it completes the row and is the section's "see all"
// route, so the page has one see-all style and no empty cell.
interface Props {
  href: string;
  title: string;
  note: string;
}
const { href, title, note } = Astro.props;
---

<li class="row-span-4 pb-6">
  {/* Same anatomy as a card — an aqua square, then text and action — so the
      cell fills the row without reading as an empty slab. */}
  <a
    href={href}
    class="flex h-full flex-col overflow-hidden rounded-xl border border-[var(--nm-border)] bg-white text-center transition-colors hover:border-[var(--nm-teal)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[color:var(--nm-cyan)]"
  >
    <span class="flex aspect-square items-center justify-center bg-[linear-gradient(180deg,#fff_0%,var(--nm-surface-2)_100%)] px-4">
      <span class="nm-serif text-[22px] uppercase leading-tight text-[var(--nm-marine)]">{title}</span>
    </span>
    <span class="flex flex-1 flex-col items-center justify-center gap-2 px-3 py-3">
      <span class="text-[12px] leading-5 text-[var(--nm-muted)]">{note}</span>
      <span class="nm-btn !px-4" aria-hidden="true">Lihat</span>
    </span>
  </a>
</li>
