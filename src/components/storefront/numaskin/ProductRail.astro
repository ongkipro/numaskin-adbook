---
// Install-owned (numaskin-adbook, DESIGN.md §UX). A sideways-scrolling row of
// the same product card the grids use, so one product never looks two ways on
// a page. Each cell is a four-row grid the card's subgrid fills; an optional
// label (a ritual step) sits above the card.
import ProductListItem from '../shared/ProductListItem.astro';

interface Product {
  slug: string;
  name: string;
  category: string;
  image: string;
  price: number;
  comparePrice?: number;
  variants: Array<{ label?: string; price?: number }>;
}
interface Props {
  items: Array<{ product: Product; label?: string }>;
  ordered?: boolean;
  label: string;
}

const { items, ordered = false, label } = Astro.props;
const List = ordered ? 'ol' : 'ul';
const idr = (n: number) => `Rp${n.toLocaleString('id-ID')}`;
const hasLabels = items.some((item) => Boolean(item.label));
---

{/* A horizontal grid: every card is a subgrid of the same rows (step label,
    image, type, name, price), so prices line up across the row exactly as in
    ProductGrid. `relative` makes the list the containing block of the cards'
    sr-only text, so it is clipped with the row instead of widening the page. */}
<List
  aria-label={label}
  class:list={[
    'relative grid snap-x snap-mandatory scroll-px-5 auto-cols-[44%] grid-flow-col gap-x-3 overflow-x-auto px-5 pb-2 [scrollbar-width:none]',
    hasLabels ? 'grid-rows-[auto_auto_auto_auto_auto]' : 'grid-rows-[auto_auto_auto_auto]',
  ]}
>
  {items.map(({ product, label: itemLabel }) => (
    <li class:list={['grid snap-start grid-rows-subgrid gap-0 rounded-xl bg-white p-2', hasLabels ? 'row-span-5' : 'row-span-4']}>
      {hasLabels && <span class="nm-label mb-2 block px-1 !text-[9px]">{itemLabel}</span>}
      <ProductListItem
        product={{
          slug: product.slug,
          productName: product.name,
          heroImage: product.image,
          category: product.category,
          price: product.price,
          comparePrice: product.comparePrice,
          variants: product.variants,
        }}
        formatPrice={idr}
        stackPrice
      />
    </li>
  ))}
</List>
