---
import { cn } from '../../../lib/cn';
import { introSectionClass } from '../../../lib/ui-variants';
import Breadcrumb from './Breadcrumb.astro';

interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  badge?: string;
  title: string;
  description: string;
  breadcrumbs?: BreadcrumbItem[];
}

const { badge, title, description, breadcrumbs = [] } = Astro.props;
const rail = 'max-w-[480px]';
---

{breadcrumbs.length > 0 && <Breadcrumb items={breadcrumbs} />}
<section class={introSectionClass}>
  <div class={cn('mx-auto', rail)}>
    {/* Install-owned intro (DESIGN.md C3): serif title and cyan rule; the
        breadcrumb already names the page, so no eyebrow (polish 2026-10-15). */}
    <h1 class="nm-serif text-[30px] leading-[1.15] text-[var(--nm-marine)] [text-wrap:balance]">
      {title}
    </h1>
    <span class="nm-rule mt-3 !mx-0" aria-hidden="true"></span>
    {description && <p class="mt-3 max-w-[32rem] text-sm leading-6 text-[var(--nm-muted)]">{description}</p>}
  </div>
</section>
