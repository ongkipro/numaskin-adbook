---
import { cardImageSrc } from '../../../lib/image-derivative';

/** The card only counts these. Requiring the full variant shape made every
 *  caller carry fields the card never reads. */
interface ProductVariant {
  id?: string;
  label?: string;
  price?: number;
  comparePrice?: number;
}

interface Props {
  product: {
    slug: string;
    productName: string;
    heroImage: string;
    category: string;
    price: number;
    comparePrice?: number;
    variants: ProductVariant[];
  };
  formatPrice: (value: number) => string;
  /** Above-the-fold cards only. On /produk the first row is the page's LCP
   *  element, and a lazy LCP image is the one thing lazy-loading must never
   *  touch — under Slow 4G it spent 726ms of a 919ms LCP merely waiting to
   *  be requested. The homepage grid sits below the hero and stays lazy. */
  eager?: boolean;
}

const { product, formatPrice, eager = false } = Astro.props;
const comparePrice = product.comparePrice ?? 0;
const hasDiscount = comparePrice > product.price;
// numaskin.id's category line names type and size ("FACIAL CLEANSER · 100 ML").
// Only a single sellable size is shown: several sizes are the PDP's pills (a
// count truncated the line at 390 px), and a bundle's "Paket" says nothing.
const isBundle = product.category === 'Paket Hemat';
const onlyLabel = product.variants.length === 1 ? product.variants[0]?.label?.trim() : '';
const sizeNote = onlyLabel && onlyLabel.toLowerCase() !== 'paket' ? onlyLabel : '';
const discountPercentage = hasDiscount
  ? Math.round((1 - product.price / comparePrice) * 100)
  : 0;
---

{/* Install-owned card: numaskin.id's pale aqua image well, mono category,
    centred uppercase name and a "HEMAT n%" pill (DESIGN.md C4). */}
<article class="group h-full">
  <a
    href={`/produk/${product.slug}`}
    class="flex h-full flex-col rounded-xl focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--nm-cyan)]"
  >
    <div class="relative aspect-square overflow-hidden rounded-xl bg-gradient-to-b from-white to-[var(--nm-surface-2)]">
      <img
        src={cardImageSrc(product.heroImage)}
        alt={`Foto produk ${product.productName}`}
        width="320"
        height="320"
        class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : undefined}
        decoding="async"
      />
    </div>

    <div class="flex flex-1 flex-col items-center px-1 pt-3 text-center">
      <span class="nm-label max-w-full truncate !text-[9px]">
        {product.category}{sizeNote ? ` · ${sizeNote}` : ''}
      </span>
      {/* Regular weight, tracked, up to three lines: the distinguishing word
          ("Moisturizer", "PA++++") usually comes last, and bold capitals cut it.
          Three lines are always reserved so prices align across a row. */}
      <h2 class="mt-1.5 line-clamp-3 min-h-[54px] text-[12.5px] font-normal uppercase leading-[18px] tracking-[0.05em] text-[var(--nm-marine)]">
        {product.productName}
      </h2>

      {/* The saving is inline with the price and only on bundle cards, as on
          numaskin.id; a single product shows the struck price alone. The block
          keeps room for the wrapped pill on every card, so the price line sits
          at the same height across a row. */}
      <div class="mt-auto flex min-h-[54px] flex-wrap content-start items-center justify-center gap-x-2 gap-y-1 pt-2">
        <p class="text-sm font-bold leading-5 text-[var(--nm-marine)]">{formatPrice(product.price)}</p>
        {hasDiscount && (
          <p class="nm-strike text-[11px] leading-4 text-[var(--nm-muted)] line-through">
            {formatPrice(comparePrice)}
          </p>
        )}
        {isBundle && discountPercentage > 0 && (
          <span class="nm-label nm-pill !text-[9px]">Hemat {discountPercentage}%</span>
        )}
      </div>
    </div>
  </a>
</article>
