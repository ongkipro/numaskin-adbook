---
import { cardImageSrc } from '../../../lib/image-derivative';

/** The card only counts these. Requiring the full variant shape made every
 *  caller carry fields the card never reads. */
interface ProductVariant {
  id?: string;
  label?: string;
  price?: number;
  comparePrice?: number;
}

interface Props {
  product: {
    slug: string;
    productName: string;
    heroImage: string;
    category: string;
    price: number;
    comparePrice?: number;
    variants: ProductVariant[];
  };
  formatPrice: (value: number) => string;
  /** Above-the-fold cards only. On /produk the first row is the page's LCP
   *  element, and a lazy LCP image is the one thing lazy-loading must never
   *  touch — under Slow 4G it spent 726ms of a 919ms LCP merely waiting to
   *  be requested. The homepage grid sits below the hero and stays lazy. */
  eager?: boolean;
  /** Where a step label already names the product's role (the ritual). */
  hideType?: boolean;
  /** A bundle's contents, shown under its name as numaskin.id does. */
  contents?: string[];
}

const { product, formatPrice, eager = false, hideType = false, contents = [] } = Astro.props;
const comparePrice = product.comparePrice ?? 0;
const hasDiscount = comparePrice > product.price;
// numaskin.id's category line names type and size ("FACIAL CLEANSER · 100 ML").
// Only a single sellable size is shown: several sizes are the PDP's pills (a
// count truncated the line at 390 px), and a bundle's "Paket" says nothing.
const isBundle = product.category === 'Paket Hemat';
const onlyLabel = product.variants.length === 1 ? product.variants[0]?.label?.trim() : '';
// A bundle without a size in its name says how many products it holds.
const sizeNote = isBundle
  ? (product.productName.match(/\((\d+\s?ml)\)/i)?.[1] ?? (contents.length > 1 ? `${contents.length} produk` : ''))
  : onlyLabel && onlyLabel.toLowerCase() !== 'paket' ? onlyLabel : '';
// A bundle's category is the section it sits in ("Paket Hemat"); the label says
// what it is instead, as numaskin.id does ("SKINCARE SET · 150ML").
const typeLabel = isBundle ? 'Skincare Set' : product.category;
const discountPercentage = hasDiscount
  ? Math.round((1 - product.price / comparePrice) * 100)
  : 0;
---

{/* Install-owned card (DESIGN.md C4, §UX). Four subgrid rows — image,
    category, name, price — so a row of cards shares one baseline per row:
    names render in full, and only a row whose name wraps longer grows.
    The parent grid cell must be `grid grid-rows-subgrid row-span-4`
    (ProductGrid.astro). */}
<article class="group row-span-4 grid grid-rows-subgrid gap-0">
  <a
    href={`/produk/${product.slug}`}
    class="row-span-4 grid grid-rows-subgrid gap-0 rounded-xl text-center focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[color:var(--nm-cyan)]"
  >
    <div class="relative aspect-square overflow-hidden rounded-xl bg-gradient-to-b from-white to-[var(--nm-surface-2)]">
      <img
        src={cardImageSrc(product.heroImage)}
        alt=""
        width="320"
        height="320"
        class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : undefined}
        decoding="async"
      />
    </div>
    <span class="nm-label nm-mono block px-1 pt-3 !text-[9px] [text-wrap:balance]">
      {!hideType && <>{typeLabel}{sizeNote && <span class="whitespace-nowrap">{` · ${sizeNote}`}</span>}</>}
    </span>
    <div class="px-1 pt-1.5">
      <h2 class="text-[12.5px] font-normal uppercase leading-[18px] tracking-[0.05em] text-[var(--nm-marine)] [text-wrap:pretty]">
        {/* Non-breaking hyphens keep "6-IN-1", "TONE-UP" and "ANTI-AGING" whole. */}
        {product.productName.replace(/-/g, '\u2011')}
      </h2>
      {contents.length > 0 && (
        <p class="mt-1 text-[11px] leading-4 text-[var(--nm-muted)]">{contents.join(' + ')}</p>
      )}
    </div>
    {/* The saving sits in the price row and only on bundle cards, as on
        numaskin.id; a single product shows the struck price alone. */}
    {/* A card too narrow for price and struck price on one line (under
        148 px) stacks them, so a row of cards never mixes the two layouts.
        The wrapper is the size container: containment on the subgridded
        <article> itself breaks the subgrid. */}
    <div class="@container">
      <div class="flex flex-wrap content-start items-center justify-center gap-x-1.5 gap-y-1 px-1 pb-6 pt-2 @max-[9.25rem]:flex-col @max-[9.25rem]:pb-2">
        <p class="text-sm font-bold leading-5 text-[var(--nm-marine)]">{formatPrice(product.price)}</p>
        {hasDiscount && (
          <p class="nm-strike text-[11px] leading-4 text-[var(--nm-muted)] line-through">
            <span class="sr-only">Harga normal </span>{formatPrice(comparePrice)}
          </p>
        )}
        {isBundle && discountPercentage > 0 && (
          <span class="nm-label nm-pill !text-[9px]">Hemat {discountPercentage}%</span>
        )}
      </div>
    </div>
  </a>
</article>
