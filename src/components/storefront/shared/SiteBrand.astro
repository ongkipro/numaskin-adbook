---
// Install-owned (numaskin-adbook): numaskin.id's text wordmark — the store
// name in tracked capitals joined by a middle dot, over the katakana reading.
// The name still comes from the tenant, so renaming the store in /admin
// renames the wordmark. DESIGN.md C2.
import '../../../styles/numaskin.css';

interface Props {
  href?: string;
  class?: string;
  tone?: 'light' | 'dark' | 'glossy';
  showTagline?: boolean;
}

const { href = '/', class: className = '', tone = 'dark' } = Astro.props;
const isLight = tone === 'light';
const storeName = Astro.locals.tenant.name.trim();
const wordmark = storeName.split(/\s+/).join('·').toUpperCase();
---

<a
  href={href}
  class={`group inline-flex min-h-11 flex-col items-center justify-center text-center focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--nm-cyan)] ${className}`}
  aria-label={Astro.locals.tenant.name}
>
  <span
    aria-hidden="true"
    class={`whitespace-nowrap text-[18px] font-semibold uppercase leading-none tracking-[0.16em] transition-colors ${isLight ? 'text-white' : 'text-[var(--nm-marine)] group-hover:text-[var(--nm-teal)]'}`}
  >
    {wordmark}
  </span>
  <span
    aria-hidden="true"
    lang="ja"
    class={`mt-1 text-[10px] leading-none tracking-[0.32em] ${isLight ? 'text-white/80' : 'text-[var(--nm-teal)]'}`}
  >
    ヌマスキン
  </span>
</a>
