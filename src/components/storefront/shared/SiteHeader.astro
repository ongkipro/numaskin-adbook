---
import SiteBrand from './SiteBrand.astro';
---

{/* Official-store trust strip: name-then-checkmark, the way a social profile
    signals authenticity. Install-owned (DESIGN.md): a marine band without the
    verification tick, which implied a platform check nothing backs. */}
<div class="bg-[var(--nm-marine)] px-4 py-2 text-center">
  <p class="mx-auto flex max-w-[480px] items-center justify-center gap-1.5">
    <span class="nm-label !text-white">Official Store {Astro.locals.tenant.name}</span>
  </p>
</div>

{Astro.locals.tenant.tagline && (
  <div class="bg-[var(--nm-marine)] px-4 py-2.5 text-center text-[10px] font-normal tracking-widest uppercase text-white">
    <p class="mx-auto flex max-w-[480px] items-center justify-center gap-2 px-1">
      <span class="relative flex h-1.5 w-1.5 items-center justify-center">
        <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-[var(--nm-cyan)] opacity-75"></span>
        <span class="relative inline-flex h-1 w-1 rounded-full bg-[var(--nm-cyan)]"></span>
      </span>
      <span>{Astro.locals.tenant.tagline}</span>
    </p>
  </div>
)}

<header class="border-b border-[var(--nm-border)] bg-white">
  <div class="mx-auto flex h-[68px] max-w-[480px] items-center justify-center px-5 text-center">
    <SiteBrand href="/" showTagline={false} />
  </div>
</header>
