---
// Install-owned skin (numaskin-adbook, DESIGN.md): marine on the aqua surface.
import SiteBrand from './SiteBrand.astro';

const footerLegal = [
  // Four policies plus one way into the catalogue. Meta and Google both want a
  // reachable contact, privacy policy, terms, and a shipping/returns policy
  // before they will run a store's ads; the rest was footer weight. /tentang,
  // /disclaimer, /testimoni and the others still render, still sit in
  // sitemap.xml and can still be linked from anywhere - they just no longer
  // ride along on every page.
  { label: 'Produk', href: '/produk' },
  { label: 'Halaman', href: '/landing-page' },
  { label: 'Kontak', href: '/kontak' },
  { label: 'Kebijakan Privasi', href: '/kebijakan-privasi' },
  { label: 'Syarat & Ketentuan', href: '/syarat-ketentuan' },
  { label: 'Pengiriman & Retur', href: '/pengiriman' },
];
---

<footer class="border-t border-[var(--nm-border)] bg-[var(--nm-surface)] px-5 py-12 text-[var(--nm-marine)]">
  <div class="mx-auto max-w-[480px] space-y-6 text-center">
    <SiteBrand href="/" />
    <!-- Policy Links -->
    <nav
      aria-label="Tautan footer"
      class="flex flex-wrap items-center justify-center gap-x-5 gap-y-1 text-[10px] font-semibold uppercase tracking-widest text-[var(--nm-muted)]"
    >
      {
        footerLegal.map((item) => (
          <a
            href={item.href}
            class="inline-flex min-h-6 items-center underline-offset-4 transition-colors hover:text-[var(--nm-marine)] hover:underline focus-visible:text-[var(--nm-marine)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[color:var(--nm-cyan)] focus-visible:ring-offset-2"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <!-- Copyright -->
    <p class="text-[10px] uppercase tracking-wider text-[var(--nm-muted)]">
      © {new Date().getFullYear()} {Astro.locals.tenant.name}. All Rights Reserved.
    </p>
  </div>
</footer>
