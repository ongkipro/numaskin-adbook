---
import { formatIdr } from '../../../lib/format-idr';
import { getStorefrontProduct } from '../../../lib/catalog';
import { resolveFormVariant } from '../../../lib/form-config';
import { getRuntimeEnv } from '../../../lib/env';
import { loadStoreCodDisabledProvinceCodes } from '../../../lib/form-mode';
import { jsonForScript } from '../../../lib/json-script';
import Icon from '../shared/Icon.astro';

interface Props {
  productSlug?: string;
  bundleProductSlugs?: string[];
  selectedVariantId?: string;
  province?: string;
  embedded?: boolean;
  bannerImage?: string;
  product?: any;
  codDisabledProvinceCodes?: string[];
}

const {
  productSlug = '',
  bundleProductSlugs,
  province = '',
  selectedVariantId,
  embedded = false,
  bannerImage,
  codDisabledProvinceCodes: codDisabledProvinceCodesProp,
} = Astro.props;
const product = await getStorefrontProduct(Astro.locals, productSlug);
if (!product) throw new Error(`Product ${productSlug} not found`);
const bundleProducts = bundleProductSlugs?.length
  ? (
      await Promise.all(
        bundleProductSlugs.map((slug) => getStorefrontProduct(Astro.locals, slug)),
      )
    ).filter(Boolean)
  : [];
const isBundledMode = bundleProducts.length > 0;
const buildVariantOption = (prod: any, v: any) => {
  const shortLabel = String(v.label || '').trim();
  const displayTitle = isBundledMode
    ? prod.variants.length > 1 && !shortLabel.includes(prod.productName)
      ? `${prod.productName} (${shortLabel})`
      : prod.productName
    : shortLabel;
  const fullLabel =
    isBundledMode && !shortLabel.includes(prod.productName)
      ? `${prod.productName} (${shortLabel})`
      : shortLabel;
  const plusCount = (shortLabel.match(/\+/g) || []).length;
  const itemCount =
    plusCount > 0 ? plusCount + 1 : /2[×x]\s*/i.test(shortLabel) ? 2 : 1;
  const tierBadge = !isBundledMode
    ? ''
    : itemCount >= 4
      ? `Paket Lengkap ${itemCount}-in-1`
      : itemCount === 3
        ? 'Paket Lengkap 3-in-1'
        : itemCount === 2
          ? 'Paket Hemat 2 Produk'
          : '';
  const normalizedComparePrice =
    prod.slug === 'deep-sea-water-treatment-lotion' && /2[×x]\s*150/i.test(shortLabel)
      ? 218000
      : prod.slug === 'deep-sea-water-treatment-lotion' && shortLabel === '150ml'
        ? 135000
        : v.comparePrice;
  return {
    ...v,
    comparePrice: normalizedComparePrice,
    label: fullLabel,
    shortLabel,
    displayTitle,
    showSubLabel: isBundledMode && !displayTitle.includes(shortLabel),
    tierBadge,
    productId: String(prod.productId || ''),
    productSlug: String(prod.slug || ''),
    productName: String(prod.productName || ''),
    image: String(prod.image || ''),
  };
};
const allVariants = isBundledMode
  ? [
      ...product.variants.map((v: any) => buildVariantOption(product, v)),
      ...bundleProducts.flatMap((bp: any) =>
        (bp.variants || []).map((v: any) => buildVariantOption(bp, v)),
      ),
    ]
  : product.variants;
const defaultVariant =
  resolveFormVariant({ ...product, variants: allVariants }, selectedVariantId) ||
  allVariants[0];
const defaultComparePrice = defaultVariant.comparePrice ?? defaultVariant.price;
const defaultHasDiscount = defaultComparePrice > defaultVariant.price;
const database = getRuntimeEnv(Astro.locals)?.OMS_DB as D1Database | undefined;
const codDisabledProvinceCodes =
  codDisabledProvinceCodesProp ??
  await loadStoreCodDisabledProvinceCodes(database);
const instanceId = `middle-${product.slug}-${embedded ? 'embedded' : 'standalone'}`;
const RootTag = embedded ? 'section' : 'main';
const formId = embedded ? `${instanceId}-form` : 'middle-form';
// Unique per render: two forms on one landing page used to share these ids, so
// a label in the second form focused the first form's field.
const fieldUid = crypto.randomUUID().slice(0, 8);
---

<RootTag class="bg-white" data-middle-form-root data-instance-id={instanceId}>
  <section class="pb-8 pt-0">
    <form id={formId} class="grid gap-5 pt-4" novalidate>
      <div class="absolute left-[-10000px] top-auto size-px overflow-hidden" aria-hidden="true">
        <label>
          Jangan isi kolom ini
          <input
            type="text"
            name="contact_url_confirm"
            tabindex="-1"
            autocomplete="off"
          />
        </label>
      </div>
      <div class="px-4">
        <section class="form-block form-block-first">
          <div class="form-block-head gap-1.5">
            <h2 class="section-title">{isBundledMode ? 'Pilih Paket Pemesanan' : 'Pilih Varian'}</h2>
            <p class="section-lead">{isBundledMode ? 'Pilih satuan atau paket bundling hemat resmi BPOM di bawah ini.' : 'Pilih varian produk yang ingin dipesan.'}</p>
          </div>
          <div class="variant-group simple-variant-group">
            {
              allVariants.map((variant: any) => {
                const comparePrice = variant.comparePrice ?? variant.price;
                const hasDiscount = comparePrice > variant.price;
                const saveAmount = hasDiscount ? comparePrice - variant.price : 0;
                return (
                  <label class="variant-option simple-variant-option">
                    <input
                      type="radio"
                      name="variant"
                      value={variant.id}
                      checked={variant.id === defaultVariant.id}
                      data-label={variant.label}
                      data-short-label={variant.shortLabel || variant.label}
                      data-product-id={variant.productId || product.productId}
                      data-product-slug={variant.productSlug || product.slug}
                      data-product-name={variant.productName || product.productName}
                      data-price={variant.price}
                      data-compare={comparePrice}
                    />
                    <div class:list={['variant-copy simple-variant-copy', isBundledMode && 'bundle-variant-copy']}>
                      <div class="variant-radio" />
                      {isBundledMode && variant.image && (
                        <div class="bundle-variant-thumb">
                          <img
                            src={variant.image}
                            alt={variant.displayTitle || variant.label}
                            width="48"
                            height="48"
                            loading="lazy"
                            decoding="async"
                            onerror="this.parentElement.hidden=true"
                          />
                        </div>
                      )}
                      <div class="variant-main simple-variant-main">
                        <div class="simple-variant-head">
                          <p class="variant-label">{variant.displayTitle || variant.label}</p>
                          {variant.tierBadge && (
                            <span class="bundle-tier-pill">{variant.tierBadge}</span>
                          )}
                        </div>
                        {variant.showSubLabel && (
                          <p class="bundle-variant-sub">{variant.shortLabel}</p>
                        )}
                        <div class="variant-price-row simple-variant-price-row">
                          <span class="variant-price">{formatIdr(variant.price)}</span>
                          {hasDiscount && <span class="simple-variant-dot" aria-hidden="true" />}
                          {hasDiscount && <span class="variant-compare">{formatIdr(comparePrice)}</span>}
                          {saveAmount >= 5000 && (
                            <span class="bundle-save-pill">Hemat {formatIdr(saveAmount)}</span>
                          )}
                        </div>
                      </div>
                    </div>
                  </label>
                );
              })
            }
          </div>
        </section>

        <section class="form-block">
          <div class="form-block-head gap-1.5">
            <h2 class="section-title">Data penerima</h2>
            <p class="section-lead">{isBundledMode ? 'Cukup isi Nama, No. WhatsApp aktif, & Alamat — Bisa Bayar di Tempat (COD) saat paket tiba di rumah.' : 'Isi data dengan benar agar admin dan kurir lebih mudah memproses pesanan.'}</p>
          </div>
          <div class="field-grid address-field-grid">
            <div class="form-field form-field-full">
              <input
                id={`customer-name-${fieldUid}`} data-field="customer-name"
                name="customer_name"
                required
                inputmode="text"
                autocomplete="name"
                placeholder=" "
              />
              <label for={`customer-name-${fieldUid}`}>Nama lengkap</label>
            </div>
            <div class="form-field form-field-full">
              <input
                id={`middle-phone-${fieldUid}`} data-field="middle-phone"
                name="customer_phone"
                required
                type="tel"
                inputmode="numeric"
                autocomplete="tel"
                placeholder=" "
              />
              <label for={`middle-phone-${fieldUid}`}>Nomor WhatsApp</label>
            </div>
            <div class="form-field form-field-full">
              <textarea id={`middle-address-${fieldUid}`} data-field="middle-address" name="address" rows="2" required placeholder=" "></textarea>
              <label for={`middle-address-${fieldUid}`}>Alamat lengkap &amp; patokan</label>
            </div>
          </div>
        </section>

        <input type="hidden" name="payment_method" value="cod" />

        <section class="form-block summary-block">
          <div class="form-block-head">
            <h2 class="section-title">Ringkasan Pemesanan</h2>
            <p class="section-lead">Periksa kembali detail pesanan sebelum melanjutkan ke proses order.</p>
          </div>
          <div class="summary-card">
            <div class="summary-row summary-row-product">
              <strong id="summary-product-name" class="summary-product-name">{defaultVariant.productName || product.productName}</strong>
              <div class="summary-price">
                <span id="summary-label" class="summary-variant">{defaultVariant.shortLabel || defaultVariant.label}</span>
                <span class="summary-price-figures">
                  <span id="summary-compare-row" class="summary-compare-wrap" hidden={!defaultHasDiscount}
                    ><span id="summary-compare">{formatIdr(defaultComparePrice)}</span></span
                  >
                  <strong id="summary-price-value">{formatIdr(defaultVariant.price)}</strong>
                </span>
              </div>
            </div>
            <div class="total-box">
              <div>
                <p>Subtotal</p>
                <small id="summary-total-note">Ongkir &amp; admin dikonfirmasi via CS</small>
              </div>
              <div class="total-box-side">
                <strong id="summary-total">{formatIdr(defaultVariant.price)}</strong>
              </div>
            </div>
          </div>

          <div class="info-box">
            <span
              >{isBundledMode ? '✓ Garansi 100% Produk Resmi BPOM & Tersegel • Bisa Bayar di Tempat (COD) ke Kurir maupun QRIS.' : 'Harga divalidasi ulang saat order diproses. Pastikan nomor WhatsApp aktif untuk konfirmasi.'}</span
            >
          </div>

          <div class="submit-panel">
            <div class="cta-row">
              <button type="submit" class="submit-main" id="submit-button"
                ><span class="submit-main-label">Buat Order Sekarang</span><Icon
                  name="lucide:arrow-right"
                  class="submit-main-icon"
                  aria-hidden="true"
                /></button
              >
            </div>
            <div class="trust-strip" aria-label="Informasi pemesanan">
              <span><Icon name="lucide:lock-keyhole" class="trust-icon" aria-hidden="true" /><i>Data pesanan</i></span>
              <span><Icon name="lucide:shield-check" class="trust-icon" aria-hidden="true" /><i>Harga tervalidasi</i></span>
              <span><Icon name="lucide:truck" class="trust-icon" aria-hidden="true" /><i>Konfirmasi admin</i></span>
            </div>
            {
              bannerImage && (
                <div class="mt-4 overflow-hidden border-t border-[#E5E5E5]">
                  <img
                    src={bannerImage}
                    alt={`Informasi promo ${product.productName}`}
                    class="mx-auto block h-auto w-full object-contain"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              )
            }
            <p id="middle-error" class="form-error" hidden></p>
          </div>
        </section>
      </div>
    </form>
  </section>
</RootTag>

<script
  is:inline
  type="application/json"
  id={`${instanceId}-config`}
  data-middle-form-config
  set:html={jsonForScript({
    instanceId,
    productSlug: product.slug,
    productId: product.productId,
    productName: product.productName,
    province,
    codDisabledProvinceCodes,
  })}
/>

<script>
  import { initMiddleOrderForm, initPromoSessionStock } from '../../../scripts/form-middle';

  initPromoSessionStock();
  initMiddleOrderForm();
</script>
