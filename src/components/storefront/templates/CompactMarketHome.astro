---
// Install-owned (numaskin-adbook, DESIGN.md §UX). The compact-market home
// rebuilt as a shopping path inside the same 480 px column: brand hero →
// search and categories → the four-step ritual → single products → bundles
// (cheapest six, then the full list on /produk) → landing pages. The template's
// section switches (hero / catalog / landingPages) are still honoured.
import HeroSection from '../home/HeroSection.astro';
import LandingPagesSection from '../home/LandingPagesSection.astro';
import NumaHero from '../numaskin/NumaHero.astro';
import CategoryChips from '../numaskin/CategoryChips.astro';
import RitualSection from '../numaskin/RitualSection.astro';
import ProductGrid from '../numaskin/ProductGrid.astro';
import SeeAllTile from '../numaskin/SeeAllTile.astro';
import Icon from '../shared/Icon.astro';
import { bundleLine, heldImagesOf, pickRitual, BUNDLE_CATEGORY } from '../numaskin/catalog-order';
import type { TenantHomeContent } from '../../../lib/tenant-content';

interface ProductCard {
  slug: string;
  name: string;
  category: string;
  description: string;
  contentsText?: string;
  href: string;
  image: string;
  price: number;
  comparePrice?: number;
  ratingValue?: number;
  reviewCount?: number;
  soldCount?: number;
  variants: Array<{ label: string; price: number }>;
}

interface Props {
  content: TenantHomeContent;
  products: ProductCard[];
  heroSlides: Array<{ image: string; alt: string; badge: string; text: string }>;
  sections: {
    hero: boolean;
    catalog: true;
    proofs?: boolean;
    landingPages?: boolean;
  };
}

const { content, products, heroSlides, sections } = Astro.props;
const singles = products.filter((p) => p.category !== BUNDLE_CATEGORY);
// The ritual shows four singles just above; the singles section shows the
// rest, so home never repeats a packshot. All singles stay one tap away.
const inRitual = new Set(pickRitual(singles).map(({ product }) => product.slug));
const singlesGrid = singles.filter((p) => !inRitual.has(p.slug));
const bundles = products
  .filter((p) => p.category === BUNDLE_CATEGORY)
  .sort((a, b) => a.price - b.price);
const BUNDLE_PREVIEW = 6;
// The home preview is the cheapest bundles whose image is not already shown,
// so two bundles sharing one merchant collage never sit side by side. Held
// images (catalog-order.ts) are kept off it; /produk lists them last.
const heldImages = heldImagesOf(bundles);
const seenImages = new Set<string>();
const seenLines = new Set<string>();
const bundlePreview = bundles.filter((p) => {
  if (heldImages.has(p.image) || seenImages.has(p.image) || seenLines.has(bundleLine(p.name))) return false;
  seenImages.add(p.image);
  seenLines.add(bundleLine(p.name));
  return true;
}).slice(0, BUNDLE_PREVIEW);
const operatorSlides = content.heroSlides.length > 0;
const categories = products.map((p) => p.category);
---

<main id="konten-utama" class="relative min-h-screen overflow-x-hidden bg-white font-sans text-[var(--nm-marine)] antialiased">
  <div id="home" class="mx-auto flex min-h-screen w-full max-w-[480px] flex-col bg-white">
    {sections.hero && (operatorSlides
      ? <HeroSection slides={heroSlides} highlights={content.heroHighlights} content={content.hero} />
      : <NumaHero hasBundles={bundles.length > 0} />)}

    {sections.catalog && products.length > 0 && (
      <>
        <section aria-label="Cari dan pilih kategori" class="border-b border-[var(--nm-border)] px-4 py-5">
          <form action="/produk" method="get" role="search" class="relative">
            <label for="home-search" class="sr-only">Cari produk</label>
            <input
              id="home-search"
              name="q"
              type="search"
              placeholder="Cari produk, mis. toner, serum…"
              class="min-h-12 w-full rounded-full border border-[var(--nm-border)] bg-[var(--nm-surface)] py-3 pl-11 pr-4 text-base text-[var(--nm-marine)] placeholder:text-[var(--nm-muted)] focus:border-[var(--nm-cyan)] focus:bg-white focus:outline-none focus:ring-1 focus:ring-[color:var(--nm-cyan)]"
            />
            <Icon name="lucide:search" class="pointer-events-none absolute left-4 top-1/2 h-4 w-4 -translate-y-1/2 text-[var(--nm-teal)]" aria-hidden="true" />
          </form>
          <CategoryChips categories={categories} active={null} class="mt-4" />
        </section>

        <RitualSection products={singles} />

        {singlesGrid.length > 0 && (
          <section aria-labelledby="produk-title" class="px-4 pb-10 pt-10">
            <div class="mb-6 text-center">
              <h2 id="produk-title" class="nm-serif text-[26px] uppercase leading-tight text-[var(--nm-marine)]">Lengkapi Rutinitas</h2>
              <span class="nm-rule mt-3" aria-hidden="true"></span>
            </div>
            {/* Every card whole: a grid, not a scroller (three items). An odd
                count is completed by the "all products" tile, so no hole. */}
            <ProductGrid id="grid-satuan" products={singlesGrid}>
              {singlesGrid.length % 2 === 1 && (
                <SeeAllTile href="/produk" title="Semua produk" note={`${products.length} produk dan paket`} images={singles.slice(0, 4).map((p) => p.image)} />
              )}
            </ProductGrid>
          </section>
        )}

        {bundles.length > 0 && (
          <section id="paket" aria-labelledby="paket-title" class="scroll-mt-4 bg-[var(--nm-surface)] px-4 pb-10 pt-10">
            <div class="mb-6 text-center">
              <h2 id="paket-title" class="nm-serif text-[26px] uppercase leading-tight text-[var(--nm-marine)]">Paket Hemat</h2>
              <span class="nm-rule mt-3" aria-hidden="true"></span>
              <p class="mx-auto mt-3 max-w-[34ch] text-[13px] leading-6 text-[var(--nm-muted)] [text-wrap:balance]">
                Sebagian dari {bundles.length} paket; semuanya ada di katalog.
              </p>
            </div>
            {/* An odd preview closes with the see-all tile; an even one keeps
                the button, so a full row is never broken by a tile. */}
            <ProductGrid id="grid-paket" products={bundlePreview}>
              {bundles.length > bundlePreview.length && bundlePreview.length % 2 === 1 && (
                <SeeAllTile href={`/produk?kategori=${encodeURIComponent(BUNDLE_CATEGORY)}`} title="Semua paket" note={`${bundles.length} paket hemat`} images={bundlePreview.slice(0, 4).map((p) => p.image)} />
              )}
            </ProductGrid>
            {bundles.length > bundlePreview.length && bundlePreview.length % 2 === 0 && (
              <div class="mt-2 text-center">
                <a href={`/produk?kategori=${encodeURIComponent(BUNDLE_CATEGORY)}`} class="nm-btn">
                  Lihat semua {bundles.length} paket
                </a>
              </div>
            )}
          </section>
        )}
      </>
    )}

    {sections.catalog && products.length === 0 && (
      <section class="px-4 py-10">
        <div class="rounded-xl border border-[var(--nm-border)] bg-[var(--nm-surface)] px-5 py-10 text-center">
          <p class="text-[13px] font-semibold">Katalog sedang disiapkan</p>
          <p class="mx-auto mt-2 max-w-[26rem] text-[12px] leading-6 text-[var(--nm-muted)]">
            Belum ada produk yang diterbitkan. Produk akan muncul di sini setelah ditambahkan dari dashboard.
          </p>
        </div>
      </section>
    )}

    {sections.landingPages !== false && <LandingPagesSection pages={content.solutions} heading={content.solutionsHeading} />}
  </div>
</main>

<script>
  // Operator slides only (the brand hero has no slider): the dots move the
  // slider; it never advances by itself — the product's HeroSection history
  // explains the LCP cost that removed autoplay. No-op without the elements.
  const heroTrack = document.getElementById('hero-track');
  const heroDots = document.getElementById('hero-dots');
  const setHeroSlide = (index: number) => {
    if (!heroTrack || !heroDots) return;
    heroTrack.style.transform = `translateX(-${index * 100}%)`;
    [...heroDots.children].forEach((dot, itemIndex) => {
      dot.className =
        itemIndex === index
          ? 'h-11 w-7 border-b-2 border-[#002b49] bg-transparent transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#269ba8]'
          : 'h-11 w-4 border-b border-[#5a6e7f]/50 bg-transparent transition-colors hover:border-[#002b49] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#269ba8]';
    });
  };
  [...(heroDots?.children ?? [])].forEach((dot, index) => {
    dot.addEventListener('click', () => setHeroSlide(index));
  });
</script>
