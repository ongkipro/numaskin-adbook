---
import BaseLayout from '../layouts/BaseLayout.astro';
import GeoIpResolvedForm from '../components/storefront/forms/GeoIpResolvedForm.astro';
import MetaLandingTracker from '../components/storefront/tracking/MetaLandingTracker.astro';
import Icon from '../components/storefront/shared/Icon.astro';
import RatingStars from '../components/storefront/shared/RatingStars.astro';
import { getStorefrontProduct } from '../lib/catalog';
import { nativeLandingCanonicalPath } from '../lib/landing-pages';
import { defaultCatalogContentId } from '../lib/catalog-feed';
import { getRuntimeEnv } from '../lib/env';
import { loadStoreCodDisabledProvinceCodes } from '../lib/form-mode';
import { getStoreAdsConfig } from '../lib/store-ads';
import '../styles/form-hybrid.css';
import '../styles/landing-pages/paket-triple-protection-3-in-1.css';

export const prerender = false;

const PRODUCT_SLUG = 'paket-triple-protection-3-in-1';
const LANDING_SLUG = 'paket-triple-protection-3-in-1';
const PAGE_TITLE = 'Paket Triple Protection 3-in-1 - Cuci, Lembap & Tameng SPF 50+ Harian BPOM';
const PAGE_DESC = 'Paket bundling 3-in-1 Numa Skin: Deep Sea Water Facial Wash 100ml + Adenosine Moisturizer 30gr + Oxydew Sunscreen SPF 50+ PA++++ 30ml untuk perlindungan harian anti-flek (3 BPOM Resmi).';
const IMG_BASE = '/images/landing/paket-triple-protection-3-in-1';
const HERO_IMAGE = `${IMG_BASE}/hero-paket-triple-protection.webp`;

const database = getRuntimeEnv(Astro.locals)?.OMS_DB as D1Database | undefined;
const claimedProductSlug = Astro.request.headers.get('x-adsbook-product-page');
const [product, canonicalPath, codDisabledProvinceCodes] = await Promise.all([
  getStorefrontProduct(Astro.locals, PRODUCT_SLUG),
  claimedProductSlug
    ? Promise.resolve(`/produk/${claimedProductSlug}`)
    : nativeLandingCanonicalPath(Astro.locals, LANDING_SLUG),
  loadStoreCodDisabledProvinceCodes(database),
  getStoreAdsConfig(Astro.locals),
]);
if (!product) {
  return Astro.rewrite('/404');
}

const canonical = `${Astro.locals.tenant.siteUrl}${canonicalPath}`;

const variants = product.variants || [];
const cheapestVariant = variants.reduce(
  (min: any, v: any) => (!min || v.price < min.price ? v : min),
  variants[0]
);
const defaultVariant = cheapestVariant || {
  id: '48',
  label: 'Facial Wash 100ml + Adenosine 30gr + Sunscreen 30ml',
  price: 204000,
  comparePrice: 226998,
};
---

<BaseLayout
  title={PAGE_TITLE}
  description={PAGE_DESC}
  image={HERO_IMAGE}
  preloadImages={HERO_IMAGE}
  canonical={canonical}
  hideHeader={true}
  hideFooter={true}
>
  <MetaLandingTracker
    slug={LANDING_SLUG}
    contentId={defaultCatalogContentId(product)}
    contentName={product.contentName}
    price={defaultVariant.price}
  />

  <div class="dsw-shell">
    <main class="dsw-canvas">
      <!-- Section 1: Hero -->
      <section id="hero-section" class="dsw-hero">
        <div class="dsw-hero-head">
          <h1 class="dsw-h1">
            <span class="dsw-hl-tilt">Wajah Kusam Polusi</span> & Muncul Flek Akibat Malas Ribet Pagi Hari?
          </h1>
          <p class="dsw-sub" style="max-width: 390px; margin: 14px auto 0; font-weight: 700;">
            Debu jalanan, keringat, dan sinar matahari tropis mempercepat timbulnya flek hitam bila kulit tidak dibersihkan dan diproteksi.<br />
            <span class="dsw-underline-teal">Cukup 3 langkah simpel dengan Paket Triple Protection 3-in-1!</span>
          </p>
        </div>

        <div class="dsw-hero-stage">
          <div class="dsw-hero-top-tag">
            <div class="dsw-hero-top-pill">
              <Icon name="lucide:award" class="size-3.5" aria-hidden="true" />
              <span>Trio Praktis Harian • Hemat Rp23.000</span>
            </div>
          </div>

          <img
            src={HERO_IMAGE}
            alt="Perbandingan wajah kusam berflek akibat polusi dan UV vs kulit bersih terlindungi dengan Paket Triple Protection 3-in-1"
            width="720"
            height="480"
            class="dsw-hero-img"
            fetchpriority="high"
            loading="eager"
            decoding="async"
          />

          <div class="dsw-hero-overlap">
            <div class="dsw-hero-overlap-inner">
              <h2 class="dsw-hero-overlap-title">3 Langkah Wajib untuk Anda yang Sibuk</h2>
              <p class="dsw-hero-overlap-text">
                Tanpa ribet banyak botol: <strong style="color: #be123c;">cuci bersih pori, kunci kelembapan anti-flek Adenosine, dan blokir sinar UVA/UVB dengan SPF 50+ PA++++</strong>.
              </p>
            </div>
          </div>
        </div>

        <div class="dsw-trust-row">
          <div class="dsw-trust-item">
            <span class="dsw-trust-icon">
              <Icon name="lucide:shield-check" class="size-4" aria-hidden="true" />
            </span>
            <div>
              <span class="dsw-trust-label">BPOM Resmi</span>
              <span class="dsw-trust-sub">3 Izin Edar</span>
            </div>
          </div>
          <div class="dsw-trust-item">
            <span class="dsw-trust-icon">
              <Icon name="lucide:badge-check" class="size-4" aria-hidden="true" />
            </span>
            <div>
              <span class="dsw-trust-label">Halal RI</span>
              <span class="dsw-trust-sub">Aman Bumil</span>
            </div>
          </div>
          <div class="dsw-trust-item">
            <span class="dsw-trust-icon">
              <Icon name="lucide:truck" class="size-4" aria-hidden="true" />
            </span>
            <div>
              <span class="dsw-trust-label">Bisa COD</span>
              <span class="dsw-trust-sub">Bayar di Rumah</span>
            </div>
          </div>
        </div>
      </section>

      <!-- Section 2: Solusi Singkat + Visual -->
      <section class="dsw-section">
        <h2 class="dsw-h2">
          Perlindungan <span class="dsw-hl-aqua">Cuci + Lembap + Kunci UV</span> setiap hari
        </h2>
        <p class="dsw-sub">Paket esensial yang merawat kebersihan, kekenyalan, dan ketahanan kulit dari sinar matahari.</p>

        <div class="dsw-photo-stack">
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/solusi-cuci-lembap-kunci-uv.webp`}
              alt="Wanita Indonesia usia 34 tahun dengan wajah bersih, lembap, dan segar terlindungi sebelum beraktivitas"
              width="648"
              height="432"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
          </div>
        </div>

        <div class="dsw-list">
          <div class="dsw-list-row">
            <span class="dsw-icon-teal">
              <Icon name="lucide:droplets" class="size-4" aria-hidden="true" />
            </span>
            <p class="dsw-list-text">
              <strong style="color: #0f172a;">Deep Sea Water Facial Wash Gel (100 ml):</strong> Mengangkat minyak, sisa sunscreen, dan polusi jalanan dengan 5% Niacinamide tanpa membuat wajah kering ketarik.
            </p>
          </div>
          <div class="dsw-list-row">
            <span class="dsw-icon-teal">
              <Icon name="lucide:layers" class="size-4" aria-hidden="true" />
            </span>
            <p class="dsw-list-text">
              <strong style="color: #0f172a;">Adenosine Moisturizer (30 gr):</strong> Pelembap gel-cream dingin dengan Adenosine, Alpha-Arbutin, & 11X Hyaluronic Acid untuk merawat flek dan garis halus.
            </p>
          </div>
          <div class="dsw-list-row">
            <span class="dsw-icon-teal">
              <Icon name="lucide:sun-dim" class="size-4" aria-hidden="true" />
            </span>
            <p class="dsw-list-text">
              <strong style="color: #0f172a;">Oxydew Sunscreen SPF 50+ PA++++ (30 ml):</strong> Menangkal radiasi UVA/UVB & panas matahari dengan 3% Luceane™ tanpa whitecast abu-abu.
            </p>
          </div>
        </div>
      </section>

      <!-- Section 3: Tanda Masalah Kulit + Visual Grid -->
      <section class="dsw-section dsw-section--warn">
        <h2 class="dsw-h2">
          Akibat keluar rumah <span class="dsw-underline-warn">tanpa proteksi</span> & pembersih yang tepat
        </h2>

        <div class="dsw-photo-grid-2">
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/masalah-malas-ribet-pagi-hari.webp`}
              alt="Wanita terburu-buru di pagi hari dengan kulit yang tampak kusam dan belum terlindungi sunscreen"
              width="315"
              height="210"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <p class="dsw-photo-caption">
              <strong style="color: #be123c; display: block;">Keluar Rumah Tanpa Tameng UV</strong>
              Sinar matahari pagi hingga siang langsung memicu munculnya bintik flek hitam baru.
            </p>
          </div>
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/masalah-wajah-kusam-pulang-kerja.webp`}
              alt="Close-up wajah kusam berminyak dan kemerahan setelah seharian terpapar panas dan polusi"
              width="315"
              height="210"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <p class="dsw-photo-caption">
              <strong style="color: #be123c; display: block;">Pori Tersumbat Debu & Keringat</strong>
              Sore hari wajah tampak kusam gelap, lengket, dan gampang timbul komedo.
            </p>
          </div>
        </div>

        <div class="dsw-list">
          <div class="dsw-list-row">
            <span class="dsw-icon-warn">
              <Icon name="lucide:triangle-alert" class="size-4" aria-hidden="true" />
            </span>
            <p class="dsw-list-text">
              Malas pakai skincare berlapis karena <strong style="color: #be123c;">takut wajah terasa berat dan berminyak saat berkeringat</strong>.
            </p>
          </div>
          <div class="dsw-list-row">
            <span class="dsw-icon-warn">
              <Icon name="lucide:triangle-alert" class="size-4" aria-hidden="true" />
            </span>
            <p class="dsw-list-text">
              Bercak cokelat di tulang pipi <strong style="color: #be123c;">bertambah gelap setiap habis aktivitas luar ruangan</strong>.
            </p>
          </div>
          <div class="dsw-list-row">
            <span class="dsw-icon-warn">
              <Icon name="lucide:triangle-alert" class="size-4" aria-hidden="true" />
            </span>
            <p class="dsw-list-text">
              Sabun cuci muka biasa membuat kulit <strong style="color: #be123c;">kering ketarik dan memperjelas garis halus</strong>.
            </p>
          </div>
        </div>
      </section>

      <!-- Section 4: Perbandingan Visual Sebelum vs Sesudah -->
      <section class="dsw-section">
        <h2 class="dsw-h2">
          Perbedaan nyata <span class="dsw-hl-aqua">sebelum vs sesudah rutin</span>
        </h2>
        <p class="dsw-sub">Tiga langkah ringkas yang menjaga kulit tetap bersih, kenyal, dan bebas kusam matahari.</p>

        <div class="dsw-photo-stack">
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/kondisi-kusam-polusi-flek-uv.webp`}
              alt="Kondisi kulit pipi kusam berpori kotor dengan noda flek matahari sebelum perawatan"
              width="648"
              height="432"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <span class="dsw-photo-badge dsw-photo-badge--before">Sebelum Triple Protection</span>
            <p class="dsw-photo-caption">
              Wajah tampak kusam kemerahan akibat panas matahari, pori tersumbat, dan flek hitam terlihat tegas.
            </p>
          </div>

          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/kondisi-segar-terlindungi-seharian.webp`}
              alt="Kondisi kulit pipi bersih, kenyal, cerah merata, dan bebas whitecast setelah rutin memakai Paket Triple Protection"
              width="648"
              height="432"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <span class="dsw-photo-badge dsw-photo-badge--after">Rutin Triple Protection 3-in-1</span>
            <p class="dsw-photo-caption">
              Kulit tampak segar bersih seharian, kelembapan terjaga, dan noda gelap terlindungi dari sinar UV.
            </p>
          </div>
        </div>
      </section>

      <!-- Section 5: Dark Marine Section — Cara Pakai Praktis -->
      <section class="dsw-section dsw-section--dark">
        <h2 class="dsw-h2">
          Urutan Pakai <span style="color: #99e2ec;">Cuma 60 Detik Tiap Pagi</span>
        </h2>
        <p class="dsw-sub">Ringkas, cepat meresap, dan tidak meninggalkan noda putih di hijab.</p>

        <div class="dsw-photo-stack">
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/cara-pakai-triple-cuci-dan-lembap.webp`}
              alt="Langkah 1 dan 2: Cuci wajah dengan Facial Wash Gel lalu oleskan Adenosine Moisturizer"
              width="648"
              height="432"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <p class="dsw-photo-caption">
              <strong style="color: #ffffff;">Langkah 1 & 2 (Pagi & Malam — Cuci & Lembapkan):</strong> Cuci wajah dengan Facial Wash Gel, keringkan, lalu oleskan 1–2 pump Adenosine Moisturizer.
            </p>
          </div>
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/cara-pakai-triple-proteksi-spf50.webp`}
              alt="Langkah 3 Pagi: Kunci dengan 2 ruas jari Oxydew Sunscreen SPF 50+ PA++++"
              width="648"
              height="432"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <p class="dsw-photo-caption">
              <strong style="color: #ffffff;">Langkah 3 (Khusus Pagi/Siang — Kunci SPF 50+):</strong> Ratakan 2 ruas jari Oxydew Sunscreen ke seluruh wajah dan leher sebelum beraktivitas.
            </p>
          </div>
        </div>

        <div class="dsw-list">
          <div class="dsw-list-row">
            <span class="dsw-step-num">1</span>
            <p class="dsw-step-text">
              <strong style="color: #ffffff;">Pagi Hari:</strong> Facial Wash Gel → Adenosine Moisturizer → Oxydew Sunscreen SPF 50+ PA++++.
            </p>
          </div>
          <div class="dsw-list-row">
            <span class="dsw-step-num">2</span>
            <p class="dsw-step-text">
              <strong style="color: #ffffff;">Malam Hari:</strong> Facial Wash Gel lalu <strong style="color: #ffffff; background: #104452; padding: 1px 6px; border-radius: 4px;">Adenosine Moisturizer</strong> (angkat sisa sunscreen & kunci perbaikan malam).
            </p>
          </div>
          <div class="dsw-list-row">
            <span class="dsw-step-num">3</span>
            <p class="dsw-step-text">
              Ketiga produk ringan di kulit dan nyaman dipakai di bawah bedak harian.
            </p>
          </div>
        </div>
      </section>

      <!-- Section 6: Ulasan Pelanggan -->
      <section class="dsw-section">
        <h2 class="dsw-h2">
          Alasan paket ini jadi <span class="dsw-hl-aqua">favorit wanita aktif</span>
        </h2>
        <p class="dsw-sub">Lengkap dari cuci muka sampai sunscreen dengan harga hemat Rp23.000.</p>

        <div class="dsw-reviews-divide">
          <div class="dsw-review-row">
            <div class="dsw-review-head">
              <div>
                <p class="dsw-review-author">
                  Ibu Rina K.
                  <span style="color: #0b6e7d; display: inline-flex;">
                    <Icon name="lucide:badge-check" class="size-4" aria-hidden="true" />
                  </span>
                </p>
                <p class="dsw-review-meta">Jakarta Timur • Usia 35 Tahun</p>
              </div>
              <RatingStars rating={5} starClass="h-3.5 w-3.5 !fill-[#d97706] !text-[#d97706]" />
            </div>
            <p class="dsw-review-quote">
              "Paket paling pas buat yang pagi-pagi sibuk kerja. <span class="dsw-hl-aqua">Habis cuci muka tinggal pakai Adenosine + Oxydew Sunscreen</span>, cepet meresap dan gak bikin muka kusam sampai sore."
            </p>
          </div>
          <div class="dsw-review-row">
            <div class="dsw-review-head">
              <div>
                <p class="dsw-review-author">
                  Bunda Tia M.
                  <span style="color: #0b6e7d; display: inline-flex;">
                    <Icon name="lucide:badge-check" class="size-4" aria-hidden="true" />
                  </span>
                </p>
                <p class="dsw-review-meta">Semarang • Usia 38 Tahun</p>
              </div>
              <RatingStars rating={5} starClass="h-3.5 w-3.5 !fill-[#d97706] !text-[#d97706]" />
            </div>
            <p class="dsw-review-quote">
              "Sunscreen-nya beneran gak ada whitecast dan gak perih di mata. <strong style="color: #0f172a;">Dipadu sama Adenosine & Facial Wash-nya</strong>, <span class="dsw-hl-aqua">flek di pipi perlahan memudar dan muka bersih banget</span>."
            </p>
          </div>
          <div class="dsw-review-row">
            <div class="dsw-review-head">
              <div>
                <p class="dsw-review-author">
                  Ibu Vera D.
                  <span style="color: #0b6e7d; display: inline-flex;">
                    <Icon name="lucide:badge-check" class="size-4" aria-hidden="true" />
                  </span>
                </p>
                <p class="dsw-review-meta">Denpasar • Hemat Rp23.000</p>
              </div>
              <RatingStars rating={5} starClass="h-3.5 w-3.5 !fill-[#d97706] !text-[#d97706]" />
            </div>
            <p class="dsw-review-quote">
              "Cuma 204 ribu udah dapet sabun, pelembap anti-aging, sama sunscreen SPF 50+. <span class="dsw-hl-rose">Hemat 23 ribu</span> dan <span class="dsw-hl-aqua">semua ukuran full size awet dipakai</span>."
            </p>
          </div>
        </div>
      </section>

      <!-- Section 7: Galeri Bukti Visual -->
      <section class="dsw-section dsw-section--tint">
        <h2 class="dsw-h2">
          Rangkaian <span style="color: #0b6e7d;">esensial 3 langkah</span> bebas gerah
        </h2>
        <p class="dsw-sub">Menjaga wajah tetap segar dari pagi hingga malam hari.</p>

        <div class="dsw-photo-grid-2">
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/bukti-tekstur-trio-triple-protection.webp`}
              alt="Swatch 3 tekstur Paket Triple Protection: gel cuci jernih, gel-cream Adenosine, dan lotion sunscreen"
              width="315"
              height="210"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
          </div>
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/bukti-wanita-kerja-segar-sore.webp`}
              alt="Potret wanita berhijab dengan wajah yang tetap segar dan bebas kusam di sore hari"
              width="315"
              height="210"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
          </div>
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/bukti-kulit-bebas-minyak-lengket.webp`}
              alt="Close-up pipi halus, lembap, dan bebas kilap minyak berlebih"
              width="315"
              height="210"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
          </div>
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/bukti-meja-rias-triple-protection.webp`}
              alt="Paket Triple Protection 3-in-1 Numa Skin di meja wastafel"
              width="315"
              height="210"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
          </div>
        </div>
      </section>

      <!-- Section 8: Product Knowledge (Full-Bleed Figures) -->
      <section class="dsw-section dsw-section--knowledge">
        <h2 class="dsw-h2">
          Formulasi <span class="dsw-hl-aqua">Triple Protection 3-in-1</span>
        </h2>
        <p class="dsw-sub">
          Menyatukan pembersih pori pH seimbang, pengunci kolagen Adenosine, dan perisai UV Luceane™.
        </p>

        <div class="dsw-figure-stack">
          <figure class="dsw-figure">
            <div class="dsw-figure-bleed">
              <img
                src={`${IMG_BASE}/formulasi-tiga-perisai-harian.webp`}
                alt="Formulasi Ulleung Deep Sea Water dengan Red Algae dan Luceane Marine Bio-Ferment"
                width="720"
                height="480"
                class="dsw-figure-img"
                loading="lazy"
                fetchpriority="low"
                decoding="async"
              />
            </div>
            <figcaption class="dsw-figcaption">
              <h3 class="dsw-figcaption-title">Daily Cleanse, Repair & UV Shield</h3>
              <p class="dsw-figcaption-desc">
                Melindungi kulit dari 3 penyebab utama penuaan dini: residu polusi pori, dehidrasi kolagen, dan radiasi UVA/UVB.
              </p>
            </figcaption>
          </figure>
          <figure class="dsw-figure">
            <div class="dsw-figure-bleed">
              <img
                src={`${IMG_BASE}/kandungan-niacinamide-adenosine-luceane.webp`}
                alt="Kandungan 5% Niacinamide, Adenosine, Alpha-Arbutin, 11X Hyaluronic Acid, dan 3% Luceane SPF 50+"
                width="720"
                height="480"
                class="dsw-figure-img"
                loading="lazy"
                fetchpriority="low"
                decoding="async"
              />
            </div>
            <figcaption class="dsw-figcaption">
              <h3 class="dsw-figcaption-title">5% Niacinamide + Adenosine + 3% Luceane™ SPF 50+</h3>
              <p class="dsw-figcaption-desc">
                Kombinasi pencerah pori, penghalus kerutan & flek hitam, serta filter matahari spektrum luas PA++++.
              </p>
            </figcaption>
          </figure>
          <figure class="dsw-figure">
            <div class="dsw-figure-bleed">
              <img
                src={`${IMG_BASE}/kemasan-triple-protection-3in1.webp`}
                alt="Kemasan resmi Paket Triple Protection 3-in-1 Numa Skin terdaftar BPOM"
                width="720"
                height="480"
                class="dsw-figure-img"
                loading="lazy"
                fetchpriority="low"
                decoding="async"
              />
            </div>
