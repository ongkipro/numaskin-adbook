---
import BaseLayout from '../layouts/BaseLayout.astro';
import GeoIpResolvedForm from '../components/storefront/forms/GeoIpResolvedForm.astro';
import MetaLandingTracker from '../components/storefront/tracking/MetaLandingTracker.astro';
import Icon from '../components/storefront/shared/Icon.astro';
import RatingStars from '../components/storefront/shared/RatingStars.astro';
import { getStorefrontProduct } from '../lib/catalog';
import { nativeLandingCanonicalPath } from '../lib/landing-pages';
import { defaultCatalogContentId } from '../lib/catalog-feed';
import { getRuntimeEnv } from '../lib/env';
import { loadStoreCodDisabledProvinceCodes } from '../lib/form-mode';
import { getStoreAdsConfig } from '../lib/store-ads';
import '../styles/form-hybrid.css';
import '../styles/landing-pages/paket-sunscreen-dan-gloss-gel.css';

export const prerender = false;

const PRODUCT_SLUG = 'paket-sunscreen-dan-gloss-gel';
const LANDING_SLUG = 'paket-sunscreen-dan-gloss-gel';
const PAGE_TITLE = 'Paket Sunscreen & Gloss Gel - Duo Ringan Kulit Berminyak & Sensitif BPOM';
const PAGE_DESC = 'Kombinasi nyaman kulit berminyak & sensitif: Calming Barrier Gloss Gel Moisturizer 30ml (NA18230107056) dan Oxydew Sunscreen SPF 50+ PA++++ 30ml (NA18251703709).';
const IMG_BASE = '/images/landing/paket-sunscreen-dan-gloss-gel';
const HERO_IMAGE = `${IMG_BASE}/hero-paket-sunscreen-gloss-gel.webp`;

const database = getRuntimeEnv(Astro.locals)?.OMS_DB as D1Database | undefined;
const claimedProductSlug = Astro.request.headers.get('x-adsbook-product-page');
const [product, canonicalPath, codDisabledProvinceCodes] = await Promise.all([
  getStorefrontProduct(Astro.locals, PRODUCT_SLUG),
  claimedProductSlug
    ? Promise.resolve(`/produk/${claimedProductSlug}`)
    : nativeLandingCanonicalPath(Astro.locals, LANDING_SLUG),
  loadStoreCodDisabledProvinceCodes(database),
  getStoreAdsConfig(Astro.locals),
]);
if (!product) {
  return Astro.rewrite('/404');
}

const canonical = `${Astro.locals.tenant.siteUrl}${canonicalPath}`;

const variants = product.variants || [];
const cheapestVariant = variants.reduce(
  (min: any, v: any) => (!min || v.price < min.price ? v : min),
  variants[0]
);
const defaultVariant = cheapestVariant || {
  id: '42',
  label: 'Gloss Gel 30ml + Sunscreen 30ml',
  price: 142000,
  comparePrice: 158000,
};
---

<BaseLayout
  title={PAGE_TITLE}
  description={PAGE_DESC}
  image={HERO_IMAGE}
  preloadImages={HERO_IMAGE}
  canonical={canonical}
  hideHeader={true}
  hideFooter={true}
>
  <MetaLandingTracker
    slug={LANDING_SLUG}
    contentId={defaultCatalogContentId(product)}
    contentName={product.contentName}
    price={defaultVariant.price}
  />

  <div class="dsw-shell">
    <main class="dsw-canvas">
      <!-- Section 1: Hero -->
      <section id="hero-section" class="dsw-hero">
        <div class="dsw-hero-head">
          <h1 class="dsw-h1">
            <span class="dsw-hl-tilt">Takut Pakai Sunscreen</span> Karena Kulit Berminyak Mudah Bruntusan?
          </h1>
          <p class="dsw-sub" style="max-width: 390px; margin: 14px auto 0; font-weight: 700;">
            Kulit berminyak dan kemerahan butuh pelembap water-jelly yang menyeimbangkan sebum sebelum dikunci tabir surya.<br />
            <span class="dsw-underline-teal">Rasakan sensasi adem bebas kilap dengan Paket Sunscreen & Gloss Gel!</span>
          </p>
        </div>

        <div class="dsw-hero-stage">
          <div class="dsw-hero-top-tag">
            <div class="dsw-hero-top-pill">
              <Icon name="lucide:award" class="size-3.5" aria-hidden="true" />
              <span>Duo Ringan Anti-Gerah • Hemat Rp16.000</span>
            </div>
          </div>

          <img
            src={HERO_IMAGE}
            alt="Perbandingan wajah berminyak kemerahan vs kulit kalem terlindungi dengan Paket Sunscreen & Gloss Gel Numa Skin"
            width="720"
            height="480"
            class="dsw-hero-img"
            fetchpriority="high"
            loading="eager"
            decoding="async"
          />

          <div class="dsw-hero-ba" aria-hidden="true">
            <span class="dsw-hero-ba-pill dsw-hero-ba-pill--before">Berminyak & Merah</span>
            <span class="dsw-hero-ba-pill dsw-hero-ba-pill--after">Adem & Bebas Kilap</span>
          </div>

          <div class="dsw-hero-trust-strip" role="list" aria-label="Jaminan kualitas Numa Skin">
            <div class="dsw-trust-item" role="listitem">
              <span class="dsw-trust-icon">
                <Icon name="lucide:shield-check" class="size-3.5" aria-hidden="true" />
              </span>
              <span class="dsw-trust-text">
                <strong class="dsw-trust-label">2 BPOM Resmi</strong>
                <span class="dsw-trust-sub">Gloss Gel & Oxydew</span>
              </span>
            </div>
            <div class="dsw-trust-item" role="listitem">
              <span class="dsw-trust-icon">
                <Icon name="lucide:sun" class="size-3.5" aria-hidden="true" />
              </span>
              <span class="dsw-trust-text">
                <strong class="dsw-trust-label">SPF 50+ PA++++</strong>
                <span class="dsw-trust-sub">Meadowestolide®</span>
              </span>
            </div>
            <div class="dsw-trust-item" role="listitem">
              <span class="dsw-trust-icon">
                <Icon name="lucide:award" class="size-3.5" aria-hidden="true" />
              </span>
              <span class="dsw-trust-text">
                <strong class="dsw-trust-label">Non-Comedogenic</strong>
                <span class="dsw-trust-sub">Ramah Jerawat</span>
              </span>
            </div>
          </div>
        </div>

        <div class="dsw-hero-foot">
          <p class="dsw-hero-caption">
            Paduan <strong>Calming Barrier Gloss Gel Moisturizer 30ml</strong> & <strong>Oxydew Sunscreen SPF 50+ PA++++ 30ml</strong> yang ringan seperti air untuk cuaca tropis Indonesia.
          </p>
          <a href="#form-pemesanan" class="dsw-cta" data-scroll-to-form>
            <span>Ambil Paket Sunscreen & Gloss Gel</span>
            <Icon name="lucide:arrow-right" class="size-5" aria-hidden="true" />
          </a>
        </div>
      </section>

      <!-- Section 2: Solusi Praktis -->
      <section class="dsw-section">
        <h2 class="dsw-h2">
          Duet Adem <span class="dsw-hl-aqua">Tanpa Sumbat Pori</span>
        </h2>
        <p class="dsw-sub" style="margin-top: 8px;">
          Solusi untuk Anda yang sering merasa gerah, berminyak, atau kemerahan saat memakai pelembap dan sunscreen di siang hari:
        </p>

        <div class="dsw-solution-box">
          <img
            src={`${IMG_BASE}/solusi-water-jelly-dan-breathable-spf.webp`}
            alt="Wanita Indonesia mengaplikasikan Calming Gloss Gel dan Oxydew Sunscreen dengan hasil akhir ringan segar"
            width="648"
            height="432"
            class="dsw-solution-img"
            loading="lazy"
            fetchpriority="low"
            decoding="async"
          />

          <div class="dsw-check-list">
            <div class="dsw-check-item">
              <span class="dsw-icon-green">
                <Icon name="lucide:check" class="size-3.5" aria-hidden="true" />
              </span>
              <p class="dsw-list-text">
                <strong>Tahap 1 — Calming Barrier Gloss Gel 30ml:</strong> Pelembap tekstur water-jelly bening dengan Meadowestolide®, Astragalus, dan Ceramide NP yang menyejukkan kemerahan serta mengontrol minyak berlebih.
              </p>
            </div>
            <div class="dsw-check-item">
              <span class="dsw-icon-green">
                <Icon name="lucide:check" class="size-3.5" aria-hidden="true" />
              </span>
              <p class="dsw-list-text">
                <strong>Tahap 2 — Oxydew Sunscreen SPF 50+ PA++++ 30ml:</strong> Tabir surya breathable dengan 3% Luceane™, Galactomyces, dan Ekstrak Meniran yang melindungi kulit dari UV tanpa rasa pengap atau whitecast.
              </p>
            </div>
            <div class="dsw-check-item">
              <span class="dsw-icon-green">
                <Icon name="lucide:check" class="size-3.5" aria-hidden="true" />
              </span>
              <p class="dsw-list-text">
                <strong>Nyaman Dipakai di Bawah Hijab & Cuaca Panas:</strong> Cepat meresap dalam hitungan detik, tidak lengket di keringat, dan menjaga pori tetap tenang.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- Section 3: Masalah Kulit -->
      <section class="dsw-section--tinted">
        <h2 class="dsw-h2">
          Dilema Kulit Berminyak <span class="dsw-hl-coral">di Cuaca Tropis</span>
        </h2>

        <div class="dsw-grid-2">
          <article class="dsw-card">
            <img
              src={`${IMG_BASE}/masalah-sunscreen-tebal-bruntusan.webp`}
              alt="Kulit wajah bruntusan dan kemerahan akibat memakai krim dan sunscreen yang terlalu berat"
              width="480"
              height="320"
              class="dsw-card-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <div class="dsw-card-body">
              <span class="dsw-badge-red">Pori Pengap & Bruntusan</span>
              <p class="dsw-card-desc">
                Memakai krim pekat lalu ditumpuk sunscreen lengket membuat pori-pori terperangkap minyak dan memicu bruntusan baru.
              </p>
            </div>
          </article>

          <article class="dsw-card">
            <img
              src={`${IMG_BASE}/masalah-wajah-merah-terbakar-siang.webp`}
              alt="Wajah memerah dan kusam karena takut memakai sunscreen di siang hari"
              width="480"
              height="320"
              class="dsw-card-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <div class="dsw-card-body">
              <span class="dsw-badge-red">Merah Terpapar UV</span>
              <p class="dsw-card-desc">
                Sebaliknya, jika tidak memakai pelembap dan sunscreen, sinar UV langsung membakar skin barrier yang tipis hingga memerah dan kusam.
              </p>
            </div>
          </article>
        </div>

        <div class="dsw-list-box">
          <p class="dsw-list-box-title">Tanda Anda Membutuhkan Paket Sunscreen & Gloss Gel:</p>
          <div class="dsw-check-list" style="margin-top: 0;">
            <div class="dsw-check-item">
              <span class="dsw-icon-red">
                <Icon name="lucide:x" class="size-3.5" aria-hidden="true" />
              </span>
              <p class="dsw-list-text">
                Area dahi dan hidung (T-zone) cepat mengkilap berminyak tapi pipi mudah terasa perih atau memerah
              </p>
            </div>
            <div class="dsw-check-item">
              <span class="dsw-icon-red">
                <Icon name="lucide:x" class="size-3.5" aria-hidden="true" />
              </span>
              <p class="dsw-list-text">
                Sering muncul bintik-bintik kecil (bruntusan) setiap kali mencoba krim siang atau sunscreen yang berat
              </p>
            </div>
            <div class="dsw-check-item">
              <span class="dsw-icon-red">
                <Icon name="lucide:x" class="size-3.5" aria-hidden="true" />
              </span>
              <p class="dsw-list-text">
                Mencari pelembap gel dingin dan sunscreen cair yang ringan seperti tidak memakai apa-apa
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- Section 4: Transformasi Nyata -->
      <section class="dsw-section">
        <h2 class="dsw-h2">
          Transformasi <span class="dsw-hl-aqua">Barrier Tenang & Segar</span>
        </h2>
        <p class="dsw-sub" style="margin-top: 8px;">
          Perbedaan kondisi kulit berminyak-sensitif sebelum dan sesudah rutin memakai Gloss Gel + Oxydew Sunscreen:
        </p>

        <div class="dsw-grid-2">
          <article class="dsw-card">
            <img
              src={`${IMG_BASE}/kondisi-kilap-merah-bruntusan.webp`}
              alt="Kondisi kulit kilap berminyak dengan kemerahan dan bruntusan sebelum perawatan"
              width="480"
              height="320"
              class="dsw-card-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <div class="dsw-card-body">
              <span class="dsw-badge-red">Sebelum Perawatan</span>
              <p class="dsw-card-desc">
                Kulit tampak memerah akibat panas matahari, produksi sebum tidak terkontrol, dan tekstur pipi terasa kasar.
              </p>
            </div>
          </article>

          <article class="dsw-card">
            <img
              src={`${IMG_BASE}/kondisi-adem-kalem-terlindungi.webp`}
              alt="Kondisi kulit wajah kalem, halus, dan segar terlindungi setelah perawatan rutin"
              width="480"
              height="320"
              class="dsw-card-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <div class="dsw-card-body">
              <span class="dsw-badge-green">Rutin Gloss Gel + Oxydew</span>
              <p class="dsw-card-desc">
                Kemerahan tampak mereda, kadar air dan minyak lebih seimbang, serta kulit terlindungi dari terik UV tanpa kilap berlebih.
              </p>
            </div>
          </article>
        </div>

        <div class="dsw-list-box">
          <p class="dsw-list-box-title">Hasil Pemakaian Harian:</p>
          <div class="dsw-check-list" style="margin-top: 0;">
            <div class="dsw-check-item">
              <span class="dsw-icon-green">
                <Icon name="lucide:check" class="size-3.5" aria-hidden="true" />
              </span>
              <p class="dsw-list-text">
                <strong>Hari 1–3:</strong> Sensasi dingin water-jelly menenangkan kulit yang gerah dan sunscreen menyatu bening tanpa whitecast
              </p>
            </div>
            <div class="dsw-check-item">
              <span class="dsw-icon-green">
                <Icon name="lucide:check" class="size-3.5" aria-hidden="true" />
              </span>
              <p class="dsw-list-text">
                <strong>Minggu 1–2:</strong> Produksi minyak di siang hari terasa lebih terkendali dan kemerahan tampak berkurang
              </p>
            </div>
            <div class="dsw-check-item">
              <span class="dsw-icon-green">
                <Icon name="lucide:check" class="size-3.5" aria-hidden="true" />
              </span>
              <p class="dsw-list-text">
                <strong>Minggu 3–4:</strong> Skin barrier terasa lebih kuat, tekstur bruntusan menghalus, dan wajah tampak cerah bersih
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- Section 5: Cara Pakai 2 Langkah -->
      <section class="dsw-section--tinted">
        <h2 class="dsw-h2">
          Cara Pakai <span class="dsw-hl-aqua">2 Langkah Bebas Gerah</span>
        </h2>
        <p class="dsw-sub" style="margin-top: 8px;">
          Gunakan Gloss Gel pagi & malam, lalu kunci dengan Oxydew Sunscreen setiap pagi/siang:
        </p>

        <div class="dsw-grid-2">
          <article class="dsw-card">
            <img
              src={`${IMG_BASE}/cara-pakai-step1-oles-gloss-gel.webp`}
              alt="Langkah 1 oleskan Calming Barrier Gloss Gel untuk menenangkan kulit"
              width="480"
              height="320"
              class="dsw-card-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <div class="dsw-card-body">
              <span class="dsw-badge-teal">1. Sejukkan Barrier</span>
              <p class="dsw-card-desc">
                Oleskan <strong>Calming Barrier Gloss Gel 30ml</strong> secara merata di wajah pagi dan malam untuk menghidrasi tanpa minyak.
              </p>
            </div>
          </article>

          <article class="dsw-card">
            <img
              src={`${IMG_BASE}/cara-pakai-step2-kunci-oxydew.webp`}
              alt="Langkah 2 aplikasikan 2 ruas jari Oxydew Sunscreen SPF 50+ di pagi hari"
              width="480"
              height="320"
              class="dsw-card-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <div class="dsw-card-body">
              <span class="dsw-badge-teal">2. Kunci SPF 50+ (Pagi)</span>
              <p class="dsw-card-desc">
                Setiap pagi sebelum beraktivitas, ratakan 2 ruas jari <strong>Oxydew Sunscreen SPF 50+ PA++++</strong> di wajah dan leher.
              </p>
            </div>
          </article>
        </div>

        <div style="margin-top: 22px; text-align: center;">
          <a href="#form-pemesanan" class="dsw-cta" data-scroll-to-form>
            <span>Pesan Paket Sunscreen & Gloss Gel</span>
            <Icon name="lucide:arrow-right" class="size-5" aria-hidden="true" />
          </a>
        </div>
      </section>

      <!-- Section 6: Bukti Pelanggan -->
      <section class="dsw-section">
        <h2 class="dsw-h2">
          Disukai Pemilik <span class="dsw-hl-aqua">Kulit Berminyak & Sensitif</span>
        </h2>
        <p class="dsw-sub" style="margin-top: 8px;">
          Pengalaman pelanggan yang menggunakan duet Calming Gloss Gel & Oxydew Sunscreen:
        </p>

        <div class="dsw-grid-2">
          <div class="dsw-proof-cell">
            <img
              src={`${IMG_BASE}/bukti-tekstur-jelly-dan-lotion.webp`}
              alt="Tekstur water-jelly bening Gloss Gel dan lotion ringan Oxydew Sunscreen"
              width="480"
              height="320"
              class="dsw-proof-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <p class="dsw-proof-OverlayCaption">Ringan Seperti Air</p>
          </div>
          <div class="dsw-proof-cell">
            <img
              src={`${IMG_BASE}/bukti-wanita-28an-bebas-kilap.webp`}
              alt="Potret pelanggan usia 28 tahun dengan wajah kalem bebas kilap minyak"
              width="480"
              height="320"
              class="dsw-proof-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <p class="dsw-proof-OverlayCaption">Nyaman Seharian di Luar</p>
          </div>
          <div class="dsw-proof-cell">
            <img
              src={`${IMG_BASE}/bukti-pipi-tenang-halus.webp`}
              alt="Close-up pipi tenang bebas kemerahan dan bruntusan"
              width="480"
              height="320"
              class="dsw-proof-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <p class="dsw-proof-OverlayCaption">Pori Tenang Tanpa Pengap</p>
          </div>
          <div class="dsw-proof-cell">
            <img
              src={`${IMG_BASE}/bukti-meja-rias-sunscreen-gloss.webp`}
              alt="Kemasan Paket Sunscreen dan Gloss Gel di meja rias pelanggan"
              width="480"
              height="320"
              class="dsw-proof-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <p class="dsw-proof-OverlayCaption">Duet Wajib Kulit Berminyak</p>
          </div>
        </div>

        <div class="dsw-testi-list">
          <article class="dsw-testi-card">
            <div class="dsw-testi-head">
              <div class="dsw-testi-avatar" aria-hidden="true">A</div>
              <div class="dsw-testi-meta">
                <p class="dsw-testi-name">
                  Kak Intan Aurelia (27 thn)
                  <span class="dsw-verified-pill">Verified Buyer</span>
                </p>
                <div class="dsw-stars">
                  <RatingStars rating={5} starClass="h-3.5 w-3.5 !fill-[#d97706] !text-[#d97706]" />
                </div>
              </div>
            </div>
            <p class="dsw-testi-body">
              "Kulitku gampang banget bruntusan kalau pakai pelembap + sunscreen yang berat. Pas nyobain Gloss Gel ditumpuk Oxydew Sunscreen ini kaget karena rasanya adem dan ringan banget! Sampai sore muka nggak kilang minyak."
            </p>
            <div class="dsw-testi-foot">
              <span>Depok</span>
              <span>•</span>
              <span>Pemakaian 3 Minggu</span>
            </div>
          </article>

          <article class="dsw-testi-card">
            <div class="dsw-testi-head">
              <div class="dsw-testi-avatar" aria-hidden="true">F</div>
              <div class="dsw-testi-meta">
                <p class="dsw-testi-name">
                  Kak Fira Rahmawati (30 thn)
                  <span class="dsw-verified-pill">Verified Buyer</span>
                </p>
                <div class="dsw-stars">
                  <RatingStars rating={5} starClass="h-3.5 w-3.5 !fill-[#d97706] !text-[#d97706]" />
                </div>
              </div>
            </div>
            <p class="dsw-testi-body">
              "Pipiku sering merah kalau kena panas siang. Pakai Gloss Gel dulu bikin kulit langsung kalem, terus dikunci Oxydew SPF 50+ yang nggak ada whitecast-nya sama sekali."
            </p>
            <div class="dsw-testi-foot">
              <span>Sidoarjo</span>
              <span>•</span>
              <span>Pemakaian 4 Minggu</span>
            </div>
          </article>
        </div>
      </section>

      <!-- Section 7: Tabel Perbandingan -->
      <section class="dsw-section--tinted">
        <h2 class="dsw-h2">
          Keunggulan <span class="dsw-hl-aqua">Paket Sunscreen & Gloss Gel</span>
        </h2>
        <p class="dsw-sub" style="margin-top: 8px;">
          Mengapa duet ini jauh lebih bersahabat untuk kulit berminyak, kombinasi, dan sensitif:
        </p>

        <div class="dsw-cmp-card">
          <div class="dsw-cmp-head">
            <div class="dsw-cmp-col">Karakteristik</div>
            <div class="dsw-cmp-col dsw-cmp-col--numa">Sunscreen & Gloss Gel</div>
            <div class="dsw-cmp-col">Krim & SPF Biasa</div>
          </div>

          <div class="dsw-cmp-row">
            <div class="dsw-cmp-cell dsw-cmp-cell--feature">Tekstur di Kulit Berminyak</div>
            <div class="dsw-cmp-cell dsw-cmp-cell--numa">
              <span class="dsw-icon-green" style="margin: 0 auto;">
                <Icon name="lucide:check" class="size-3.5" aria-hidden="true" />
              </span>
              <span class="dsw-cmp-sub">Water-Jelly + Fluid Ringan</span>
            </div>
            <div class="dsw-cmp-cell">
              <span class="dsw-icon-red" style="margin: 0 auto;">
                <Icon name="lucide:x" class="size-3.5" aria-hidden="true" />
              </span>
              <span class="dsw-cmp-sub">Pekat & menyumbat pori</span>
            </div>
          </div>

          <div class="dsw-cmp-row">
            <div class="dsw-cmp-cell dsw-cmp-cell--feature">Penenang Kemerahan & Sebum</div>
