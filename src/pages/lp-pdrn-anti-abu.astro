---
import BaseLayout from '../layouts/BaseLayout.astro';
import GeoIpResolvedForm from '../components/storefront/forms/GeoIpResolvedForm.astro';
import MetaLandingTracker from '../components/storefront/tracking/MetaLandingTracker.astro';
import Icon from '../components/storefront/shared/Icon.astro';
import RatingStars from '../components/storefront/shared/RatingStars.astro';
import LpHeroOffer from '../components/storefront/landing-pages/LpHeroOffer.astro';
import LpBundleValueSection, {
  type BundleTierSpec,
} from '../components/storefront/landing-pages/LpBundleValueSection.astro';
import LpFloatingCta from '../components/storefront/landing-pages/LpFloatingCta.astro';
import { getStorefrontProduct } from '../lib/catalog';
import { nativeLandingCanonicalPath } from '../lib/landing-pages';
import { defaultCatalogContentId } from '../lib/catalog-feed';
import { getRuntimeEnv } from '../lib/env';
import { loadStoreCodDisabledProvinceCodes } from '../lib/form-mode';
import { getStoreAdsConfig } from '../lib/store-ads';
import '../styles/form-hybrid.css';
import '../styles/landing-pages/lp-meta-ads.css';

export const prerender = false;

const PRODUCT_SLUG = 'pdrn-alpha-arbutin-tone-up-day-cream';
const LANDING_SLUG = 'lp-pdrn-anti-abu';
const PAGE_TITLE =
  'PDRN Alpha Arbutin Tone-Up Day Cream — 0% Abu-Abu di Kulit Sawo Matang & Tahan Keringat BPOM';
const PAGE_DESC =
  'Krim pagi tone-up berpigmen Warm Natural Beige yang langsung menyatu di kulit sawo matang Indonesia dengan 0% efek abu-abu dempul, 10.000 ppm PDRN, dan Alpha-Arbutin (BPOM NA18262000246).';
const IMG_BASE = '/images/landing/pdrn-alpha-arbutin-tone-up-day-cream';
const HERO_IMAGE = `${IMG_BASE}/hero-pdrn-anti-abu.webp`;

const database = getRuntimeEnv(Astro.locals)?.OMS_DB as D1Database | undefined;
const claimedProductSlug = Astro.request.headers.get('x-adsbook-product-page');
const [product, canonicalPath, codDisabledProvinceCodes] = await Promise.all([
  getStorefrontProduct(Astro.locals, PRODUCT_SLUG),
  claimedProductSlug
    ? Promise.resolve(`/produk/${claimedProductSlug}`)
    : nativeLandingCanonicalPath(Astro.locals, LANDING_SLUG),
  loadStoreCodDisabledProvinceCodes(database),
  getStoreAdsConfig(Astro.locals),
]);
if (!product) {
  return Astro.rewrite('/404');
}

const canonical = `${Astro.locals.tenant.siteUrl}${canonicalPath}`;

const variants = product.variants || [];
const cheapestVariant = variants.reduce(
  (min: any, v: any) => (!min || v.price < min.price ? v : min),
  variants[0]
);
const defaultVariant = cheapestVariant || {
  id: '54',
  label: '30 gr',
  price: 79499,
  comparePrice: 100000,
};

const BUNDLE_TIERS: BundleTierSpec[] = [
  {
    productSlug: 'pdrn-alpha-arbutin-tone-up-day-cream',
    badge: 'Pilihan Coba Satuan',
    image: `${IMG_BASE}/kemasan-pdrn-jar-30g.webp`,
    imageAlt: 'Kemasan Jar PDRN Alpha Arbutin Tone-Up Day Cream 30gr',
    benefit: 'Krim pagi Warm Natural Beige 10.000 PPM Encapsulated PDRN + Alpha-Arbutin bebas abu-abu.',
    ctaLabel: 'Pilih 1 Jar',
  },
  {
    productSlug: 'paket-protection-duo-pdrn',
    badge: 'Terfavorit • Paket Pagi Anti-UV & Anti-Luntur',
    featured: true,
    image: '/images/landing/paket-protection-duo-pdrn/kemasan-duo-pdrn-oxydew.webp',
    imageAlt: 'Paket Protection Duo PDRN Day Cream dan Oxydew Sunscreen SPF 50+',
    benefit: 'PDRN Tone-Up Day Cream 30gr + Oxydew Sunscreen 3% Luceane SPF 50+ PA++++ 30ml bebas whitecast.',
    ctaLabel: 'Ambil Duo Anti-UV',
  },
  {
    productSlug: 'paket-hydra-glow-duo',
    badge: 'Duet Krim Siang & Malam',
    image: '/images/landing/paket-hydra-glow-duo/kemasan-hydra-glow-duo.webp',
    imageAlt: 'Paket Hydra Glow Duo PDRN Day Cream dan Adenosine Moisturizer',
    benefit: 'Cerah natural bebas bedak tebal di pagi hari + kunci hidrasi 11X Hyaluronic Acid di malam hari.',
    ctaLabel: 'Pilih Siang-Malam',
  },
  {
    productSlug: 'paket-age-defense-trio',
    badge: 'Perawatan Lengkap 3-in-1 (24 Jam)',
    image: '/images/landing/paket-age-defense-trio/kemasan-age-defense-trio.webp',
    imageAlt: 'Paket Age Defense Trio 3-in-1 Numa Skin',
    benefit: 'Komplit 3 produk full-size: PDRN Day Cream + Adenosine Moisturizer + Oxydew Sunscreen SPF 50+.',
    ctaLabel: 'Pilih Paket Trio',
  },
];
---

<BaseLayout
  title={PAGE_TITLE}
  description={PAGE_DESC}
  image={HERO_IMAGE}
  preloadImages={HERO_IMAGE}
  canonical={canonical}
  noindex={true}
  hideHeader={true}
  hideFooter={true}
>
  <MetaLandingTracker
    slug={LANDING_SLUG}
    contentId={defaultCatalogContentId(product)}
    contentName={product.contentName}
    price={defaultVariant.price}
  />

  <div class="dsw-shell">
    <main class="dsw-canvas">
      <!-- Section 1: Hero (Matched to CPAS 2 Batch 3 Highest-CTR 6%–10.4% KOL PDRN Videos) -->
      <section id="hero-section" class="dsw-hero">
        <div class="dsw-hero-head">
          <h1 class="dsw-h1">
            Kulit Sawo Matang <span class="dsw-hl-tilt">Langsung Cerah Menyatu</span> — 0% Abu-Abu Dempul Seharian!
          </h1>
          <p class="dsw-sub" style="max-width: 390px; margin: 14px auto 0; font-weight: 700;">
            Kapok pakai krim tone-up putih tembok yang bikin muka belang di leher & luntur putih saat berkeringat?<br />
            <span class="dsw-underline-teal">Pigmen Warm Natural Beige + 10.000 PPM PDRN menyatu di kulit Indonesia dalam 15 detik!</span>
          </p>
        </div>

        <div class="dsw-hero-stage">
          <div class="dsw-hero-top-tag">
            <div class="dsw-hero-top-pill">
              <Icon name="lucide:sun" class="size-3.5" aria-hidden="true" />
              <span>Warm Natural Beige • 0% Whitecast & Anti-Abu</span>
            </div>
          </div>

          <img
            src={HERO_IMAGE}
            alt="Perbandingan wajah sawo matang yang belang abu-abu dempul vs cerah warm beige menyatu mulus dengan leher menggunakan Numa Skin PDRN Day Cream"
            width="720"
            height="480"
            class="dsw-hero-img"
            fetchpriority="high"
            loading="eager"
            decoding="async"
          />

          <div class="dsw-hero-ba" aria-hidden="true">
            <span class="dsw-hero-ba-pill dsw-hero-ba-pill--before">SEBELUM — Belang Abu-Abu Dempul</span>
            <span class="dsw-hero-ba-pill dsw-hero-ba-pill--after">SESUDAH — Warm Beige Menyatu Alami</span>
          </div>

          <div class="dsw-hero-overlap">
            <div class="dsw-hero-overlap-inner">
              <h2 class="dsw-hero-overlap-title">Diformulasikan Khusus Undertone Kulit Wanita Indonesia!</h2>
              <p class="dsw-hero-overlap-text">
                Krim tone-up impor berwarna putih susu <strong style="color: #be123c;">dirancang untuk kulit pucat, sehingga berubah abu-abu kusam di kulit sawo matang</strong>.
              </p>
            </div>
          </div>
        </div>

        <div class="dsw-trust-row">
          <div class="dsw-trust-item">
            <span class="dsw-trust-icon">
              <Icon name="lucide:shield-check" class="size-4" aria-hidden="true" />
            </span>
            <div>
              <span class="dsw-trust-label">BPOM Resmi</span>
              <span class="dsw-trust-sub">NA18262000246</span>
            </div>
          </div>
          <div class="dsw-trust-item">
            <span class="dsw-trust-icon">
              <Icon name="lucide:badge-check" class="size-4" aria-hidden="true" />
            </span>
            <div>
              <span class="dsw-trust-label">Anti-Luntur</span>
              <span class="dsw-trust-sub">Satin Finish</span>
            </div>
          </div>
          <div class="dsw-trust-item">
            <span class="dsw-trust-icon">
              <Icon name="lucide:truck" class="size-4" aria-hidden="true" />
            </span>
            <div>
              <span class="dsw-trust-label">Bisa COD</span>
              <span class="dsw-trust-sub">Bayar di Rumah</span>
            </div>
          </div>
        </div>

        <LpHeroOffer
          price={defaultVariant.price}
          comparePrice={defaultVariant.comparePrice}
          eyebrow="Promo Resmi Hari Ini • Tersedia Paket Pagi Anti-UV Hemat"
          ctaText="Pilih Paket & Cek Ongkir"
        />
      </section>

      <!-- Section 2: Solusi Singkat + Visual -->
      <section class="dsw-section">
        <h2 class="dsw-h2">
          Rapi berangkat pagi <span class="dsw-hl-aqua">tanpa takut belang di leher</span>
        </h2>
        <p class="dsw-sub">Pigmen warm natural beige yang menyatu mulus dalam 15 detik di kulit sawo matang maupun kuning langsat.</p>

        <div class="dsw-photo-stack">
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/solusi-tone-up-natural-beige.webp`}
              alt="Wanita Indonesia meratakan krim pagi berwarna natural beige di pipi dengan hasil cerah menyatu"
              width="648"
              height="432"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
          </div>
        </div>

        <div class="dsw-list">
          <div class="dsw-list-row">
            <span class="dsw-icon-teal">
              <Icon name="lucide:layers" class="size-4" aria-hidden="true" />
            </span>
            <p class="dsw-list-text">
              <strong style="color: #0f172a;">10.000 ppm (1%) Encapsulated Vegan PDRN</strong> dengan daya serap 330,3% lebih dalam untuk merawat elastisitas kulit.
            </p>
          </div>
          <div class="dsw-list-row">
            <span class="dsw-icon-teal">
              <Icon name="lucide:sun" class="size-4" aria-hidden="true" />
            </span>
            <p class="dsw-list-text">
              <strong style="color: #0f172a;">Alpha-Arbutin + 5% Niacinamide</strong> menghambat pemicu flek hitam & noda gelap hingga 9x lebih efektif dibanding Beta-Arbutin.
            </p>
          </div>
          <div class="dsw-list-row">
            <span class="dsw-icon-teal">
              <Icon name="lucide:shield-plus" class="size-4" aria-hidden="true" />
            </span>
            <p class="dsw-list-text">
              <strong style="color: #0f172a;">4X UV Filter & Natural Beige Tint</strong> menyamarkan flek dan meratakan warna kulit seketika tanpa rasa lengket maupun efek topeng.
            </p>
          </div>
        </div>
      </section>

      <!-- Section 3: Tanda Masalah Kulit + Visual Grid -->
      <section class="dsw-section dsw-section--warn">
        <h2 class="dsw-h2">
          Kenapa krim tone-up putih bikin <span class="dsw-underline-warn">muka abu-abu & cakey</span>:
        </h2>

        <div class="dsw-photo-grid-2">
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/masalah-muka-abu-topeng.webp`}
              alt="Wajah tampak belang keabuan dan dempul akibat krim pemutih instan berwarna putih kapur"
              width="315"
              height="210"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <p class="dsw-photo-caption">
              <strong style="color: #be123c; display: block;">Abu-Abu & Belang di Leher</strong>
              Krim putih kapur bertabrakan dengan pigmen hangat kulit sawo matang.
            </p>
          </div>
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/masalah-flek-kusam-pagi.webp`}
              alt="Flek hitam membandel dan noda gelap di tulang pipi yang sulit tertutup krim biasa"
              width="315"
              height="210"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <p class="dsw-photo-caption">
              <strong style="color: #be123c; display: block;">Luntur Saat Berkeringat</strong>
              Menggumpal pecah di sekitar hidung dan garis senyum saat cuaca panas.
            </p>
          </div>
        </div>

        <div class="dsw-list">
          <div class="dsw-list-row">
            <span class="dsw-icon-warn">
              <Icon name="lucide:triangle-alert" class="size-4" aria-hidden="true" />
            </span>
            <p class="dsw-list-text">
              Setiap kali pakai krim pencerah instan, <strong style="color: #be123c;">wajah malah kelihatan keabuan seperti pakai bedak dingin</strong>.
            </p>
          </div>
          <div class="dsw-list-row">
            <span class="dsw-icon-warn">
              <Icon name="lucide:triangle-alert" class="size-4" aria-hidden="true" />
            </span>
            <p class="dsw-list-text">
              Saat terkena keringat siang hari, <strong style="color: #be123c;">krim luntur meninggalkan garis putih di lipatan wajah dan hijab</strong>.
            </p>
          </div>
          <div class="dsw-list-row">
            <span class="dsw-icon-warn">
              <Icon name="lucide:triangle-alert" class="size-4" aria-hidden="true" />
            </span>
            <p class="dsw-list-text">
              Krim siang biasa hanya menutup di permukaan <strong style="color: #be123c;">tanpa PDRN & Alpha-Arbutin yang benar-benar memudarkan flek hitam</strong>.
            </p>
          </div>
        </div>
      </section>

      <!-- Section 4: Ilustrasi Perawatan Rutin -->
      <section class="dsw-section">
        <h2 class="dsw-h2">
          Bukti nyata perubahan <span class="dsw-hl-aqua">di kulit sawo matang</span>
        </h2>
        <p class="dsw-sub">Beda telak krim tone-up putih kapur vs pigmen Natural Beige PDRN Numa Skin.</p>

        <div class="dsw-photo-stack">
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/kondisi-kusam-abu-dempul.webp`}
              alt="Kulit pipi tampak kusam dengan flek hitam dan sisa krim putih yang menggumpal abu-abu di pori"
              width="648"
              height="432"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <span class="dsw-photo-badge dsw-photo-badge--before">SEBELUM — Flek & Abu-Abu Dempul</span>
            <p class="dsw-photo-caption">
              Flek hitam di pipi membayang keabuan dan residu krim putih menggumpal kasar di dalam pori-pori.
            </p>
          </div>

          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/kondisi-cerah-alami-menyatu.webp`}
              alt="Kulit sawo matang tampak cerah merata, halus, dan glowing alami setelah memakai PDRN Tone-Up Day Cream"
              width="648"
              height="432"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <span class="dsw-photo-badge dsw-photo-badge--after">SESUDAH RUTIN — Cerah Menyatu Alami</span>
            <p class="dsw-photo-caption">
              Warna kulit langsung setingkat lebih cerah merata, flek hitam tersamarkan mulus, dan menyatu alami dengan leher.
            </p>
          </div>
        </div>
      </section>

      <!-- Section 5: Dark Marine Section — Cara Pakai Praktis -->
      <section class="dsw-section dsw-section--dark">
        <h2 class="dsw-h2">
          Menyatu Sempurna <span style="color: #99e2ec;">Dalam 15 Detik</span>
        </h2>
        <p class="dsw-sub">Mudah dibaurkan dengan jari tanpa perlu sponge atau kuas makeup.</p>

        <div class="dsw-photo-stack">
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/cara-pakai-ambil-krim-beige.webp`}
              alt="Mengambil krim pagi berwarna warm natural beige dari jar kaca frosted Numa Skin PDRN Day Cream"
              width="648"
              height="432"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <p class="dsw-photo-caption">
              <strong style="color: #ffffff;">Langkah 1 (Ambil Seukuran Mutiara):</strong> Totolkan krim beige di dahi, kedua pipi, hidung, dan dagu.
            </p>
          </div>

          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/cara-pakai-ratakan-pagi.webp`}
              alt="Meratakan PDRN Tone-Up Day Cream dengan jari di depan cermin meja rias pagi hari"
              width="648"
              height="432"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <p class="dsw-photo-caption">
              <strong style="color: #ffffff;">Langkah 2 (Baurkan Merata):</strong> Tepuk dan ratakan lembut ke seluruh wajah hingga menyatu sempurna.
            </p>
          </div>
        </div>

        <div class="dsw-list">
          <div class="dsw-list-row">
            <span class="dsw-step-num">1</span>
            <p class="dsw-step-text">
              Gunakan <strong style="color: #ffffff;">setiap pagi hari</strong> setelah mencuci wajah dan memakai toner/serum.
            </p>
          </div>
          <div class="dsw-list-row">
            <span class="dsw-step-num">2</span>
            <p class="dsw-step-text">
              Bisa dipakai langsung <strong style="color: #ffffff; background: #104452; padding: 1px 6px; border-radius: 4px;">tanpa foundation atau bedak padat</strong> untuk tampilan segar harian.
            </p>
          </div>
          <div class="dsw-list-row">
            <span class="dsw-step-num">3</span>
            <p class="dsw-step-text">
              Untuk aktivitas luar ruangan terik, pilih <strong style="color: #ffffff;">Paket Protection Duo (+ Oxydew Sunscreen SPF 50+ PA++++)</strong> di form bawah.
            </p>
          </div>
        </div>
      </section>

      <!-- Section 6: Ulasan Pelanggan -->
      <section class="dsw-section">
        <h2 class="dsw-h2">
          Apa kata pemilik <span class="dsw-hl-aqua">kulit sawo matang?</span>
        </h2>
        <p class="dsw-sub">Ribuan pelanggan beralih karena warnanya menyatu tanpa efek topeng keabuan.</p>

        <div class="dsw-reviews-divide">
          <div class="dsw-review-row">
            <div class="dsw-review-head">
              <div>
                <p class="dsw-review-author">
                  Kak Nadia P.
                  <span style="color: #0b6e7d; display: inline-flex;">
                    <Icon name="lucide:badge-check" class="size-4" aria-hidden="true" />
                  </span>
                </p>
                <p class="dsw-review-meta">Jakarta Selatan • Kulit Sawo Matang</p>
              </div>
              <RatingStars rating={5} starClass="h-3.5 w-3.5 !fill-[#d97706] !text-[#d97706]" />
            </div>
            <p class="dsw-review-quote">
              "Akhirnya nemu day cream tone-up yang <span class="dsw-hl-aqua">warnanya beige natural, bukan putih tembok!</span> Di kulitku yang sawo matang langsung nyatu, <strong style="color: #0f172a;">gak bikin muka abu-abu sama sekali</strong>."
            </p>
          </div>

          <div class="dsw-review-row">
            <div class="dsw-review-head">
              <div>
                <p class="dsw-review-author">
                  Ibu Rini H.
                  <span style="color: #0b6e7d; display: inline-flex;">
                    <Icon name="lucide:badge-check" class="size-4" aria-hidden="true" />
                  </span>
                </p>
                <p class="dsw-review-meta">Semarang • Guru Usia 41 Tahun</p>
              </div>
              <RatingStars rating={5} starClass="h-3.5 w-3.5 !fill-[#d97706] !text-[#d97706]" />
            </div>
            <p class="dsw-review-quote">
              "Pagi-pagi buru-buru ngajar tinggal oles krim PDRN ini aja udah kelihatan rapi dan segar. Setelah habis 1 jar, <span class="dsw-hl-aqua">flek hitam bekas matahari di pipi juga kelihatan makin tipis</span>."
            </p>
          </div>

          <div class="dsw-review-row">
            <div class="dsw-review-head">
              <div>
                <p class="dsw-review-author">
                  Ibu Maya L.
                  <span style="color: #0b6e7d; display: inline-flex;">
                    <Icon name="lucide:badge-check" class="size-4" aria-hidden="true" />
                  </span>
                </p>
                <p class="dsw-review-meta">Tangerang • Ambil Paket Bundling</p>
              </div>
              <RatingStars rating={5} starClass="h-3.5 w-3.5 !fill-[#d97706] !text-[#d97706]" />
            </div>
            <p class="dsw-review-quote">
              "Biasanya kalau pakai krim pagi, siang dikit langsung <span class="dsw-hl-rose">mengkilap dan luntur di sekitar hidung</span>. Pakai Numa Skin ini <span class="dsw-hl-aqua">tetap halus satin sampai sore</span>."
            </p>
          </div>
        </div>
      </section>

      <!-- Section 7: Galeri Bukti Visual -->
      <section class="dsw-section dsw-section--tint">
        <h2 class="dsw-h2">
          Warna <span style="color: #0b6e7d;">Natural Beige</span> untuk kulit tropis
        </h2>
        <p class="dsw-sub">Menyamarkan tampilan pori dan noda gelap tanpa menutup napas kulit.</p>

        <div class="dsw-photo-grid-2">
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/bukti-swatch-warm-beige.webp`}
              alt="Swatch tekstur krim berwarna warm natural beige yang menyatu di kulit tangan sawo matang"
              width="315"
              height="210"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
          </div>
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/bukti-wanita-kerja-cerah.webp`}
              alt="Wanita Indonesia berhijab tampil segar dan cerah alami di pagi hari"
              width="315"
              height="210"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
          </div>
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/bukti-glow-tanpa-bedak.webp`}
              alt="Hasil akhir kulit satin-dewy yang halus merata tanpa bedak tebal"
              width="315"
              height="210"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
          </div>
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/bukti-meja-rias-pdrn.webp`}
