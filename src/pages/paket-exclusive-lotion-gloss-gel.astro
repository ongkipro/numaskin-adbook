---
import BaseLayout from '../layouts/BaseLayout.astro';
import GeoIpResolvedForm from '../components/storefront/forms/GeoIpResolvedForm.astro';
import MetaLandingTracker from '../components/storefront/tracking/MetaLandingTracker.astro';
import Icon from '../components/storefront/shared/Icon.astro';
import RatingStars from '../components/storefront/shared/RatingStars.astro';
import { getStorefrontProduct } from '../lib/catalog';
import { nativeLandingCanonicalPath } from '../lib/landing-pages';
import { defaultCatalogContentId } from '../lib/catalog-feed';
import { getRuntimeEnv } from '../lib/env';
import { loadStoreCodDisabledProvinceCodes } from '../lib/form-mode';
import { getStoreAdsConfig } from '../lib/store-ads';
import '../styles/form-hybrid.css';
import '../styles/landing-pages/paket-exclusive-lotion-gloss-gel.css';

export const prerender = false;

const PRODUCT_SLUG = 'paket-exclusive-lotion-gloss-gel';
const LANDING_SLUG = 'paket-exclusive-lotion-gloss-gel';
const PAGE_TITLE = 'Paket Exclusive Lotion & Gloss Gel - Gift Set Hidrasi & Penenang Barrier BPOM';
const PAGE_DESC = 'Paket eksklusif Numa Skin berisi Deep Sea Water Treatment Lotion 150ml + Travel Size 50ml (NA18220101400), Calming Barrier Gloss Gel 30ml (NA18230107056), dan Exclusive Pouch.';
const IMG_BASE = '/images/landing/paket-exclusive-lotion-gloss-gel';
const HERO_IMAGE = `${IMG_BASE}/hero-paket-exclusive-lotion-gloss-gel.webp`;

const database = getRuntimeEnv(Astro.locals)?.OMS_DB as D1Database | undefined;
const claimedProductSlug = Astro.request.headers.get('x-adsbook-product-page');
const [product, canonicalPath, codDisabledProvinceCodes] = await Promise.all([
  getStorefrontProduct(Astro.locals, PRODUCT_SLUG),
  claimedProductSlug
    ? Promise.resolve(`/produk/${claimedProductSlug}`)
    : nativeLandingCanonicalPath(Astro.locals, LANDING_SLUG),
  loadStoreCodDisabledProvinceCodes(database),
  getStoreAdsConfig(Astro.locals),
]);
if (!product) {
  return Astro.rewrite('/404');
}

const canonical = `${Astro.locals.tenant.siteUrl}${canonicalPath}`;

const variants = product.variants || [];
const cheapestVariant = variants.reduce(
  (min: any, v: any) => (!min || v.price < min.price ? v : min),
  variants[0]
);
const defaultVariant = cheapestVariant || {
  id: '21',
  label: 'Toner 150ml + Toner 50ml + Gloss Gel 30ml + Pouch',
  price: 240000,
  comparePrice: 267000,
};
---

<BaseLayout
  title={PAGE_TITLE}
  description={PAGE_DESC}
  image={HERO_IMAGE}
  preloadImages={HERO_IMAGE}
  canonical={canonical}
  hideHeader={true}
  hideFooter={true}
>
  <MetaLandingTracker
    slug={LANDING_SLUG}
    contentId={defaultCatalogContentId(product)}
    contentName={product.contentName}
    price={defaultVariant.price}
  />

  <div class="dsw-shell">
    <main class="dsw-canvas">
      <!-- Section 1: Hero -->
      <section id="hero-section" class="dsw-hero">
        <div class="dsw-hero-head">
          <h1 class="dsw-h1">
            <span class="dsw-hl-tilt">Kulit Rewel & Merah</span> Saat di Rumah Maupun Saat Bepergian?
          </h1>
          <p class="dsw-sub" style="max-width: 390px; margin: 14px auto 0; font-weight: 700;">
            Skin barrier yang tipis mudah memerah dan bruntusan jika jadwal hidrasi terputus saat keluar rumah.<br />
            <span class="dsw-underline-teal">Rawat di rumah & di perjalanan dengan Exclusive Box + Pouch!</span>
          </p>
        </div>

        <div class="dsw-hero-stage">
          <div class="dsw-hero-top-tag">
            <div class="dsw-hero-top-pill">
              <Icon name="lucide:award" class="size-3.5" aria-hidden="true" />
              <span>Exclusive Box + Pouch • Hemat Rp27rb</span>
            </div>
          </div>

          <img
            src={HERO_IMAGE}
            alt="Perbandingan kulit kemerahan bruntusan vs kulit tenang glassy dengan Paket Exclusive Lotion dan Gloss Gel Numa Skin"
            width="720"
            height="480"
            class="dsw-hero-img"
            fetchpriority="high"
            loading="eager"
            decoding="async"
          />

          <div class="dsw-hero-ba" aria-hidden="true">
            <span class="dsw-hero-ba-pill dsw-hero-ba-pill--before">Kemerahan & Dehidrasi</span>
            <span class="dsw-hero-ba-pill dsw-hero-ba-pill--after">Barrier Tenang & Glassy</span>
          </div>

          <div class="dsw-hero-trust-strip" role="list" aria-label="Jaminan kualitas Numa Skin">
            <div class="dsw-trust-item" role="listitem">
              <span class="dsw-trust-icon">
                <Icon name="lucide:shield-check" class="size-3.5" aria-hidden="true" />
              </span>
              <span class="dsw-trust-text">
                <strong class="dsw-trust-label">2 BPOM Resmi</strong>
                <span class="dsw-trust-sub">Lotion & Gloss Gel</span>
              </span>
            </div>
            <div class="dsw-trust-item" role="listitem">
              <span class="dsw-trust-icon">
                <Icon name="lucide:droplets" class="size-3.5" aria-hidden="true" />
              </span>
              <span class="dsw-trust-text">
                <strong class="dsw-trust-label">150ml + 50ml</strong>
                <span class="dsw-trust-sub">Rumah & Travel Size</span>
              </span>
            </div>
            <div class="dsw-trust-item" role="listitem">
              <span class="dsw-trust-icon">
                <Icon name="lucide:layers" class="size-3.5" aria-hidden="true" />
              </span>
              <span class="dsw-trust-text">
                <strong class="dsw-trust-label">Bonus Pouch</strong>
                <span class="dsw-trust-sub">Exclusive Gift Box</span>
              </span>
            </div>
          </div>
        </div>

        <div class="dsw-hero-foot">
          <p class="dsw-hero-caption">
            Paket eksklusif lengkap: <strong>Treatment Lotion 150ml + 50ml</strong>, <strong>Calming Barrier Gloss Gel 30ml</strong>, dan <strong>Exclusive Pouch</strong> dalam Gift Box.
          </p>
          <a href="#form-pemesanan" class="dsw-cta" data-scroll-to-form>
            <span>Ambil Paket Exclusive Ini</span>
            <Icon name="lucide:arrow-right" class="size-5" aria-hidden="true" />
          </a>
        </div>
      </section>

      <!-- Section 2: Solusi Praktis -->
      <section class="dsw-section">
        <h2 class="dsw-h2">
          Hidrasi Utuh <span class="dsw-hl-aqua">di Rumah & Saat Bepergian</span>
        </h2>
        <p class="dsw-sub" style="margin-top: 8px;">
          Satu paket eksklusif untuk menjaga skin barrier tetap tenang, adem, dan lembap tanpa jeda:
        </p>

        <div class="dsw-solution-box">
          <img
            src={`${IMG_BASE}/solusi-kompres-toner-kunci-gloss-gel.webp`}
            alt="Wanita Indonesia mengaplikasikan rangkaian Treatment Lotion dan Gloss Gel dengan hasil kulit glassy tenang"
            width="648"
            height="432"
            class="dsw-solution-img"
            loading="lazy"
            fetchpriority="low"
            decoding="async"
          />

          <div class="dsw-check-list">
            <div class="dsw-check-item">
              <span class="dsw-icon-green">
                <Icon name="lucide:check" class="size-3.5" aria-hidden="true" />
              </span>
              <p class="dsw-list-text"><strong>Treatment Lotion Jumbo 150ml (di Rumah):</strong> First essence dengan 76% Air Laut Dalam Ulleungdo, Galactomyces, dan 5X Ceramide untuk kompres hidrasi pagi dan malam.</p>
            </div>
            <div class="dsw-check-item">
              <span class="dsw-icon-green">
                <Icon name="lucide:check" class="size-3.5" aria-hidden="true" />
              </span>
              <p class="dsw-list-text"><strong>Treatment Lotion Travel 50ml + Pouch (Bepergian):</strong> Kemasan pump 50ml praktis di dalam pouch eksklusif agar kulit tidak pernah kering saat di kantor atau perjalanan.</p>
            </div>
            <div class="dsw-check-item">
              <span class="dsw-icon-green">
                <Icon name="lucide:check" class="size-3.5" aria-hidden="true" />
              </span>
              <p class="dsw-list-text"><strong>Calming Barrier Gloss Gel 30ml:</strong> Pelembap water-jelly dengan Meadowestolide dan Astragalus yang meredakan kemerahan serta mengunci kelembapan.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- Section 3: Masalah Kulit -->
      <section class="dsw-section--tinted">
        <h2 class="dsw-h2">
          Kenapa Skin Barrier <span class="dsw-hl-coral">Sering Kembali Rewel?</span>
        </h2>

        <div class="dsw-grid-2">
          <article class="dsw-card">
            <img
              src={`${IMG_BASE}/masalah-kulit-rewel-traveling-rumah.webp`}
              alt="Kulit wajah kembali memerah dan bruntusan karena lupa membawa skincare saat bepergian"
              width="480"
              height="320"
              class="dsw-card-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <div class="dsw-card-body">
              <span class="dsw-badge-red">Hidrasi Terputus di Luar</span>
              <p class="dsw-card-desc">Botol toner besar sulit dibawa bepergian sehingga wajah dehidrasi terkena AC dan polusi seharian.</p>
            </div>
          </article>

          <article class="dsw-card">
            <img
              src={`${IMG_BASE}/masalah-minyak-berlebih-tapi-kering.webp`}
              alt="Kulit berminyak di luar namun terasa perih ketarik dan mengelupas di sela hidung"
              width="480"
              height="320"
              class="dsw-card-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <div class="dsw-card-body">
              <span class="dsw-badge-red">Berminyak Tapi Perih</span>
              <p class="dsw-card-desc">Toner saja menguap kembali jika tidak dikunci gel pelembap bertekstur ringan yang menenangkan pori.</p>
            </div>
          </article>
        </div>

        <div class="dsw-list-box">
          <p class="dsw-list-box-title">Tanda Anda Membutuhkan Paket Ini:</p>
          <div class="dsw-check-list" style="margin-top: 0;">
            <div class="dsw-check-item">
              <span class="dsw-icon-red">
                <Icon name="lucide:x" class="size-3.5" aria-hidden="true" />
              </span>
              <p class="dsw-list-text">Kulit mudah memerah, perih, atau muncul bruntusan halus saat berganti cuaca atau ruangan ber-AC</p>
            </div>
            <div class="dsw-check-item">
              <span class="dsw-icon-red">
                <Icon name="lucide:x" class="size-3.5" aria-hidden="true" />
              </span>
              <p class="dsw-list-text">Sering bepergian atau bekerja seharian sehingga butuh botol 150ml di meja rias dan 50ml di dalam tas</p>
            </div>
            <div class="dsw-check-item">
              <span class="dsw-icon-red">
                <Icon name="lucide:x" class="size-3.5" aria-hidden="true" />
              </span>
              <p class="dsw-list-text">Mencari bingkisan skincare eksklusif dengan Gift Box & Pouch resmi Numa Skin yang siap pakai</p>
            </div>
          </div>
        </div>
      </section>

      <!-- Section 4: Transformasi Nyata -->
      <section class="dsw-section">
        <h2 class="dsw-h2">
          Transformasi <span class="dsw-hl-aqua">Barrier Tenang & Glass Skin</span>
        </h2>
        <p class="dsw-sub" style="margin-top: 8px;">
          Perbedaan nyata sebelum dan sesudah rutin menghidrasi kulit dengan Paket Exclusive Lotion & Gloss Gel:
        </p>

        <div class="dsw-grid-2">
          <article class="dsw-card">
            <img
              src={`${IMG_BASE}/kondisi-kemerahan-dehidrasi-bruntusan.webp`}
              alt="Kondisi kulit kemerahan, bruntusan halus di dahi dan pipi, serta dehidrasi sebelum perawatan"
              width="480"
              height="320"
              class="dsw-card-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <div class="dsw-card-body">
              <span class="dsw-badge-red">Sebelum Perawatan</span>
              <p class="dsw-card-desc">Pipi mudah memerah, tekstur terasa kasar beruntusan, dan minyak berlebih muncul karena dehidrasi dalam.</p>
            </div>
          </article>

          <article class="dsw-card">
            <img
              src={`${IMG_BASE}/kondisi-barrier-tenang-glassy-segar.webp`}
              alt="Kondisi kulit tenang, mulus, bebas kemerahan, dan tampak glassy sehat setelah rutin memakai paket"
              width="480"
              height="320"
              class="dsw-card-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <div class="dsw-card-body">
              <span class="dsw-badge-green">Rutin Exclusive Set</span>
              <p class="dsw-card-desc">Kemerahan tampak mereda, pori terasa adem seimbang, dan permukaan kulit memantulkan kilau sehat.</p>
            </div>
          </article>
        </div>

        <div class="dsw-list-box">
          <p class="dsw-list-box-title">Tahapan Hasil Pemakaian Rutin:</p>
          <div class="dsw-check-list" style="margin-top: 0;">
            <div class="dsw-check-item">
              <span class="dsw-icon-green">
                <Icon name="lucide:check" class="size-3.5" aria-hidden="true" />
              </span>
              <p class="dsw-list-text"><strong>Minggu 1:</strong> Sensasi panas dan ketarik sehabis cuci muka langsung reda berkat kompres Lotion & Gloss Gel</p>
            </div>
            <div class="dsw-check-item">
              <span class="dsw-icon-green">
                <Icon name="lucide:check" class="size-3.5" aria-hidden="true" />
              </span>
              <p class="dsw-list-text"><strong>Minggu 2–3:</strong> Bruntusan akibat dehidrasi tampak lebih halus dan produksi minyak di zona-T lebih terkontrol</p>
            </div>
            <div class="dsw-check-item">
              <span class="dsw-icon-green">
                <Icon name="lucide:check" class="size-3.5" aria-hidden="true" />
              </span>
              <p class="dsw-list-text"><strong>Minggu 4–6:</strong> Skin barrier terasa jauh lebih kuat, tidak gampang rewel saat traveling, dan tampak glassy</p>
            </div>
          </div>
        </div>
      </section>

      <!-- Section 5: Cara Pakai -->
      <section class="dsw-section--tinted">
        <h2 class="dsw-h2">
          Cara Pakai <span class="dsw-hl-aqua">Praktis Setiap Hari</span>
        </h2>
        <p class="dsw-sub" style="margin-top: 8px;">
          Dua langkah sederhana setiap pagi dan malam di rumah maupun saat bepergian:
        </p>

        <div class="dsw-grid-2">
          <article class="dsw-card">
            <img
              src={`${IMG_BASE}/cara-pakai-exc-step1-toner-lotion.webp`}
              alt="Menuangkan Deep Sea Water Treatment Lotion ke telapak tangan lalu menepuk lembut ke wajah"
              width="480"
              height="320"
              class="dsw-card-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <div class="dsw-card-body">
              <span class="dsw-badge-teal">1. Tepuk Treatment Lotion</span>
              <p class="dsw-card-desc">Gunakan botol <strong>150ml di rumah</strong> atau <strong>50ml saat bepergian</strong>, tepuk lembut ke wajah hingga meresap.</p>
            </div>
          </article>

          <article class="dsw-card">
            <img
              src={`${IMG_BASE}/cara-pakai-exc-step2-gloss-gel.webp`}
              alt="Mengoleskan Calming Barrier Gloss Gel Moisturizer secara merata untuk mengunci kelembapan"
              width="480"
              height="320"
              class="dsw-card-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <div class="dsw-card-body">
              <span class="dsw-badge-teal">2. Kunci dengan Gloss Gel</span>
              <p class="dsw-card-desc">Ambil <strong>Calming Barrier Gloss Gel 30ml</strong> secukupnya, ratakan ke seluruh wajah sebagai pengunci barrier.</p>
            </div>
          </article>
        </div>

        <div style="margin-top: 22px; text-align: center;">
          <a href="#form-pemesanan" class="dsw-cta" data-scroll-to-form>
            <span>Pesan Paket Exclusive Sekarang</span>
            <Icon name="lucide:arrow-right" class="size-5" aria-hidden="true" />
          </a>
        </div>
      </section>

      <!-- Section 6: Bukti Pelanggan -->
      <section class="dsw-section">
        <h2 class="dsw-h2">
          Bukti Tekstur <span class="dsw-hl-aqua">& Kepuasan Pelanggan</span>
        </h2>
        <p class="dsw-sub" style="margin-top: 8px;">
          Pengalaman pelanggan yang menyukai kepraktisan Paket Exclusive Lotion & Gloss Gel:
        </p>

        <div class="dsw-grid-2">
          <div class="dsw-proof-cell">
            <img
              src={`${IMG_BASE}/bukti-tekstur-lotion-dan-water-jelly.webp`}
              alt="Swatch tekstur cair Treatment Lotion dan water-jelly Gloss Gel di punggung tangan"
              width="480"
              height="320"
              class="dsw-proof-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <p class="dsw-proof-OverlayCaption">Lotion Cair & Water-Jelly Adem</p>
          </div>
          <div class="dsw-proof-cell">
            <img
              src={`${IMG_BASE}/bukti-wanita-29an-kalem-glass-skin.webp`}
              alt="Wanita Indonesia usia 29 tahun dengan kulit wajah tenang dan bebas kemerahan"
              width="480"
              height="320"
              class="dsw-proof-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <p class="dsw-proof-OverlayCaption">Wajah Kalem Bebas Kemerahan</p>
          </div>
          <div class="dsw-proof-cell">
            <img
              src={`${IMG_BASE}/bukti-pipi-adem-bebas-kemerahan.webp`}
              alt="Close-up pipi halus dan lembap glassy tanpa rasa lengket"
              width="480"
              height="320"
              class="dsw-proof-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <p class="dsw-proof-OverlayCaption">Lembap Glassy Tanpa Lengket</p>
          </div>
          <div class="dsw-proof-cell">
            <img
              src={`${IMG_BASE}/bukti-meja-rias-exclusive-lotion-gloss.webp`}
              alt="Paket Exclusive Box berisi Treatment Lotion 150ml, 50ml, Gloss Gel 30ml, dan Pouch di meja rias"
              width="480"
              height="320"
              class="dsw-proof-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <p class="dsw-proof-OverlayCaption">Lengkap Box & Pouch Resmi</p>
          </div>
        </div>

        <div class="dsw-testi-list">
          <article class="dsw-testi-card">
            <div class="dsw-testi-head">
              <div class="dsw-testi-avatar" aria-hidden="true">N</div>
              <div class="dsw-testi-meta">
                <p class="dsw-testi-name">
                  Kak Nadia Putri (29 thn)
                  <span class="dsw-verified-pill">Verified Buyer</span>
                </p>
                <div class="dsw-stars">
                  <RatingStars rating={5} starClass="h-3.5 w-3.5 !fill-[#d97706] !text-[#d97706]" />
                </div>
              </div>
            </div>
            <p class="dsw-testi-body">"Suka banget sama Paket Exclusive ini! Dapat box cakep plus pouch bening Numa Skin. Botol 150ml aku taruh di kamar, yang 50ml pump masuk tas kerja bareng Gloss Gel. Kulitku yang tadinya gampang merah kena AC kantor sekarang adem dan glassy terus."</p>
            <div class="dsw-testi-foot">
              <span>Jakarta Selatan</span>
              <span>•</span>
              <span>Pemakaian 4 Minggu</span>
            </div>
          </article>

          <article class="dsw-testi-card">
            <div class="dsw-testi-head">
              <div class="dsw-testi-avatar" aria-hidden="true">R</div>
              <div class="dsw-testi-meta">
                <p class="dsw-testi-name">
                  Bunda Rina Maharani (34 thn)
                  <span class="dsw-verified-pill">Verified Buyer</span>
                </p>
                <div class="dsw-stars">
                  <RatingStars rating={5} starClass="h-3.5 w-3.5 !fill-[#d97706] !text-[#d97706]" />
                </div>
              </div>
            </div>
            <p class="dsw-testi-body">"Beli paket ini awalnya karena pengen dapet ukuran besar sama travel size sekaligus, ternyata Gloss Gel-nya juara banget buat nenangin bruntusan di pipi. Teksturnya dingin kayak air, cepat meresap, dan hemat Rp27 ribu dibanding beli pisah."</p>
            <div class="dsw-testi-foot">
              <span>Bandung</span>
              <span>•</span>
              <span>Pemakaian 5 Minggu</span>
            </div>
          </article>
        </div>
      </section>

      <!-- Section 7: Tabel Perbandingan -->
      <section class="dsw-section--tinted">
        <h2 class="dsw-h2">
          Keunggulan <span class="dsw-hl-aqua">Paket Exclusive Box</span>
        </h2>
        <p class="dsw-sub" style="margin-top: 8px;">
          Mengapa memilih Paket Exclusive Lotion & Gloss Gel jauh lebih hemat dan efektif dibandingkan membeli produk satuan:
        </p>

        <div class="dsw-cmp-card">
          <div class="dsw-cmp-head">
            <div class="dsw-cmp-col">Karakteristik</div>
            <div class="dsw-cmp-col dsw-cmp-col--numa">Exclusive Set</div>
            <div class="dsw-cmp-col">Beli Satuan Biasa</div>
          </div>

          <div class="dsw-cmp-row">
            <div class="dsw-cmp-cell dsw-cmp-cell--feature">Kapasitas Toner</div>
            <div class="dsw-cmp-cell dsw-cmp-cell--numa">
              <span class="dsw-icon-green" style="margin: 0 auto;">
                <Icon name="lucide:check" class="size-3.5" aria-hidden="true" />
              </span>
              <span class="dsw-cmp-sub">Dapat 2 Botol (150ml + 50ml)</span>
            </div>
            <div class="dsw-cmp-cell">
              <span class="dsw-icon-red" style="margin: 0 auto;">
                <Icon name="lucide:x" class="size-3.5" aria-hidden="true" />
              </span>
              <span class="dsw-cmp-sub">Hanya 1 botol ukuran tunggal</span>
            </div>
          </div>

          <div class="dsw-cmp-row">
            <div class="dsw-cmp-cell dsw-cmp-cell--feature">Pengunci Skin Barrier</div>
            <div class="dsw-cmp-cell dsw-cmp-cell--numa">
              <span class="dsw-icon-green" style="margin: 0 auto;">
                <Icon name="lucide:check" class="size-3.5" aria-hidden="true" />
              </span>
              <span class="dsw-cmp-sub">Calming Gloss Gel 30ml</span>
            </div>
            <div class="dsw-cmp-cell">
              <span class="dsw-icon-red" style="margin: 0 auto;">
                <Icon name="lucide:x" class="size-3.5" aria-hidden="true" />
