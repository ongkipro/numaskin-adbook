---
import BaseLayout from '../layouts/BaseLayout.astro';
import GeoIpResolvedForm from '../components/storefront/forms/GeoIpResolvedForm.astro';
import MetaLandingTracker from '../components/storefront/tracking/MetaLandingTracker.astro';
import Icon from '../components/storefront/shared/Icon.astro';
import RatingStars from '../components/storefront/shared/RatingStars.astro';
import { getStorefrontProduct } from '../lib/catalog';
import { nativeLandingCanonicalPath } from '../lib/landing-pages';
import { defaultCatalogContentId } from '../lib/catalog-feed';
import { getRuntimeEnv } from '../lib/env';
import { loadStoreCodDisabledProvinceCodes } from '../lib/form-mode';
import { getStoreAdsConfig } from '../lib/store-ads';
import '../styles/form-hybrid.css';
import '../styles/landing-pages/paket-complete-routine-4-in-1-50ml.css';

export const prerender = false;

const PRODUCT_SLUG = 'paket-complete-routine-4-in-1-50ml';
const LANDING_SLUG = 'paket-complete-routine-4-in-1-50ml';
const PAGE_TITLE = 'Paket Complete Routine 4-in-1 (50ml) - Rangkaian Anti-Aging & UV Praktis BPOM';
const PAGE_DESC = 'Rangkaian 4 langkah anti-aging Numa Skin ukuran praktis: Treatment Lotion 50ml, NAD+ Booster Serum 20ml, Adenosine Moisturizer 30gr, dan Oxydew Sunscreen SPF 50+ 30ml.';
const IMG_BASE = '/images/landing/paket-complete-routine-4-in-1-50ml';
const HERO_IMAGE = `${IMG_BASE}/hero-paket-complete-4in1-50ml.webp`;

const database = getRuntimeEnv(Astro.locals)?.OMS_DB as D1Database | undefined;
const claimedProductSlug = Astro.request.headers.get('x-adsbook-product-page');
const [product, canonicalPath, codDisabledProvinceCodes] = await Promise.all([
  getStorefrontProduct(Astro.locals, PRODUCT_SLUG),
  claimedProductSlug
    ? Promise.resolve(`/produk/${claimedProductSlug}`)
    : nativeLandingCanonicalPath(Astro.locals, LANDING_SLUG),
  loadStoreCodDisabledProvinceCodes(database),
  getStoreAdsConfig(Astro.locals),
]);
if (!product) {
  return Astro.rewrite('/404');
}

const canonical = `${Astro.locals.tenant.siteUrl}${canonicalPath}`;

const variants = product.variants || [];
const cheapestVariant = variants.reduce(
  (min: any, v: any) => (!min || v.price < min.price ? v : min),
  variants[0]
);
const defaultVariant = cheapestVariant || {
  id: '15',
  label: 'Toner 50ml + NAD+ Serum 20ml + Adenosine 30gr + Sunscreen 30ml',
  price: 311000,
  comparePrice: 345998,
};
---

<BaseLayout
  title={PAGE_TITLE}
  description={PAGE_DESC}
  image={HERO_IMAGE}
  preloadImages={HERO_IMAGE}
  canonical={canonical}
  hideHeader={true}
  hideFooter={true}
>
  <MetaLandingTracker
    slug={LANDING_SLUG}
    contentId={defaultCatalogContentId(product)}
    contentName={product.contentName}
    price={defaultVariant.price}
  />

  <div class="dsw-shell">
    <main class="dsw-canvas">
      <!-- Section 1: Hero -->
      <section id="hero-section" class="dsw-hero">
        <div class="dsw-hero-head">
          <h1 class="dsw-h1">
            <span class="dsw-hl-tilt">Ingin Kulit Kencang</span> & Bebas Flek Tanpa Ribet Pilih Skincare?
          </h1>
          <p class="dsw-sub" style="max-width: 390px; margin: 14px auto 0; font-weight: 700;">
            4 tahapan inti dari hidrasi, serum NAD+, pelembap Adenosine, hingga perisai UV SPF 50+ sudah dirangkai pas untuk Anda.<br />
            <span class="dsw-underline-teal">Mulai rutinitas anti-aging utuh dengan Paket 4-in-1 (50ml)!</span>
          </p>
        </div>

        <div class="dsw-hero-stage">
          <div class="dsw-hero-top-tag">
            <div class="dsw-hero-top-pill">
              <Icon name="lucide:award" class="size-3.5" aria-hidden="true" />
              <span>Complete 4-in-1 (50ml) • Hemat Rp35rb</span>
            </div>
          </div>

          <img
            src={HERO_IMAGE}
            alt="Perbandingan wajah berflek dan berkerut vs kulit kencang terlindungi dengan Paket Complete Routine 4-in-1 50ml Numa Skin"
            width="720"
            height="480"
            class="dsw-hero-img"
            fetchpriority="high"
            loading="eager"
            decoding="async"
          />

          <div class="dsw-hero-ba" aria-hidden="true">
            <span class="dsw-hero-ba-pill dsw-hero-ba-pill--before">Flek & Garis Penuaan</span>
            <span class="dsw-hero-ba-pill dsw-hero-ba-pill--after">Kencang & Terlindungi</span>
          </div>

          <div class="dsw-hero-trust-strip" role="list" aria-label="Jaminan kualitas Numa Skin">
            <div class="dsw-trust-item" role="listitem">
              <span class="dsw-trust-icon">
                <Icon name="lucide:shield-check" class="size-3.5" aria-hidden="true" />
              </span>
              <span class="dsw-trust-text">
                <strong class="dsw-trust-label">4 BPOM Resmi</strong>
                <span class="dsw-trust-sub">Rangkaian 4-in-1</span>
              </span>
            </div>
            <div class="dsw-trust-item" role="listitem">
              <span class="dsw-trust-icon">
                <Icon name="lucide:droplets" class="size-3.5" aria-hidden="true" />
              </span>
              <span class="dsw-trust-text">
                <strong class="dsw-trust-label">NAD+ & Adenosine</strong>
                <span class="dsw-trust-sub">6X Peptide + 11X HA</span>
              </span>
            </div>
            <div class="dsw-trust-item" role="listitem">
              <span class="dsw-trust-icon">
                <Icon name="lucide:layers" class="size-3.5" aria-hidden="true" />
              </span>
              <span class="dsw-trust-text">
                <strong class="dsw-trust-label">SPF 50+ PA++++</strong>
                <span class="dsw-trust-sub">3% Luceane™</span>
              </span>
            </div>
          </div>
        </div>

        <div class="dsw-hero-foot">
          <p class="dsw-hero-caption">
            Rangkaian 4 langkah esensial: <strong>Treatment Lotion 50ml</strong>, <strong>NAD+ Booster Serum</strong>, <strong>Adenosine Moisturizer</strong>, dan <strong>Oxydew Sunscreen</strong>.
          </p>
          <a href="#form-pemesanan" class="dsw-cta" data-scroll-to-form>
            <span>Ambil Paket 4-in-1 (50ml) Ini</span>
            <Icon name="lucide:arrow-right" class="size-5" aria-hidden="true" />
          </a>
        </div>
      </section>

      <!-- Section 2: Solusi Praktis -->
      <section class="dsw-section">
        <h2 class="dsw-h2">
          4 Tahap Inti <span class="dsw-hl-aqua">Hidrasi, Kencang & Perisai UV</span>
        </h2>
        <p class="dsw-sub" style="margin-top: 8px;">
          Urutan perawatan pagi dan malam yang ringkas tanpa perlu krim berlapis-lapis:
        </p>

        <div class="dsw-solution-box">
          <img
            src={`${IMG_BASE}/solusi-empat-langkah-praktis-50ml.webp`}
            alt="Wanita Indonesia usia 38 tahun dengan kulit wajah kencang dan sehat memakai Paket 4-in-1 Numa Skin"
            width="648"
            height="432"
            class="dsw-solution-img"
            loading="lazy"
            fetchpriority="low"
            decoding="async"
          />

          <div class="dsw-check-list">
            <div class="dsw-check-item">
              <span class="dsw-icon-green">
                <Icon name="lucide:check" class="size-3.5" aria-hidden="true" />
              </span>
              <p class="dsw-list-text"><strong>Tahap 1 & 2 (Toner 50ml + NAD+ Serum):</strong> Membuka jalur pori dengan 76% Air Laut Dalam Ulleungdo lalu menyuplai RejuveNAD™ & 6X Peptide untuk mengencangkan kontur wajah.</p>
            </div>
            <div class="dsw-check-item">
              <span class="dsw-icon-green">
                <Icon name="lucide:check" class="size-3.5" aria-hidden="true" />
              </span>
              <p class="dsw-list-text"><strong>Tahap 3 (Adenosine Moisturizer 30gr):</strong> Mengunci hidrasi dengan 11X Hyaluronic Acid dan Adenosine untuk menghaluskan garis halus serta menyamarkan flek.</p>
            </div>
            <div class="dsw-check-item">
              <span class="dsw-icon-green">
                <Icon name="lucide:check" class="size-3.5" aria-hidden="true" />
              </span>
              <p class="dsw-list-text"><strong>Tahap 4 Pagi (Oxydew Sunscreen SPF 50+ PA++++):</strong> Melindungi kulit di siang hari dengan 3% Luceane™ tanpa whitecast.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- Section 3: Masalah Kulit -->
      <section class="dsw-section--tinted">
        <h2 class="dsw-h2">
          Kenapa Perawatan Anti-Aging <span class="dsw-hl-coral">Sering Berhenti di Tengah Jalan?</span>
        </h2>

        <div class="dsw-grid-2">
          <article class="dsw-card">
            <img
              src={`${IMG_BASE}/masalah-skincare-campur-aduk-50ml.webp`}
              alt="Meja rias penuh botol skincare berbeda merek yang membingungkan"
              width="480"
              height="320"
              class="dsw-card-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <div class="dsw-card-body">
              <span class="dsw-badge-red">Bingung Urutan Pakai</span>
              <p class="dsw-card-desc">Terlalu banyak produk beda merek membuat kulit justru rewel dan urutan pemakaian jadi tidak konsisten.</p>
            </div>
          </article>

          <article class="dsw-card">
            <img
              src={`${IMG_BASE}/masalah-penuaan-flek-membandel-50ml.webp`}
              alt="Close-up flek hitam dan kerutan halus akibat perawatan yang tidak lengkap"
              width="480"
              height="320"
              class="dsw-card-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <div class="dsw-card-body">
              <span class="dsw-badge-red">Kurang Perisai Siang</span>
              <p class="dsw-card-desc">Hanya memakai serum malam tanpa kunci pelembap Adenosine dan tabir surya SPF 50+ membuat flek kembali gelap.</p>
            </div>
          </article>
        </div>

        <div class="dsw-list-box">
          <p class="dsw-list-box-title">Tanda Anda Membutuhkan Paket Ini:</p>
          <div class="dsw-check-list" style="margin-top: 0;">
            <div class="dsw-check-item">
              <span class="dsw-icon-red">
                <Icon name="lucide:x" class="size-3.5" aria-hidden="true" />
              </span>
              <p class="dsw-list-text">Menginginkan 1 paket lengkap untuk pagi dan malam yang fokus pada pengencangan, garis halus, dan anti-flek</p>
            </div>
            <div class="dsw-check-item">
              <span class="dsw-icon-red">
                <Icon name="lucide:x" class="size-3.5" aria-hidden="true" />
              </span>
              <p class="dsw-list-text">Lebih menyukai pelembap bening sejuk (Adenosine Gel-Cream) tanpa efek tone-up warna di pagi hari</p>
            </div>
            <div class="dsw-check-item">
              <span class="dsw-icon-red">
                <Icon name="lucide:x" class="size-3.5" aria-hidden="true" />
              </span>
              <p class="dsw-list-text">Ingin mencoba paket 4-in-1 dengan ukuran Toner 50ml yang lebih ekonomis dan hemat Rp35.000</p>
            </div>
          </div>
        </div>
      </section>

      <!-- Section 4: Transformasi Nyata -->
      <section class="dsw-section">
        <h2 class="dsw-h2">
          Transformasi <span class="dsw-hl-aqua">Kulit Padat, Halus & Terlindungi</span>
        </h2>
        <p class="dsw-sub" style="margin-top: 8px;">
          Perbedaan kulit sebelum dan sesudah rutin menjalankan 4 langkah Complete Routine:
        </p>

        <div class="dsw-grid-2">
          <article class="dsw-card">
            <img
              src={`${IMG_BASE}/kondisi-flek-kerutan-kusam-50ml.webp`}
              alt="Kondisi kulit kusam dengan flek hitam dan garis senyum sebelum perawatan"
              width="480"
              height="320"
              class="dsw-card-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <div class="dsw-card-body">
              <span class="dsw-badge-red">Sebelum Perawatan</span>
              <p class="dsw-card-desc">Kulit terasa kering, garis senyum serta kerutan sudut mata terlihat jelas, dan noda hitam tampak kontras.</p>
            </div>
          </article>

          <article class="dsw-card">
            <img
              src={`${IMG_BASE}/kondisi-kulit-kencang-terlindungi-50ml.webp`}
              alt="Kondisi kulit tampak kencang, kenyal, dan cerah merata"
              width="480"
              height="320"
              class="dsw-card-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <div class="dsw-card-body">
              <span class="dsw-badge-green">Rutin 4-in-1 (50ml)</span>
              <p class="dsw-card-desc">Tekstur kulit terasa padat membal, garis halus tampak lebih rata, dan wajah segar terlindungi seharian.</p>
            </div>
          </article>
        </div>

        <div class="dsw-list-box">
          <p class="dsw-list-box-title">Tahapan Hasil Pemakaian Rutin:</p>
          <div class="dsw-check-list" style="margin-top: 0;">
            <div class="dsw-check-item">
              <span class="dsw-icon-green">
                <Icon name="lucide:check" class="size-3.5" aria-hidden="true" />
              </span>
              <p class="dsw-list-text"><strong>Minggu 1–2:</strong> Kulit terasa sejuk terhidrasi, serum meresap cepat, dan sunscreen nyaman tanpa lengket</p>
            </div>
            <div class="dsw-check-item">
              <span class="dsw-icon-green">
                <Icon name="lucide:check" class="size-3.5" aria-hidden="true" />
              </span>
              <p class="dsw-list-text"><strong>Minggu 3–4:</strong> Pipi terasa lebih kenyal elastis dan garis-garis halus dehidrasi tampak mulai terisi</p>
            </div>
            <div class="dsw-check-item">
              <span class="dsw-icon-green">
                <Icon name="lucide:check" class="size-3.5" aria-hidden="true" />
              </span>
              <p class="dsw-list-text"><strong>Minggu 5–6:</strong> Tampilan flek hitam tampak lebih samar dan kontur wajah terlihat lebih segar awet muda</p>
            </div>
          </div>
        </div>
      </section>

      <!-- Section 5: Cara Pakai -->
      <section class="dsw-section--tinted">
        <h2 class="dsw-h2">
          Cara Pakai <span class="dsw-hl-aqua">Praktis Setiap Hari</span>
        </h2>
        <p class="dsw-sub" style="margin-top: 8px;">
          Urutan pemakaian pagi dan malam yang sangat mudah diikuti:
        </p>

        <div class="dsw-grid-2">
          <article class="dsw-card">
            <img
              src={`${IMG_BASE}/cara-pakai-4in1-50ml-pagi.webp`}
              alt="Urutan pagi memakai Toner 50ml, NAD+ Serum, Adenosine Moisturizer, dan Oxydew Sunscreen"
              width="480"
              height="320"
              class="dsw-card-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <div class="dsw-card-body">
              <span class="dsw-badge-teal">Urutan Pagi (4 Langkah)</span>
              <p class="dsw-card-desc">Tepuk <strong>Toner 50ml</strong> → <strong>NAD+ Serum</strong> → <strong>Adenosine Moisturizer</strong> → kunci 2 ruas jari <strong>Oxydew Sunscreen</strong>.</p>
            </div>
          </article>

          <article class="dsw-card">
            <img
              src={`${IMG_BASE}/cara-pakai-4in1-50ml-malam.webp`}
              alt="Urutan malam memakai Toner 50ml, NAD+ Booster Serum, dan Adenosine Moisturizer"
              width="480"
              height="320"
              class="dsw-card-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <div class="dsw-card-body">
              <span class="dsw-badge-teal">Urutan Malam (3 Langkah)</span>
              <p class="dsw-card-desc">Tepuk <strong>Toner 50ml</strong> → pijat <strong>NAD+ Booster Serum</strong> ke arah atas → kunci hidrasi dengan <strong>Adenosine Moisturizer</strong>.</p>
            </div>
          </article>
        </div>

        <div style="margin-top: 22px; text-align: center;">
          <a href="#form-pemesanan" class="dsw-cta" data-scroll-to-form>
            <span>Pesan Paket 4-in-1 (50ml) Sekarang</span>
            <Icon name="lucide:arrow-right" class="size-5" aria-hidden="true" />
          </a>
        </div>
      </section>

      <!-- Section 6: Bukti Pelanggan -->
      <section class="dsw-section">
        <h2 class="dsw-h2">
          Bukti Tekstur <span class="dsw-hl-aqua">& Kepuasan Pelanggan</span>
        </h2>
        <p class="dsw-sub" style="margin-top: 8px;">
          Kepuasan pelanggan yang memilih Paket Complete Routine 4-in-1 (50ml):
        </p>

        <div class="dsw-grid-2">
          <div class="dsw-proof-cell">
            <img
              src={`${IMG_BASE}/bukti-tekstur-empat-produk-50ml.webp`}
              alt="Swatch 4 tekstur produk Complete Routine 4-in-1 di punggung tangan"
              width="480"
              height="320"
              class="dsw-proof-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <p class="dsw-proof-OverlayCaption">4 Tekstur Bening & Ringan</p>
          </div>
          <div class="dsw-proof-cell">
            <img
              src={`${IMG_BASE}/bukti-bunda-38an-awet-muda-50ml.webp`}
              alt="Wanita Indonesia usia 38 tahun berhijab dengan wajah kencang dan cerah"
              width="480"
              height="320"
              class="dsw-proof-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <p class="dsw-proof-OverlayCaption">Kulit Kencang & Segar di Usia 35+</p>
          </div>
          <div class="dsw-proof-cell">
            <img
              src={`${IMG_BASE}/bukti-kulit-kenyal-terawat-50ml.webp`}
              alt="Close-up pipi kenyal membal dengan pori-pori halus"
              width="480"
              height="320"
              class="dsw-proof-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <p class="dsw-proof-OverlayCaption">Garis Halus Tampak Lebih Rata</p>
          </div>
          <div class="dsw-proof-cell">
            <img
              src={`${IMG_BASE}/bukti-meja-rias-complete-4in1-50ml.webp`}
              alt="Keempat produk Paket Complete Routine 4-in-1 50ml di meja rias"
              width="480"
              height="320"
              class="dsw-proof-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <p class="dsw-proof-OverlayCaption">Rangkaian 4-in-1 Praktis & Hemat</p>
          </div>
        </div>

        <div class="dsw-testi-list">
          <article class="dsw-testi-card">
            <div class="dsw-testi-head">
              <div class="dsw-testi-avatar" aria-hidden="true">F</div>
              <div class="dsw-testi-meta">
                <p class="dsw-testi-name">
                  Bunda Farida Hasan (39 thn)
                  <span class="dsw-verified-pill">Verified Buyer</span>
                </p>
                <div class="dsw-stars">
                  <RatingStars rating={5} starClass="h-3.5 w-3.5 !fill-[#d97706] !text-[#d97706]" />
                </div>
              </div>
            </div>
            <p class="dsw-testi-body">"Paket 4-in-1 yang Toner 50ml ini pas banget buat aku yang pengen perawatan anti-aging lengkap tapi anggarannya sekitar 300 ribuan. Keempat produknya ringan banget dipakai tumpuk pagi-pagi, nggak gerah sama sekali."</p>
            <div class="dsw-testi-foot">
              <span>Bogor</span>
              <span>•</span>
              <span>Pemakaian 5 Minggu</span>
            </div>
          </article>

          <article class="dsw-testi-card">
            <div class="dsw-testi-head">
              <div class="dsw-testi-avatar" aria-hidden="true">L</div>
              <div class="dsw-testi-meta">
                <p class="dsw-testi-name">
                  Ibu Lilis Suryani (41 thn)
                  <span class="dsw-verified-pill">Verified Buyer</span>
                </p>
                <div class="dsw-stars">
                  <RatingStars rating={5} starClass="h-3.5 w-3.5 !fill-[#d97706] !text-[#d97706]" />
                </div>
              </div>
            </div>
            <p class="dsw-testi-body">"Sejak rutin pakai urutan 4 produk ini, kerutan halus di bawah mata dan garis senyum berkurang jauh. Sunscreen-nya juga enak banget nggak bikin perih di mata."</p>
            <div class="dsw-testi-foot">
              <span>Malang</span>
              <span>•</span>
              <span>Pemakaian 6 Minggu</span>
            </div>
          </article>
        </div>
      </section>

      <!-- Section 7: Tabel Perbandingan -->
      <section class="dsw-section--tinted">
        <h2 class="dsw-h2">
          Keunggulan <span class="dsw-hl-aqua">Complete Routine 4-in-1 (50ml)</span>
        </h2>
        <p class="dsw-sub" style="margin-top: 8px;">
          Mengapa memilih Paket Complete Routine 4-in-1 (50ml) jauh lebih hemat dan efektif dibandingkan membeli produk satuan:
        </p>

        <div class="dsw-cmp-card">
          <div class="dsw-cmp-head">
            <div class="dsw-cmp-col">Karakteristik</div>
            <div class="dsw-cmp-col dsw-cmp-col--numa">4-in-1 (50ml)</div>
            <div class="dsw-cmp-col">Beli Satuan Biasa</div>
          </div>

          <div class="dsw-cmp-row">
            <div class="dsw-cmp-cell dsw-cmp-cell--feature">Tahapan Perawatan</div>
            <div class="dsw-cmp-cell dsw-cmp-cell--numa">
              <span class="dsw-icon-green" style="margin: 0 auto;">
                <Icon name="lucide:check" class="size-3.5" aria-hidden="true" />
              </span>
              <span class="dsw-cmp-sub">Hidrasi + Serum + Krim + SPF 50+</span>
            </div>
            <div class="dsw-cmp-cell">
              <span class="dsw-icon-red" style="margin: 0 auto;">
                <Icon name="lucide:x" class="size-3.5" aria-hidden="true" />
              </span>
              <span class="dsw-cmp-sub">Hanya 1 atau 2 produk terpisah</span>
            </div>
          </div>

          <div class="dsw-cmp-row">
            <div class="dsw-cmp-cell dsw-cmp-cell--feature">Fokus Anti-Aging</div>
