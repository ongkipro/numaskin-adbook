---
import { geoHeadersFromCf } from '../../lib/geo';
import Breadcrumb from '../../components/storefront/shared/Breadcrumb.astro';
import MetaLandingTracker from '../../components/storefront/tracking/MetaLandingTracker.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getStorefrontProduct, getStorefrontProducts } from '../../lib/catalog';
import { BUNDLE_CATEGORY, VARIANT_IMAGES, bundleContents, categoryLabel, orderCategories, singlesForBundle, singlesTotal, sizeChoice, withoutSizes } from '../../components/storefront/numaskin/catalog-order';
import ProductGrid from '../../components/storefront/numaskin/ProductGrid.astro';
import SeeAllTile from '../../components/storefront/numaskin/SeeAllTile.astro';
import { getProductPageLanding } from '../../lib/landing-pages';
import Icon from '../../components/storefront/shared/Icon.astro';
import RatingStars from '../../components/storefront/shared/RatingStars.astro';
import GeoIpResolvedForm from '../../components/storefront/forms/GeoIpResolvedForm.astro';
import ProductImageGallery from '../../components/storefront/ProductImageGallery.astro';
import SocialProofToast from '../../components/storefront/shared/SocialProofToast.astro';
import { recentOrderCount } from '../../lib/social-proof';
import { getRuntimeEnv } from '../../lib/env';
import { resolveFormModeContext } from '../../lib/form-mode';
import '../../styles/form-hybrid.css';
import { defaultCatalogContentId } from '../../lib/catalog-feed';
import { buildProductJsonLd } from '../../lib/json-ld';

export const prerender = false;

const product = await getStorefrontProduct(Astro.locals, Astro.params.slug || '');
const formContext = await resolveFormModeContext(Astro.request);
if (!product) {
  return Astro.rewrite('/404');
}

// A landing page may have taken this product's page over (A21). The landing
// route owns the whole rendering path already, so this hands off to it rather
// than growing a second copy here. The URL stays `/produk/<slug>`: that is the
// product's address, and the landing page's own slug redirects to it, so the
// two never compete as duplicate content.
// `astro check` does not count a value used only in a frontmatter `return` as
// read, so the geo helper is named once here to keep that check clean.
void geoHeadersFromCf;

// Read beside the landing claim, not after it: a D1 round trip is a Pacific
// crossing when a US colo serves the page. Unused when the claim rewrites.
const [productPageLanding, socialProofOrders] = await Promise.all([
  getProductPageLanding(Astro.locals, String(product.productId)),
  // The store's real orders (A-300); under the threshold the toast renders nothing.
  recentOrderCount(getRuntimeEnv(Astro.locals)?.OMS_DB as D1Database | undefined),
]);
if (productPageLanding) {
  // The rewritten route does NOT see this route's `Astro.url` — it sees the
  // landing slug — so the hand-off is signalled on the request itself.
  // Without it the landing route reads a direct visit, redirects back here,
  // and the two bounce forever.
  return Astro.rewrite(
    new Request(new URL(`/${productPageLanding.slug}`, Astro.url), {
      headers: new Headers({
        ...Object.fromEntries(Astro.request.headers),
        // The rebuilt request loses `request.cf`; without the visitor's
        // province the landing's hybrid form showed everyone the full form.
        ...geoHeadersFromCf(Astro.request),
        'x-adsbook-product-page': product.slug,
      }),
    }),
  );
}

const cheapestVariant = [...product.variants].sort((a, b) => a.price - b.price)[0] ?? null;
// When the options differ in one item's size only, the label names that item
// and the pills show just the size, so a bundle buyer does not wonder about
// the other items ("Pilih ukuran toner": 50ml / 150ml).
const sizePick = sizeChoice(product.variants.map((v) => v.label));
const sizedPart = sizePick?.part ?? '';
const pillText = (label: string) => sizePick?.sizes[product.variants.findIndex((v) => v.label === label)] ?? label;
const shownDescription = product.variants.length > 1 ? withoutSizes(product.description ?? '') : product.description;
// Install-owned (DESIGN.md §UX): bundle-aware labels, and "complete the
// routine" picks — the single products other than this one, in routine order.
const isBundle = product.category === BUNDLE_CATEGORY;
const allProducts = await getStorefrontProducts(Astro.locals);
const routineOrder = orderCategories(allProducts.map((p) => p.category));
// A bundle's saving against buying its items singly, per variant, at today's
// single prices; 0 (nothing shown) when an item cannot be priced or there is
// no saving. This is the comparison a buyer can check, unlike compare-at.
const singleProducts = allProducts.filter((p) => p.category !== BUNDLE_CATEGORY);
const contents = isBundle ? bundleContents(product.description ?? '') : [];
const vsSingles = (v: { label: string; price: number }) =>
  isBundle ? Math.max(0, singlesTotal(v.label, contents, singleProducts) - v.price) : 0;
const displayVsSingles = cheapestVariant ? vsSingles(cheapestVariant) : 0;
const otherSingles = allProducts
  .filter((p) => p.slug !== product.slug && p.category !== BUNDLE_CATEGORY)
  .sort((a, b) => routineOrder.indexOf(a.category) - routineOrder.indexOf(b.category));
// A bundle offers its own products singly; a single offers the rest of the
// routine. Even counts, so the 2×2 grid shows every card whole.
const ownSingles = isBundle ? singlesForBundle(bundleContents(product.description ?? ''), otherSingles) : [];
const related = ownSingles.length > 0 ? ownSingles : otherSingles.slice(0, 4);
const relatedIsOwn = ownSingles.length > 0;
const displayPrice = cheapestVariant?.price ?? product.price;
const displayComparePrice = cheapestVariant?.comparePrice ?? product.comparePrice ?? 0;
const displayDiscount =
  displayComparePrice > displayPrice ? Math.round((1 - displayPrice / displayComparePrice) * 100) : 0;

const ratingValue = product.ratingValue;
const reviewCount = product.reviewCount;
const soldCount = product.soldCount;
const hasAggregateRating =
  typeof ratingValue === 'number' && typeof reviewCount === 'number' && reviewCount > 0;
const hasSoldCount = typeof soldCount === 'number' && soldCount > 0;
const formattedRating = hasAggregateRating ? ratingValue.toFixed(1) : null;
const soldLabel = hasSoldCount
  ? soldCount >= 1000
    ? `${(soldCount / 1000).toFixed(1).replace('.0', '')}rb+ terjual`
    : `${soldCount} terjual`
  : null;

const productImages = product.images && product.images.length > 0 ? product.images : [product.heroImage];

// Install-owned (DESIGN.md C6): icon accent is numaskin.id's deep teal.
const productAccent = '#0b6e7d';
const canonical = `${Astro.locals.tenant.siteUrl}/produk/${product.slug}`;
const productTitle = product.seoTitle;
const productDescription = product.seoDescription;
// One builder for every Product JSON-LD (lib/json-ld.ts): one Offer per variant.
const productSchema = buildProductJsonLd({
  siteUrl: Astro.locals.tenant.siteUrl,
  organization: { name: Astro.locals.tenant.name },
  defaultBrand: Astro.locals.tenant.defaultBrand,
  product: {
    name: product.productName,
    description: product.description,
    image: productImages,
    url: canonical,
    sku: product.productId,
    category: product.category,
    ...(product.brand ? { brand: product.brand } : {}),
    ...(hasAggregateRating ? { ratingValue: Number(formattedRating), reviewCount } : {}),
    reviews: product.reviews.map((review) => ({ name: review.name, rating: review.rating, comment: review.comment })),
    offers: product.variants.map((variant) => ({
      price: variant.price,
      availability: 'InStock',
      name: variant.label,
      ...(variant.sku ? { sku: variant.sku } : {}),
    })),
  },
});

const productSchemaJson = JSON.stringify(productSchema).replace(/</g, '\\u003c');
---

<BaseLayout
  title={productTitle}
  description={productDescription}
  image={product.heroImage}
  preloadImages={product.heroImage}
  canonical={canonical}
  ogType="product"
  hideHeader={false}
  hideFooter={false}
  breadcrumbs={[
    { name: 'Beranda', url: '/' },
    { name: 'Produk', url: '/produk' },
    { name: product.productName, url: canonical },
  ]}
>
  <MetaLandingTracker
    slug={product.slug}
    contentId={defaultCatalogContentId(product)}
    contentName={product.productName}
    price={displayPrice}
  />
  {/* The page's only Product JSON-LD: BaseLayout is deliberately given no
      `product`, which would emit a second, conflicting Product block. */}
  <script is:inline type="application/ld+json" set:html={productSchemaJson} />

  <main class="mx-auto max-w-[480px] bg-[var(--nm-surface)]">
    <Breadcrumb
      items={[
        { label: 'Produk', href: '/produk' },
        { label: categoryLabel(product.category), href: `/produk?kategori=${encodeURIComponent(product.category)}` },
        { label: product.productName },
      ]}
    />
    <!-- Product Hero Gallery Component. Edge to edge on purpose: the photo is
         the first thing the page says, and padding around it only made the
         column feel narrower than it is. -->
    <div class="bg-white">
      <ProductImageGallery
        images={productImages}
        productName={product.productName}
        badgeText={undefined /* install: the breadcrumb already names the category */}
        discountPercentage={0 /* install: the saving shows once, beside the price (DESIGN.md C6) */}
      />
      {/* A multi-size bundle whose sizes lack their own photo shows one size;
          the caption says the order follows the chosen size. Sizes with their
          own packshot (VARIANT_IMAGES) swap the photo instead. */}
      {isBundle && product.variants.length > 1 && !product.variants.every((v) => VARIANT_IMAGES[Number(v.id)]) && (
        <p class="bg-white px-5 pt-3 text-[13px] font-medium leading-5 text-[var(--nm-marine)]">
          Foto ilustrasi. Isi paket mengikuti ukuran yang dipilih.
        </p>
      )}
    </div>

    <!-- Main Header & Pricing Surface -->
    <section class="border-fade-b bg-white px-5 py-5">
      <h1 class="nm-serif text-[26px] leading-[1.2] text-[var(--nm-marine)] [text-wrap:balance]">
        {product.productName}
      </h1>
      <p class="mt-1 text-[13px] leading-relaxed text-[var(--nm-muted)]">
        {product.subheadline || shownDescription}
      </p>

      <!-- Rating & Sold Claims -->
      <div class="mt-3 flex items-center gap-3 text-[12px] text-[var(--nm-muted)]">
        {
          hasAggregateRating && (
            <>
              <div class="flex items-center gap-1.5">
                <RatingStars
                  rating={ratingValue}
                  starClass="h-[13px] w-[13px]"
                  label={`Rating produk ${formattedRating} dari 5 bintang`}
                />
                <span class="font-semibold text-[var(--nm-marine)]">{formattedRating}</span>
              </div>
              <span>{reviewCount} penilaian</span>
            </>
          )
        }
        {hasAggregateRating && hasSoldCount && <span class="h-3 w-px bg-[var(--nm-border)]" />}
        {hasSoldCount && <span class="font-normal text-[var(--nm-muted)]">{soldLabel}</span>}
      </div>

      <!-- Pricing Display. Install-owned (DESIGN.md C6): one price on the page.
           It shows the variant the order form starts on (the cheapest, passed
           to GeoIpResolvedForm below), and the size pills move both together. -->
      <div class="mt-4 flex flex-wrap items-baseline gap-x-3 gap-y-2 border-t border-[var(--nm-border)] pt-4">
        <span data-pdp-price class="text-[28px] font-bold leading-none tracking-tight text-[var(--nm-marine)]">
          Rp{Math.round(displayPrice).toLocaleString('id-ID')}
        </span>
        <span data-pdp-compare hidden={!(displayComparePrice > displayPrice)} class="text-[13px] font-normal text-[var(--nm-muted)] line-through">
          Rp{Math.round(displayComparePrice).toLocaleString('id-ID')}
        </span>
        {/* A bundle states its saving once, in rupiah, on the line below. */}
        <span data-pdp-save data-bundle={isBundle ? '' : undefined} hidden={isBundle || !(displayDiscount > 0)} class="nm-label nm-pill self-center">
          Hemat {displayDiscount}%
        </span>
      </div>
      {isBundle && (
        <p data-pdp-vs hidden={!(displayVsSingles > 0)} class="mt-2 text-[13px] font-semibold text-[var(--nm-teal)]">
          Rp{displayVsSingles.toLocaleString('id-ID')} lebih hemat dibanding beli satuan
        </p>
      )}

      {/* One variant: no choice to make, so its label (a bundle's contents with
          sizes) is stated instead of a single pill. */}
      {product.variants.length === 1 && isBundle && product.variants[0].label.trim().toLowerCase() !== 'paket' && (
        <p class="mt-5 text-[13px] leading-6 text-[var(--nm-marine)]">
          <span class="nm-label !text-[var(--nm-marine)]">Isi paket</span>
          <span class="mt-1 block">{product.variants[0].label}</span>
        </p>
      )}
      {product.variants.length > 1 && (
        <div class="mt-5">
          <p id="pdp-variant-label" class="nm-label !text-[var(--nm-marine)]">Pilih ukuran{sizedPart ? ` ${sizedPart.toLowerCase()}` : ''}</p>
          <div class="mt-2.5 flex flex-wrap gap-2" role="group" aria-labelledby="pdp-variant-label">
            {[...product.variants].sort((a, b) => a.price - b.price).map((v) => (
              <button
                type="button"
                data-variant-pick={v.id}
                data-price={v.price}
                data-compare={v.comparePrice ?? 0}
                data-vs={vsSingles(v)}
                data-label={v.label}
                data-image={VARIANT_IMAGES[Number(v.id)]}
                aria-pressed={v.id === cheapestVariant?.id ? 'true' : 'false'}
                class="min-h-11 rounded-full border border-[var(--nm-border)] bg-[var(--nm-surface)] px-5 text-[13px] font-semibold text-[var(--nm-marine)] transition-colors hover:border-[var(--nm-teal)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[color:var(--nm-cyan)] aria-pressed:border-[var(--nm-marine)] aria-pressed:bg-[var(--nm-marine)] aria-pressed:text-white"
              >
                {pillText(v.label)}
              </button>
            ))}
          </div>
          {/* A bundle's pills name only the size that differs; the full contents
              of the chosen size sit under them, so the choice shows what it
              changes (review cycle 8). Updated with the pills. */}
          {isBundle && cheapestVariant && /\s\+\s|^\d+×/.test(cheapestVariant.label) && (
            <p class="mt-3 text-[13px] leading-6 text-[var(--nm-marine)]" aria-live="polite">
              <span class="text-[var(--nm-muted)]">Isi: </span><span data-pdp-contents>{cheapestVariant.label}</span>
            </p>
          )}
        </div>
      )}

      {/* No inline order button: the form follows the details, and the sticky
          bar takes the buyer there once the photo scrolls away (owner, 2026-10-15). */}
      <p class="mt-4 text-[12px] leading-5 text-[var(--nm-muted)]">
        Bisa bayar di tempat (COD) untuk sebagian besar wilayah
      </p>
    </section>

    <!-- Product details. Install-owned (DESIGN.md §UX): the description reads
         open; the lists are native <details> disclosures, numaskin.id's
         accordion pattern without script. All start closed: with no button
         under the sizes (owner), the form should be one short scroll away. -->
    <section aria-labelledby="pdp-detail" class="border-b border-[var(--nm-border)] bg-white px-5 py-6">
      <h2 id="pdp-detail" class="sr-only">Tentang produk ini</h2>
      <p class="mt-3 text-[14px] leading-6 text-[var(--nm-muted)]">{shownDescription}</p>

      <div class="mt-5 divide-y divide-[var(--nm-border)] border-y border-[var(--nm-border)]">
        {[
          { title: 'Manfaat utama', items: product.benefits ?? [] },
          { title: isBundle ? 'Urutan pemakaian' : 'Bahan aktif unggulan', items: product.keyPoints ?? [] },
        ].filter((block) => block.items.length > 0).map((block) => (
          <details class="group">
            <summary class="flex min-h-12 cursor-pointer list-none items-center justify-between gap-3 py-3 text-[14px] font-semibold text-[var(--nm-marine)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[color:var(--nm-cyan)] [&::-webkit-details-marker]:hidden">
              {block.title}
              <Icon name="lucide:chevron-down" class="h-4 w-4 shrink-0 text-[var(--nm-teal)] transition-transform group-open:rotate-180" aria-hidden="true" />
            </summary>
            <ul class="space-y-2.5 pb-4 text-[14px] leading-6 text-[var(--nm-muted)]">
              {block.items.map((item) => (
                <li class="grid grid-cols-[10px_1fr] gap-2.5">
                  <span class="mt-[11px] h-1.5 w-1.5 rounded-full bg-[var(--nm-cyan)]" aria-hidden="true" />
                  <span class="min-w-0">{item}</span>
                </li>
              ))}
            </ul>
          </details>
        ))}
      </div>

      {/* lazy: "Cocok untuk" chips are hidden on this install — the merchant's
          values ("Anti-aging", "Mencerahkan", "Memperkuat skin barrier") are
          outcome claims without a source, the rule that already holds bundle
          images off home. Restore the block when the owner sources them. */}
    </section>

    <!-- Product Reviews -->
    {
      (hasAggregateRating || product.reviews.length > 0) && (
        <section class="border-fade-b bg-white px-5 py-6">
          <div class="border-fade-b pb-3.5">
            <div class="flex items-center gap-2">
              <RatingStars max={1} starClass="h-[17px] w-[17px]" label="Penilaian produk" />
              <h2 class="text-[12px] font-semibold uppercase tracking-[0.12em] text-[var(--nm-marine)]">Ulasan Produk</h2>
            </div>

            {hasAggregateRating && (
              <div class="mt-2.5 flex items-center gap-1.5 border-fade-t pt-2.5 text-[12px] font-bold text-[var(--nm-marine)]">
                <span class="text-[var(--nm-marine)]">★ {formattedRating} / 5.0</span>
                <span class="text-[var(--nm-muted)]">• {reviewCount} ulasan</span>
              </div>
            )}
          </div>

          {product.reviews.length > 0 && (
            <div class="mt-4 space-y-4">
              {product.reviews.map((review) => (
                <div class="border-fade-b pb-4 last:border-0 last:pb-0">
                  <div class="flex items-center gap-3">
                    <div 
                      class="flex h-10 w-10 shrink-0 items-center justify-center border border-[var(--nm-marine)] bg-[var(--nm-marine)] text-[13px] font-bold uppercase text-white"
                      style="font-family: 'Cinzel', serif;"
                    >
                      {review.name.charAt(0)}
                    </div>
                    <div class="min-w-0 flex-1">
                      <div class="flex items-center gap-1.5">
                        <p class="text-[12px] font-bold text-[var(--nm-marine)]">{review.name}</p>
                        {review.verified && (
                          <span class="inline-flex items-center gap-0.5 border border-[var(--nm-marine)] bg-white px-1.5 py-0.5 text-[8px] font-semibold uppercase tracking-wider text-[var(--nm-muted)]">
                            Terverifikasi
                          </span>
                        )}
                      </div>
                      <p class="mt-0.5 flex items-center gap-2 text-[11px] text-[var(--nm-muted)]"><span>{review.location}</span><span class="h-3 w-px bg-[var(--nm-border)]" aria-hidden="true" /><span>{review.date}</span></p>
                    </div>
                  </div>
                  <RatingStars rating={review.rating} class="mt-2" starClass="h-2.5 w-2.5" />
                  <p class="mt-1.5 text-[13px] leading-6 text-[var(--nm-muted)]">"{review.comment}"</p>
                </div>
              ))}
            </div>
          )}
        </section>
      )
    }

    {/* Install-owned: the product's "ongkir dihitung otomatis" card is gone.
        Which form renders (full quote or confirmed-by-CS) depends on the
        buyer's province, and each form states its own shipping rule; a fixed
        sentence here contradicted one of them (review 2026-10-15). */}

    <!-- Direct Order Form Container. Install-owned heading: the "Pesan
         Sekarang" jump lands on a titled step, not mid-form. -->
    <section id="form-pemesanan" aria-labelledby="form-pemesanan-title" class="mt-4 scroll-mt-6 overflow-hidden rounded-none bg-white px-1 py-2">
      <h2 id="form-pemesanan-title" class="nm-serif px-3 pt-5 text-center text-[22px] uppercase leading-tight text-[var(--nm-marine)]">Form Pemesanan</h2>
      <span class="nm-rule mt-3" aria-hidden="true"></span>
      <GeoIpResolvedForm mode={formContext.mode} province={formContext.province} productSlug={product.slug} embedded={true} selectedVariantId={cheapestVariant?.id} />
    </section>

    {related.length > 0 && (
      <section aria-labelledby="pdp-related" class="border-t border-[var(--nm-border)] bg-[var(--nm-surface)] py-8">
        {/* On a bundle page the row offers the single products, so the buyer can
            also take one item instead of the set. */}
        <h2 id="pdp-related" class="nm-serif px-5 text-center text-[22px] uppercase leading-tight text-[var(--nm-marine)]">
          {relatedIsOwn ? 'Beli satuan' : 'Lengkapi rutinitas'}
        </h2>
        <span class="nm-rule mt-3" aria-hidden="true"></span>
        <div class="mt-5 px-4">
          <ProductGrid
            id="grid-related"
            products={related.map((p) => ({ slug: p.slug, name: p.productName, category: p.category, image: p.heroImage, price: p.price, comparePrice: p.comparePrice, variants: p.variants }))}
          >
            {related.length % 2 === 1 && (
              <SeeAllTile href="/produk" title="Semua produk" note={`${allProducts.length} produk dan paket`} images={otherSingles.slice(0, 4).map((p) => p.heroImage)} />
            )}
          </ProductGrid>
        </div>
      </section>
    )}

    <SocialProofToast
      orderCount={socialProofOrders}
    />

    <!-- Sticky Mobile Purchase Bar (Auto-hides while the hero or the order
         form is visible: over the hero it covers the product photo before the
         visitor has read anything, and over the form its CTA points at a form
         already on screen) -->
    <div id="sticky-purchase-bar" class="fixed inset-x-0 bottom-0 z-40 mx-auto flex w-full max-w-[480px] items-center justify-between border-fade-t bg-white/95 px-5 py-3 shadow-[0_-8px_24px_rgba(17,17,17,0.08)] backdrop-blur-md transition-all duration-300 lg:hidden" style="transform: translateY(100%); opacity: 0; pointer-events: none;">
      <div>
        <p class="text-[9px] font-semibold uppercase tracking-[0.12em] text-[var(--nm-muted)]">Harga Promo</p>
        <p data-pdp-sticky-price class="text-base font-bold text-[var(--nm-marine)]">Rp{Math.round(displayPrice).toLocaleString('id-ID')}</p>
      </div>
      <a
        href="#form-pemesanan"
        class="nm-btn active:scale-[0.98]"
      >
        Pesan Sekarang
      </a>
    </div>
  </main>

  <script>
    // Install-owned (DESIGN.md C6): the size pills and the order form's variant
    // radios are one choice. A pill checks the form's radio (the form's own
    // listeners then reprice the summary); either side updates the headline.
    function initVariantPills() {
      const pills = [...document.querySelectorAll<HTMLButtonElement>('[data-variant-pick]')];
      // A single variant needs no picking: the form's variant step is hidden
      // (its one radio stays checked and is submitted).
      const onlyRadios = document.querySelectorAll<HTMLInputElement>('input[name="variant"]');
      if (pills.length === 0) {
        if (onlyRadios.length === 1) onlyRadios[0].closest('.form-block')?.classList.add('nm-variant-synced');
        return;
      }
      const price = document.querySelector('[data-pdp-price]');
      const compare = document.querySelector<HTMLElement>('[data-pdp-compare]');
      const save = document.querySelector<HTMLElement>('[data-pdp-save]');
      const sticky = document.querySelector('[data-pdp-sticky-price]');
      const vs = document.querySelector<HTMLElement>('[data-pdp-vs]');
      const contents = document.querySelector<HTMLElement>('[data-pdp-contents]');
      const idr = (n: number) => `Rp${Math.round(n).toLocaleString('id-ID')}`;
      const show = (id: string) => {
        const pill = pills.find((p) => p.dataset.variantPick === id);
        if (!pill) return;
        const p = Number(pill.dataset.price);
        const c = Number(pill.dataset.compare);
        pills.forEach((x) => x.setAttribute('aria-pressed', String(x === pill)));
        if (price) price.textContent = idr(p);
        if (sticky) sticky.textContent = idr(p);
        const discounted = c > p;
        if (compare) { compare.hidden = !discounted; compare.textContent = idr(c); }
        if (save && !save.hasAttribute('data-bundle')) { save.hidden = !discounted; save.textContent = `Hemat ${Math.round((1 - p / c) * 100)}%`; }
        const saving = Number(pill.dataset.vs);
        if (vs) { vs.hidden = !(saving > 0); vs.textContent = `${idr(saving)} lebih hemat dibanding beli satuan`; }
        if (contents && pill.dataset.label) contents.textContent = pill.dataset.label;
        const photo = document.querySelector<HTMLImageElement>('[data-gallery] img');
        if (photo && pill.dataset.image) photo.src = pill.dataset.image;
      };
      // With the sync running, the pills are the one visible size choice: the
      // form's own variant step (same options, one screen lower) is hidden,
      // and its radios stay the submit control. Without script it stays.
      const radios = document.querySelectorAll<HTMLInputElement>('input[name="variant"]');
      if (radios.length > 0 && pills.every((p) => [...radios].some((r) => r.value === p.dataset.variantPick))) {
        radios[0].closest('.form-block')?.classList.add('nm-variant-synced');
      }
      pills.forEach((pill) => pill.addEventListener('click', () => {
        const id = pill.dataset.variantPick ?? '';
        const radio = document.querySelector<HTMLInputElement>(`input[name="variant"][value="${CSS.escape(id)}"]`);
        if (radio && !radio.checked) {
          radio.checked = true;
          radio.dispatchEvent(new Event('change', { bubbles: true }));
        }
        show(id);
      }));
      document.addEventListener('change', (event) => {
        const target = event.target as HTMLInputElement | null;
        if (target?.name === 'variant' && target.checked) show(target.value);
      });
    }
    initVariantPills();

    function initStickyBarObserver() {
      const stickyBar = document.getElementById('sticky-purchase-bar');
      const orderForm = document.getElementById('form-pemesanan');
      const hero = document.querySelector('[data-gallery]');
      if (!stickyBar || !orderForm) return;

      // The bar hides while EITHER blocker is on screen. It also starts hidden
      // in the markup, because the hero fills the first viewport — waiting for
      // the observer's first callback used to flash the bar over the photo.
      let heroVisible = true;
      let formVisible = false;

      const applyStickyVisibility = () => {
        if (heroVisible || formVisible) {
          stickyBar.style.transform = 'translateY(100%)';
          stickyBar.style.opacity = '0';
          stickyBar.style.pointerEvents = 'none';
        } else {
          stickyBar.style.transform = 'translateY(0)';
          stickyBar.style.opacity = '1';
          stickyBar.style.pointerEvents = 'auto';
        }
      };

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.target === hero) heroVisible = entry.isIntersecting;
            if (entry.target === orderForm) formVisible = entry.isIntersecting;
          });
          applyStickyVisibility();
        },
        { threshold: 0, rootMargin: '0px 0px -40px 0px' }
      );

      if (hero) observer.observe(hero);
      else heroVisible = false;
      observer.observe(orderForm);
      applyStickyVisibility();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initStickyBarObserver);
    } else {
      initStickyBarObserver();
    }
  </script>
</BaseLayout>
