---
import BaseLayout from '../layouts/BaseLayout.astro';
import GeoIpResolvedForm from '../components/storefront/forms/GeoIpResolvedForm.astro';
import MetaLandingTracker from '../components/storefront/tracking/MetaLandingTracker.astro';
import Icon from '../components/storefront/shared/Icon.astro';
import RatingStars from '../components/storefront/shared/RatingStars.astro';
import { getStorefrontProduct } from '../lib/catalog';
import { nativeLandingCanonicalPath } from '../lib/landing-pages';
import { defaultCatalogContentId } from '../lib/catalog-feed';
import { getRuntimeEnv } from '../lib/env';
import { loadStoreCodDisabledProvinceCodes } from '../lib/form-mode';
import { getStoreAdsConfig } from '../lib/store-ads';
import '../styles/form-hybrid.css';
import '../styles/landing-pages/paket-anti-aging-trio.css';

export const prerender = false;

const PRODUCT_SLUG = 'paket-anti-aging-trio';
const LANDING_SLUG = 'paket-anti-aging-trio';
const PAGE_TITLE = 'Paket Anti-Aging Trio - 3 Langkah Kencangkan Kontur, Samarkan Flek & Kunci SPF 50+ BPOM';
const PAGE_DESC = 'Paket bundling 3-in-1 terlaris Numa Skin: NAD+ Booster Serum 20ml + Adenosine Moisturizer 30g + Oxydew Sunscreen SPF 50+ PA++++ 30ml untuk perawatan kerutan & flek 24 jam (3 BPOM Resmi).';
const IMG_BASE = '/images/landing/paket-anti-aging-trio';
const HERO_IMAGE = `${IMG_BASE}/hero-paket-anti-aging-trio.webp`;

const database = getRuntimeEnv(Astro.locals)?.OMS_DB as D1Database | undefined;
const claimedProductSlug = Astro.request.headers.get('x-adsbook-product-page');
const [product, canonicalPath, codDisabledProvinceCodes] = await Promise.all([
  getStorefrontProduct(Astro.locals, PRODUCT_SLUG),
  claimedProductSlug
    ? Promise.resolve(`/produk/${claimedProductSlug}`)
    : nativeLandingCanonicalPath(Astro.locals, LANDING_SLUG),
  loadStoreCodDisabledProvinceCodes(database),
  getStoreAdsConfig(Astro.locals),
]);
if (!product) {
  return Astro.rewrite('/404');
}

const canonical = `${Astro.locals.tenant.siteUrl}${canonicalPath}`;

const variants = product.variants || [];
const cheapestVariant = variants.reduce(
  (min: any, v: any) => (!min || v.price < min.price ? v : min),
  variants[0]
);
const defaultVariant = cheapestVariant || {
  id: '12',
  label: 'NAD+ Serum 20ml + Adenosine 30gr + Sunscreen 30ml',
  price: 240000,
  comparePrice: 266998,
};
---

<BaseLayout
  title={PAGE_TITLE}
  description={PAGE_DESC}
  image={HERO_IMAGE}
  preloadImages={HERO_IMAGE}
  canonical={canonical}
  hideHeader={true}
  hideFooter={true}
>
  <MetaLandingTracker
    slug={LANDING_SLUG}
    contentId={defaultCatalogContentId(product)}
    contentName={product.contentName}
    price={defaultVariant.price}
  />

  <div class="dsw-shell">
    <main class="dsw-canvas">
      <!-- Section 1: Hero -->
      <section id="hero-section" class="dsw-hero">
        <div class="dsw-hero-head">
          <h1 class="dsw-h1">
            <span class="dsw-hl-tilt">Kerutan & Flek Hitam</span> Makin Dalam Karena Rawat Wajah Setengah-Setengah?
          </h1>
          <p class="dsw-sub" style="max-width: 390px; margin: 14px auto 0; font-weight: 700;">
            Serum pengencang tanpa pelembap pengunci & tameng UV siang akan menguap sia-sia.<br />
            <span class="dsw-underline-teal">Tuntaskan 3 lapis penuaan dengan Anti-Aging Trio Numa Skin!</span>
          </p>
        </div>

        <div class="dsw-hero-stage">
          <div class="dsw-hero-top-tag">
            <div class="dsw-hero-top-pill">
              <Icon name="lucide:award" class="size-3.5" aria-hidden="true" />
              <span>Paket 3-in-1 Anti-Aging • Hemat Rp27.000</span>
            </div>
          </div>

          <img
            src={HERO_IMAGE}
            alt="Perbandingan wajah kendur berflek hitam vs kulit kencang kenyal terlindungi UV dengan Paket Anti-Aging Trio Numa Skin"
            width="720"
            height="480"
            class="dsw-hero-img"
            fetchpriority="high"
            loading="eager"
            decoding="async"
          />

          <div class="dsw-hero-overlap">
            <div class="dsw-hero-overlap-inner">
              <h2 class="dsw-hero-overlap-title">Mengapa 1 Produk Saja Gagal Melawan Penuaan 35+?</h2>
              <p class="dsw-hero-overlap-text">
                Di usia 35+, kulit kehilangan <strong style="color: #be123c;">energi seluler NAD+, cadangan kolagen Adenosine, sekaligus diserang radiasi UVA pemicu flek tiap siang</strong>.
              </p>
            </div>
          </div>
        </div>

        <div class="dsw-trust-row">
          <div class="dsw-trust-item">
            <span class="dsw-trust-icon">
              <Icon name="lucide:shield-check" class="size-4" aria-hidden="true" />
            </span>
            <div>
              <span class="dsw-trust-label">BPOM Resmi</span>
              <span class="dsw-trust-sub">3 Izin Edar</span>
            </div>
          </div>
          <div class="dsw-trust-item">
            <span class="dsw-trust-icon">
              <Icon name="lucide:badge-check" class="size-4" aria-hidden="true" />
            </span>
            <div>
              <span class="dsw-trust-label">Halal RI</span>
              <span class="dsw-trust-sub">Aman Bumil</span>
            </div>
          </div>
          <div class="dsw-trust-item">
            <span class="dsw-trust-icon">
              <Icon name="lucide:truck" class="size-4" aria-hidden="true" />
            </span>
            <div>
              <span class="dsw-trust-label">Bisa COD</span>
              <span class="dsw-trust-sub">Bayar di Rumah</span>
            </div>
          </div>
        </div>
      </section>

      <!-- Section 2: Solusi Singkat + Visual -->
      <section class="dsw-section">
        <h2 class="dsw-h2">
          Sinergi <span class="dsw-hl-aqua">3 langkah anti-aging 24 jam</span> dalam 1 paket
        </h2>
        <p class="dsw-sub">Tiga tahap esensial yang saling mengunci agar kontur pipi mengencang dan flek tidak kambuh lagi.</p>

        <div class="dsw-photo-stack">
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/solusi-tiga-lapis-pengunci.webp`}
              alt="Wanita Indonesia usia 40 tahun dengan kulit wajah kencang, kenyal, dan bebas flek hitam berkat perawatan 3 langkah Numa Skin"
              width="648"
              height="432"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
          </div>
        </div>

        <div class="dsw-list">
          <div class="dsw-list-row">
            <span class="dsw-icon-teal">
              <Icon name="lucide:layers" class="size-4" aria-hidden="true" />
            </span>
            <p class="dsw-list-text">
              <strong style="color: #0f172a;">NAD+ Booster Serum (20 ml):</strong> Menghidupkan energi perbaikan seluler & mengencangkan garis senyum dengan 2% Swiss RejuveNAD™ + 6X Peptide Complex.
            </p>
          </div>
          <div class="dsw-list-row">
            <span class="dsw-icon-teal">
              <Icon name="lucide:droplets" class="size-4" aria-hidden="true" />
            </span>
            <p class="dsw-list-text">
              <strong style="color: #0f172a;">Adenosine Moisturizer (30 gr):</strong> Mengunci hidrasi 5 lapis kulit & merawat flek hitam dengan Adenosine, Skin Communicator™, & 11X Hyaluronic Acid.
            </p>
          </div>
          <div class="dsw-list-row">
            <span class="dsw-icon-teal">
              <Icon name="lucide:sun-dim" class="size-4" aria-hidden="true" />
            </span>
            <p class="dsw-list-text">
              <strong style="color: #0f172a;">Oxydew Sunscreen SPF 50+ PA++++ (30 ml):</strong> Memblokir sinar UVA/UVB perusak kolagen & pemicu flek baru dengan 3% Luceane™ tanpa whitecast abu-abu.
            </p>
          </div>
        </div>
      </section>

      <!-- Section 3: Tanda Masalah Kulit + Visual Grid -->
      <section class="dsw-section dsw-section--warn">
        <h2 class="dsw-h2">
          Mengapa kerutan & flek <span class="dsw-underline-warn">sulit memudar</span> jika hanya pakai serum tunggal?
        </h2>

        <div class="dsw-photo-grid-2">
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/masalah-serum-tanpa-sunscreen.webp`}
              alt="Wanita bercermin melihat wajah yang tetap kusam dan timbul flek karena memakai serum tanpa dikunci pelembap dan sunscreen"
              width="315"
              height="210"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <p class="dsw-photo-caption">
              <strong style="color: #be123c; display: block;">Serum Menguap Tanpa Pengunci</strong>
              Tanpa lapisan pelembap & SPF, nutrisi aktif menguap dan rusak oleh terik matahari.
            </p>
          </div>
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/masalah-pipi-kendur-flek-uv.webp`}
              alt="Kondisi pipi mulai turun dengan garis senyum dalam dan flek hitam membandel di tulang pipi"
              width="315"
              height="210"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <p class="dsw-photo-caption">
              <strong style="color: #be123c; display: block;">Kolagen Putus Dihantam UVA</strong>
              Radiasi siang hari merusak serat elastin pipi sekaligus mempertebal bercak melasma.
            </p>
          </div>
        </div>

        <div class="dsw-list">
          <div class="dsw-list-row">
            <span class="dsw-icon-warn">
              <Icon name="lucide:triangle-alert" class="size-4" aria-hidden="true" />
            </span>
            <p class="dsw-list-text">
              Sudah beli serum mahal, tapi <strong style="color: #be123c;">pipi tetap terasa kendur dan kering ketarik</strong> saat bangun pagi di ruang ber-AC.
            </p>
          </div>
          <div class="dsw-list-row">
            <span class="dsw-icon-warn">
              <Icon name="lucide:triangle-alert" class="size-4" aria-hidden="true" />
            </span>
            <p class="dsw-list-text">
              Flek hitam yang mulai memudar <strong style="color: #be123c;">kembali menghitam tiap kali beraktivitas di luar ruangan</strong> tanpa proteksi SPF 50+.
            </p>
          </div>
          <div class="dsw-list-row">
            <span class="dsw-icon-warn">
              <Icon name="lucide:triangle-alert" class="size-4" aria-hidden="true" />
            </span>
            <p class="dsw-list-text">
              Mencampur produk beda merek justru membuat tekstur <strong style="color: #be123c;">menggumpal (pilling), lengket, dan memicu bruntusan</strong>.
            </p>
          </div>
        </div>
      </section>

      <!-- Section 4: Perbandingan Visual Sebelum vs Sesudah -->
      <section class="dsw-section">
        <h2 class="dsw-h2">
          Perbandingan hasil <span class="dsw-hl-aqua">ritual 3 langkah lengkap</span>
        </h2>
        <p class="dsw-sub">Ketika perbaikan seluler, penguncian kelembapan, dan perisai UV bekerja serentak.</p>

        <div class="dsw-photo-stack">
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/kondisi-kerutan-flek-tanpa-trio.webp`}
              alt="Kondisi kulit dengan garis senyum dalam, noda flek hitam, dan tekstur kering sebelum pemakaian rutin"
              width="648"
              height="432"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <span class="dsw-photo-badge dsw-photo-badge--before">Tanpa Trio Sinergis</span>
            <p class="dsw-photo-caption">
              Garis senyum tampak tegas, kelembapan cepat hilang, dan noda hitam kembali menggelap tiap terkena matahari.
            </p>
          </div>

          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/kondisi-wajah-kencang-bebas-flek.webp`}
              alt="Kondisi wajah kencang, kenyal, cerah merata, dan terlindungi setelah pemakaian rutin Paket Anti-Aging Trio"
              width="648"
              height="432"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <span class="dsw-photo-badge dsw-photo-badge--after">Rutin Trio 3-in-1</span>
            <p class="dsw-photo-caption">
              Kontur pipi terasa lebih padat membal, bercak hitam memudar bertahap, dan wajah tetap segar terlindungi seharian.
            </p>
          </div>
        </div>
      </section>

      <!-- Section 5: Dark Marine Section — Cara Pakai Praktis -->
      <section class="dsw-section dsw-section--dark">
        <h2 class="dsw-h2">
          Urutan Pakai <span style="color: #99e2ec;">3 Lapis Cepat Meresap</span>
        </h2>
        <p class="dsw-sub">Semua berbahan dasar Ulleung Deep Sea Water sehingga ringan tanpa rasa gerah.</p>

        <div class="dsw-photo-stack">
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/cara-pakai-trio-serum-pelembap.webp`}
              alt="Langkah 1 dan 2: Teteskan NAD+ Booster Serum lalu kunci dengan Adenosine Moisturizer pagi dan malam"
              width="648"
              height="432"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <p class="dsw-photo-caption">
              <strong style="color: #ffffff;">Langkah 1 & 2 (Pagi & Malam — Serum + Moisturizer):</strong> Teteskan 3–4 tetes NAD+ Serum lalu kunci dengan 1–2 pump Adenosine Moisturizer.
            </p>
          </div>
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/cara-pakai-trio-kunci-spf50.webp`}
              alt="Langkah 3 Pagi: Oleskan 2 ruas jari Oxydew Sunscreen SPF 50+ PA++++ sebelum beraktivitas"
              width="648"
              height="432"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <p class="dsw-photo-caption">
              <strong style="color: #ffffff;">Langkah 3 (Khusus Pagi/Siang — Oxydew SPF 50+):</strong> Ratakan 2 ruas jari Oxydew Sunscreen 15 menit sebelum keluar rumah.
            </p>
          </div>
        </div>

        <div class="dsw-list">
          <div class="dsw-list-row">
            <span class="dsw-step-num">1</span>
            <p class="dsw-step-text">
              <strong style="color: #ffffff;">Rutinitas Pagi:</strong> Cuci muka → NAD+ Serum → Adenosine Moisturizer → kunci dengan Oxydew Sunscreen SPF 50+.
            </p>
          </div>
          <div class="dsw-list-row">
            <span class="dsw-step-num">2</span>
            <p class="dsw-step-text">
              <strong style="color: #ffffff;">Rutinitas Malam:</strong> Cuci muka → NAD+ Serum lalu <strong style="color: #ffffff; background: #104452; padding: 1px 6px; border-radius: 4px;">kunci dengan Adenosine Moisturizer</strong> sebelum tidur.
            </p>
          </div>
          <div class="dsw-list-row">
            <span class="dsw-step-num">3</span>
            <p class="dsw-step-text">
              Ketiga formula menyatu sempurna di bawah bedak atau <em>cushion</em> tanpa <em>whitecast</em>.
            </p>
          </div>
        </div>
      </section>

      <!-- Section 6: Ulasan Pelanggan -->
      <section class="dsw-section">
        <h2 class="dsw-h2">
          Alasan trio ini jadi <span class="dsw-hl-aqua">andalan usia 35–55 tahun</span>
        </h2>
        <p class="dsw-sub"> Lebih hemat Rp27.000 dibanding beli satuan dan hasilnya jauh lebih terukur.</p>

        <div class="dsw-reviews-divide">
          <div class="dsw-review-row">
            <div class="dsw-review-head">
              <div>
                <p class="dsw-review-author">
                  Ibu Ratna W.
                  <span style="color: #0b6e7d; display: inline-flex;">
                    <Icon name="lucide:badge-check" class="size-4" aria-hidden="true" />
                  </span>
                </p>
                <p class="dsw-review-meta">Jakarta Selatan • Usia 42 Tahun</p>
              </div>
              <RatingStars rating={5} starClass="h-3.5 w-3.5 !fill-[#d97706] !text-[#d97706]" />
            </div>
            <p class="dsw-review-quote">
              "Biasanya kalau tumpuk serum, pelembap, sama sunscreen muka jadi berat berminyak. <span class="dsw-hl-aqua">Trio Numa ini langsung meresap adem, gak pilling sama sekali</span> dan bikin pipi berasa kencang."
            </p>
          </div>
          <div class="dsw-review-row">
            <div class="dsw-review-head">
              <div>
                <p class="dsw-review-author">
                  Bunda Dewi S.
                  <span style="color: #0b6e7d; display: inline-flex;">
                    <Icon name="lucide:badge-check" class="size-4" aria-hidden="true" />
                  </span>
                </p>
                <p class="dsw-review-meta">Bandung • Paket Repeat Order</p>
              </div>
              <RatingStars rating={5} starClass="h-3.5 w-3.5 !fill-[#d97706] !text-[#d97706]" />
            </div>
            <p class="dsw-review-quote">
              "Dulu pakai serum doang flek di pipi tetep balik pas siang. <strong style="color: #0f172a;">Semenjak dikunci Adenosine + Oxydew SPF 50+</strong>, <span class="dsw-hl-aqua">garis senyum memudar dan flek gak pernah menghitam lagi</span>."
            </p>
          </div>
          <div class="dsw-review-row">
            <div class="dsw-review-head">
              <div>
                <p class="dsw-review-author">
                  Ibu Hesti M.
                  <span style="color: #0b6e7d; display: inline-flex;">
                    <Icon name="lucide:badge-check" class="size-4" aria-hidden="true" />
                  </span>
                </p>
                <p class="dsw-review-meta">Semarang • Hemat Rp27.000</p>
              </div>
              <RatingStars rating={5} starClass="h-3.5 w-3.5 !fill-[#d97706] !text-[#d97706]" />
            </div>
            <p class="dsw-review-quote">
              "Beli paket 3-in-1 gini <span class="dsw-hl-rose">hemat hampir 27 ribu daripada beli pisah</span>. <span class="dsw-hl-aqua">Bangun tidur muka plumpy kenyal</span>, siangnya terlindungi penuh."
            </p>
          </div>
        </div>
      </section>

      <!-- Section 7: Galeri Bukti Visual -->
      <section class="dsw-section dsw-section--tint">
        <h2 class="dsw-h2">
          Trio lengkap untuk <span style="color: #0b6e7d;">peremajaan kulit tropis</span>
        </h2>
        <p class="dsw-sub">Tiga botol ukuran penuh untuk merawat penuaan sekaligus menangkal terik matahari.</p>

        <div class="dsw-photo-grid-2">
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/bukti-tekstur-trio-cepat-meresap.webp`}
              alt="Tekstur rangkaian Anti-Aging Trio yang ringan dan meresap cepat di kulit tangan"
              width="315"
              height="210"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
          </div>
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/bukti-bunda-40an-trio-kencang.webp`}
              alt="Potret pelanggan wanita berhijab usia 40-an dengan wajah cerah kencang dan bebas flek"
              width="315"
              height="210"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
          </div>
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/bukti-kulit-padat-terlindungi.webp`}
              alt="Close-up kulit pipi yang tampak kenyal, padat, dan glowing sehat"
              width="315"
              height="210"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
          </div>
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/bukti-meja-rias-anti-aging-trio.webp`}
              alt="Paket Anti-Aging Trio Numa Skin di meja rias pelanggan"
              width="315"
              height="210"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
          </div>
        </div>
      </section>

      <!-- Section 8: Product Knowledge (Full-Bleed Figures) -->
      <section class="dsw-section dsw-section--knowledge">
        <h2 class="dsw-h2">
          Mengapa <span class="dsw-hl-aqua">Anti-Aging Trio</span> bekerja jauh lebih efektif?
        </h2>
        <p class="dsw-sub">
          Dirancang dalam satu ekosistem air laut dalam Pulau Ulleung agar penyerapan aktif berlipat ganda.
        </p>

        <div class="dsw-figure-stack">
          <figure class="dsw-figure">
            <div class="dsw-figure-bleed">
              <img
                src={`${IMG_BASE}/formulasi-trio-seluler-uv.webp`}
                alt="Teknologi 3 lapis RejuveNAD, Skin Communicator, dan Luceane dalam air laut dalam Ulleung"
                width="720"
                height="480"
                class="dsw-figure-img"
                loading="lazy"
                fetchpriority="low"
                decoding="async"
              />
            </div>
            <figcaption class="dsw-figcaption">
              <h3 class="dsw-figcaption-title">3-Layer Cellular & UV Defense Architecture</h3>
              <p class="dsw-figcaption-desc">
                RejuveNAD™ memulihkan energi seluler, Skin Communicator™ memperkuat jaringan kolagen, dan Luceane™ melindungi DNA kulit dari penuaan sinar UV.
              </p>
            </figcaption>
          </figure>
          <figure class="dsw-figure">
            <div class="dsw-figure-bleed">
              <img
                src={`${IMG_BASE}/kandungan-nad-adenosine-luceane.webp`}
                alt="Kombinasi bahan aktif 2% NAD+, 6X Peptide, Adenosine, 11X Hyaluronic Acid, dan 3% Luceane"
                width="720"
                height="480"
                class="dsw-figure-img"
                loading="lazy"
                fetchpriority="low"
                decoding="async"
              />
            </div>
            <figcaption class="dsw-figcaption">
              <h3 class="dsw-figcaption-title">6X Peptide + Adenosine + 11X Hyaluronic + SPF 50+</h3>
              <p class="dsw-figcaption-desc">
                Perpaduan lengkap peptida pengencang, pencerah noda hitam, pengunci hidrasi 11 lapis, dan filter UV spektrum luas.
              </p>
            </figcaption>
          </figure>
          <figure class="dsw-figure">
            <div class="dsw-figure-bleed">
              <img
