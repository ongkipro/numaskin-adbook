---
import BaseLayout from '../layouts/BaseLayout.astro';
import GeoIpResolvedForm from '../components/storefront/forms/GeoIpResolvedForm.astro';
import MetaLandingTracker from '../components/storefront/tracking/MetaLandingTracker.astro';
import Icon from '../components/storefront/shared/Icon.astro';
import RatingStars from '../components/storefront/shared/RatingStars.astro';
import { getStorefrontProduct } from '../lib/catalog';
import { nativeLandingCanonicalPath } from '../lib/landing-pages';
import { defaultCatalogContentId } from '../lib/catalog-feed';
import { getRuntimeEnv } from '../lib/env';
import { loadStoreCodDisabledProvinceCodes } from '../lib/form-mode';
import { getStoreAdsConfig } from '../lib/store-ads';
import '../styles/form-hybrid.css';
import '../styles/landing-pages/paket-ultimate-anti-aging-50ml.css';

export const prerender = false;

const PRODUCT_SLUG = 'paket-ultimate-anti-aging-50ml';
const LANDING_SLUG = 'paket-ultimate-anti-aging-50ml';
const PAGE_TITLE = 'Paket Ultimate Anti-Aging 50ml - Rangkaian 5-in-1 Flek, Kerutan & UV BPOM';
const PAGE_DESC = 'Paket lengkap 5 produk anti-aging Numa Skin ukuran praktis: Treatment Lotion 50ml, NAD+ Serum 20ml, PDRN Day Cream 30gr, Adenosine Moisturizer 30gr, dan Oxydew Sunscreen 30ml.';
const IMG_BASE = '/images/landing/paket-ultimate-anti-aging-50ml';
const HERO_IMAGE = `${IMG_BASE}/hero-paket-ultimate-50ml.webp`;

const database = getRuntimeEnv(Astro.locals)?.OMS_DB as D1Database | undefined;
const claimedProductSlug = Astro.request.headers.get('x-adsbook-product-page');
const [product, canonicalPath, codDisabledProvinceCodes] = await Promise.all([
  getStorefrontProduct(Astro.locals, PRODUCT_SLUG),
  claimedProductSlug
    ? Promise.resolve(`/produk/${claimedProductSlug}`)
    : nativeLandingCanonicalPath(Astro.locals, LANDING_SLUG),
  loadStoreCodDisabledProvinceCodes(database),
  getStoreAdsConfig(Astro.locals),
]);
if (!product) {
  return Astro.rewrite('/404');
}

const canonical = `${Astro.locals.tenant.siteUrl}${canonicalPath}`;

const variants = product.variants || [];
const cheapestVariant = variants.reduce(
  (min: any, v: any) => (!min || v.price < min.price ? v : min),
  variants[0]
);
const defaultVariant = cheapestVariant || {
  id: '51',
  label: 'Toner 50ml + NAD+ Serum 20ml + Day Cream 30gr + Adenosine 30gr + Sunscreen 30ml',
  price: 382500,
  comparePrice: 425497,
};
---

<BaseLayout
  title={PAGE_TITLE}
  description={PAGE_DESC}
  image={HERO_IMAGE}
  preloadImages={HERO_IMAGE}
  canonical={canonical}
  hideHeader={true}
  hideFooter={true}
>
  <MetaLandingTracker
    slug={LANDING_SLUG}
    contentId={defaultCatalogContentId(product)}
    contentName={product.contentName}
    price={defaultVariant.price}
  />

  <div class="dsw-shell">
    <main class="dsw-canvas">
      <!-- Section 1: Hero -->
      <section id="hero-section" class="dsw-hero">
        <div class="dsw-hero-head">
          <h1 class="dsw-h1">
            <span class="dsw-hl-tilt">Flek, Kerutan & Kendur</span> Muncul Bersamaan di Usia 35+?
          </h1>
          <p class="dsw-sub" style="max-width: 390px; margin: 14px auto 0; font-weight: 700;">
            Penuaan kulit membutuhkan hidrasi pembuka, booster NAD+, krim pencerah pagi, pengunci malam, dan perisai UV.<br />
            <span class="dsw-underline-teal">Rawat tuntas 24 jam dengan Paket Ultimate 5-in-1 (50ml)!</span>
          </p>
        </div>

        <div class="dsw-hero-stage">
          <div class="dsw-hero-top-tag">
            <div class="dsw-hero-top-pill">
              <Icon name="lucide:award" class="size-3.5" aria-hidden="true" />
              <span>Ultimate 5-in-1 (50ml) • Hemat Rp43rb</span>
            </div>
          </div>

          <img
            src={HERO_IMAGE}
            alt="Perbandingan wajah berflek dan kendur vs kulit kencang cerah dengan Paket Ultimate Anti-Aging 50ml Numa Skin"
            width="720"
            height="480"
            class="dsw-hero-img"
            fetchpriority="high"
            loading="eager"
            decoding="async"
          />

          <div class="dsw-hero-ba" aria-hidden="true">
            <span class="dsw-hero-ba-pill dsw-hero-ba-pill--before">Flek & Kontur Kendur</span>
            <span class="dsw-hero-ba-pill dsw-hero-ba-pill--after">Kencang & Cerah Utuh</span>
          </div>

          <div class="dsw-hero-trust-strip" role="list" aria-label="Jaminan kualitas Numa Skin">
            <div class="dsw-trust-item" role="listitem">
              <span class="dsw-trust-icon">
                <Icon name="lucide:shield-check" class="size-3.5" aria-hidden="true" />
              </span>
              <span class="dsw-trust-text">
                <strong class="dsw-trust-label">5 BPOM Resmi</strong>
                <span class="dsw-trust-sub">5 Produk Lengkap</span>
              </span>
            </div>
            <div class="dsw-trust-item" role="listitem">
              <span class="dsw-trust-icon">
                <Icon name="lucide:droplets" class="size-3.5" aria-hidden="true" />
              </span>
              <span class="dsw-trust-text">
                <strong class="dsw-trust-label">NAD+ & PDRN</strong>
                <span class="dsw-trust-sub">Adenosine + 11X HA</span>
              </span>
            </div>
            <div class="dsw-trust-item" role="listitem">
              <span class="dsw-trust-icon">
                <Icon name="lucide:layers" class="size-3.5" aria-hidden="true" />
              </span>
              <span class="dsw-trust-text">
                <strong class="dsw-trust-label">SPF 50+ PA++++</strong>
                <span class="dsw-trust-sub">3% Luceane™</span>
              </span>
            </div>
          </div>
        </div>

        <div class="dsw-hero-foot">
          <p class="dsw-hero-caption">
            Rangkaian 5-in-1 paling lengkap dengan <strong>Toner 50ml</strong>, <strong>NAD+ Serum</strong>, <strong>PDRN Day Cream</strong>, <strong>Adenosine Moisturizer</strong>, dan <strong>Oxydew Sunscreen</strong>.
          </p>
          <a href="#form-pemesanan" class="dsw-cta" data-scroll-to-form>
            <span>Ambil Paket Ultimate 50ml Ini</span>
            <Icon name="lucide:arrow-right" class="size-5" aria-hidden="true" />
          </a>
        </div>
      </section>

      <!-- Section 2: Solusi Praktis -->
      <section class="dsw-section">
        <h2 class="dsw-h2">
          5 Tahap Presisi <span class="dsw-hl-aqua">Perawatan Pagi & Malam</span>
        </h2>
        <p class="dsw-sub" style="margin-top: 8px;">
          Dirancang agar setiap lapisan bahan aktif bekerja saling menguatkan dari pagi hingga malam:
        </p>

        <div class="dsw-solution-box">
          <img
            src={`${IMG_BASE}/solusi-lima-tahap-pagi-malam-50ml.webp`}
            alt="Wanita Indonesia usia 40 tahun merawat kulit dengan 5 produk Numa Skin Ultimate Anti-Aging"
            width="648"
            height="432"
            class="dsw-solution-img"
            loading="lazy"
            fetchpriority="low"
            decoding="async"
          />

          <div class="dsw-check-list">
            <div class="dsw-check-item">
              <span class="dsw-icon-green">
                <Icon name="lucide:check" class="size-3.5" aria-hidden="true" />
              </span>
              <p class="dsw-list-text"><strong>Pembuka & Booster Seluler:</strong> Treatment Lotion 50ml membuka hidrasi pori, dilanjutkan NAD+ Booster Serum (RejuveNAD™ + 6X Peptide) untuk merawat kekencangan kontur wajah.</p>
            </div>
            <div class="dsw-check-item">
              <span class="dsw-icon-green">
                <Icon name="lucide:check" class="size-3.5" aria-hidden="true" />
              </span>
              <p class="dsw-list-text"><strong>Koreksi Flek & Kunci Elastisitas:</strong> PDRN + Alpha Arbutin Day Cream mencerahkan wajah di pagi hari tanpa abu-abu, sedangkan Adenosine Moisturizer mengunci kelembapan 11X HA.</p>
            </div>
            <div class="dsw-check-item">
              <span class="dsw-icon-green">
                <Icon name="lucide:check" class="size-3.5" aria-hidden="true" />
              </span>
              <p class="dsw-list-text"><strong>Perisai UV Anti-Penuaan:</strong> Oxydew Sunscreen SPF 50+ PA++++ dengan 3% Luceane™ melindungi hasil perawatan dari sengatan matahari.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- Section 3: Masalah Kulit -->
      <section class="dsw-section--tinted">
        <h2 class="dsw-h2">
          Kenapa Skincare Eceran <span class="dsw-hl-coral">Sering Gagal di Usia 35+?</span>
        </h2>

        <div class="dsw-grid-2">
          <article class="dsw-card">
            <img
              src={`${IMG_BASE}/masalah-bingung-urut-skincare-anti-aging.webp`}
              alt="Wanita bingung mencampur berbagai merek skincare yang tidak saling mendukung"
              width="480"
              height="320"
              class="dsw-card-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <div class="dsw-card-body">
              <span class="dsw-badge-red">Formula Saling Bertabrakan</span>
              <p class="dsw-card-desc">Mencampur produk beda merek sering membuat krim menggumpal, pori tersumbat, dan bahan aktif tidak meresap.</p>
            </div>
          </article>

          <article class="dsw-card">
            <img
              src={`${IMG_BASE}/masalah-flek-garis-senyum-usia-38.webp`}
              alt="Close-up flek hitam membandel dan garis senyum yang makin dalam di usia 38 tahun"
              width="480"
              height="320"
              class="dsw-card-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <div class="dsw-card-body">
              <span class="dsw-badge-red">Penuaan Multi-Dimensi</span>
              <p class="dsw-card-desc">Di usia 35+, flek hitam hadir bersama hilangnya elastisitas pipi sehingga tidak cukup diatasi dengan 1 krim saja.</p>
            </div>
          </article>
        </div>

        <div class="dsw-list-box">
          <p class="dsw-list-box-title">Tanda Anda Membutuhkan Paket Ini:</p>
          <div class="dsw-check-list" style="margin-top: 0;">
            <div class="dsw-check-item">
              <span class="dsw-icon-red">
                <Icon name="lucide:x" class="size-3.5" aria-hidden="true" />
              </span>
              <p class="dsw-list-text">Memiliki masalah ganda: flek hitam/bekas jerawat gelap sekaligus garis senyum dan pipi yang mulai turun</p>
            </div>
            <div class="dsw-check-item">
              <span class="dsw-icon-red">
                <Icon name="lucide:x" class="size-3.5" aria-hidden="true" />
              </span>
              <p class="dsw-list-text">Ingin langsung mendapatkan seluruh rangkaian 5 produk anti-aging Numa Skin dengan harga lebih terjangkau (Toner 50ml)</p>
            </div>
            <div class="dsw-check-item">
              <span class="dsw-icon-red">
                <Icon name="lucide:x" class="size-3.5" aria-hidden="true" />
              </span>
              <p class="dsw-list-text">Menginginkan jadwal pakai pagi dan malam yang sudah terukur tanpa perlu pusing memilih produk tambahan</p>
            </div>
          </div>
        </div>
      </section>

      <!-- Section 4: Transformasi Nyata -->
      <section class="dsw-section">
        <h2 class="dsw-h2">
          Transformasi <span class="dsw-hl-aqua">Wajah Kencang, Cerah & Terlindungi</span>
        </h2>
        <p class="dsw-sub" style="margin-top: 8px;">
          Perubahan bertahap saat kelima produk bekerja sinergis merawat kulit siang dan malam:
        </p>

        <div class="dsw-grid-2">
          <article class="dsw-card">
            <img
              src={`${IMG_BASE}/kondisi-penuaan-flek-kendur-50ml.webp`}
              alt="Kondisi kulit usia 40 tahun dengan flek hitam, garis senyum dalam, dan warna kulit kusam"
              width="480"
              height="320"
              class="dsw-card-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <div class="dsw-card-body">
              <span class="dsw-badge-red">Sebelum Perawatan</span>
              <p class="dsw-card-desc">Tampak bintik flek kecokelatan di tulang pipi, garis senyum terlihat jelas, dan rona wajah tampak lelah.</p>
            </div>
          </article>

          <article class="dsw-card">
            <img
              src={`${IMG_BASE}/kondisi-wajah-kencang-cerah-50ml.webp`}
              alt="Kondisi kulit tampak kencang, padat, cerah merata, dan flek hitam tersamarkan"
              width="480"
              height="320"
              class="dsw-card-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <div class="dsw-card-body">
              <span class="dsw-badge-green">Rutin Ultimate 5-in-1</span>
              <p class="dsw-card-desc">Kontur pipi terasa lebih padat kencang, tampilan flek memudar bertahap, dan wajah tampak cerah segar.</p>
            </div>
          </article>
        </div>

        <div class="dsw-list-box">
          <p class="dsw-list-box-title">Tahapan Hasil Pemakaian Rutin:</p>
          <div class="dsw-check-list" style="margin-top: 0;">
            <div class="dsw-check-item">
              <span class="dsw-icon-green">
                <Icon name="lucide:check" class="size-3.5" aria-hidden="true" />
              </span>
              <p class="dsw-list-text"><strong>Minggu 1–2:</strong> Kulit langsung terasa lembap kenyal, tone-up pagi menyatu mulus, dan wajah bebas kusam</p>
            </div>
            <div class="dsw-check-item">
              <span class="dsw-icon-green">
                <Icon name="lucide:check" class="size-3.5" aria-hidden="true" />
              </span>
              <p class="dsw-list-text"><strong>Minggu 3–4:</strong> Garis-garis halus di sekitar mata dan senyum tampak lebih halus berkat sinergi NAD+ & Adenosine</p>
            </div>
            <div class="dsw-check-item">
              <span class="dsw-icon-green">
                <Icon name="lucide:check" class="size-3.5" aria-hidden="true" />
              </span>
              <p class="dsw-list-text"><strong>Minggu 5–6:</strong> Noda hitam tampak lebih samar, kontur wajah terasa kencang, dan terlindungi dari flek baru</p>
            </div>
          </div>
        </div>
      </section>

      <!-- Section 5: Cara Pakai -->
      <section class="dsw-section--tinted">
        <h2 class="dsw-h2">
          Cara Pakai <span class="dsw-hl-aqua">Praktis Setiap Hari</span>
        </h2>
        <p class="dsw-sub" style="margin-top: 8px;">
          Panduan pemakaian 5 produk untuk rutinitas Pagi dan Malam:
        </p>

        <div class="dsw-grid-2">
          <article class="dsw-card">
            <img
              src={`${IMG_BASE}/cara-pakai-ultimate-50ml-pagi.webp`}
              alt="Rutinitas pagi memakai Toner 50ml, PDRN Day Cream, dan Oxydew Sunscreen SPF 50+"
              width="480"
              height="320"
              class="dsw-card-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <div class="dsw-card-body">
              <span class="dsw-badge-teal">Rutinitas Pagi (Cerah & Proteksi)</span>
              <p class="dsw-card-desc">Tepuk <strong>Toner 50ml</strong> (bisa tambah <strong>NAD+ Serum</strong>), ratakan <strong>PDRN Day Cream</strong>, lalu kunci dengan <strong>Oxydew Sunscreen</strong>.</p>
            </div>
          </article>

          <article class="dsw-card">
            <img
              src={`${IMG_BASE}/cara-pakai-ultimate-50ml-malam.webp`}
              alt="Rutinitas malam memakai Toner 50ml, NAD+ Booster Serum, dan Adenosine Moisturizer"
              width="480"
              height="320"
              class="dsw-card-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <div class="dsw-card-body">
              <span class="dsw-badge-teal">Rutinitas Malam (Lifting & Regenerasi)</span>
              <p class="dsw-card-desc">Tepuk <strong>Toner 50ml</strong>, pijat 3 tetes <strong>NAD+ Booster Serum</strong> ke arah atas, lalu kunci dengan <strong>Adenosine Moisturizer</strong>.</p>
            </div>
          </article>
        </div>

        <div style="margin-top: 22px; text-align: center;">
          <a href="#form-pemesanan" class="dsw-cta" data-scroll-to-form>
            <span>Pesan Paket Ultimate 50ml Sekarang</span>
            <Icon name="lucide:arrow-right" class="size-5" aria-hidden="true" />
          </a>
        </div>
      </section>

      <!-- Section 6: Bukti Pelanggan -->
      <section class="dsw-section">
        <h2 class="dsw-h2">
          Bukti Tekstur <span class="dsw-hl-aqua">& Kepuasan Pelanggan</span>
        </h2>
        <p class="dsw-sub" style="margin-top: 8px;">
          Pengalaman nyata pelanggan yang memakai rangkaian lengkap 5-in-1 Numa Skin:
        </p>

        <div class="dsw-grid-2">
          <div class="dsw-proof-cell">
            <img
              src={`${IMG_BASE}/bukti-tekstur-lima-produk-50ml.webp`}
              alt="Swatch 5 tekstur produk Numa Skin Ultimate Anti-Aging di punggung tangan"
              width="480"
              height="320"
              class="dsw-proof-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <p class="dsw-proof-OverlayCaption">5 Tekstur Ringan Saling Mengunci</p>
          </div>
          <div class="dsw-proof-cell">
            <img
              src={`${IMG_BASE}/bukti-ibu-40an-glowing-50ml.webp`}
              alt="Wanita Indonesia usia 40 tahun berhijab dengan wajah cerah kencang"
              width="480"
              height="320"
              class="dsw-proof-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <p class="dsw-proof-OverlayCaption">Tampak Awet Muda di Usia 40+</p>
          </div>
          <div class="dsw-proof-cell">
            <img
              src={`${IMG_BASE}/bukti-kulit-padat-kenyal-50ml.webp`}
              alt="Close-up tulang pipi padat kenyal dan bebas flek hitam"
              width="480"
              height="320"
              class="dsw-proof-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <p class="dsw-proof-OverlayCaption">Pipi Padat & Flek Tersamarkan</p>
          </div>
          <div class="dsw-proof-cell">
            <img
              src={`${IMG_BASE}/bukti-meja-rias-ultimate-50ml.webp`}
              alt="Rangkaian 5 produk Paket Ultimate Anti-Aging 50ml di atas meja rias"
              width="480"
              height="320"
              class="dsw-proof-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <p class="dsw-proof-OverlayCaption">Paket 5-in-1 Praktis & Lengkap</p>
          </div>
        </div>

        <div class="dsw-testi-list">
          <article class="dsw-testi-card">
            <div class="dsw-testi-head">
              <div class="dsw-testi-avatar" aria-hidden="true">H</div>
              <div class="dsw-testi-meta">
                <p class="dsw-testi-name">
                  Ibu Hj. Ratna Dewi (43 thn)
                  <span class="dsw-verified-pill">Verified Buyer</span>
                </p>
                <div class="dsw-stars">
                  <RatingStars rating={5} starClass="h-3.5 w-3.5 !fill-[#d97706] !text-[#d97706]" />
                </div>
              </div>
            </div>
            <p class="dsw-testi-body">"Ambil Paket Ultimate yang Toner 50ml ini karena pengen nyobain kelima produk anti-aging Numa Skin sekaligus. MasyaAllah cocok semua di kulitku! Pagi pakai PDRN + Sunscreen mukaku cerah alami, malam pakai NAD+ Serum + Adenosine bangun tidur pipi kencang banget."</p>
            <div class="dsw-testi-foot">
              <span>Surabaya</span>
              <span>•</span>
              <span>Pemakaian 6 Minggu</span>
            </div>
          </article>

          <article class="dsw-testi-card">
            <div class="dsw-testi-head">
              <div class="dsw-testi-avatar" aria-hidden="true">M</div>
              <div class="dsw-testi-meta">
                <p class="dsw-testi-name">
                  Bunda Meilani Sari (38 thn)
                  <span class="dsw-verified-pill">Verified Buyer</span>
                </p>
                <div class="dsw-stars">
                  <RatingStars rating={5} starClass="h-3.5 w-3.5 !fill-[#d97706] !text-[#d97706]" />
                </div>
              </div>
            </div>
            <p class="dsw-testi-body">"Lebih hemat hampir Rp43 ribu dibanding beli satu-satu. Urutan pakainya jelas, teksturnya nggak ada yang lengket, dan flek bekas KB di pipiku udah jauh memudar dalam sebulan lebih."</p>
            <div class="dsw-testi-foot">
              <span>Bekasi</span>
              <span>•</span>
              <span>Pemakaian 5 Minggu</span>
            </div>
          </article>
        </div>
      </section>

      <!-- Section 7: Tabel Perbandingan -->
      <section class="dsw-section--tinted">
        <h2 class="dsw-h2">
          Keunggulan <span class="dsw-hl-aqua">Paket Ultimate 5-in-1 (50ml)</span>
        </h2>
        <p class="dsw-sub" style="margin-top: 8px;">
          Mengapa memilih Paket Ultimate Anti-Aging (50ml) jauh lebih hemat dan efektif dibandingkan membeli produk satuan:
        </p>

        <div class="dsw-cmp-card">
          <div class="dsw-cmp-head">
            <div class="dsw-cmp-col">Karakteristik</div>
            <div class="dsw-cmp-col dsw-cmp-col--numa">Ultimate 50ml</div>
            <div class="dsw-cmp-col">Beli Satuan Biasa</div>
          </div>

          <div class="dsw-cmp-row">
            <div class="dsw-cmp-cell dsw-cmp-cell--feature">Kelengkapan Tahapan</div>
            <div class="dsw-cmp-cell dsw-cmp-cell--numa">
              <span class="dsw-icon-green" style="margin: 0 auto;">
                <Icon name="lucide:check" class="size-3.5" aria-hidden="true" />
              </span>
              <span class="dsw-cmp-sub">5 Produk Utuh Siang & Malam</span>
            </div>
            <div class="dsw-cmp-cell">
              <span class="dsw-icon-red" style="margin: 0 auto;">
                <Icon name="lucide:x" class="size-3.5" aria-hidden="true" />
              </span>
              <span class="dsw-cmp-sub">Perawatan setengah-setengah</span>
            </div>
          </div>

          <div class="dsw-cmp-row">
            <div class="dsw-cmp-cell dsw-cmp-cell--feature">Bahan Aktif Utama</div>
            <div class="dsw-cmp-cell dsw-cmp-cell--numa">
