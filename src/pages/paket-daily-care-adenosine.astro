---
import BaseLayout from '../layouts/BaseLayout.astro';
import GeoIpResolvedForm from '../components/storefront/forms/GeoIpResolvedForm.astro';
import MetaLandingTracker from '../components/storefront/tracking/MetaLandingTracker.astro';
import Icon from '../components/storefront/shared/Icon.astro';
import RatingStars from '../components/storefront/shared/RatingStars.astro';
import { getStorefrontProduct } from '../lib/catalog';
import { nativeLandingCanonicalPath } from '../lib/landing-pages';
import { defaultCatalogContentId } from '../lib/catalog-feed';
import { getRuntimeEnv } from '../lib/env';
import { loadStoreCodDisabledProvinceCodes } from '../lib/form-mode';
import { getStoreAdsConfig } from '../lib/store-ads';
import '../styles/form-hybrid.css';
import '../styles/landing-pages/paket-daily-care-adenosine.css';

export const prerender = false;

const PRODUCT_SLUG = 'paket-daily-care-adenosine';
const LANDING_SLUG = 'paket-daily-care-adenosine';
const PAGE_TITLE = 'Paket Daily Care Adenosine — Sabun Gel 5% Niacinamide + Pelembap Anti-Flek BPOM';
const PAGE_DESC = 'Paket perawatan harian praktis Numa Skin: Deep Sea Water Facial Wash Gel 100ml + Adenosine Deep Sea Water Moisturizer 30g untuk membersihkan wajah tanpa ketarik & merawat flek kerutan (BPOM Resmi).';
const IMG_BASE = '/images/landing/paket-daily-care-adenosine';
const HERO_IMAGE = `${IMG_BASE}/hero-paket-daily-care-adenosine.webp`;

const database = getRuntimeEnv(Astro.locals)?.OMS_DB as D1Database | undefined;
const claimedProductSlug = Astro.request.headers.get('x-adsbook-product-page');
const [product, canonicalPath, codDisabledProvinceCodes] = await Promise.all([
  getStorefrontProduct(Astro.locals, PRODUCT_SLUG),
  claimedProductSlug
    ? Promise.resolve(`/produk/${claimedProductSlug}`)
    : nativeLandingCanonicalPath(Astro.locals, LANDING_SLUG),
  loadStoreCodDisabledProvinceCodes(database),
  getStoreAdsConfig(Astro.locals),
]);
if (!product) {
  return Astro.rewrite('/404');
}

const canonical = `${Astro.locals.tenant.siteUrl}${canonicalPath}`;

const variants = product.variants || [];
const cheapestVariant = variants.reduce(
  (min: any, v: any) => (!min || v.price < min.price ? v : min),
  variants[0]
);
const defaultVariant = cheapestVariant || {
  id: '16',
  label: 'Facial Wash 100ml + Adenosine 30gr',
  price: 133000,
  comparePrice: 147998,
};
---

<BaseLayout
  title={PAGE_TITLE}
  description={PAGE_DESC}
  image={HERO_IMAGE}
  preloadImages={HERO_IMAGE}
  canonical={canonical}
  hideHeader={true}
  hideFooter={true}
>
  <MetaLandingTracker
    slug={LANDING_SLUG}
    contentId={defaultCatalogContentId(product)}
    contentName={product.contentName}
    price={defaultVariant.price}
  />

  <div class="dsw-shell">
    <main class="dsw-canvas">
      <!-- Section 1: Hero -->
      <section id="hero-section" class="dsw-hero">
        <div class="dsw-hero-head">
          <h1 class="dsw-h1">
            <span class="dsw-hl-tilt">Flek & Kerutan</span> Mengganggu Tapi Malas Pakai Skincare Berlapis-Lapis?
          </h1>
          <p class="dsw-sub" style="max-width: 390px; margin: 14px auto 0; font-weight: 700;">
            Tak perlu 7 tahap rumit untuk merawat kulit usia 30+ agar bersih dan kenyal.<br />
            <span class="dsw-underline-teal">Cukup 2 langkah Cuci & Kunci dengan Daily Care Adenosine!</span>
          </p>
        </div>

        <div class="dsw-hero-stage">
          <div class="dsw-hero-top-tag">
            <div class="dsw-hero-top-pill">
              <Icon name="lucide:sparkles" class="size-3.5" aria-hidden="true" />
              <span>Ritual Simpel 2 Langkah • Hemat Rp15.000</span>
            </div>
          </div>

          <img
            src={HERO_IMAGE}
            alt="Perbandingan wajah kusam berflek vs kulit bersih kenyal cerah dengan Paket Daily Care Adenosine Numa Skin"
            width="720"
            height="480"
            class="dsw-hero-img"
            fetchpriority="high"
            loading="eager"
            decoding="async"
          />

          <div class="dsw-hero-overlap">
            <div class="dsw-hero-overlap-inner">
              <h2 class="dsw-hero-overlap-title">Rahasia Konsisten Merawat Kulit Adalah Kesederhanaan!</h2>
              <p class="dsw-hero-overlap-text">
                Banyak wanita gagal merawat flek karena <strong style="color: #be123c;">terlalu banyak botol yang akhirnya malas dipakai atau justru merusak barrier saat cuci muka</strong>.
              </p>
            </div>
          </div>
        </div>

        <div class="dsw-trust-row">
          <div class="dsw-trust-item">
            <span class="dsw-trust-icon">
              <Icon name="lucide:shield-check" class="size-4" aria-hidden="true" />
            </span>
            <div>
              <span class="dsw-trust-label">BPOM Resmi</span>
              <span class="dsw-trust-sub">2 Izin Edar</span>
            </div>
          </div>
          <div class="dsw-trust-item">
            <span class="dsw-trust-icon">
              <Icon name="lucide:badge-check" class="size-4" aria-hidden="true" />
            </span>
            <div>
              <span class="dsw-trust-label">Halal RI</span>
              <span class="dsw-trust-sub">Aman Bumil</span>
            </div>
          </div>
          <div class="dsw-trust-item">
            <span class="dsw-trust-icon">
              <Icon name="lucide:truck" class="size-4" aria-hidden="true" />
            </span>
            <div>
              <span class="dsw-trust-label">Bisa COD</span>
              <span class="dsw-trust-sub">Bayar di Rumah</span>
            </div>
          </div>
        </div>
      </section>

      <!-- Section 2: Solusi Singkat + Visual -->
      <section class="dsw-section">
        <h2 class="dsw-h2">
          Cukup <span class="dsw-hl-aqua">2 langkah praktis</span> setiap pagi & malam
        </h2>
        <p class="dsw-sub">Bersihkan dengan lembut lalu kunci nutrisi anti-aging dan pencerah flek dalam 1 menit.</p>

        <div class="dsw-photo-stack">
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/solusi-dua-langkah-simpel.webp`}
              alt="Wanita Indonesia usia 36 tahun tersenyum memegang rangkaian simpel 2 langkah Numa Skin dengan kulit wajah cerah kenyal"
              width="648"
              height="432"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
          </div>
        </div>

        <div class="dsw-list">
          <div class="dsw-list-row">
            <span class="dsw-icon-teal">
              <Icon name="lucide:droplets" class="size-4" aria-hidden="true" />
            </span>
            <p class="dsw-list-text">
              <strong style="color: #0f172a;">Langkah 1 — Facial Wash Gel (100 ml):</strong> Mengangkat kotoran & kusam dengan 5% Pharmaceutical Niacinamide + Vitamin E tanpa membuat kulit kering ketarik.
            </p>
          </div>
          <div class="dsw-list-row">
            <span class="dsw-icon-teal">
              <Icon name="lucide:sparkles" class="size-4" aria-hidden="true" />
            </span>
            <p class="dsw-list-text">
              <strong style="color: #0f172a;">Langkah 2 — Adenosine Moisturizer (30 gr):</strong> Merawat garis halus, flek hitam, dan elastisitas pipi dengan Adenosine, Alpha-Arbutin, & 11X Hyaluronic Acid.
            </p>
          </div>
          <div class="dsw-list-row">
            <span class="dsw-icon-teal">
              <Icon name="lucide:badge-check" class="size-4" aria-hidden="true" />
            </span>
            <p class="dsw-list-text">
              <strong style="color: #0f172a;">Super Hemat Hanya Rp133.000:</strong> Dapatkan 2 produk ukuran penuh ber-BPOM (hemat Rp14.998 dari harga satuan Rp147.998).
            </p>
          </div>
        </div>
      </section>

      <!-- Section 3: Tanda Masalah Kulit + Visual Grid -->
      <section class="dsw-section dsw-section--warn">
        <h2 class="dsw-h2">
          Mengapa perawatan yang <span class="dsw-underline-warn">terlalu rumit</span> sering berujung gagal?
        </h2>

        <div class="dsw-photo-grid-2">
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/masalah-ribet-banyak-botol.webp`}
              alt="Wanita tampak lelah melihat banyak botol skincare yang menumpuk di meja rias"
              width="315"
              height="210"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <p class="dsw-photo-caption">
              <strong style="color: #be123c; display: block;">Bosan & Tidak Konsisten</strong>
              Rutinitas 6–7 langkah membuat lelah di malam hari sehingga perawatan sering terlewat.
            </p>
          </div>
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/masalah-cuci-muka-bikin-keriput.webp`}
              alt="Close-up kulit pipi yang kering, kusam, dan tampak garis halus akibat salah memilih sabun muka"
              width="315"
              height="210"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <p class="dsw-photo-caption">
              <strong style="color: #be123c; display: block;">Sabun Keras Mempercepat Keriput</strong>
              Memakai krim anti-aging percuma jika sabun cuci mukanya masih mengikis kelembapan alami.
            </p>
          </div>
        </div>

        <div class="dsw-list">
          <div class="dsw-list-row">
            <span class="dsw-icon-warn">
              <Icon name="lucide:triangle-alert" class="size-4" aria-hidden="true" />
            </span>
            <p class="dsw-list-text">
              Ingin wajah bersih cerah dan bebas kerutan, tapi <strong style="color: #be123c;">tidak punya waktu luang untuk memakai banyak tahapan skincare</strong>.
            </p>
          </div>
          <div class="dsw-list-row">
            <span class="dsw-icon-warn">
              <Icon name="lucide:triangle-alert" class="size-4" aria-hidden="true" />
            </span>
            <p class="dsw-list-text">
              Sehabis mencuci muka, <strong style="color: #be123c;">kulit terasa kering kaku sehingga garis senyum dan kerutan mata makin terlihat jelas</strong>.
            </p>
          </div>
          <div class="dsw-list-row">
            <span class="dsw-icon-warn">
              <Icon name="lucide:triangle-alert" class="size-4" aria-hidden="true" />
            </span>
            <p class="dsw-list-text">
              Khawatir anggaran membengkak jika harus <strong style="color: #be123c;">membeli banyak produk perawatan anti-aging sekaligus</strong>.
            </p>
          </div>
        </div>
      </section>

      <!-- Section 4: Perbandingan Visual Sebelum vs Sesudah -->
      <section class="dsw-section">
        <h2 class="dsw-h2">
          Perbandingan hasil <span class="dsw-hl-aqua">2 langkah yang konsisten</span>
        </h2>
        <p class="dsw-sub">Dua produk yang tepat dan dipakai teratur mengalahkan sepuluh botol yang jarang disentuh.</p>

        <div class="dsw-photo-stack">
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/kondisi-kusam-kering-sebelum-daily.webp`}
              alt="Kondisi kulit kusam, kering, dengan noda hitam samar dan garis halus sebelum perawatan rutin"
              width="648"
              height="432"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <span class="dsw-photo-badge dsw-photo-badge--before">Tanpa Perawatan Teratur</span>
            <p class="dsw-photo-caption">
              Kulit tampak lelah kusam, terasa kering sehabis cuci muka, dan bercak flek mulai menebal di pipi.
            </p>
          </div>

          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/kondisi-cerah-kenyal-daily-care.webp`}
              alt="Kondisi kulit bersih, cerah merata, dan kenyal halus setelah rutin memakai Paket Daily Care Adenosine"
              width="648"
              height="432"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <span class="dsw-photo-badge dsw-photo-badge--after">Rutin Daily Care Adenosine</span>
            <p class="dsw-photo-caption">
              Wajah terasa bersih lembap sejak bilasan pertama, lalu dikunci gel-cream dingin yang memudarkan flek dan menghaluskan kerutan.
            </p>
          </div>
        </div>
      </section>

      <!-- Section 5: Dark Marine Section — Cara Pakai Praktis -->
      <section class="dsw-section dsw-section--dark">
        <h2 class="dsw-h2">
          Urutan Pakai <span style="color: #99e2ec;">Selesai Dalam 60 Detik</span>
        </h2>
        <p class="dsw-sub">Sangat praktis untuk Bunda yang sibuk mengurus keluarga maupun bekerja.</p>

        <div class="dsw-photo-stack">
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/cara-pakai-daily-step1-wash.webp`}
              alt="Langkah 1 mencuci wajah dengan Deep Sea Water Facial Wash Gel"
              width="648"
              height="432"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <p class="dsw-photo-caption">
              <strong style="color: #ffffff;">Langkah 1 (30 Detik — Cuci Muka):</strong> Busakan sedikit gel pembersih pada wajah basah, pijat lembut, dan bilas hingga bersih segar.
            </p>
          </div>
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/cara-pakai-daily-step2-adenosine.webp`}
              alt="Langkah 2 mengoleskan Adenosine Moisturizer dengan sensasi dingin ke pipi"
              width="648"
              height="432"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <p class="dsw-photo-caption">
              <strong style="color: #ffffff;">Langkah 2 (30 Detik — Kunci Adenosine):</strong> Tekan 1–2 pump Adenosine Moisturizer, ratakan ke wajah dan leher pagi serta malam.
            </p>
          </div>
        </div>

        <div class="dsw-list">
          <div class="dsw-list-row">
            <span class="dsw-step-num">1</span>
            <p class="dsw-step-text">
              <strong style="color: #ffffff;">Pagi Hari:</strong> Cuci wajah dengan Facial Wash Gel → oleskan Adenosine Moisturizer agar kulit lembap cerah seharian.
            </p>
          </div>
          <div class="dsw-list-row">
            <span class="dsw-step-num">2</span>
            <p class="dsw-step-text">
              <strong style="color: #ffffff;">Malam Hari:</strong> Cuci wajah dari debu harian → <strong style="color: #ffffff; background: #104452; padding: 1px 6px; border-radius: 4px;">oleskan Adenosine Moisturizer</strong> untuk regenerasi saat tidur.
            </p>
          </div>
          <div class="dsw-list-row">
            <span class="dsw-step-num">3</span>
            <p class="dsw-step-text">
              Botol <em>airless pump</em> dan <em>flip-top tube</em> menjaga isi tetap higienis hingga tetes terakhir.
            </p>
          </div>
        </div>
      </section>

      <!-- Section 6: Ulasan Pelanggan -->
      <section class="dsw-section">
        <h2 class="dsw-h2">
          Alasan paket ini jadi <span class="dsw-hl-aqua">pilihan favorit pemula Numa Skin</span>
        </h2>
        <p class="dsw-sub">Harga terjangkau, cara pakai simpel, dan manfaat pencerah + anti-aging sudah lengkap.</p>

        <div class="dsw-reviews-divide">
          <div class="dsw-review-row">
            <div class="dsw-review-head">
              <div>
                <p class="dsw-review-author">
                  Ibu Nurul H.
                  <span style="color: #0b6e7d; display: inline-flex;">
                    <Icon name="lucide:badge-check" class="size-4" aria-hidden="true" />
                  </span>
                </p>
                <p class="dsw-review-meta">Bogor • Ibu Rumah Tangga 38 Tahun</p>
              </div>
              <RatingStars rating={5} starClass="h-3.5 w-3.5 !fill-[#d97706] !text-[#d97706]" />
            </div>
            <p class="dsw-review-quote">
              "Saya orangnya gak telaten pakai skincare banyak-banyak. <span class="dsw-hl-aqua">Paket 2 botol ini penyelamat banget, cuma cuci muka lanjut krim Adenosine</span> tapi muka kelihatan cerah kenyal!"
            </p>
          </div>
          <div class="dsw-review-row">
            <div class="dsw-review-head">
              <div>
                <p class="dsw-review-author">
                  Bunda Fitri A.
                  <span style="color: #0b6e7d; display: inline-flex;">
                    <Icon name="lucide:badge-check" class="size-4" aria-hidden="true" />
                  </span>
                </p>
                <p class="dsw-review-meta">Solo • Kulit Kering & Berflek</p>
              </div>
              <RatingStars rating={5} starClass="h-3.5 w-3.5 !fill-[#d97706] !text-[#d97706]" />
            </div>
            <p class="dsw-review-quote">
              "Sabunnya beneran lembut gak bikin kesat ketarik. <strong style="color: #0f172a;">Pas dilanjut pelembap Adenosine rasanya dingin adem</strong>, <span class="dsw-hl-aqua">flek tipis di pipi mulai samar dalam 3 minggu</span>."
            </p>
          </div>
          <div class="dsw-review-row">
            <div class="dsw-review-head">
              <div>
                <p class="dsw-review-author">
                  Ibu Wahyu N.
                  <span style="color: #0b6e7d; display: inline-flex;">
                    <Icon name="lucide:badge-check" class="size-4" aria-hidden="true" />
                  </span>
                </p>
                <p class="dsw-review-meta">Sidoarjo • Paket Hemat Rp133.000</p>
              </div>
              <RatingStars rating={5} starClass="h-3.5 w-3.5 !fill-[#d97706] !text-[#d97706]" />
            </div>
            <p class="dsw-review-quote">
              "Dengan harga <span class="dsw-hl-rose">133 ribu udah dapet sabun 100ml sama krim anti-aging BPOM</span>. <span class="dsw-hl-aqua">Awet sebulan lebih dan bisa bayar COD</span> di rumah."
            </p>
          </div>
        </div>
      </section>

      <!-- Section 7: Galeri Bukti Visual -->
      <section class="dsw-section dsw-section--tint">
        <h2 class="dsw-h2">
          Duet praktis untuk <span style="color: #0b6e7d;">wajah bersih & kenyal setiap hari</span>
        </h2>
        <p class="dsw-sub">Kombinasi pembersih pencerah dan pelembap anti-kerutan berbahan dasar air laut dalam.</p>

        <div class="dsw-photo-grid-2">
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/bukti-tekstur-wash-dan-adenosine.webp`}
              alt="Perbandingan tekstur gel pembersih bening dan cooling gel-cream Adenosine di tangan"
              width="315"
              height="210"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
          </div>
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/bukti-bunda-praktis-cerah.webp`}
              alt="Potret wanita berhijab tersenyum cerah dengan kulit wajah sehat dan lembap"
              width="315"
              height="210"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
          </div>
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/bukti-pipi-lembut-bebas-ketarik.webp`}
              alt="Close-up pipi yang halus, kenyal, dan bebas garis kering"
              width="315"
              height="210"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
          </div>
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/bukti-meja-rias-daily-adenosine.webp`}
              alt="Kemasan Paket Daily Care Adenosine Numa Skin di meja rias"
              width="315"
              height="210"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
          </div>
        </div>
      </section>

      <!-- Section 8: Product Knowledge (Full-Bleed Figures) -->
      <section class="dsw-section dsw-section--knowledge">
        <h2 class="dsw-h2">
          Mengapa <span class="dsw-hl-aqua">Daily Care Adenosine</span> efektif meski hanya 2 langkah?
        </h2>
        <p class="dsw-sub">
          Setiap produk memuat konsentrasi bahan aktif klinis yang bekerja ganda.
        </p>

        <div class="dsw-figure-stack">
          <figure class="dsw-figure">
            <div class="dsw-figure-bleed">
              <img
                src={`${IMG_BASE}/formulasi-daily-cleanse-communicate.webp`}
                alt="Sinergi air laut dalam Pulau Ulleung dan ekstrak alga merah Jania rubens"
                width="720"
                height="480"
                class="dsw-figure-img"
                loading="lazy"
                fetchpriority="low"
                decoding="async"
              />
            </div>
            <figcaption class="dsw-figcaption">
              <h3 class="dsw-figcaption-title">Cleanse Without Stripping + Skin Communicator™</h3>
              <p class="dsw-figcaption-desc">
                Membersihkan pori sambil menjaga pH alami, lalu langsung mengaktifkan komunikasi seluler untuk sintesis kolagen dan elastin.
              </p>
            </figcaption>
          </figure>
          <figure class="dsw-figure">
            <div class="dsw-figure-bleed">
              <img
                src={`${IMG_BASE}/kandungan-5niacinamide-adenosine-11ha.webp`}
                alt="Kombinasi 5% Niacinamide, Adenosine, Alpha-Arbutin, dan 11X Hyaluronic Acid"
                width="720"
                height="480"
                class="dsw-figure-img"
                loading="lazy"
                fetchpriority="low"
                decoding="async"
              />
            </div>
            <figcaption class="dsw-figcaption">
              <h3 class="dsw-figcaption-title">5% Niacinamide + Adenosine + Alpha-Arbutin + 11X HA</h3>
              <p class="dsw-figcaption-desc">
                Mencerahkan kusam dari dua arah (Niacinamide di pembersih + Alpha-Arbutin di pelembap) sambil mengisi 5 lapisan hidrasi kulit.
              </p>
            </figcaption>
          </figure>
          <figure class="dsw-figure">
            <div class="dsw-figure-bleed">
              <img
                src={`${IMG_BASE}/kemasan-daily-care-adenosine.webp`}
                alt="Kemasan resmi Paket Daily Care Adenosine: Facial Wash Gel 100ml dan Adenosine Moisturizer 30gr"
                width="720"
                height="480"
                class="dsw-figure-img"
                loading="lazy"
                fetchpriority="low"
                decoding="async"
              />
            </div>
            <figcaption class="dsw-figcaption">
