---
import BaseLayout from '../layouts/BaseLayout.astro';
import GeoIpResolvedForm from '../components/storefront/forms/GeoIpResolvedForm.astro';
import MetaLandingTracker from '../components/storefront/tracking/MetaLandingTracker.astro';
import Icon from '../components/storefront/shared/Icon.astro';
import RatingStars from '../components/storefront/shared/RatingStars.astro';
import { getStorefrontProduct } from '../lib/catalog';
import { nativeLandingCanonicalPath } from '../lib/landing-pages';
import { defaultCatalogContentId } from '../lib/catalog-feed';
import { getRuntimeEnv } from '../lib/env';
import { loadStoreCodDisabledProvinceCodes } from '../lib/form-mode';
import { getStoreAdsConfig } from '../lib/store-ads';
import '../styles/form-hybrid.css';
import '../styles/landing-pages/paket-sunscreen-adenosine-toner-50ml.css';

export const prerender = false;

const PRODUCT_SLUG = 'paket-sunscreen-adenosine-toner-50ml';
const LANDING_SLUG = 'paket-sunscreen-adenosine-toner-50ml';
const PAGE_TITLE = 'Paket Sunscreen, Adenosine & Toner 50ml - Trio Anti-Flek, Hidrasi & UV BPOM';
const PAGE_DESC = 'Rangkaian 3 langkah anti-aging & perisai UV praktis: Deep Sea Water Treatment Lotion 50ml (NA18220101400), Adenosine Moisturizer 30gr (NA18250109281), dan Oxydew Sunscreen SPF 50+ 30ml (NA18251703709).';
const IMG_BASE = '/images/landing/paket-sunscreen-adenosine-toner-50ml';
const HERO_IMAGE = `${IMG_BASE}/hero-paket-sunscreen-adenosine-toner-50ml.webp`;

const database = getRuntimeEnv(Astro.locals)?.OMS_DB as D1Database | undefined;
const claimedProductSlug = Astro.request.headers.get('x-adsbook-product-page');
const [product, canonicalPath, codDisabledProvinceCodes] = await Promise.all([
  getStorefrontProduct(Astro.locals, PRODUCT_SLUG),
  claimedProductSlug
    ? Promise.resolve(`/produk/${claimedProductSlug}`)
    : nativeLandingCanonicalPath(Astro.locals, LANDING_SLUG),
  loadStoreCodDisabledProvinceCodes(database),
  getStoreAdsConfig(Astro.locals),
]);
if (!product) {
  return Astro.rewrite('/404');
}

const canonical = `${Astro.locals.tenant.siteUrl}${canonicalPath}`;

const variants = product.variants || [];
const cheapestVariant = variants.reduce(
  (min: any, v: any) => (!min || v.price < min.price ? v : min),
  variants[0]
);
const defaultVariant = cheapestVariant || {
  id: '41',
  label: 'Toner 50ml + Adenosine 30gr + Sunscreen 30ml',
  price: 213000,
  comparePrice: 236999,
};
---

<BaseLayout
  title={PAGE_TITLE}
  description={PAGE_DESC}
  image={HERO_IMAGE}
  preloadImages={HERO_IMAGE}
  canonical={canonical}
  hideHeader={true}
  hideFooter={true}
>
  <MetaLandingTracker
    slug={LANDING_SLUG}
    contentId={defaultCatalogContentId(product)}
    contentName={product.contentName}
    price={defaultVariant.price}
  />

  <div class="dsw-shell">
    <main class="dsw-canvas">
      <!-- Section 1: Hero -->
      <section id="hero-section" class="dsw-hero">
        <div class="dsw-hero-head">
          <h1 class="dsw-h1">
            <span class="dsw-hl-tilt">Flek Hitam Kambuh Lagi</span> Karena Kulit Kering Kena Panas Siang?
          </h1>
          <p class="dsw-sub" style="max-width: 390px; margin: 14px auto 0; font-weight: 700;">
            Merawat flek dan garis halus membutuhkan kompres hidrasi, kunci Adenosine, serta perisai UV SPF 50+ setiap pagi.<br />
            <span class="dsw-underline-teal">Putus siklus flek & dehidrasi dengan Paket Trio 50ml!</span>
          </p>
        </div>

        <div class="dsw-hero-stage">
          <div class="dsw-hero-top-tag">
            <div class="dsw-hero-top-pill">
              <Icon name="lucide:award" class="size-3.5" aria-hidden="true" />
              <span>Trio Anti-Flek & UV 50ml • Hemat Rp24rb</span>
            </div>
          </div>

          <img
            src={HERO_IMAGE}
            alt="Perbandingan wajah berflek kering vs kulit kenyal terlindungi dengan Paket Sunscreen Adenosine dan Toner 50ml Numa Skin"
            width="720"
            height="480"
            class="dsw-hero-img"
            fetchpriority="high"
            loading="eager"
            decoding="async"
          />

          <div class="dsw-hero-ba" aria-hidden="true">
            <span class="dsw-hero-ba-pill dsw-hero-ba-pill--before">Flek & Kering UV</span>
            <span class="dsw-hero-ba-pill dsw-hero-ba-pill--after">Kenyal & Terlindungi</span>
          </div>

          <div class="dsw-hero-trust-strip" role="list" aria-label="Jaminan kualitas Numa Skin">
            <div class="dsw-trust-item" role="listitem">
              <span class="dsw-trust-icon">
                <Icon name="lucide:shield-check" class="size-3.5" aria-hidden="true" />
              </span>
              <span class="dsw-trust-text">
                <strong class="dsw-trust-label">3 BPOM Resmi</strong>
                <span class="dsw-trust-sub">Toner, Krim & SPF</span>
              </span>
            </div>
            <div class="dsw-trust-item" role="listitem">
              <span class="dsw-trust-icon">
                <Icon name="lucide:droplets" class="size-3.5" aria-hidden="true" />
              </span>
              <span class="dsw-trust-text">
                <strong class="dsw-trust-label">Adenosine + 11X HA</strong>
                <span class="dsw-trust-sub">Skin Communicator™</span>
              </span>
            </div>
            <div class="dsw-trust-item" role="listitem">
              <span class="dsw-trust-icon">
                <Icon name="lucide:layers" class="size-3.5" aria-hidden="true" />
              </span>
              <span class="dsw-trust-text">
                <strong class="dsw-trust-label">SPF 50+ PA++++</strong>
                <span class="dsw-trust-sub">3% Luceane™</span>
              </span>
            </div>
          </div>
        </div>

        <div class="dsw-hero-foot">
          <p class="dsw-hero-caption">
            Trio harian paling pas: <strong>Treatment Lotion 50ml</strong> + <strong>Adenosine Moisturizer 30gr</strong> + <strong>Oxydew Sunscreen SPF 50+ PA++++ 30ml</strong>.
          </p>
          <a href="#form-pemesanan" class="dsw-cta" data-scroll-to-form>
            <span>Ambil Paket Trio 50ml Ini</span>
            <Icon name="lucide:arrow-right" class="size-5" aria-hidden="true" />
          </a>
        </div>
      </section>

      <!-- Section 2: Solusi Praktis -->
      <section class="dsw-section">
        <h2 class="dsw-h2">
          3 Langkah Harian <span class="dsw-hl-aqua">Hidrasi, Samarkan Flek & Perisai UV</span>
        </h2>
        <p class="dsw-sub" style="margin-top: 8px;">
          Fondasi 3 produk yang bekerja 24 jam menjaga kulit tetap kenyal dan bebas flek matahari:
        </p>

        <div class="dsw-solution-box">
          <img
            src={`${IMG_BASE}/solusi-tiga-langkah-anti-flek-uv-50ml.webp`}
            alt="Wanita Indonesia dengan kulit wajah kenyal dan terlindungi memakai Paket Trio 50ml Numa Skin"
            width="648"
            height="432"
            class="dsw-solution-img"
            loading="lazy"
            fetchpriority="low"
            decoding="async"
          />

          <div class="dsw-check-list">
            <div class="dsw-check-item">
              <span class="dsw-icon-green">
                <Icon name="lucide:check" class="size-3.5" aria-hidden="true" />
              </span>
              <p class="dsw-list-text"><strong>Tahap 1 — Treatment Lotion 50ml:</strong> 76% Air Laut Dalam Ulleungdo, Galactomyces, dan 5X Ceramide membuka jalur hidrasi di pori.</p>
            </div>
            <div class="dsw-check-item">
              <span class="dsw-icon-green">
                <Icon name="lucide:check" class="size-3.5" aria-hidden="true" />
              </span>
              <p class="dsw-list-text"><strong>Tahap 2 — Adenosine Moisturizer 30gr:</strong> Cooling gel-cream dengan Adenosine, Jania Rubens, dan 11X Hyaluronic Acid untuk merawat garis halus serta noda hitam.</p>
            </div>
            <div class="dsw-check-item">
              <span class="dsw-icon-green">
                <Icon name="lucide:check" class="size-3.5" aria-hidden="true" />
              </span>
              <p class="dsw-list-text"><strong>Tahap 3 Pagi — Oxydew Sunscreen SPF 50+ PA++++ 30ml:</strong> Perisai UV dengan 3% Luceane™ yang menangkal sinar matahari penyebab flek kambuh tanpa whitecast.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- Section 3: Masalah Kulit -->
      <section class="dsw-section--tinted">
        <h2 class="dsw-h2">
          Kenapa Flek & Garis Halus <span class="dsw-hl-coral">Sulit Memudar?</span>
        </h2>

        <div class="dsw-grid-2">
          <article class="dsw-card">
            <img
              src={`${IMG_BASE}/masalah-flek-kambuh-tanpa-proteksi-50ml.webp`}
              alt="Kulit wajah kembali menggelap karena terpapar matahari tanpa perlindungan lengkap"
              width="480"
              height="320"
              class="dsw-card-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <div class="dsw-card-body">
              <span class="dsw-badge-red">Bocor Terpapar Matahari</span>
              <p class="dsw-card-desc">Tanpa tabir surya SPF 50+ PA++++ di pagi hari, sinar UV langsung memicu produksi melanin gelap kembali di tulang pipi.</p>
            </div>
          </article>

          <article class="dsw-card">
            <img
              src={`${IMG_BASE}/masalah-kulit-kering-kerutan-uv-50ml.webp`}
              alt="Tekstur kulit kering dengan garis halus di sekitar mata dan pipi"
              width="480"
              height="320"
              class="dsw-card-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <div class="dsw-card-body">
              <span class="dsw-badge-red">Dehidrasi Memperjelas Kerut</span>
              <p class="dsw-card-desc">Kulit yang kekurangan cairan di lapisan epidermis membuat garis senyum dan kerutan halus tampak semakin dalam.</p>
            </div>
          </article>
        </div>

        <div class="dsw-list-box">
          <p class="dsw-list-box-title">Tanda Anda Membutuhkan Paket Ini:</p>
          <div class="dsw-check-list" style="margin-top: 0;">
            <div class="dsw-check-item">
              <span class="dsw-icon-red">
                <Icon name="lucide:x" class="size-3.5" aria-hidden="true" />
              </span>
              <p class="dsw-list-text">Membutuhkan 1 paket ringkas yang sudah mencakup Toner, Pelembap Anti-Aging, dan Sunscreen SPF 50+ sekaligus</p>
            </div>
            <div class="dsw-check-item">
              <span class="dsw-icon-red">
                <Icon name="lucide:x" class="size-3.5" aria-hidden="true" />
              </span>
              <p class="dsw-list-text">Ingin merawat flek hitam dan garis halus tanpa rasa lengket atau whitecast abu-abu di siang hari</p>
            </div>
            <div class="dsw-check-item">
              <span class="dsw-icon-red">
                <Icon name="lucide:x" class="size-3.5" aria-hidden="true" />
              </span>
              <p class="dsw-list-text">Mencari versi Toner 50ml yang lebih ekonomis (Rp213.000, hemat Rp24.000) dan praktis dibawa bepergian</p>
            </div>
          </div>
        </div>
      </section>

      <!-- Section 4: Transformasi Nyata -->
      <section class="dsw-section">
        <h2 class="dsw-h2">
          Transformasi <span class="dsw-hl-aqua">Kulit Membal, Cerah & Terlindungi</span>
        </h2>
        <p class="dsw-sub" style="margin-top: 8px;">
          Perbedaan kondisi kulit sebelum dan sesudah rutin memakai Paket Sunscreen, Adenosine & Toner 50ml:
        </p>

        <div class="dsw-grid-2">
          <article class="dsw-card">
            <img
              src={`${IMG_BASE}/kondisi-flek-dehidrasi-terbakar-uv-50ml.webp`}
              alt="Kondisi kulit kering dehidrasi dengan bintik flek hitam dan kemerahan UV"
              width="480"
              height="320"
              class="dsw-card-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <div class="dsw-card-body">
              <span class="dsw-badge-red">Sebelum Perawatan</span>
              <p class="dsw-card-desc">Wajah terasa kering ketarik, bintik kecokelatan tampak tegas di pipi, dan garis dehidrasi terlihat jelas.</p>
            </div>
          </article>

          <article class="dsw-card">
            <img
              src={`${IMG_BASE}/kondisi-kenyal-cerah-terlindungi-24jam-50ml.webp`}
              alt="Kondisi kulit tampak kenyal, lembap merata, dan cerah terlindungi"
              width="480"
              height="320"
              class="dsw-card-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <div class="dsw-card-body">
              <span class="dsw-badge-green">Rutin Trio 50ml</span>
              <p class="dsw-card-desc">Tekstur pipi terasa sejuk membal, tampilan noda hitam tampak lebih samar, dan wajah terlindungi nyaman.</p>
            </div>
          </article>
        </div>

        <div class="dsw-list-box">
          <p class="dsw-list-box-title">Tahapan Hasil Pemakaian Rutin:</p>
          <div class="dsw-check-list" style="margin-top: 0;">
            <div class="dsw-check-item">
              <span class="dsw-icon-green">
                <Icon name="lucide:check" class="size-3.5" aria-hidden="true" />
              </span>
              <p class="dsw-list-text"><strong>Minggu 1:</strong> Kulit langsung terasa lembap adem, Adenosine meresap cepat, dan Oxydew menyatu bening</p>
            </div>
            <div class="dsw-check-item">
              <span class="dsw-icon-green">
                <Icon name="lucide:check" class="size-3.5" aria-hidden="true" />
              </span>
              <p class="dsw-list-text"><strong>Minggu 2–3:</strong> Garis halus akibat kekeringan tampak lebih halus dan wajah tidak kusam saat siang hari</p>
            </div>
            <div class="dsw-check-item">
              <span class="dsw-icon-green">
                <Icon name="lucide:check" class="size-3.5" aria-hidden="true" />
              </span>
              <p class="dsw-list-text"><strong>Minggu 4–6:</strong> Tampilan flek hitam tampak memudar bertahap dan elastisitas kulit terjaga</p>
            </div>
          </div>
        </div>
      </section>

      <!-- Section 5: Cara Pakai -->
      <section class="dsw-section--tinted">
        <h2 class="dsw-h2">
          Cara Pakai <span class="dsw-hl-aqua">Praktis Setiap Hari</span>
        </h2>
        <p class="dsw-sub" style="margin-top: 8px;">
          Urutan pemakaian pagi dan malam setelah mencuci wajah:
        </p>

        <div class="dsw-grid-2">
          <article class="dsw-card">
            <img
              src={`${IMG_BASE}/cara-pakai-trio-50ml-step1-toner-adenosine.webp`}
              alt="Menepukkan Treatment Lotion 50ml lalu mengoleskan Adenosine Moisturizer 30gr"
              width="480"
              height="320"
              class="dsw-card-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <div class="dsw-card-body">
              <span class="dsw-badge-teal">1. Toner 50ml + Adenosine (Pagi/Malam)</span>
              <p class="dsw-card-desc">Tepuk <strong>Treatment Lotion 50ml</strong> ke seluruh wajah, lalu kunci kelembapannya dengan <strong>Adenosine Moisturizer 30gr</strong>.</p>
            </div>
          </article>

          <article class="dsw-card">
            <img
              src={`${IMG_BASE}/cara-pakai-trio-50ml-step2-sunscreen.webp`}
              alt="Mengoleskan 2 ruas jari Oxydew Sunscreen SPF 50+ PA++++ di pagi hari"
              width="480"
              height="320"
              class="dsw-card-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <div class="dsw-card-body">
              <span class="dsw-badge-teal">2. Kunci SPF 50+ (Khusus Pagi)</span>
              <p class="dsw-card-desc">Setiap pagi, ratakan 2 ruas jari <strong>Oxydew Sunscreen SPF 50+ PA++++</strong> ke seluruh wajah dan leher.</p>
            </div>
          </article>
        </div>

        <div style="margin-top: 22px; text-align: center;">
          <a href="#form-pemesanan" class="dsw-cta" data-scroll-to-form>
            <span>Pesan Paket Trio 50ml Sekarang</span>
            <Icon name="lucide:arrow-right" class="size-5" aria-hidden="true" />
          </a>
        </div>
      </section>

      <!-- Section 6: Bukti Pelanggan -->
      <section class="dsw-section">
        <h2 class="dsw-h2">
          Bukti Tekstur <span class="dsw-hl-aqua">& Kepuasan Pelanggan</span>
        </h2>
        <p class="dsw-sub" style="margin-top: 8px;">
          Pengalaman pelanggan yang rutin memakai Paket Sunscreen, Adenosine & Toner 50ml:
        </p>

        <div class="dsw-grid-2">
          <div class="dsw-proof-cell">
            <img
              src={`${IMG_BASE}/bukti-tekstur-trio-sat-50ml.webp`}
              alt="Swatch 3 tekstur Treatment Lotion, Adenosine Gel-Cream, dan Oxydew Sunscreen di tangan"
              width="480"
              height="320"
              class="dsw-proof-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <p class="dsw-proof-OverlayCaption">3 Tekstur Ringan Bebas Lengket</p>
          </div>
          <div class="dsw-proof-cell">
            <img
              src={`${IMG_BASE}/bukti-bunda-37an-bebas-flek-uv-50ml.webp`}
              alt="Wanita Indonesia usia 37 tahun berhijab dengan kulit cerah dan kenyal"
              width="480"
              height="320"
              class="dsw-proof-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <p class="dsw-proof-OverlayCaption">Nyaman Dipakai Aktivitas Harian</p>
          </div>
          <div class="dsw-proof-cell">
            <img
              src={`${IMG_BASE}/bukti-kulit-membal-segar-sore-50ml.webp`}
              alt="Close-up pipi kenyal dan halus tanpa whitecast"
              width="480"
              height="320"
              class="dsw-proof-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <p class="dsw-proof-OverlayCaption">Kenyal Seharian Tanpa Whitecast</p>
          </div>
          <div class="dsw-proof-cell">
            <img
              src={`${IMG_BASE}/bukti-meja-rias-sunscreen-adenosine-toner-50ml.webp`}
              alt="Ketiga produk Paket Sunscreen Adenosine dan Toner 50ml di meja rias"
              width="480"
              height="320"
              class="dsw-proof-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <p class="dsw-proof-OverlayCaption">Trio Praktis Hemat Rp24.000</p>
          </div>
        </div>

        <div class="dsw-testi-list">
          <article class="dsw-testi-card">
            <div class="dsw-testi-head">
              <div class="dsw-testi-avatar" aria-hidden="true">R</div>
              <div class="dsw-testi-meta">
                <p class="dsw-testi-name">
                  Bunda Ratih Wulandari (37 thn)
                  <span class="dsw-verified-pill">Verified Buyer</span>
                </p>
                <div class="dsw-stars">
                  <RatingStars rating={5} starClass="h-3.5 w-3.5 !fill-[#d97706] !text-[#d97706]" />
                </div>
              </div>
            </div>
            <p class="dsw-testi-body">"Paket Trio yang Toner 50ml ini pas banget buat pemula yang mau coba rangkaian anti-flek Numa Skin. Ketiganya ringan banget di kulit, dipakai bertumpuk pagi hari nggak bikin gerah dan flek di pipiku berangsur memudar."</p>
            <div class="dsw-testi-foot">
              <span>Tangerang</span>
              <span>•</span>
              <span>Pemakaian 4 Minggu</span>
            </div>
          </article>

          <article class="dsw-testi-card">
            <div class="dsw-testi-head">
              <div class="dsw-testi-avatar" aria-hidden="true">N</div>
              <div class="dsw-testi-meta">
                <p class="dsw-testi-name">
                  Ibu Nurul Hidayah (40 thn)
                  <span class="dsw-verified-pill">Verified Buyer</span>
                </p>
                <div class="dsw-stars">
                  <RatingStars rating={5} starClass="h-3.5 w-3.5 !fill-[#d97706] !text-[#d97706]" />
                </div>
              </div>
            </div>
            <p class="dsw-testi-body">"Suka banget karena udah dapet Toner, Adenosine Moisturizer, sama Sunscreen SPF 50+ cuma Rp213.000. Kulitku yang tadinya kering dan gampang merah kena matahari sekarang jauh lebih kenyal."</p>
            <div class="dsw-testi-foot">
              <span>Yogyakarta</span>
              <span>•</span>
              <span>Pemakaian 5 Minggu</span>
            </div>
          </article>
        </div>
      </section>

      <!-- Section 7: Tabel Perbandingan -->
      <section class="dsw-section--tinted">
        <h2 class="dsw-h2">
          Keunggulan <span class="dsw-hl-aqua">Paket Trio 50ml</span>
        </h2>
        <p class="dsw-sub" style="margin-top: 8px;">
          Mengapa memilih Paket Sunscreen, Adenosine & Toner (50ml) jauh lebih hemat dan efektif dibandingkan membeli produk satuan:
        </p>

        <div class="dsw-cmp-card">
          <div class="dsw-cmp-head">
            <div class="dsw-cmp-col">Karakteristik</div>
            <div class="dsw-cmp-col dsw-cmp-col--numa">Trio 50ml</div>
            <div class="dsw-cmp-col">Beli Satuan Biasa</div>
          </div>

          <div class="dsw-cmp-row">
            <div class="dsw-cmp-cell dsw-cmp-cell--feature">Kelengkapan Dasar</div>
            <div class="dsw-cmp-cell dsw-cmp-cell--numa">
              <span class="dsw-icon-green" style="margin: 0 auto;">
                <Icon name="lucide:check" class="size-3.5" aria-hidden="true" />
              </span>
              <span class="dsw-cmp-sub">Toner + Krim Adenosine + SPF 50+</span>
            </div>
            <div class="dsw-cmp-cell">
              <span class="dsw-icon-red" style="margin: 0 auto;">
                <Icon name="lucide:x" class="size-3.5" aria-hidden="true" />
              </span>
              <span class="dsw-cmp-sub">Perawatan tidak lengkap</span>
            </div>
          </div>

          <div class="dsw-cmp-row">
            <div class="dsw-cmp-cell dsw-cmp-cell--feature">Teknologi Anti-Aging</div>
            <div class="dsw-cmp-cell dsw-cmp-cell--numa">
              <span class="dsw-icon-green" style="margin: 0 auto;">
