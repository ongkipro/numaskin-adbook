  <script is:inline>
    (function () {
      var sticky = document.getElementById('floating-cta');
      var hero = document.getElementById('hero-section');
      var formSection = document.getElementById('form-pemesanan');

      document.querySelectorAll('[data-scroll-to-form]').forEach(function (link) {
        link.addEventListener('click', function (ev) {
          if (!formSection) return;
          ev.preventDefault();
          formSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
          setTimeout(function () {
            var firstInput = formSection.querySelector('input[name="name"], input[type="text"]');
            if (firstInput && typeof firstInput.focus === 'function') {
              firstInput.focus({ preventScroll: true });
            }
          }, 480);
        });
      });

      if (!sticky || !hero || !formSection || !('IntersectionObserver' in window)) return;

      var heroVisible = true;
      var formVisible = false;

      function syncSticky() {
        if (!heroVisible && !formVisible) {
          sticky.classList.add('is-visible');
        } else {
          sticky.classList.remove('is-visible');
        }
      }

      var observer = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (entry) {
            if (entry.target === hero) {
              heroVisible = entry.isIntersecting;
            } else if (entry.target === formSection) {
              formVisible = entry.isIntersecting;
            }
          });
          syncSticky();
        },
        { threshold: 0.08 }
      );

      observer.observe(hero);
      observer.observe(formSection);
    })();
  </script>
