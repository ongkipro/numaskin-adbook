---
import BaseLayout from '../layouts/BaseLayout.astro';
import GeoIpResolvedForm from '../components/storefront/forms/GeoIpResolvedForm.astro';
import MetaLandingTracker from '../components/storefront/tracking/MetaLandingTracker.astro';
import Icon from '../components/storefront/shared/Icon.astro';
import RatingStars from '../components/storefront/shared/RatingStars.astro';
import { getStorefrontProduct } from '../lib/catalog';
import { nativeLandingCanonicalPath } from '../lib/landing-pages';
import { defaultCatalogContentId } from '../lib/catalog-feed';
import { getRuntimeEnv } from '../lib/env';
import { loadStoreCodDisabledProvinceCodes } from '../lib/form-mode';
import { getStoreAdsConfig } from '../lib/store-ads';
import '../styles/form-hybrid.css';
import '../styles/landing-pages/paket-skin-recharge-duo-150ml.css';

export const prerender = false;

const PRODUCT_SLUG = 'paket-skin-recharge-duo-150ml';
const LANDING_SLUG = 'paket-skin-recharge-duo-150ml';
const PAGE_TITLE = 'Paket Skin Recharge Duo (150ml) — Toner Laut Dalam & NAD+ Booster Serum BPOM';
const PAGE_DESC = 'Kembalikan vitalitas kulit lelah dengan Deep Sea Water Treatment Lotion 150ml (NA18220101400) dan NAD+ Booster Anti-Aging Serum 20ml (NA18262000245) dari Numa Skin.';
const IMG_BASE = '/images/landing/paket-skin-recharge-duo-150ml';
const HERO_IMAGE = `${IMG_BASE}/hero-paket-skin-recharge-150ml.webp`;

const database = getRuntimeEnv(Astro.locals)?.OMS_DB as D1Database | undefined;
const claimedProductSlug = Astro.request.headers.get('x-adsbook-product-page');
const [product, canonicalPath, codDisabledProvinceCodes] = await Promise.all([
  getStorefrontProduct(Astro.locals, PRODUCT_SLUG),
  claimedProductSlug
    ? Promise.resolve(`/produk/${claimedProductSlug}`)
    : nativeLandingCanonicalPath(Astro.locals, LANDING_SLUG),
  loadStoreCodDisabledProvinceCodes(database),
  getStoreAdsConfig(Astro.locals),
]);
if (!product) {
  return Astro.rewrite('/404');
}

const canonical = `${Astro.locals.tenant.siteUrl}${canonicalPath}`;

const variants = product.variants || [];
const cheapestVariant = variants.reduce(
  (min: any, v: any) => (!min || v.price < min.price ? v : min),
  variants[0]
);
const defaultVariant = cheapestVariant || {
  id: '38',
  label: 'Toner 150ml + NAD+ Serum 20ml',
  price: 196000,
  comparePrice: 217999,
};
---

<BaseLayout
  title={PAGE_TITLE}
  description={PAGE_DESC}
  image={HERO_IMAGE}
  preloadImages={HERO_IMAGE}
  canonical={canonical}
  hideHeader={true}
  hideFooter={true}
>
  <MetaLandingTracker
    slug={LANDING_SLUG}
    contentId={defaultCatalogContentId(product)}
    contentName={product.contentName}
    price={defaultVariant.price}
  />

  <div class="dsw-shell">
    <main class="dsw-canvas">
      <!-- Section 1: Hero -->
      <section id="hero-section" class="dsw-hero">
        <div class="dsw-hero-head">
          <h1 class="dsw-h1">
            <span class="dsw-hl-tilt">Wajah Lelah & Kendur</span> Meski Sudah Pakai Serum Anti-Aging?
          </h1>
          <p class="dsw-sub" style="max-width: 390px; margin: 14px auto 0; font-weight: 700;">
            Molekul peptida serum anti-aging membutuhkan pori yang basah terhidrasi agar terserap hingga ke lapisan dalam.<br />
            <span class="dsw-underline-teal">Bangkitkan energi sel kulit dengan Paket Skin Recharge Duo 150ml!</span>
          </p>
        </div>

        <div class="dsw-hero-stage">
          <div class="dsw-hero-top-tag">
            <div class="dsw-hero-top-pill">
              <Icon name="lucide:sparkles" class="size-3.5" aria-hidden="true" />
              <span>Duo Booster Energi 150ml • Hemat Rp22.000</span>
            </div>
          </div>

          <img
            src={HERO_IMAGE}
            alt="Perbandingan wajah lelah kendur vs kulit kencang segar berenergi dengan Paket Skin Recharge Duo 150ml Numa Skin"
            width="720"
            height="480"
            class="dsw-hero-img"
            fetchpriority="high"
            loading="eager"
            decoding="async"
          />

          <div class="dsw-hero-ba" aria-hidden="true">
            <span class="dsw-hero-ba-pill dsw-hero-ba-pill--before">Lelah & Kendur</span>
            <span class="dsw-hero-ba-pill dsw-hero-ba-pill--after">Segar & Kencang</span>
          </div>

          <div class="dsw-hero-trust-strip" role="list" aria-label="Jaminan kualitas Numa Skin">
            <div class="dsw-trust-item" role="listitem">
              <span class="dsw-trust-icon">
                <Icon name="lucide:shield-check" class="size-3.5" aria-hidden="true" />
              </span>
              <span class="dsw-trust-text">
                <strong class="dsw-trust-label">2 BPOM Resmi</strong>
                <span class="dsw-trust-sub">Lotion & NAD+ Serum</span>
              </span>
            </div>
            <div class="dsw-trust-item" role="listitem">
              <span class="dsw-trust-icon">
                <Icon name="lucide:droplets" class="size-3.5" aria-hidden="true" />
              </span>
              <span class="dsw-trust-text">
                <strong class="dsw-trust-label">2% RejuveNAD™</strong>
                <span class="dsw-trust-sub">+ 6X Peptide</span>
              </span>
            </div>
            <div class="dsw-trust-item" role="listitem">
              <span class="dsw-trust-icon">
                <Icon name="lucide:award" class="size-3.5" aria-hidden="true" />
              </span>
              <span class="dsw-trust-text">
                <strong class="dsw-trust-label">Halal ID</strong>
                <span class="dsw-trust-sub">Non-Retinol</span>
              </span>
            </div>
          </div>
        </div>

        <div class="dsw-hero-foot">
          <p class="dsw-hero-caption">
            Paduan <strong>Deep Sea Water Treatment Lotion 150ml</strong> & <strong>NAD+ Booster Anti-Aging Serum</strong> untuk menyegarkan kulit lelah dan merawat garis senyum.
          </p>
          <a href="#form-pemesanan" class="dsw-cta" data-scroll-to-form>
            <span>Ambil Paket Skin Recharge 150ml</span>
            <Icon name="lucide:arrow-right" class="size-5" aria-hidden="true" />
          </a>
        </div>
      </section>

      <!-- Section 2: Solusi Praktis -->
      <section class="dsw-section">
        <h2 class="dsw-h2">
          Sinergi <span class="dsw-hl-aqua">First Essence & NAD+</span>
        </h2>
        <p class="dsw-sub" style="margin-top: 8px;">
          Kombinasi pre-serum mineral laut dalam dan booster energi seluler Swiss untuk wajah yang kembali segar dan padat:
        </p>

        <div class="dsw-solution-box">
          <img
            src={`${IMG_BASE}/solusi-toner-pembuka-serum-nad.webp`}
            alt="Wanita Indonesia mengaplikasikan NAD+ Booster Serum setelah Treatment Lotion 150ml"
            width="648"
            height="432"
            class="dsw-solution-img"
            loading="lazy"
            fetchpriority="low"
            decoding="async"
          />

          <div class="dsw-check-list">
            <div class="dsw-check-item">
              <span class="dsw-icon-green">
                <Icon name="lucide:check" class="size-3.5" aria-hidden="true" />
              </span>
              <p class="dsw-list-text">
                <strong>Tahap 1 — Treatment Lotion 150ml (Pre-Serum Booster):</strong> Air Laut Dalam Pulau Ulleung, Galactomyces, dan Hyaluronic Acid membasahi jalur pori sehingga serum terserap jauh lebih merata.
              </p>
            </div>
            <div class="dsw-check-item">
              <span class="dsw-icon-green">
                <Icon name="lucide:check" class="size-3.5" aria-hidden="true" />
              </span>
              <p class="dsw-list-text">
                <strong>Tahap 2 — NAD+ Booster Anti-Aging Serum:</strong> Diformulasikan dengan 2% RejuveNAD™ (Mibelle Biochemistry Swiss) dan 6X Biomimetic Peptide untuk merawat kekencangan pipi serta menyamarkan kerutan halus.
              </p>
            </div>
            <div class="dsw-check-item">
              <span class="dsw-icon-green">
                <Icon name="lucide:check" class="size-3.5" aria-hidden="true" />
              </span>
              <p class="dsw-list-text">
                <strong>Nyaman Tanpa Rasa Perih:</strong> Bebas retinol keras maupun pengelupasan ekstrem, dilengkapi 4X Cica Complex yang ramah untuk pemakaian pagi dan malam.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- Section 3: Masalah Kulit -->
      <section class="dsw-section--tinted">
        <h2 class="dsw-h2">
          Kenapa Wajah Usia 35+ <span class="dsw-hl-coral">Tampak Lelah & Turun?</span>
        </h2>

        <div class="dsw-grid-2">
          <article class="dsw-card">
            <img
              src={`${IMG_BASE}/masalah-serum-tidak-meresap-kering.webp`}
              alt="Kulit kering membuat serum anti-aging sulit meresap optimal"
              width="480"
              height="320"
              class="dsw-card-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <div class="dsw-card-body">
              <span class="dsw-badge-red">Penyerapan Terhambat</span>
              <p class="dsw-card-desc">
                Tanpa first essence pembuka pori, cairan serum hanya mengendap di permukaan kulit yang kering dan cepat menguap.
              </p>
            </div>
          </article>

          <article class="dsw-card">
            <img
              src={`${IMG_BASE}/masalah-garis-senyum-pipi-turun.webp`}
              alt="Garis senyum dalam dan kontur pipi menurun akibat penurunan energi sel"
              width="480"
              height="320"
              class="dsw-card-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <div class="dsw-card-body">
              <span class="dsw-badge-red">Energi Sel Menurun</span>
              <p class="dsw-card-desc">
                Memasuki usia 35–50 tahun, cadangan koenzim NAD+ alami kulit menyusut drastis sehingga jaringan kolagen kehilangan daya pegasnya.
              </p>
            </div>
          </article>
        </div>

        <div class="dsw-list-box">
          <p class="dsw-list-box-title">Tanda Kulit Anda Butuh Skin Recharge Duo:</p>
          <div class="dsw-check-list" style="margin-top: 0;">
            <div class="dsw-check-item">
              <span class="dsw-icon-red">
                <Icon name="lucide:x" class="size-3.5" aria-hidden="true" />
              </span>
              <p class="dsw-list-text">
                Wajah terlihat sayu, kusam, dan kurang segar meski sudah tidur cukup di malam hari
              </p>
            </div>
            <div class="dsw-check-item">
              <span class="dsw-icon-red">
                <Icon name="lucide:x" class="size-3.5" aria-hidden="true" />
              </span>
              <p class="dsw-list-text">
                Lipatan garis senyum (smile lines) di samping bibir dan kerutan halus sudut mata makin terlihat
              </p>
            </div>
            <div class="dsw-check-item">
              <span class="dsw-icon-red">
                <Icon name="lucide:x" class="size-3.5" aria-hidden="true" />
              </span>
              <p class="dsw-list-text">
                Kontur pipi dan rahang mulai terasa kendur saat bercermin
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- Section 4: Transformasi Nyata -->
      <section class="dsw-section">
        <h2 class="dsw-h2">
          Transformasi <span class="dsw-hl-aqua">Vitalitas & Kekencangan</span>
        </h2>
        <p class="dsw-sub" style="margin-top: 8px;">
          Perubahan tampilan kulit saat pori dihidrasi dengan Treatment Lotion 150ml lalu diberi nutrisi NAD+ Booster Serum:
        </p>

        <div class="dsw-grid-2">
          <article class="dsw-card">
            <img
              src={`${IMG_BASE}/kondisi-wajah-lelah-garis-senyum.webp`}
              alt="Kondisi kulit wajah lelah dengan garis senyum dan kerutan halus sebelum perawatan"
              width="480"
              height="320"
              class="dsw-card-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <div class="dsw-card-body">
              <span class="dsw-badge-red">Sebelum Skin Recharge</span>
              <p class="dsw-card-desc">
                Kulit tampak kering kusam, tekstur kurang elastis, dan lipatan garis senyum terlihat tegas.
              </p>
            </div>
          </article>

          <article class="dsw-card">
            <img
              src={`${IMG_BASE}/kondisi-wajah-segar-kencang-padat.webp`}
              alt="Kondisi kulit wajah segar, kencang, dan padat bercahaya setelah perawatan rutin"
              width="480"
              height="320"
              class="dsw-card-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <div class="dsw-card-body">
              <span class="dsw-badge-green">Rutin Skin Recharge Duo</span>
              <p class="dsw-card-desc">
                Wajah tampak segar berenergi, kontur pipi terasa lebih padat terangkat, dan garis halus tampak tersamarkan.
              </p>
            </div>
          </article>
        </div>

        <div class="dsw-list-box">
          <p class="dsw-list-box-title">Tahapan Hasil Pemakaian Rutin:</p>
          <div class="dsw-check-list" style="margin-top: 0;">
            <div class="dsw-check-item">
              <span class="dsw-icon-green">
                <Icon name="lucide:check" class="size-3.5" aria-hidden="true" />
              </span>
              <p class="dsw-list-text">
                <strong>Minggu 1–2:</strong> Kulit terasa jauh lebih lembap, kenyal, dan serum langsung meresap tanpa lengket
              </p>
            </div>
            <div class="dsw-check-item">
              <span class="dsw-icon-green">
                <Icon name="lucide:check" class="size-3.5" aria-hidden="true" />
              </span>
              <p class="dsw-list-text">
                <strong>Minggu 3–4:</strong> Tampilan wajah yang lelah berubah tampak lebih cerah segar dan halus
              </p>
            </div>
            <div class="dsw-check-item">
              <span class="dsw-icon-green">
                <Icon name="lucide:check" class="size-3.5" aria-hidden="true" />
              </span>
              <p class="dsw-list-text">
                <strong>Hari ke-42:</strong> Kontur pipi terasa lebih kencang dan tampilan garis senyum tampak lebih samar
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- Section 5: Cara Pakai 2 Langkah -->
      <section class="dsw-section--tinted">
        <h2 class="dsw-h2">
          Cara Pakai <span class="dsw-hl-aqua">2 Langkah Booster</span>
        </h2>
        <p class="dsw-sub" style="margin-top: 8px;">
          Gunakan setiap pagi dan malam setelah mencuci wajah untuk hasil peremajaan yang optimal:
        </p>

        <div class="dsw-grid-2">
          <article class="dsw-card">
            <img
              src={`${IMG_BASE}/cara-pakai-recharge-step1-toner.webp`}
              alt="Langkah 1 kompres dan tepuk Treatment Lotion 150ml ke seluruh wajah"
              width="480"
              height="320"
              class="dsw-card-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <div class="dsw-card-body">
              <span class="dsw-badge-teal">1. Hidrasi Pembuka</span>
              <p class="dsw-card-desc">
                Tepukkan 4–5 tetes <strong>Treatment Lotion 150ml</strong> ke wajah dan leher untuk membasahi pori dengan 72+ mineral laut.
              </p>
            </div>
          </article>

          <article class="dsw-card">
            <img
              src={`${IMG_BASE}/cara-pakai-recharge-step2-nad.webp`}
              alt="Langkah 2 teteskan NAD+ Booster Serum dan pijat ke arah atas"
              width="480"
              height="320"
              class="dsw-card-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <div class="dsw-card-body">
              <span class="dsw-badge-teal">2. Pijat Lifting NAD+</span>
              <p class="dsw-card-desc">
                Teteskan 3–4 tetes <strong>NAD+ Booster Serum</strong> lalu pijat lembut ke arah atas sepanjang garis rahang dan tulang pipi.
              </p>
            </div>
          </article>
        </div>

        <div style="margin-top: 22px; text-align: center;">
          <a href="#form-pemesanan" class="dsw-cta" data-scroll-to-form>
            <span>Pesan Paket Skin Recharge 150ml</span>
            <Icon name="lucide:arrow-right" class="size-5" aria-hidden="true" />
          </a>
        </div>
      </section>

      <!-- Section 6: Bukti Pelanggan -->
      <section class="dsw-section">
        <h2 class="dsw-h2">
          Bukti Nyata <span class="dsw-hl-aqua">Kulit Segar & Padat</span>
        </h2>
        <p class="dsw-sub" style="margin-top: 8px;">
          Ulasan pelanggan yang rutin menggunakan kombinasi Treatment Lotion 150ml & NAD+ Booster Serum:
        </p>

        <div class="dsw-grid-2">
          <div class="dsw-proof-cell">
            <img
              src={`${IMG_BASE}/bukti-tekstur-recharge-duo.webp`}
              alt="Tekstur cair Treatment Lotion dan emulsi lembut NAD+ Booster Serum"
              width="480"
              height="320"
              class="dsw-proof-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <p class="dsw-proof-OverlayCaption">Cepat Meresap Tanpa Lengket</p>
          </div>
          <div class="dsw-proof-cell">
            <img
              src={`${IMG_BASE}/bukti-wanita-40an-segar-kencang.webp`}
              alt="Potret pelanggan usia 40-an dengan kulit wajah kencang dan segar"
              width="480"
              height="320"
              class="dsw-proof-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <p class="dsw-proof-OverlayCaption">Tampak Lebih Muda & Segar</p>
          </div>
          <div class="dsw-proof-cell">
            <img
              src={`${IMG_BASE}/bukti-kontur-pipi-padat.webp`}
              alt="Close-up kontur pipi yang terasa lebih padat dan halus"
              width="480"
              height="320"
              class="dsw-proof-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <p class="dsw-proof-OverlayCaption">Garis Senyum Lebih Halus</p>
          </div>
          <div class="dsw-proof-cell">
            <img
              src={`${IMG_BASE}/bukti-meja-rias-skin-recharge.webp`}
              alt="Kemasan Paket Skin Recharge Duo 150ml di meja rias pelanggan"
              width="480"
              height="320"
              class="dsw-proof-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <p class="dsw-proof-OverlayCaption">Duet Anti-Aging Favorit</p>
          </div>
        </div>

        <div class="dsw-testi-list">
          <article class="dsw-testi-card">
            <div class="dsw-testi-head">
              <div class="dsw-testi-avatar" aria-hidden="true">M</div>
              <div class="dsw-testi-meta">
                <p class="dsw-testi-name">
                  Ibu Meilani (42 thn)
                  <span class="dsw-verified-pill">Verified Buyer</span>
                </p>
                <div class="dsw-stars">
                  <RatingStars rating={5} />
                </div>
              </div>
            </div>
            <p class="dsw-testi-body">
              "Sejak pakai toner 150ml dulu baru ditimpa serum NAD+, bedanya kerasa banget! Serumnya langsung nyerep ke dalam kulit, nggak cuma nempel di luar. Setelah sebulan garis senyum dan area bawah mata kelihatan jauh lebih kencang."
            </p>
            <div class="dsw-testi-foot">
              <span>Jakarta Selatan</span>
              <span>•</span>
              <span>Pemakaian 5 Minggu</span>
            </div>
          </article>

          <article class="dsw-testi-card">
            <div class="dsw-testi-head">
              <div class="dsw-testi-avatar" aria-hidden="true">D</div>
              <div class="dsw-testi-meta">
                <p class="dsw-testi-name">
                  Ibu Diana Putri (39 thn)
                  <span class="dsw-verified-pill">Verified Buyer</span>
                </p>
                <div class="dsw-stars">
                  <RatingStars rating={5} />
                </div>
              </div>
            </div>
            <p class="dsw-testi-body">
              "Wajahku yang tadinya kelihatan capek dan kusam sekarang jadi segar membal. Suka banget karena serum anti-agingnya lembut, nggak bikin perih atau mengelupas sama sekali."
            </p>
            <div class="dsw-testi-foot">
              <span>Semarang</span>
              <span>•</span>
              <span>Pemakaian 4 Minggu</span>
            </div>
          </article>
        </div>
      </section>

      <!-- Section 7: Tabel Perbandingan -->
      <section class="dsw-section--tinted">
        <h2 class="dsw-h2">
          Keunggulan <span class="dsw-hl-aqua">Paket Skin Recharge 150ml</span>
        </h2>
        <p class="dsw-sub" style="margin-top: 8px;">
          Bandingkan efektivitas duet pre-serum + NAD+ Booster Serum dibanding memakai serum biasa sendirian:
        </p>

        <div class="dsw-cmp-card">
          <div class="dsw-cmp-head">
            <div class="dsw-cmp-col">Aspek Perawatan</div>
            <div class="dsw-cmp-col dsw-cmp-col--numa">Skin Recharge 150ml</div>
            <div class="dsw-cmp-col">Serum Tunggal Biasa</div>
          </div>

          <div class="dsw-cmp-row">
            <div class="dsw-cmp-cell dsw-cmp-cell--feature">Persiapan Jalur Pori</div>
            <div class="dsw-cmp-cell dsw-cmp-cell--numa">
              <span class="dsw-icon-green" style="margin: 0 auto;">
                <Icon name="lucide:check" class="size-3.5" aria-hidden="true" />
              </span>
              <span class="dsw-cmp-sub">Toner 150ml (72+ Mineral)</span>
            </div>
            <div class="dsw-cmp-cell">
              <span class="dsw-icon-red" style="margin: 0 auto;">
                <Icon name="lucide:x" class="size-3.5" aria-hidden="true" />
              </span>
              <span class="dsw-cmp-sub">Tanpa pembuka pori</span>
            </div>
          </div>

          <div class="dsw-cmp-row">
            <div class="dsw-cmp-cell dsw-cmp-cell--feature">Teknologi Anti-Aging</div>
            <div class="dsw-cmp-cell dsw-cmp-cell--numa">
              <span class="dsw-icon-green" style="margin: 0 auto;">
                <Icon name="lucide:check" class="size-3.5" aria-hidden="true" />
              </span>
              <span class="dsw-cmp-sub">2% RejuveNAD™ + 6X Peptide</span>
            </div>
            <div class="dsw-cmp-cell">
              <span class="dsw-icon-red" style="margin: 0 auto;">
