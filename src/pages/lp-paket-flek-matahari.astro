---
import BaseLayout from '../layouts/BaseLayout.astro';
import GeoIpResolvedForm from '../components/storefront/forms/GeoIpResolvedForm.astro';
import MetaLandingTracker from '../components/storefront/tracking/MetaLandingTracker.astro';
import Icon from '../components/storefront/shared/Icon.astro';
import RatingStars from '../components/storefront/shared/RatingStars.astro';
import LpHeroOffer from '../components/storefront/landing-pages/LpHeroOffer.astro';
import LpBundleValueSection, {
  type BundleTierSpec,
} from '../components/storefront/landing-pages/LpBundleValueSection.astro';
import LpFloatingCta from '../components/storefront/landing-pages/LpFloatingCta.astro';
import { getStorefrontProduct } from '../lib/catalog';
import { nativeLandingCanonicalPath } from '../lib/landing-pages';
import { defaultCatalogContentId } from '../lib/catalog-feed';
import { getRuntimeEnv } from '../lib/env';
import { loadStoreCodDisabledProvinceCodes } from '../lib/form-mode';
import { getStoreAdsConfig } from '../lib/store-ads';
import '../styles/form-hybrid.css';
import '../styles/landing-pages/lp-meta-ads.css';

export const prerender = false;

const PRODUCT_SLUG = 'paket-adenosine-dan-sunscreen';
const LANDING_SLUG = 'lp-paket-flek-matahari';
const PAGE_TITLE =
  'Paket Adenosine & Sunscreen SPF 50+ — Duo Pelembap Malam & Tameng UV 24 Jam BPOM';
const PAGE_DESC =
  'Paket bundling #1 terlaris Numa Skin: Adenosine Deep Sea Water Moisturizer 30g + Oxydew Sunscreen 3% Luceane SPF 50+ PA++++ 30ml untuk merawat warna kulit kurang merata dan melindungi dari terik matahari (BPOM Resmi).';
const IMG_BASE = '/images/landing/paket-adenosine-dan-sunscreen';
const HERO_IMAGE = `${IMG_BASE}/hero-paket-adenosine-sunscreen.webp`;

const database = getRuntimeEnv(Astro.locals)?.OMS_DB as D1Database | undefined;
const claimedProductSlug = Astro.request.headers.get('x-adsbook-product-page');
const [product, canonicalPath, codDisabledProvinceCodes] = await Promise.all([
  getStorefrontProduct(Astro.locals, PRODUCT_SLUG),
  claimedProductSlug
    ? Promise.resolve(`/produk/${claimedProductSlug}`)
    : nativeLandingCanonicalPath(Astro.locals, LANDING_SLUG),
  loadStoreCodDisabledProvinceCodes(database),
  getStoreAdsConfig(Astro.locals),
]);
if (!product) {
  return Astro.rewrite('/404');
}

const canonical = `${Astro.locals.tenant.siteUrl}${canonicalPath}`;

const variants = product.variants || [];
const cheapestVariant = variants.reduce(
  (min: any, v: any) => (!min || v.price < min.price ? v : min),
  variants[0]
);
const defaultVariant = cheapestVariant || {
  id: '8',
  label: 'Adenosine 30gr + Sunscreen 30ml',
  price: 142000,
  comparePrice: 157999,
};

const BUNDLE_TIERS: BundleTierSpec[] = [
  {
    productSlug: 'paket-adenosine-dan-sunscreen',
    badge: 'Paket Utama • Duo Adenosine & Sunscreen SPF 50+',
    featured: true,
    image: `${IMG_BASE}/kemasan-duo-adenosine-oxydew.webp`,
    imageAlt: 'Paket Adenosine Moisturizer 30gr dan Oxydew Sunscreen 30ml',
    benefit: 'Adenosine Moisturizer 30gr (11X HA + Alpha-Arbutin) + Oxydew Sunscreen 3% Luceane SPF 50+ PA++++ 30ml.',
    ctaLabel: 'Ambil Paket Duo',
  },
  {
    productSlug: 'paket-age-defense-trio',
    badge: 'Upgrade Trio + PDRN Tone-Up Day Cream',
    image: '/images/landing/paket-age-defense-trio/kemasan-age-defense-trio.webp',
    imageAlt: 'Paket Age Defense Trio 3-in-1 Numa Skin',
    benefit: 'Tambahkan PDRN Tone-Up Day Cream 30gr (Natural Beige) untuk tampilan cerah rapi tanpa foundation di pagi hari.',
    ctaLabel: 'Upgrade + Day Cream',
  },
  {
    productSlug: 'paket-sunscreen-adenosine-toner-150ml',
    badge: 'Upgrade Trio + Treatment Lotion 150ml',
    image: '/images/landing/paket-sunscreen-adenosine-toner-150ml/kemasan-sunscreen-adenosine-toner-150ml.webp',
    imageAlt: 'Paket Sunscreen Adenosine dan Treatment Lotion 150ml',
    benefit: 'Tambahkan Deep Sea Water Treatment Lotion Jumbo 150ml untuk kompres CSM sebelum pelembap.',
    ctaLabel: 'Upgrade + Toner 150ml',
  },
];
---

<BaseLayout
  title={PAGE_TITLE}
  description={PAGE_DESC}
  image={HERO_IMAGE}
  preloadImages={HERO_IMAGE}
  canonical={canonical}
  noindex={true}
  hideHeader={true}
  hideFooter={true}
>
  <MetaLandingTracker
    slug={LANDING_SLUG}
    contentId={defaultCatalogContentId(product)}
    contentName={product.contentName}
    price={defaultVariant.price}
  />

  <div class="dsw-shell">
    <main class="dsw-canvas">
      <!-- Section 1: Hero -->
      <section id="hero-section" class="dsw-hero">
        <div class="dsw-hero-head">
          <h1 class="dsw-h1">
            Rawat Malam Tapi <span class="dsw-hl-tilt">Flek Gosong Lagi Saat Kena Panas Siang?</span> Kunci Adenosine & Tameng SPF 50+!
          </h1>
          <p class="dsw-sub" style="max-width: 390px; margin: 14px auto 0; font-weight: 700;">
            Pakai krim malam semahal apapun percuma kalau siang hari flek hitam kembali terbakar sinar UV.<br />
            <span class="dsw-underline-teal">Paket Bundling #1 Terlaris Numa Skin — Hemat Rp16.000!</span>
          </p>
        </div>

        <div class="dsw-hero-stage">
          <div class="dsw-hero-top-tag">
            <div class="dsw-hero-top-pill">
              <Icon name="lucide:award" class="size-3.5" aria-hidden="true" />
              <span>Paket Bundling #1 Favorit • Hemat Rp16.000</span>
            </div>
          </div>

          <img
            src={HERO_IMAGE}
            alt="Perbandingan wajah flek hitam terbakar matahari vs kulit cerah kenyal terlindungi dengan Paket Adenosine & Oxydew Sunscreen"
            width="720"
            height="480"
            class="dsw-hero-img"
            fetchpriority="high"
            loading="eager"
            decoding="async"
          />

          <div class="dsw-hero-ba" aria-hidden="true">
            <span class="dsw-hero-ba-pill dsw-hero-ba-pill--before">SEBELUM — Flek Gosong Terbakar UV</span>
            <span class="dsw-hero-ba-pill dsw-hero-ba-pill--after">SESUDAH — Cerah Kenyal Terlindungi</span>
          </div>

          <div class="dsw-hero-overlap">
            <div class="dsw-hero-overlap-inner">
              <h2 class="dsw-hero-overlap-title">15 Menit Kena Panas Tanpa SPF = Flek Hitam Kambuh!</h2>
              <p class="dsw-hero-overlap-text">
                Hanya 15 menit terkena terik matahari tanpa SPF 50+ sudah cukup untuk <strong style="color: #be123c;">membakar pigmen melanin dan mempertebal flek hitam membandel di tulang pipi</strong>.
              </p>
            </div>
          </div>
        </div>

        <div class="dsw-trust-row">
          <div class="dsw-trust-item">
            <span class="dsw-trust-icon">
              <Icon name="lucide:shield-check" class="size-4" aria-hidden="true" />
            </span>
            <div>
              <span class="dsw-trust-label">2 BPOM Resmi</span>
              <span class="dsw-trust-sub">NA1825.. & NA1825..</span>
            </div>
          </div>
          <div class="dsw-trust-item">
            <span class="dsw-trust-icon">
              <Icon name="lucide:badge-check" class="size-4" aria-hidden="true" />
            </span>
            <div>
              <span class="dsw-trust-label">Halal RI</span>
              <span class="dsw-trust-sub">Aman Bumil</span>
            </div>
          </div>
          <div class="dsw-trust-item">
            <span class="dsw-trust-icon">
              <Icon name="lucide:truck" class="size-4" aria-hidden="true" />
            </span>
            <div>
              <span class="dsw-trust-label">Bisa COD</span>
              <span class="dsw-trust-sub">Bayar Kurir</span>
            </div>
          </div>
        </div>

        <LpHeroOffer
          price={defaultVariant.price}
          comparePrice={defaultVariant.comparePrice}
          eyebrow="Paket Bundling Terlaris Adenosine + Sunscreen SPF 50+"
          ctaText="Ambil Paket Hemat Sekarang"
        />
      </section>

      <!-- Section 2: Solusi Singkat + Visual -->
      <section class="dsw-section">
        <h2 class="dsw-h2">
          Sinergi <span class="dsw-hl-aqua">perbaikan malam & perisai siang</span> dalam 1 paket
        </h2>
        <p class="dsw-sub">Dua langkah esensial yang saling mengunci agar rona kusam memudar dan tidak balik lagi.</p>

        <div class="dsw-photo-stack">
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/solusi-proteksi-siang-malam.webp`}
              alt="Wanita Indonesia usia 36 tahun dengan kulit wajah cerah kenyal dan bebas warna kulit kurang merata berkat perawatan siang malam Numa Skin"
              width="648"
              height="432"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
          </div>
        </div>

        <div class="dsw-list">
          <div class="dsw-list-row">
            <span class="dsw-icon-teal">
              <Icon name="lucide:droplets" class="size-4" aria-hidden="true" />
            </span>
            <p class="dsw-list-text">
              <strong style="color: #0f172a;">Adenosine Moisturizer (30 gr):</strong> Memudarkan flek hitam membandel, garis senyum, dan mengisi cadangan air 5 lapis dengan Adenosine, Alpha-Arbutin, & 11X Hyaluronic Acid.
            </p>
          </div>
          <div class="dsw-list-row">
            <span class="dsw-icon-teal">
              <Icon name="lucide:sun-dim" class="size-4" aria-hidden="true" />
            </span>
            <p class="dsw-list-text">
              <strong style="color: #0f172a;">Oxydew Sunscreen SPF 50+ PA++++ (30 ml):</strong> Memblokir radiasi UVA/UVB pemicu flek hitam baru dengan 3% Luceane™ tanpa whitecast abu-abu.
            </p>
          </div>
          <div class="dsw-list-row">
            <span class="dsw-icon-teal">
              <Icon name="lucide:layers" class="size-4" aria-hidden="true" />
            </span>
            <p class="dsw-list-text">
              <strong style="color: #0f172a;">Lebih Hemat Rp15.999:</strong> Dibandingkan membeli satuan (Rp157.999), cukup Rp142.000 untuk pemakaian penuh 4–6 minggu.
            </p>
          </div>
        </div>
      </section>

      <!-- Section 3: Tanda Masalah Kulit + Visual Grid -->
      <section class="dsw-section dsw-section--warn">
        <h2 class="dsw-h2">
          Kenapa <span class="dsw-underline-warn">flek hitam makin melebar</span> kalau cuma pakai 1 krim saja?
        </h2>

        <div class="dsw-photo-grid-2">
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/masalah-pakai-krim-tanpa-spf.webp`}
              alt="Kulit pipi terbakar UV dan bercak flek hitam kembali menggelap karena tanpa sunscreen SPF 50+"
              width="315"
              height="210"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <p class="dsw-photo-caption">
              <strong style="color: #be123c; display: block;">Rawat Malam, Gosong Siang</strong>
              Kulit yang baru diregenerasi malam hari langsung terbakar UV saat pagi.
            </p>
          </div>
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/masalah-flek-kambuh-terik.webp`}
              alt="Flek hitam membandel di tulang pipi makin tegas akibat sengatan matahari tropis"
              width="315"
              height="210"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <p class="dsw-photo-caption">
              <strong style="color: #be123c; display: block;">Flek Menahun & Kerutan</strong>
              Sinar UVA menembus dermis, mempertebal flek, dan memutus kolagen pipi.
            </p>
          </div>
        </div>

        <div class="dsw-list">
          <div class="dsw-list-row">
            <span class="dsw-icon-warn">
              <Icon name="lucide:triangle-alert" class="size-4" aria-hidden="true" />
            </span>
            <p class="dsw-list-text">
              Sudah habis ratusan ribu ganti pelembap/serum, tapi <strong style="color: #be123c;">flek hitam di tulang pipi tetap gosong kembali</strong> tiap habis keluar rumah.
            </p>
          </div>
          <div class="dsw-list-row">
            <span class="dsw-icon-warn">
              <Icon name="lucide:triangle-alert" class="size-4" aria-hidden="true" />
            </span>
            <p class="dsw-list-text">
              Malas pakai sunscreen biasa karena <strong style="color: #be123c;">lengket, perih di mata, dan bikin muka abu-abu</strong> saat ditumpuk pelembap.
            </p>
          </div>
          <div class="dsw-list-row">
            <span class="dsw-icon-warn">
              <Icon name="lucide:triangle-alert" class="size-4" aria-hidden="true" />
            </span>
            <p class="dsw-list-text">
              Kulit makin <strong style="color: #be123c;">kusam belang di batas hijab dan muncul kerutan halus</strong> di sudut mata.
            </p>
          </div>
        </div>
      </section>

      <!-- Section 4: Ilustrasi Perawatan Rutin -->
      <section class="dsw-section">
        <h2 class="dsw-h2">
          Bukti nyata perubahan <span class="dsw-hl-aqua">kombinasi 24 jam</span>
        </h2>
        <p class="dsw-sub">Ketika pencerah malam dan tameng UV SPF 50+ bekerja tanpa celah.</p>

        <div class="dsw-photo-stack">
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/kondisi-flek-makin-gelap-uv.webp`}
              alt="Kondisi pipi dengan noda flek hitam pekat, kemerahan matahari, dan garis halus"
              width="648"
              height="432"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <span class="dsw-photo-badge dsw-photo-badge--before">SEBELUM — Flek Hitam Terbakar UV</span>
            <p class="dsw-photo-caption">
              Flek hitam di tulang pipi tampak gelap kontras, kulit kemerahan terpapar panas, dan tekstur pori kering kasar.
            </p>
          </div>

          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/kondisi-flek-memudar-terlindungi.webp`}
              alt="Kondisi pipi tampak cerah merata, kenyal, dan terlindungi setelah rutin memakai Paket Adenosine & Sunscreen"
              width="648"
              height="432"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <span class="dsw-photo-badge dsw-photo-badge--after">SESUDAH RUTIN — Cerah & Terlindungi UV</span>
            <p class="dsw-photo-caption">
              Bercak flek hitam memudar bertahap, noda baru tercegah total, dan kulit tampak kenyal bercahaya sehat sepanjang hari.
            </p>
          </div>
        </div>
      </section>

      <!-- Section 5: Dark Marine Section — Cara Pakai Praktis -->
      <section class="dsw-section dsw-section--dark">
        <h2 class="dsw-h2">
          Urutan Pakai <span style="color: #99e2ec;">2 Langkah Tanpa Menggumpal</span>
        </h2>
        <p class="dsw-sub">Tekstur ringan yang menyatu sempurna di bawah bedak atau cushion.</p>

        <div class="dsw-photo-stack">
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/cara-pakai-step1-adenosine.webp`}
              alt="Langkah 1 mengoleskan Adenosine Deep Sea Water Moisturizer ke pipi pagi dan malam"
              width="648"
              height="432"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <p class="dsw-photo-caption">
              <strong style="color: #ffffff;">Langkah 1 (Pagi & Malam — Adenosine):</strong> Tekan 1–2 pump gel-cream Adenosine, pijat merata ke wajah & leher.
            </p>
          </div>

          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/cara-pakai-step2-oxydew-pagi.webp`}
              alt="Langkah 2 mengaplikasikan 2 ruas jari Oxydew Sunscreen SPF 50+ PA++++ pada pagi hari"
              width="648"
              height="432"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <p class="dsw-photo-caption">
              <strong style="color: #ffffff;">Langkah 2 (Khusus Pagi/Siang — Oxydew SPF 50+):</strong> Ratakan 2 ruas jari sunscreen 15 menit sebelum beraktivitas.
            </p>
          </div>
        </div>

        <div class="dsw-list">
          <div class="dsw-list-row">
            <span class="dsw-step-num">1</span>
            <p class="dsw-step-text">
              <strong style="color: #ffffff;">Rutinitas Pagi:</strong> Cuci muka → Adenosine Moisturizer → kunci dengan Oxydew Sunscreen SPF 50+ PA++++.
            </p>
          </div>
          <div class="dsw-list-row">
            <span class="dsw-step-num">2</span>
            <p class="dsw-step-text">
              <strong style="color: #ffffff;">Rutinitas Malam:</strong> Cuci muka → oleskan <strong style="color: #ffffff; background: #104452; padding: 1px 6px; border-radius: 4px;">Adenosine Moisturizer sedikit lebih tebal</strong> di area rona kusam & garis senyum.
            </p>
          </div>
          <div class="dsw-list-row">
            <span class="dsw-step-num">3</span>
            <p class="dsw-step-text">
              Kedua formula berbahan dasar <strong style="color: #ffffff;">Ulleung Deep Sea Water</strong> sehingga tidak pilling (menggumpal) saat ditumpuk.
            </p>
          </div>
        </div>
      </section>

      <!-- Section 6: Ulasan Pelanggan -->
      <section class="dsw-section">
        <h2 class="dsw-h2">
          Alasan paket ini jadi <span class="dsw-hl-aqua">andalan Bunda Indonesia</span>
        </h2>
        <p class="dsw-sub">Kombinasi ringkas 2 langkah untuk rutinitas pagi & malam tanpa ribet.</p>

        <div class="dsw-reviews-divide">
          <div class="dsw-review-row">
            <div class="dsw-review-head">
              <div>
                <p class="dsw-review-author">
                  Ibu Sri Wahyuni
                  <span style="color: #0b6e7d; display: inline-flex;">
                    <Icon name="lucide:badge-check" class="size-4" aria-hidden="true" />
                  </span>
                </p>
                <p class="dsw-review-meta">Malang • Usia 41 Tahun</p>
              </div>
              <RatingStars rating={5} starClass="h-3.5 w-3.5 !fill-[#d97706] !text-[#d97706]" />
            </div>
            <p class="dsw-review-quote">
              "Awalnya cuma beli Adenosine-nya aja, ternyata pas digabung sama Oxydew Sunscreen hasilnya jauh lebih cepat kelihatan! <span class="dsw-hl-aqua">Flek hitam di pipi gak pernah menghitam lagi walau sering antar jemput anak</span> siang bolong."
            </p>
          </div>

          <div class="dsw-review-row">
            <div class="dsw-review-head">
              <div>
                <p class="dsw-review-author">
                  Ibu Lina H.
                  <span style="color: #0b6e7d; display: inline-flex;">
                    <Icon name="lucide:badge-check" class="size-4" aria-hidden="true" />
                  </span>
                </p>
                <p class="dsw-review-meta">Tangerang • Paket Repeat Order ke-2</p>
              </div>
              <RatingStars rating={5} starClass="h-3.5 w-3.5 !fill-[#d97706] !text-[#d97706]" />
            </div>
            <p class="dsw-review-quote">
              "Paling sebel kalau pelembap ditumpuk sunscreen terus jadi menggumpal kayak daki. <strong style="color: #0f172a;">Duo Numa Skin ini klop banget teksturnya</strong>, <span class="dsw-hl-aqua">ringan, adem, dan gak bikin muka abu-abu</span>."
            </p>
          </div>

          <div class="dsw-review-row">
            <div class="dsw-review-head">
              <div>
                <p class="dsw-review-author">
                  Kak Dian A.
                  <span style="color: #0b6e7d; display: inline-flex;">
                    <Icon name="lucide:badge-check" class="size-4" aria-hidden="true" />
                  </span>
                </p>
                <p class="dsw-review-meta">Yogyakarta • Lebih Hemat Beli Paket</p>
              </div>
              <RatingStars rating={5} starClass="h-3.5 w-3.5 !fill-[#d97706] !text-[#d97706]" />
            </div>
            <p class="dsw-review-quote">
              "Beli paket gini <span class="dsw-hl-rose">jauh lebih hemat hampir 16 ribu</span> daripada beli pisah. Udah jalan sebulan pakai rutin, <span class="dsw-hl-aqua">garis halus bawah mata memudar dan muka kelihatan segar lembap</span>."
            </p>
          </div>
        </div>
      </section>

      <!-- Section 7: Galeri Bukti Visual -->
      <section class="dsw-section dsw-section--tint">
        <h2 class="dsw-h2">
          Duo praktis untuk <span style="color: #0b6e7d;">kulit tropis Indonesia</span>
        </h2>
        <p class="dsw-sub">Cukup 2 tube ringkas untuk merawat kelembapan kulit sekaligus menangkal terik matahari.</p>

        <div class="dsw-photo-grid-2">
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/bukti-tekstur-duo-ringan.webp`}
              alt="Perbandingan tekstur cooling gel-cream Adenosine dan fluid lotion Oxydew Sunscreen di punggung tangan"
              width="315"
              height="210"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
          </div>
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/bukti-bunda-35an-bebas-flek.webp`}
              alt="Potret wanita berhijab usia 36 tahun dengan kulit wajah cerah merata di bawah sinar matahari pagi"
              width="315"
              height="210"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
          </div>
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/bukti-kulit-kenyal-anti-gosong.webp`}
              alt="Close-up pipi kenyal lembap bebas whitecast dan bebas kemerahan UV"
              width="315"
              height="210"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
          </div>
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/bukti-meja-rias-duo-adenosine.webp`}
