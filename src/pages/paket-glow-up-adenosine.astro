---
import BaseLayout from '../layouts/BaseLayout.astro';
import GeoIpResolvedForm from '../components/storefront/forms/GeoIpResolvedForm.astro';
import MetaLandingTracker from '../components/storefront/tracking/MetaLandingTracker.astro';
import Icon from '../components/storefront/shared/Icon.astro';
import RatingStars from '../components/storefront/shared/RatingStars.astro';
import { getStorefrontProduct } from '../lib/catalog';
import { nativeLandingCanonicalPath } from '../lib/landing-pages';
import { defaultCatalogContentId } from '../lib/catalog-feed';
import { getRuntimeEnv } from '../lib/env';
import { loadStoreCodDisabledProvinceCodes } from '../lib/form-mode';
import { getStoreAdsConfig } from '../lib/store-ads';
import '../styles/form-hybrid.css';
import '../styles/landing-pages/paket-glow-up-adenosine.css';

export const prerender = false;

const PRODUCT_SLUG = 'paket-glow-up-adenosine';
const LANDING_SLUG = 'paket-glow-up-adenosine';
const PAGE_TITLE = 'Paket Glow Up Adenosine — 3 Langkah Dasar Bersih, Lembap & Samarkan Flek BPOM';
const PAGE_DESC = 'Paket bundling 3-in-1 Numa Skin: Deep Sea Water Facial Wash 100ml + Treatment Lotion (50ml/150ml) + Adenosine Moisturizer 30gr untuk pori bersih & wajah kenyal bebas flek (3 BPOM Resmi).';
const IMG_BASE = '/images/landing/paket-glow-up-adenosine';
const HERO_IMAGE = `${IMG_BASE}/hero-paket-glow-up-adenosine.webp`;

const database = getRuntimeEnv(Astro.locals)?.OMS_DB as D1Database | undefined;
const claimedProductSlug = Astro.request.headers.get('x-adsbook-product-page');
const [product, canonicalPath, codDisabledProvinceCodes] = await Promise.all([
  getStorefrontProduct(Astro.locals, PRODUCT_SLUG),
  claimedProductSlug
    ? Promise.resolve(`/produk/${claimedProductSlug}`)
    : nativeLandingCanonicalPath(Astro.locals, LANDING_SLUG),
  loadStoreCodDisabledProvinceCodes(database),
  getStoreAdsConfig(Astro.locals),
]);
if (!product) {
  return Astro.rewrite('/404');
}

const canonical = `${Astro.locals.tenant.siteUrl}${canonicalPath}`;

const variants = product.variants || [];
const cheapestVariant = variants.reduce(
  (min: any, v: any) => (!min || v.price < min.price ? v : min),
  variants[0]
);
const defaultVariant = cheapestVariant || {
  id: '24',
  label: 'Facial Wash 100ml + Toner 50ml + Adenosine 30gr',
  price: 204000,
  comparePrice: 226998,
};
---

<BaseLayout
  title={PAGE_TITLE}
  description={PAGE_DESC}
  image={HERO_IMAGE}
  preloadImages={HERO_IMAGE}
  canonical={canonical}
  hideHeader={true}
  hideFooter={true}
>
  <MetaLandingTracker
    slug={LANDING_SLUG}
    contentId={defaultCatalogContentId(product)}
    contentName={product.contentName}
    price={defaultVariant.price}
  />

  <div class="dsw-shell">
    <main class="dsw-canvas">
      <!-- Section 1: Hero -->
      <section id="hero-section" class="dsw-hero">
        <div class="dsw-hero-head">
          <h1 class="dsw-h1">
            <span class="dsw-hl-tilt">Wajah Kusam & Flek</span> Karena Salah Urutan Dasar Skincare?
          </h1>
          <p class="dsw-sub" style="max-width: 390px; margin: 14px auto 0; font-weight: 700;">
            Sabun cuci muka yang keras dan pelembap tanpa toner pembuka membuat pori tersumbat dan flek makin pekat.<br />
            <span class="dsw-underline-teal">Bangun fondasi wajah cerah kenyal dengan Paket Glow Up Adenosine!</span>
          </p>
        </div>

        <div class="dsw-hero-stage">
          <div class="dsw-hero-top-tag">
            <div class="dsw-hero-top-pill">
              <Icon name="lucide:sparkles" class="size-3.5" aria-hidden="true" />
              <span>Basic Trio Anti-Flek • Mulai Rp204.000</span>
            </div>
          </div>

          <img
            src={HERO_IMAGE}
            alt="Perbandingan wajah kusam berflek vs kulit bersih cerah kenyal dengan Paket Glow Up Adenosine Numa Skin"
            width="720"
            height="480"
            class="dsw-hero-img"
            fetchpriority="high"
            loading="eager"
            decoding="async"
          />

          <div class="dsw-hero-overlap">
            <div class="dsw-hero-overlap-inner">
              <h2 class="dsw-hero-overlap-title">3 Fondasi Wajib Kulit Usia 30+</h2>
              <p class="dsw-hero-overlap-text">
                Kulit butuh <strong style="color: #be123c;">pembersih gel lembut, toner pembuka hidrasi, dan pelembap pengunci Adenosine</strong> agar flek dan garis halus terawat dari dasar.
              </p>
            </div>
          </div>
        </div>

        <div class="dsw-trust-row">
          <div class="dsw-trust-item">
            <span class="dsw-trust-icon">
              <Icon name="lucide:shield-check" class="size-4" aria-hidden="true" />
            </span>
            <div>
              <span class="dsw-trust-label">BPOM Resmi</span>
              <span class="dsw-trust-sub">3 Izin Edar</span>
            </div>
          </div>
          <div class="dsw-trust-item">
            <span class="dsw-trust-icon">
              <Icon name="lucide:badge-check" class="size-4" aria-hidden="true" />
            </span>
            <div>
              <span class="dsw-trust-label">Halal RI</span>
              <span class="dsw-trust-sub">Aman Bumil</span>
            </div>
          </div>
          <div class="dsw-trust-item">
            <span class="dsw-trust-icon">
              <Icon name="lucide:truck" class="size-4" aria-hidden="true" />
            </span>
            <div>
              <span class="dsw-trust-label">Bisa COD</span>
              <span class="dsw-trust-sub">Bayar di Rumah</span>
            </div>
          </div>
        </div>
      </section>

      <!-- Section 2: Solusi Singkat + Visual -->
      <section class="dsw-section">
        <h2 class="dsw-h2">
          Rangkaian <span class="dsw-hl-aqua">Cuci + Toner + Kunci Lembap</span> setiap hari
        </h2>
        <p class="dsw-sub">Tersedia pilihan ukuran Toner 50ml (Rp204.000) maupun Jumbo 150ml (Rp231.000).</p>

        <div class="dsw-photo-stack">
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/solusi-cuci-kompres-kunci-lembap.webp`}
              alt="Wanita Indonesia usia 35 tahun menyentuh kulit pipinya yang bersih, kenyal, dan glowing setelah 3 langkah dasar Numa Skin"
              width="648"
              height="432"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
          </div>
        </div>

        <div class="dsw-list">
          <div class="dsw-list-row">
            <span class="dsw-icon-teal">
              <Icon name="lucide:droplets" class="size-4" aria-hidden="true" />
            </span>
            <p class="dsw-list-text">
              <strong style="color: #0f172a;">Deep Sea Water Facial Wash Gel (100 ml):</strong> Membersihkan sebum & debu hingga ke pori dengan 5% Niacinamide dan pH seimbang tanpa rasa kesat ketarik.
            </p>
          </div>
          <div class="dsw-list-row">
            <span class="dsw-icon-teal">
              <Icon name="lucide:sparkles" class="size-4" aria-hidden="true" />
            </span>
            <p class="dsw-list-text">
              <strong style="color: #0f172a;">Deep Sea Water Treatment Lotion (50 ml / 150 ml):</strong> 2-in-1 Toner & First Essence dengan Galactomyces & Ceramide yang membuka jalur serap pelembap.
            </p>
          </div>
          <div class="dsw-list-row">
            <span class="dsw-icon-teal">
              <Icon name="lucide:shield-check" class="size-4" aria-hidden="true" />
            </span>
            <p class="dsw-list-text">
              <strong style="color: #0f172a;">Adenosine Moisturizer (30 gr):</strong> Gel-cream dingin dengan Adenosine, Alpha-Arbutin, & 11X Hyaluronic Acid untuk merawat flek dan garis halus.
            </p>
          </div>
        </div>
      </section>

      <!-- Section 3: Tanda Masalah Kulit + Visual Grid -->
      <section class="dsw-section dsw-section--warn">
        <h2 class="dsw-h2">
          Mengapa wajah <span class="dsw-underline-warn">tetap kusam</span> walau rajin cuci muka & pakai krim?
        </h2>

        <div class="dsw-photo-grid-2">
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/masalah-sabun-keras-bikin-flek.webp`}
              alt="Wanita bercermin memegang pipi yang terasa kering ketarik dan kusam akibat sabun cuci muka keras"
              width="315"
              height="210"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <p class="dsw-photo-caption">
              <strong style="color: #be123c; display: block;">Sabun Keras Mengikis Barrier</strong>
              Sabun berbusa kasar membuat kulit kehilangan minyak alami dan memicu garis dehidrasi.
            </p>
          </div>
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/masalah-pelembap-numpuk-di-pori.webp`}
              alt="Close-up kulit pipi kusam di mana pelembap terasa lengket karena pori belum dihidrasi toner"
              width="315"
              height="210"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <p class="dsw-photo-caption">
              <strong style="color: #be123c; display: block;">Krim Menumpuk Tanpa Toner</strong>
              Melewatkan toner membuat pelembap hanya menempel di permukaan dan terasa lengket.
            </p>
          </div>
        </div>

        <div class="dsw-list">
          <div class="dsw-list-row">
            <span class="dsw-icon-warn">
              <Icon name="lucide:triangle-alert" class="size-4" aria-hidden="true" />
            </span>
            <p class="dsw-list-text">
              Habis cuci muka wajah terasa <strong style="color: #be123c;">kaku ketarik, lalu sejam kemudian banjir minyak</strong>.
            </p>
          </div>
          <div class="dsw-list-row">
            <span class="dsw-icon-warn">
              <Icon name="lucide:triangle-alert" class="size-4" aria-hidden="true" />
            </span>
            <p class="dsw-list-text">
              Pelembap yang dipakai terasa <strong style="color: #be123c;">lama meresap dan kurang memberi efek kenyal</strong>.
            </p>
          </div>
          <div class="dsw-list-row">
            <span class="dsw-icon-warn">
              <Icon name="lucide:triangle-alert" class="size-4" aria-hidden="true" />
            </span>
            <p class="dsw-list-text">
              Noda flek hitam dan kusam <strong style="color: #be123c;">betah bertahan karena sel kulit mati menumpuk</strong>.
            </p>
          </div>
        </div>
      </section>

      <!-- Section 4: Perbandingan Visual Sebelum vs Sesudah -->
      <section class="dsw-section">
        <h2 class="dsw-h2">
          Perbandingan kulit <span class="dsw-hl-aqua">sebelum vs sesudah rutin</span>
        </h2>
        <p class="dsw-sub">Ketika pembersihan lembut, hidrasi esens, dan penguncian Adenosine dilakukan teratur.</p>

        <div class="dsw-photo-stack">
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/kondisi-kusam-kasar-ketarik.webp`}
              alt="Kondisi pipi dengan pori tersumbat, tekstur kering kasar, dan bercak flek sebelum perawatan"
              width="648"
              height="432"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <span class="dsw-photo-badge dsw-photo-badge--before">Sebelum Glow Up Adenosine</span>
            <p class="dsw-photo-caption">
              Pori tampak kotor dan kasar, kulit terasa ketarik setelah cuci muka, dan bercak gelap terlihat jelas.
            </p>
          </div>

          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/kondisi-bersih-cerah-membal.webp`}
              alt="Kondisi pipi bersih, pori tampak halus, kenyal, dan cerah merata setelah rutin memakai Paket Glow Up Adenosine"
              width="648"
              height="432"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <span class="dsw-photo-badge dsw-photo-badge--after">Rutin Glow Up Adenosine</span>
            <p class="dsw-photo-caption">
              Pori tampak bersih terawat, kulit terasa kenyal membal, dan rona wajah tampak lebih cerah merata.
            </p>
          </div>
        </div>
      </section>

      <!-- Section 5: Dark Marine Section — Cara Pakai Praktis -->
      <section class="dsw-section dsw-section--dark">
        <h2 class="dsw-h2">
          Urutan Pakai <span style="color: #99e2ec;">3 Langkah Pagi & Malam</span>
        </h2>
        <p class="dsw-sub">Mudah diikuti bahkan untuk pemula yang baru mulai merawat anti-aging.</p>

        <div class="dsw-photo-stack">
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/cara-pakai-glow-cuci-dan-toner.webp`}
              alt="Langkah 1 dan 2: Cuci muka dengan Facial Wash Gel lalu tepuk Treatment Lotion pada wajah lembap"
              width="648"
              height="432"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <p class="dsw-photo-caption">
              <strong style="color: #ffffff;">Langkah 1 & 2 (Cuci Lembut & Basahi Pori):</strong> Cuci wajah dengan Facial Wash Gel, bilas, lalu tepuk 3–4 tetes Treatment Lotion.
            </p>
          </div>
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/cara-pakai-glow-kunci-adenosine.webp`}
              alt="Langkah 3: Kunci kelembapan dengan Adenosine Moisturizer di seluruh wajah"
              width="648"
              height="432"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <p class="dsw-photo-caption">
              <strong style="color: #ffffff;">Langkah 3 (Kunci Hidrasi & Rawat Flek):</strong> Ratakan 1–2 pump Adenosine Moisturizer ke seluruh wajah dan leher.
            </p>
          </div>
        </div>

        <div class="dsw-list">
          <div class="dsw-list-row">
            <span class="dsw-step-num">1</span>
            <p class="dsw-step-text">
              <strong style="color: #ffffff;">Tahap 1 — Facial Wash Gel (100 ml):</strong> Mengangkat kotoran & minyak tanpa merusak pelindung kulit.
            </p>
          </div>
          <div class="dsw-list-row">
            <span class="dsw-step-num">2</span>
            <p class="dsw-step-text">
              <strong style="color: #ffffff;">Tahap 2 — Treatment Lotion (50 ml / 150 ml):</strong> Menghidrasi instan agar pelembap terserap cepat.
            </p>
          </div>
          <div class="dsw-list-row">
            <span class="dsw-step-num">3</span>
            <p class="dsw-step-text">
              <strong style="color: #ffffff;">Tahap 3 — Adenosine Moisturizer (30 gr):</strong> <strong style="color: #ffffff; background: #104452; padding: 1px 6px; border-radius: 4px;">Mengunci kelembapan</strong> serta menyamarkan flek & kerutan.
            </p>
          </div>
        </div>
      </section>

      <!-- Section 6: Ulasan Pelanggan -->
      <section class="dsw-section">
        <h2 class="dsw-h2">
          Ulasan pelanggan <span class="dsw-hl-aqua">Paket Glow Up Adenosine</span>
        </h2>
        <p class="dsw-sub">Paket dasar paling pas untuk memulai perawatan anti-flek tanpa ribet.</p>

        <div class="dsw-reviews-divide">
          <div class="dsw-review-row">
            <div class="dsw-review-head">
              <div>
                <p class="dsw-review-author">
                  Bunda Sari M.
                  <span style="color: #0b6e7d; display: inline-flex;">
                    <Icon name="lucide:badge-check" class="size-4" aria-hidden="true" />
                  </span>
                </p>
                <p class="dsw-review-meta">Cikarang • Varian Toner 150ml</p>
              </div>
              <RatingStars rating={5} starClass="h-3.5 w-3.5 !fill-[#d97706] !text-[#d97706]" />
            </div>
            <p class="dsw-review-quote">
              "Sabunnya enak banget gak bikin muka ketarik, terus disambung toner sama Adenosine <span class="dsw-hl-aqua">kulit langsung adem kenyal dan flek di pipi berangsur samar</span>."
            </p>
          </div>
          <div class="dsw-review-row">
            <div class="dsw-review-head">
              <div>
                <p class="dsw-review-author">
                  Ibu Lilis H.
                  <span style="color: #0b6e7d; display: inline-flex;">
                    <Icon name="lucide:badge-check" class="size-4" aria-hidden="true" />
                  </span>
                </p>
                <p class="dsw-review-meta">Cirebon • Varian Toner 50ml</p>
              </div>
              <RatingStars rating={5} starClass="h-3.5 w-3.5 !fill-[#d97706] !text-[#d97706]" />
            </div>
            <p class="dsw-review-quote">
              "Coba yang paket toner 50ml dulu harganya cuma 204 ribu udah dapet 3 produk. <strong style="color: #0f172a;">Muka yang tadinya kusam kasar jadi halus banget</strong>, <span class="dsw-hl-aqua">bulan depan mau repeat yang 150ml</span>."
            </p>
          </div>
          <div class="dsw-review-row">
            <div class="dsw-review-head">
              <div>
                <p class="dsw-review-author">
                  Bunda Mega W.
                  <span style="color: #0b6e7d; display: inline-flex;">
                    <Icon name="lucide:badge-check" class="size-4" aria-hidden="true" />
                  </span>
                </p>
                <p class="dsw-review-meta">Pekanbaru • Usia 36 Tahun</p>
              </div>
              <RatingStars rating={5} starClass="h-3.5 w-3.5 !fill-[#d97706] !text-[#d97706]" />
            </div>
            <p class="dsw-review-quote">
              "Simple cuma 3 langkah tapi hasilnya nyata. <span class="dsw-hl-rose">Hemat sampai 26 ribu</span> dan <span class="dsw-hl-aqua">pori-pori kelihatan jauh lebih bersih rapi</span>."
            </p>
          </div>
        </div>
      </section>

      <!-- Section 7: Galeri Bukti Visual -->
      <section class="dsw-section dsw-section--tint">
        <h2 class="dsw-h2">
          Fondasi <span style="color: #0b6e7d;">kulit bersih & kenyal</span> setiap hari
        </h2>
        <p class="dsw-sub">Tiga langkah berbahan dasar mineral laut Ulleung yang ramah untuk semua jenis kulit.</p>

        <div class="dsw-photo-grid-2">
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/bukti-tekstur-trio-glow-adenosine.webp`}
              alt="Swatch 3 tekstur Paket Glow Up Adenosine: gel cuci jernih, essence cair, dan gel-cream sejuk"
              width="315"
              height="210"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
          </div>
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/bukti-wanita-hijab-glowing-dasar.webp`}
              alt="Potret wanita berhijab usia 35 tahun dengan kulit wajah bersih, sehat, dan glowing"
              width="315"
              height="210"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
          </div>
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/bukti-kulit-halus-pori-bersih.webp`}
              alt="Close-up tekstur pipi yang halus, pori bersih, dan lembap membal"
              width="315"
              height="210"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
          </div>
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/bukti-meja-rias-glow-adenosine.webp`}
              alt="Paket Glow Up Adenosine Numa Skin di wastafel kamar mandi"
              width="315"
              height="210"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
          </div>
        </div>
      </section>

      <!-- Section 8: Product Knowledge (Full-Bleed Figures) -->
      <section class="dsw-section dsw-section--knowledge">
        <h2 class="dsw-h2">
          Keunggulan <span class="dsw-hl-aqua">Paket Glow Up Adenosine</span>
        </h2>
        <p class="dsw-sub">
          Merawat kebersihan pori, keseimbangan pH, dan kekenyalan kolagen dalam satu rangkaian.
        </p>

        <div class="dsw-figure-stack">
          <figure class="dsw-figure">
            <div class="dsw-figure-bleed">
              <img
                src={`${IMG_BASE}/formulasi-dasar-glow-ulleung.webp`}
                alt="Formulasi Ulleung Deep Sea Water dengan busa mikro lembut dan alga merah Jania rubens"
                width="720"
                height="480"
                class="dsw-figure-img"
                loading="lazy"
                fetchpriority="low"
                decoding="async"
              />
            </div>
            <figcaption class="dsw-figcaption">
              <h3 class="dsw-figcaption-title">Cleanse, Hydrate & Lock Architecture</h3>
              <p class="dsw-figcaption-desc">
                Pembersih pH rendah menjaga skin barrier tetap utuh, Treatment Lotion mengisi hidrasi, dan Adenosine mengunci kelembapan.
              </p>
            </figcaption>
          </figure>
          <figure class="dsw-figure">
            <div class="dsw-figure-bleed">
              <img
                src={`${IMG_BASE}/kandungan-niacinamide-galactomyces-adenosine.webp`}
                alt="Kandungan 5% Niacinamide, Galactomyces, Ceramide, Adenosine, Alpha-Arbutin, dan 11X Hyaluronic Acid"
                width="720"
                height="480"
                class="dsw-figure-img"
                loading="lazy"
                fetchpriority="low"
                decoding="async"
              />
            </div>
            <figcaption class="dsw-figcaption">
              <h3 class="dsw-figcaption-title">5% Niacinamide + Galactomyces + Adenosine + 11X HA</h3>
              <p class="dsw-figcaption-desc">
                Sinergi pencerah kusam di tahap cuci muka, fermentasi penghalus pori di tahap toner, dan anti-aging Adenosine di tahap pelembap.
              </p>
            </figcaption>
          </figure>
          <figure class="dsw-figure">
            <div class="dsw-figure-bleed">
              <img
                src={`${IMG_BASE}/kemasan-glow-up-adenosine.webp`}
                alt="Kemasan resmi Paket Glow Up Adenosine Numa Skin terdaftar BPOM"
                width="720"
                height="480"
                class="dsw-figure-img"
                loading="lazy"
                fetchpriority="low"
                decoding="async"
              />
            </div>
            <figcaption class="dsw-figcaption">
