      <!-- Section 11: Order Form with Tiered Bundling -->
      <section id="form-pemesanan" class="dsw-section--checkout">
        <div style="padding: 0 20px 14px; text-align: center;">
          <h2 class="dsw-h2" style="font-size: 26px;">
            Pilih Paket & <span class="dsw-hl-aqua">Alamat Pengiriman</span>
          </h2>
          <p class="dsw-sub" style="max-width: 360px; margin: 8px auto 0;">
            Tersedia 1 Tube Satuan (Rp78.999) atau Paket Bundling Hemat dengan Sunscreen SPF 50+ / PDRN Day Cream (Hemat hingga Rp24.000).
          </p>
        </div>

        <GeoIpResolvedForm
          mode="hybrid"
          productSlug={product.slug}
          bundleProductSlugs={[
            'paket-adenosine-dan-sunscreen',
            'paket-hydra-glow-duo',
            'paket-age-defense-trio',
          ]}
          embedded={true}
          selectedVariantId={String(defaultVariant.id)}
          codDisabledProvinceCodes={codDisabledProvinceCodes}
        />
      </section>
    </main>

    <LpFloatingCta
      label="Pesan Sekarang"
      price={defaultVariant.price}
      ariaLabel="Pesan Adenosine Deep Sea Water Moisturizer"
    />
  </div>
</BaseLayout>
