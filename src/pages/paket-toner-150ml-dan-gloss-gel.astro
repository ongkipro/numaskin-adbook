---
import BaseLayout from '../layouts/BaseLayout.astro';
import GeoIpResolvedForm from '../components/storefront/forms/GeoIpResolvedForm.astro';
import MetaLandingTracker from '../components/storefront/tracking/MetaLandingTracker.astro';
import Icon from '../components/storefront/shared/Icon.astro';
import RatingStars from '../components/storefront/shared/RatingStars.astro';
import { getStorefrontProduct } from '../lib/catalog';
import { nativeLandingCanonicalPath } from '../lib/landing-pages';
import { defaultCatalogContentId } from '../lib/catalog-feed';
import { getRuntimeEnv } from '../lib/env';
import { loadStoreCodDisabledProvinceCodes } from '../lib/form-mode';
import { getStoreAdsConfig } from '../lib/store-ads';
import '../styles/form-hybrid.css';
import '../styles/landing-pages/paket-toner-150ml-dan-gloss-gel.css';

export const prerender = false;

const PRODUCT_SLUG = 'paket-toner-150ml-dan-gloss-gel';
const LANDING_SLUG = 'paket-toner-150ml-dan-gloss-gel';
const PAGE_TITLE = 'Paket Toner 150ml & Gloss Gel - Duet Hidrasi Jumbo & Penenang Barrier BPOM';
const PAGE_DESC = 'Duet penenang skin barrier ukuran besar: Deep Sea Water Treatment Lotion 150ml (NA18220101400) dan Calming Barrier Gloss Gel Moisturizer 30ml (NA18230107056).';
const IMG_BASE = '/images/landing/paket-toner-150ml-dan-gloss-gel';
const HERO_IMAGE = `${IMG_BASE}/hero-paket-toner-150ml-gloss-gel.webp`;

const database = getRuntimeEnv(Astro.locals)?.OMS_DB as D1Database | undefined;
const claimedProductSlug = Astro.request.headers.get('x-adsbook-product-page');
const [product, canonicalPath, codDisabledProvinceCodes] = await Promise.all([
  getStorefrontProduct(Astro.locals, PRODUCT_SLUG),
  claimedProductSlug
    ? Promise.resolve(`/produk/${claimedProductSlug}`)
    : nativeLandingCanonicalPath(Astro.locals, LANDING_SLUG),
  loadStoreCodDisabledProvinceCodes(database),
  getStoreAdsConfig(Astro.locals),
]);
if (!product) {
  return Astro.rewrite('/404');
}

const canonical = `${Astro.locals.tenant.siteUrl}${canonicalPath}`;

const variants = product.variants || [];
const cheapestVariant = variants.reduce(
  (min: any, v: any) => (!min || v.price < min.price ? v : min),
  variants[0]
);
const defaultVariant = cheapestVariant || {
  id: '46',
  label: 'Toner 150ml + Gloss Gel 30ml',
  price: 169000,
  comparePrice: 188000,
};
---

<BaseLayout
  title={PAGE_TITLE}
  description={PAGE_DESC}
  image={HERO_IMAGE}
  preloadImages={HERO_IMAGE}
  canonical={canonical}
  hideHeader={true}
  hideFooter={true}
>
  <MetaLandingTracker
    slug={LANDING_SLUG}
    contentId={defaultCatalogContentId(product)}
    contentName={product.contentName}
    price={defaultVariant.price}
  />

  <div class="dsw-shell">
    <main class="dsw-canvas">
      <!-- Section 1: Hero -->
      <section id="hero-section" class="dsw-hero">
        <div class="dsw-hero-head">
          <h1 class="dsw-h1">
            <span class="dsw-hl-tilt">Wajah Mudah Merah</span> & Bruntusan Saat Pakai Krim Tebal?
          </h1>
          <p class="dsw-sub" style="max-width: 390px; margin: 14px auto 0; font-weight: 700;">
            Kulit sensitif dan kombinasi membutuhkan hidrasi cair yang dikunci dengan water-jelly ringan bebas penyumbat pori.<br />
            <span class="dsw-underline-teal">Tenangkan kemerahan & bruntusan dengan Toner 150ml + Gloss Gel!</span>
          </p>
        </div>

        <div class="dsw-hero-stage">
          <div class="dsw-hero-top-tag">
            <div class="dsw-hero-top-pill">
              <Icon name="lucide:award" class="size-3.5" aria-hidden="true" />
              <span>Toner 150ml + Gloss Gel • Hemat Rp19rb</span>
            </div>
          </div>

          <img
            src={HERO_IMAGE}
            alt="Perbandingan kulit merah bruntusan vs kulit tenang glassy dengan Paket Toner 150ml dan Gloss Gel Numa Skin"
            width="720"
            height="480"
            class="dsw-hero-img"
            fetchpriority="high"
            loading="eager"
            decoding="async"
          />

          <div class="dsw-hero-ba" aria-hidden="true">
            <span class="dsw-hero-ba-pill dsw-hero-ba-pill--before">Merah & Bruntusan</span>
            <span class="dsw-hero-ba-pill dsw-hero-ba-pill--after">Tenang & Glass Skin</span>
          </div>

          <div class="dsw-hero-trust-strip" role="list" aria-label="Jaminan kualitas Numa Skin">
            <div class="dsw-trust-item" role="listitem">
              <span class="dsw-trust-icon">
                <Icon name="lucide:shield-check" class="size-3.5" aria-hidden="true" />
              </span>
              <span class="dsw-trust-text">
                <strong class="dsw-trust-label">2 BPOM Resmi</strong>
                <span class="dsw-trust-sub">Toner & Gloss Gel</span>
              </span>
            </div>
            <div class="dsw-trust-item" role="listitem">
              <span class="dsw-trust-icon">
                <Icon name="lucide:droplets" class="size-3.5" aria-hidden="true" />
              </span>
              <span class="dsw-trust-text">
                <strong class="dsw-trust-label">Toner Jumbo 150ml</strong>
                <span class="dsw-trust-sub">76% Ulleung Water</span>
              </span>
            </div>
            <div class="dsw-trust-item" role="listitem">
              <span class="dsw-trust-icon">
                <Icon name="lucide:layers" class="size-3.5" aria-hidden="true" />
              </span>
              <span class="dsw-trust-text">
                <strong class="dsw-trust-label">Water-Jelly 30ml</strong>
                <span class="dsw-trust-sub">Meadowestolide</span>
              </span>
            </div>
          </div>
        </div>

        <div class="dsw-hero-foot">
          <p class="dsw-hero-caption">
            Duet penenang barrier ukuran puas: <strong>Deep Sea Water Treatment Lotion 150ml</strong> + <strong>Calming Barrier Gloss Gel Moisturizer 30ml</strong>.
          </p>
          <a href="#form-pemesanan" class="dsw-cta" data-scroll-to-form>
            <span>Ambil Paket Toner 150ml & Gloss Gel</span>
            <Icon name="lucide:arrow-right" class="size-5" aria-hidden="true" />
          </a>
        </div>
      </section>

      <!-- Section 2: Solusi Praktis -->
      <section class="dsw-section">
        <h2 class="dsw-h2">
          2 Langkah Dingin <span class="dsw-hl-aqua">Penenang Skin Barrier Rewel</span>
        </h2>
        <p class="dsw-sub" style="margin-top: 8px;">
          Kombinasi ringan seperti air untuk kulit yang mudah memerah, bruntusan, atau berminyak-dehidrasi:
        </p>

        <div class="dsw-solution-box">
          <img
            src={`${IMG_BASE}/solusi-hidrasi-dingin-penenang-barrier-150ml.webp`}
            alt="Wanita Indonesia mengaplikasikan Gloss Gel setelah Treatment Lotion 150ml untuk kulit tenang"
            width="648"
            height="432"
            class="dsw-solution-img"
            loading="lazy"
            fetchpriority="low"
            decoding="async"
          />

          <div class="dsw-check-list">
            <div class="dsw-check-item">
              <span class="dsw-icon-green">
                <Icon name="lucide:check" class="size-3.5" aria-hidden="true" />
              </span>
              <p class="dsw-list-text"><strong>Langkah 1 — Treatment Lotion Jumbo 150ml:</strong> Menyuplai 76% Air Laut Dalam Ulleungdo, Galactomyces, dan 5X Ceramide untuk mengisi cadangan air di pori.</p>
            </div>
            <div class="dsw-check-item">
              <span class="dsw-icon-green">
                <Icon name="lucide:check" class="size-3.5" aria-hidden="true" />
              </span>
              <p class="dsw-list-text"><strong>Langkah 2 — Calming Barrier Gloss Gel 30ml:</strong> Tekstur water-jelly sejuk dengan Meadowestolide dan Astragalus yang meredakan kemerahan serta mengunci hidrasi tanpa minyak.</p>
            </div>
            <div class="dsw-check-item">
              <span class="dsw-icon-green">
                <Icon name="lucide:check" class="size-3.5" aria-hidden="true" />
              </span>
              <p class="dsw-list-text"><strong>Kapasitas Toner 150ml Lebih Awet:</strong> Sangat leluasa dipakai kompres kapas (CSM) pada area pipi atau dahi yang sedang memerah.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- Section 3: Masalah Kulit -->
      <section class="dsw-section--tinted">
        <h2 class="dsw-h2">
          Kenapa Kulit Sensitif <span class="dsw-hl-coral">Sering Salah Pilih Pelembap?</span>
        </h2>

        <div class="dsw-grid-2">
          <article class="dsw-card">
            <img
              src={`${IMG_BASE}/masalah-pelembap-berat-bikin-bruntusan-150ml.webp`}
              alt="Kulit wajah muncul bruntusan akibat memakai krim pelembap yang terlalu berat"
              width="480"
              height="320"
              class="dsw-card-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <div class="dsw-card-body">
              <span class="dsw-badge-red">Krim Berat Menyumbat</span>
              <p class="dsw-card-desc">Krim pelembap yang terlalu pekat membuat pori-pori pengap dan memicu bintik bruntusan baru di dahi serta pipi.</p>
            </div>
          </article>

          <article class="dsw-card">
            <img
              src={`${IMG_BASE}/masalah-kulit-dehidrasi-kemerahan-150ml.webp`}
              alt="Kulit pipi tampak memerah dan terasa perih akibat skin barrier menipis"
              width="480"
              height="320"
              class="dsw-card-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <div class="dsw-card-body">
              <span class="dsw-badge-red">Barrier Haus Hidrasi</span>
              <p class="dsw-card-desc">Tanpa kompres toner mineral sebelum gel pelembap, kulit yang dehidrasi tetap terasa perih di bagian dalam.</p>
            </div>
          </article>
        </div>

        <div class="dsw-list-box">
          <p class="dsw-list-box-title">Tanda Anda Membutuhkan Paket Ini:</p>
          <div class="dsw-check-list" style="margin-top: 0;">
            <div class="dsw-check-item">
              <span class="dsw-icon-red">
                <Icon name="lucide:x" class="size-3.5" aria-hidden="true" />
              </span>
              <p class="dsw-list-text">Pipi mudah memerah saat terkena panas matahari, salah kosmetik, atau sehabis eksfoliasi</p>
            </div>
            <div class="dsw-check-item">
              <span class="dsw-icon-red">
                <Icon name="lucide:x" class="size-3.5" aria-hidden="true" />
              </span>
              <p class="dsw-list-text">Memiliki tipe kulit berminyak di zona-T namun kering mengelupas di sekitar hidung dan pipi</p>
            </div>
            <div class="dsw-check-item">
              <span class="dsw-icon-red">
                <Icon name="lucide:x" class="size-3.5" aria-hidden="true" />
              </span>
              <p class="dsw-list-text">Menginginkan paket Toner ukuran besar 150ml + Gloss Gel dengan penghematan Rp19.000</p>
            </div>
          </div>
        </div>
      </section>

      <!-- Section 4: Transformasi Nyata -->
      <section class="dsw-section">
        <h2 class="dsw-h2">
          Transformasi <span class="dsw-hl-aqua">Wajah Kalem, Halus & Bebas Pengap</span>
        </h2>
        <p class="dsw-sub" style="margin-top: 8px;">
          Perbedaan kondisi skin barrier sebelum dan sesudah rutin memakai Toner 150ml & Gloss Gel:
        </p>

        <div class="dsw-grid-2">
          <article class="dsw-card">
            <img
              src={`${IMG_BASE}/kondisi-merah-perih-bruntusan-150ml.webp`}
              alt="Kondisi kulit kemerahan, bruntusan, dan pori tampak meradang"
              width="480"
              height="320"
              class="dsw-card-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <div class="dsw-card-body">
              <span class="dsw-badge-red">Sebelum Perawatan</span>
              <p class="dsw-card-desc">Wajah tampak memerah, permukaan kasar oleh bruntusan kecil, dan minyak berlebih keluar karena dehidrasi.</p>
            </div>
          </article>

          <article class="dsw-card">
            <img
              src={`${IMG_BASE}/kondisi-kalem-halus-glassy-150ml.webp`}
              alt="Kondisi kulit tenang, halus merata, dan berkilau sehat seperti kaca"
              width="480"
              height="320"
              class="dsw-card-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <div class="dsw-card-body">
              <span class="dsw-badge-green">Rutin Toner 150ml + Gel</span>
              <p class="dsw-card-desc">Kemerahan tampak jauh lebih tenang, tekstur bruntusan menghalus, dan kulit terasa adem glassy.</p>
            </div>
          </article>
        </div>

        <div class="dsw-list-box">
          <p class="dsw-list-box-title">Tahapan Hasil Pemakaian Rutin:</p>
          <div class="dsw-check-list" style="margin-top: 0;">
            <div class="dsw-check-item">
              <span class="dsw-icon-green">
                <Icon name="lucide:check" class="size-3.5" aria-hidden="true" />
              </span>
              <p class="dsw-list-text"><strong>Minggu 1:</strong> Sensasi panas dan perih di wajah langsung terasa sejuk setiap selesai pemakaian</p>
            </div>
            <div class="dsw-check-item">
              <span class="dsw-icon-green">
                <Icon name="lucide:check" class="size-3.5" aria-hidden="true" />
              </span>
              <p class="dsw-list-text"><strong>Minggu 2–3:</strong> Bruntusan halus tampak mereda dan produksi minyak berlebih di siang hari berkurang</p>
            </div>
            <div class="dsw-check-item">
              <span class="dsw-icon-green">
                <Icon name="lucide:check" class="size-3.5" aria-hidden="true" />
              </span>
              <p class="dsw-list-text"><strong>Minggu 4–6:</strong> Skin barrier kembali kokoh, tekstur pipi mulus, dan tampak bening bercahaya</p>
            </div>
          </div>
        </div>
      </section>

      <!-- Section 5: Cara Pakai -->
      <section class="dsw-section--tinted">
        <h2 class="dsw-h2">
          Cara Pakai <span class="dsw-hl-aqua">Praktis Setiap Hari</span>
        </h2>
        <p class="dsw-sub" style="margin-top: 8px;">
          Urutan pakai pagi dan malam yang menyegarkan kulit:
        </p>

        <div class="dsw-grid-2">
          <article class="dsw-card">
            <img
              src={`${IMG_BASE}/cara-pakai-tg150-step1-toner.webp`}
              alt="Menuangkan dan menepukkan Treatment Lotion 150ml ke wajah"
              width="480"
              height="320"
              class="dsw-card-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <div class="dsw-card-body">
              <span class="dsw-badge-teal">1. Tepuk / Kompres Toner 150ml</span>
              <p class="dsw-card-desc">Tepuk <strong>Treatment Lotion 150ml</strong> ke seluruh wajah, atau kompres 3 menit di bagian pipi yang memerah.</p>
            </div>
          </article>

          <article class="dsw-card">
            <img
              src={`${IMG_BASE}/cara-pakai-tg150-step2-gloss-gel.webp`}
              alt="Mengambil Calming Barrier Gloss Gel dengan spatula lalu mengoleskan ke wajah"
              width="480"
              height="320"
              class="dsw-card-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <div class="dsw-card-body">
              <span class="dsw-badge-teal">2. Kunci dengan Gloss Gel</span>
              <p class="dsw-card-desc">Oleskan <strong>Calming Barrier Gloss Gel</strong> tipis merata di pagi hari, atau sedikit lebih tebal sebagai sleeping mask malam.</p>
            </div>
          </article>
        </div>

        <div style="margin-top: 22px; text-align: center;">
          <a href="#form-pemesanan" class="dsw-cta" data-scroll-to-form>
            <span>Pesan Toner 150ml & Gloss Gel</span>
            <Icon name="lucide:arrow-right" class="size-5" aria-hidden="true" />
          </a>
        </div>
      </section>

      <!-- Section 6: Bukti Pelanggan -->
      <section class="dsw-section">
        <h2 class="dsw-h2">
          Bukti Tekstur <span class="dsw-hl-aqua">& Kepuasan Pelanggan</span>
        </h2>
        <p class="dsw-sub" style="margin-top: 8px;">
          Testimoni pelanggan yang mengatasi kulit rewel dengan duet Toner 150ml & Gloss Gel:
        </p>

        <div class="dsw-grid-2">
          <div class="dsw-proof-cell">
            <img
              src={`${IMG_BASE}/bukti-tekstur-toner-dan-jelly-150ml.webp`}
              alt="Swatch tekstur cair Treatment Lotion dan bening water-jelly Gloss Gel di tangan"
              width="480"
              height="320"
              class="dsw-proof-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <p class="dsw-proof-OverlayCaption">100% Tekstur Ringan Bebas Minyak</p>
          </div>
          <div class="dsw-proof-cell">
            <img
              src={`${IMG_BASE}/bukti-wanita-28an-wajah-adem-150ml.webp`}
              alt="Wanita Indonesia usia 28 tahun berhijab dengan kulit tenang bebas kemerahan"
              width="480"
              height="320"
              class="dsw-proof-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <p class="dsw-proof-OverlayCaption">Kemerahan & Bruntusan Mereda</p>
          </div>
          <div class="dsw-proof-cell">
            <img
              src={`${IMG_BASE}/bukti-pori-tenang-bebas-lengket-150ml.webp`}
              alt="Close-up pipi mulus dengan kilau glassy sehat"
              width="480"
              height="320"
              class="dsw-proof-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <p class="dsw-proof-OverlayCaption">Efek Glassy Tanpa Rasa Lengket</p>
          </div>
          <div class="dsw-proof-cell">
            <img
              src={`${IMG_BASE}/bukti-meja-rias-toner-150ml-gloss.webp`}
              alt="Botol Treatment Lotion 150ml dan jar Gloss Gel 30ml di meja rias"
              width="480"
              height="320"
              class="dsw-proof-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <p class="dsw-proof-OverlayCaption">Botol 150ml Awet untuk Kompres</p>
          </div>
        </div>

        <div class="dsw-testi-list">
          <article class="dsw-testi-card">
            <div class="dsw-testi-head">
              <div class="dsw-testi-avatar" aria-hidden="true">C</div>
              <div class="dsw-testi-meta">
                <p class="dsw-testi-name">
                  Kak Citra Maharani (28 thn)
                  <span class="dsw-verified-pill">Verified Buyer</span>
                </p>
                <div class="dsw-stars">
                  <RatingStars rating={5} starClass="h-3.5 w-3.5 !fill-[#d97706] !text-[#d97706]" />
                </div>
              </div>
            </div>
            <p class="dsw-testi-body">"Penyelamat kulitku waktu lagi breakout dan merah-merah gara-gara salah eksfoliasi! Aku kompres pakai Toner 150ml terus dikunci Gloss Gel, besok paginya merah di pipi langsung kalem banget. Teksturnya dingin kayak jelly air."</p>
            <div class="dsw-testi-foot">
              <span>Bandung</span>
              <span>•</span>
              <span>Pemakaian 4 Minggu</span>
            </div>
          </article>

          <article class="dsw-testi-card">
            <div class="dsw-testi-head">
              <div class="dsw-testi-avatar" aria-hidden="true">P</div>
              <div class="dsw-testi-meta">
                <p class="dsw-testi-name">
                  Bunda Putri Lestari (32 thn)
                  <span class="dsw-verified-pill">Verified Buyer</span>
                </p>
                <div class="dsw-stars">
                  <RatingStars rating={5} starClass="h-3.5 w-3.5 !fill-[#d97706] !text-[#d97706]" />
                </div>
              </div>
            </div>
            <p class="dsw-testi-body">"Kulit kombinasi kayak aku paling cocok sama duet ini. Tonernya gede 150ml puas dipakai tiap hari, Gloss Gel-nya bikin lembap kenyal tapi sama sekali nggak bikin komedo atau bruntusan."</p>
            <div class="dsw-testi-foot">
              <span>Surabaya</span>
              <span>•</span>
              <span>Pemakaian 5 Minggu</span>
            </div>
          </article>
        </div>
      </section>

      <!-- Section 7: Tabel Perbandingan -->
      <section class="dsw-section--tinted">
        <h2 class="dsw-h2">
          Keunggulan <span class="dsw-hl-aqua">Toner 150ml & Gloss Gel</span>
        </h2>
        <p class="dsw-sub" style="margin-top: 8px;">
          Mengapa memilih Paket Toner 150ml & Gloss Gel jauh lebih hemat dan efektif dibandingkan membeli produk satuan:
        </p>

        <div class="dsw-cmp-card">
          <div class="dsw-cmp-head">
            <div class="dsw-cmp-col">Karakteristik</div>
            <div class="dsw-cmp-col dsw-cmp-col--numa">Toner 150ml + Gel</div>
            <div class="dsw-cmp-col">Beli Satuan Biasa</div>
          </div>

          <div class="dsw-cmp-row">
            <div class="dsw-cmp-cell dsw-cmp-cell--feature">Tekstur & Daya Serap</div>
            <div class="dsw-cmp-cell dsw-cmp-cell--numa">
              <span class="dsw-icon-green" style="margin: 0 auto;">
                <Icon name="lucide:check" class="size-3.5" aria-hidden="true" />
              </span>
              <span class="dsw-cmp-sub">Watery Essence + Water-Jelly Sejuk</span>
            </div>
            <div class="dsw-cmp-cell">
              <span class="dsw-icon-red" style="margin: 0 auto;">
                <Icon name="lucide:x" class="size-3.5" aria-hidden="true" />
              </span>
              <span class="dsw-cmp-sub">Krim pekat rawan menyumbat pori</span>
            </div>
          </div>

          <div class="dsw-cmp-row">
            <div class="dsw-cmp-cell dsw-cmp-cell--feature">Kandungan Penenang</div>
            <div class="dsw-cmp-cell dsw-cmp-cell--numa">
              <span class="dsw-icon-green" style="margin: 0 auto;">
                <Icon name="lucide:check" class="size-3.5" aria-hidden="true" />
              </span>
              <span class="dsw-cmp-sub">Ulleung Water + Meadowestolide + Astragalus</span>
            </div>
            <div class="dsw-cmp-cell">
              <span class="dsw-icon-red" style="margin: 0 auto;">
                <Icon name="lucide:x" class="size-3.5" aria-hidden="true" />
              </span>
