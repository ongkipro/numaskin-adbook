---
import BaseLayout from '../layouts/BaseLayout.astro';
import GeoIpResolvedForm from '../components/storefront/forms/GeoIpResolvedForm.astro';
import MetaLandingTracker from '../components/storefront/tracking/MetaLandingTracker.astro';
import Icon from '../components/storefront/shared/Icon.astro';
import RatingStars from '../components/storefront/shared/RatingStars.astro';
import LpHeroOffer from '../components/storefront/landing-pages/LpHeroOffer.astro';
import LpBundleValueSection, {
  type BundleTierSpec,
} from '../components/storefront/landing-pages/LpBundleValueSection.astro';
import LpFloatingCta from '../components/storefront/landing-pages/LpFloatingCta.astro';
import { getStorefrontProduct } from '../lib/catalog';
import { nativeLandingCanonicalPath } from '../lib/landing-pages';
import { defaultCatalogContentId } from '../lib/catalog-feed';
import { getRuntimeEnv } from '../lib/env';
import { loadStoreCodDisabledProvinceCodes } from '../lib/form-mode';
import { getStoreAdsConfig } from '../lib/store-ads';
import '../styles/form-hybrid.css';
import '../styles/landing-pages/lp-meta-ads.css';

export const prerender = false;

const PRODUCT_SLUG = 'paket-luminous-duo';
const LANDING_SLUG = 'lp-paket-nad-pdrn';
const PAGE_TITLE =
  'Paket Duet NAD+ & PDRN (Luminous Duo) — NAD+ Booster Serum + PDRN Tone-Up Day Cream BPOM';
const PAGE_DESC =
  'Duet aktif premium Numa Skin: NAD+ Booster Serum 20ml (2% Swiss RejuveNAD™ + 6X Peptide) + PDRN Alpha Arbutin Tone-Up Day Cream 30g (10.000 PPM Encapsulated PDRN, Warm Beige bebas abu-abu) hemat Rp19.000.';
const IMG_BASE = '/images/landing/paket-luminous-duo';
const HERO_IMAGE = `${IMG_BASE}/hero-paket-luminous-duo.webp`;

const database = getRuntimeEnv(Astro.locals)?.OMS_DB as D1Database | undefined;
const claimedProductSlug = Astro.request.headers.get('x-adsbook-product-page');
const [product, canonicalPath, codDisabledProvinceCodes] = await Promise.all([
  getStorefrontProduct(Astro.locals, PRODUCT_SLUG),
  claimedProductSlug
    ? Promise.resolve(`/produk/${claimedProductSlug}`)
    : nativeLandingCanonicalPath(Astro.locals, LANDING_SLUG),
  loadStoreCodDisabledProvinceCodes(database),
  getStoreAdsConfig(Astro.locals),
]);
if (!product) {
  return Astro.rewrite('/404');
}

const canonical = `${Astro.locals.tenant.siteUrl}${canonicalPath}`;

const variants = product.variants || [];
const cheapestVariant = variants.reduce(
  (min: any, v: any) => (!min || v.price < min.price ? v : min),
  variants[0]
);
const defaultVariant = cheapestVariant || {
  id: '31',
  label: 'NAD+ Serum 20ml + Day Cream 30gr',
  price: 169500,
  comparePrice: 188498,
};

const BUNDLE_TIERS: BundleTierSpec[] = [
  {
    productSlug: 'paket-luminous-duo',
    badge: 'Paket Utama • Duo Sultan NAD+ & PDRN',
    featured: true,
    image: `${IMG_BASE}/kemasan-luminous-duo-nad-pdrn.webp`,
    imageAlt: 'Paket Luminous Duo NAD+ Booster Serum dan PDRN Tone-Up Day Cream',
    benefit: 'NAD+ Booster Serum 20ml (2% RejuveNAD™ + 6X Peptide) + PDRN Day Cream 30gr (10.000 PPM PDRN Warm Beige).',
    ctaLabel: 'Ambil Paket Duo',
  },
  {
    productSlug: 'paket-anti-aging-trio',
    badge: 'Upgrade Trio Anti-Aging (NAD+ + Adenosine + SPF 50+)',
    image: '/images/landing/paket-anti-aging-trio/kemasan-trio-nad-adenosine-oxydew.webp',
    imageAlt: 'Paket Anti-Aging Trio Numa Skin',
    benefit: 'Perawatan 3-in-1 lengkap: NAD+ Booster Serum + Adenosine Moisturizer 30gr + Oxydew Sunscreen SPF 50+ 30ml.',
    ctaLabel: 'Upgrade ke Trio',
  },
  {
    productSlug: 'nad-booster-anti-aging-serum',
    badge: 'Opsi NAD+ Booster Serum Saja',
    image: '/images/landing/nad-booster-anti-aging-serum/kemasan-nad-serum-27ml.webp',
    imageAlt: 'NAD+ Booster Anti-Aging Serum Numa Skin',
    benefit: '1 Botol NAD+ Booster Serum (2% Swiss RejuveNAD™ + 6X Peptide Complex) untuk perawatan elastisitas pagi & malam.',
    ctaLabel: 'Pilih NAD+ Serum',
  },
];
---

<BaseLayout
  title={PAGE_TITLE}
  description={PAGE_DESC}
  image={HERO_IMAGE}
  preloadImages={HERO_IMAGE}
  canonical={canonical}
  noindex={true}
  hideHeader={true}
  hideFooter={true}
>
  <MetaLandingTracker
    slug={LANDING_SLUG}
    contentId={defaultCatalogContentId(product)}
    contentName={product.contentName}
    price={defaultVariant.price}
  />

  <div class="dsw-shell">
    <main class="dsw-canvas">
      <!-- Section 1: Hero -->
      <section id="hero-section" class="dsw-hero">
        <div class="dsw-hero-head">
          <h1 class="dsw-h1">
            Pipi Kendur & Bedak Dempul <span class="dsw-hl-tilt">Nyangkut di Garis Senyum?</span> Kencangkan Kontur + Cerah Tanpa Bedak Tebal!
          </h1>
          <p class="dsw-sub" style="max-width: 390px; margin: 14px auto 0; font-weight: 700;">
            Menutupi kulit lelah dengan foundation tebal justru memperjelas lipatan kerutan wajah.<br />
            <span class="dsw-underline-teal">Padukan 2% Swiss RejuveNAD™ + 10.000 PPM Encapsulated PDRN!</span>
          </p>
        </div>

        <div class="dsw-hero-stage">
          <div class="dsw-hero-top-tag">
            <div class="dsw-hero-top-pill">
              <Icon name="lucide:award" class="size-3.5" aria-hidden="true" />
              <span>Duo Sultan NAD+ & PDRN • Hemat Rp19.000</span>
            </div>
          </div>

          <img
            src={HERO_IMAGE}
            alt="Perbandingan wajah kendur dempul di garis senyum vs kulit kencang cerah natural warm-beige dengan Paket Luminous Duo Numa Skin"
            width="720"
            height="480"
            class="dsw-hero-img"
            fetchpriority="high"
            loading="eager"
            decoding="async"
          />

          <div class="dsw-hero-ba" aria-hidden="true">
            <span class="dsw-hero-ba-pill dsw-hero-ba-pill--before">SEBELUM — Kendur & Dempul Pecah</span>
            <span class="dsw-hero-ba-pill dsw-hero-ba-pill--after">SESUDAH — Kontur Kencang & Cerah</span>
          </div>

          <div class="dsw-hero-overlap">
            <div class="dsw-hero-overlap-inner">
              <h2 class="dsw-hero-overlap-title">Jangan Tutupi Kulit Lelah dengan Dempul Putih Abu-Abu!</h2>
              <p class="dsw-hero-overlap-text">
                Di usia 35+, kulit membutuhkan <strong style="color: #be123c;">serum pengangkat kontur sekaligus krim pagi warna Warm Beige yang menyatu di kulit sawo matang tanpa menyumbat garis halus</strong>.
              </p>
            </div>
          </div>
        </div>

        <div class="dsw-trust-row">
          <div class="dsw-trust-item">
            <span class="dsw-trust-icon">
              <Icon name="lucide:shield-check" class="size-4" aria-hidden="true" />
            </span>
            <div>
              <span class="dsw-trust-label">2 BPOM Resmi</span>
              <span class="dsw-trust-sub">NA18262000245/6</span>
            </div>
          </div>
          <div class="dsw-trust-item">
            <span class="dsw-trust-icon">
              <Icon name="lucide:badge-check" class="size-4" aria-hidden="true" />
            </span>
            <div>
              <span class="dsw-trust-label">Halal RI</span>
              <span class="dsw-trust-sub">10.000 PPM PDRN</span>
            </div>
          </div>
          <div class="dsw-trust-item">
            <span class="dsw-trust-icon">
              <Icon name="lucide:truck" class="size-4" aria-hidden="true" />
            </span>
            <div>
              <span class="dsw-trust-label">Bisa COD</span>
              <span class="dsw-trust-sub">Bayar di Rumah</span>
            </div>
          </div>
        </div>

        <LpHeroOffer
          price={defaultVariant.price}
          comparePrice={defaultVariant.comparePrice}
          eyebrow="Duet Aktif Premium 2% NAD+ Peptide & 10.000 PPM PDRN"
          ctaText="Ambil Paket Hemat Sekarang"
        />
      </section>

      <!-- Section 2: Solusi Singkat + Visual -->
      <section class="dsw-section">
        <h2 class="dsw-h2">
          Perpaduan <span class="dsw-hl-aqua">2 bahan aktif unggulan</span> dalam 1 paket
        </h2>
        <p class="dsw-sub">Menggabungkan teknologi Longevity NAD+ Swiss dengan 10.000 PPM Encapsulated PDRN.</p>

        <div class="dsw-photo-stack">
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/solusi-lifting-dan-toneup-alami.webp`}
              alt="Wanita Indonesia usia 38 tahun dengan kulit wajah kencang, mulus, dan cerah merata natural tanpa bedak tebal"
              width="648"
              height="432"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
          </div>
        </div>

        <div class="dsw-list">
          <div class="dsw-list-row">
            <span class="dsw-icon-teal">
              <Icon name="lucide:layers" class="size-4" aria-hidden="true" />
            </span>
            <p class="dsw-list-text">
              <strong style="color: #0f172a;">NAD+ Booster Serum (20 ml):</strong> Merawat kekencangan kontur pipi & menghaluskan tekstur kering dengan 2% Swiss RejuveNAD™, 6X Peptide Complex, & 4% Niacinamide.
            </p>
          </div>
          <div class="dsw-list-row">
            <span class="dsw-icon-teal">
              <Icon name="lucide:sun-dim" class="size-4" aria-hidden="true" />
            </span>
            <p class="dsw-list-text">
              <strong style="color: #0f172a;">PDRN + Alpha Arbutin Tone-Up Day Cream (30 gr):</strong> Merawat elastisitas kulit dengan 1% Encapsulated PDRN (10.000 PPM) + 2% Alpha-Arbutin serta efek cerah instan Warm Beige bebas abu-abu.
            </p>
          </div>
          <div class="dsw-list-row">
            <span class="dsw-icon-teal">
              <Icon name="lucide:badge-check" class="size-4" aria-hidden="true" />
            </span>
            <p class="dsw-list-text">
              <strong style="color: #0f172a;">Hemat Rp18.998 (Cuma Rp169.500):</strong> Perawatan intensif harian dengan 2 produk ukuran penuh ber-BPOM.
            </p>
          </div>
        </div>
      </section>

      <!-- Section 3: Tanda Masalah Kulit + Visual Grid -->
      <section class="dsw-section dsw-section--warn">
        <h2 class="dsw-h2">
          Kenapa riasan pagi selalu <span class="dsw-underline-warn">retak di kerutan & bikin muka tua</span> di usia 35+?
        </h2>

        <div class="dsw-photo-grid-2">
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/masalah-bedak-masuk-kerutan.webp`}
              alt="Close-up bedak atau foundation yang menggumpal dan retak di garis senyum serta bawah mata"
              width="315"
              height="210"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <p class="dsw-photo-caption">
              <strong style="color: #be123c; display: block;">Dempul Pecah di Garis Senyum</strong>
              Saat kolagen pipi kendur, bedak tebal langsung terjebak di lipatan kerutan.
            </p>
          </div>
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/masalah-wajah-lelah-kusam-pagi.webp`}
              alt="Kerutan sudut mata dan flek hitam membandel di wajah usia 35+"
              width="315"
              height="210"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <p class="dsw-photo-caption">
              <strong style="color: #be123c; display: block;">Kerutan Mata & Flek Hitam</strong>
              Tanpa 6X Peptide & Alpha-Arbutin, kerutan dan noda gelap makin tegas.
            </p>
          </div>
        </div>

        <div class="dsw-list">
          <div class="dsw-list-row">
            <span class="dsw-icon-warn">
              <Icon name="lucide:triangle-alert" class="size-4" aria-hidden="true" />
            </span>
            <p class="dsw-list-text">
              Tiap pakai bedak atau foundation pagi hari, <strong style="color: #be123c;">garis senyum dan kerutan bawah mata justru makin terlihat retak (cakey)</strong>.
            </p>
          </div>
          <div class="dsw-list-row">
            <span class="dsw-icon-warn">
              <Icon name="lucide:triangle-alert" class="size-4" aria-hidden="true" />
            </span>
            <p class="dsw-list-text">
              Krim tone-up putih biasa membuat <strong style="color: #be123c;">flek hitam di kulit sawo matang berubah abu-abu seperti topeng</strong>.
            </p>
          </div>
          <div class="dsw-list-row">
            <span class="dsw-icon-warn">
              <Icon name="lucide:triangle-alert" class="size-4" aria-hidden="true" />
            </span>
            <p class="dsw-list-text">
              Ingin wajah kencang, cerah, dan flek tertutup mulus dalam 2 menit <strong style="color: #be123c;">tanpa harus dempul tebal berlapis-lapis</strong>.
            </p>
          </div>
        </div>
      </section>

      <!-- Section 4: Ilustrasi Perawatan Rutin -->
      <section class="dsw-section">
        <h2 class="dsw-h2">
          Bukti nyata perubahan <span class="dsw-hl-aqua">Luminous Duo NAD+ & PDRN</span>
        </h2>
        <p class="dsw-sub">Tarikan kontur dari dalam berpadu dengan efek cerah sehat seketika di permukaan.</p>

        <div class="dsw-photo-stack">
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/kondisi-kendur-kusam-retak.webp`}
              alt="Kondisi pipi kendur, kusam bernoda flek hitam, dan riasan tampak retak di garis halus"
              width="648"
              height="432"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <span class="dsw-photo-badge dsw-photo-badge--before">SEBELUM — Kendur, Flek & Retak</span>
            <p class="dsw-photo-caption">
              Garis lipatan senyum tampak dalam, flek hitam membayang keabuan, dan krim biasa menggumpal di pori.
            </p>
          </div>

          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/kondisi-kencang-glowing-natural.webp`}
              alt="Kondisi pipi tampak kencang, halus, dan cerah satin-dewy merata berkat Paket Luminous Duo"
              width="648"
              height="432"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <span class="dsw-photo-badge dsw-photo-badge--after">SESUDAH RUTIN — Kencang & Cerah Alami</span>
            <p class="dsw-photo-caption">
              Permukaan kulit kencang terawat oleh NAD+ Serum, lalu PDRN Warm Beige menyamarkan flek menjadi cerah segar tanpa bedak.
            </p>
          </div>
        </div>
      </section>

      <!-- Section 5: Dark Marine Section — Cara Pakai Praktis -->
      <section class="dsw-section dsw-section--dark">
        <h2 class="dsw-h2">
          Urutan Pakai <span style="color: #99e2ec;">Siap Tampil Cerah Kencang</span>
        </h2>
        <p class="dsw-sub">Serum menyiapkan kanvas kulit yang kenyal agar Day Cream menyatu sehalus sutra.</p>

        <div class="dsw-photo-stack">
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/cara-pakai-luminous-step1-nad.webp`}
              alt="Langkah 1 meneteskan NAD+ Booster Serum dan memijat ke arah atas"
              width="648"
              height="432"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <p class="dsw-photo-caption">
              <strong style="color: #ffffff;">Langkah 1 (Pagi & Malam — NAD+ Serum):</strong> Teteskan 3–4 tetes serum, pijat ke arah atas di garis senyum dan tulang pipi.
            </p>
          </div>
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/cara-pakai-luminous-step2-pdrn.webp`}
              alt="Langkah 2 meratakan PDRN Tone-Up Day Cream berwarna warm beige di pagi hari"
              width="480"
              height="320"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <p class="dsw-photo-caption">
              <strong style="color: #ffffff;">Langkah 2 (Pagi Hari — PDRN Tone-Up Cream):</strong> Ambil seujung jari krim Warm Beige, totolkan tipis dan baurkan merata ke wajah.
            </p>
          </div>
        </div>

        <div class="dsw-list">
          <div class="dsw-list-row">
            <span class="dsw-step-num">1</span>
            <p class="dsw-step-text">
              <strong style="color: #ffffff;">Langkah 1 (NAD+ Serum):</strong> Dipakai pagi & malam untuk merawat kontur dan menghidrasi garis halus.
            </p>
          </div>
          <div class="dsw-list-row">
            <span class="dsw-step-num">2</span>
            <p class="dsw-step-text">
              <strong style="color: #ffffff;">Langkah 2 (PDRN Day Cream):</strong> Dipakai pagi hari setelah serum meresap untuk <strong style="color: #ffffff; background: #104452; padding: 1px 6px; border-radius: 4px;">efek cerah natural tanpa foundation</strong>.
            </p>
          </div>
          <div class="dsw-list-row">
            <span class="dsw-step-num">3</span>
            <p class="dsw-step-text">
              Krim berwarna Warm Natural Beige langsung menyatu di kulit sawo matang dalam 10 detik.
            </p>
          </div>
        </div>
      </section>

      <!-- Section 6: Ulasan Pelanggan -->
      <section class="dsw-section">
        <h2 class="dsw-h2">
          Alasan paket ini jadi <span class="dsw-hl-aqua">favorit wanita karier & Bunda</span>
        </h2>
        <p class="dsw-sub">Wajah tampak kencang terawat sekaligus langsung cerah rapi setiap pagi.</p>

        <div class="dsw-reviews-divide">
          <div class="dsw-review-row">
            <div class="dsw-review-head">
              <div>
                <p class="dsw-review-author">
                  Ibu Clarissa T.
                  <span style="color: #0b6e7d; display: inline-flex;">
                    <Icon name="lucide:badge-check" class="size-4" aria-hidden="true" />
                  </span>
                </p>
                <p class="dsw-review-meta">Jakarta Barat • Usia 39 Tahun</p>
              </div>
              <RatingStars rating={5} starClass="h-3.5 w-3.5 !fill-[#d97706] !text-[#d97706]" />
            </div>
            <p class="dsw-review-quote">
              "Kombinasi paling mewah! <span class="dsw-hl-aqua">NAD+ Serumnya bikin kulit kenyal kencang, pas ditimpa PDRN Day Cream langsung nempel mulus</span> kayak gak pakai dempul tapi cerah banget."
            </p>
          </div>
          <div class="dsw-review-row">
            <div class="dsw-review-head">
              <div>
                <p class="dsw-review-author">
                  Bunda Rina M.
                  <span style="color: #0b6e7d; display: inline-flex;">
                    <Icon name="lucide:badge-check" class="size-4" aria-hidden="true" />
                  </span>
                </p>
                <p class="dsw-review-meta">Depok • Kulit Sawo Matang</p>
              </div>
              <RatingStars rating={5} starClass="h-3.5 w-3.5 !fill-[#d97706] !text-[#d97706]" />
            </div>
            <p class="dsw-review-quote">
              "Biasanya pakai krim pagi suka ngumpul di garis senyum. <strong style="color: #0f172a;">Karena pakai NAD+ Serum dulu sebelumnya</strong>, <span class="dsw-hl-aqua">krim PDRN-nya nyatu sempurna dan bebas abu-abu</span>."
            </p>
          </div>
          <div class="dsw-review-row">
            <div class="dsw-review-head">
              <div>
                <p class="dsw-review-author">
                  Kak Yuni S.
                  <span style="color: #0b6e7d; display: inline-flex;">
                    <Icon name="lucide:badge-check" class="size-4" aria-hidden="true" />
                  </span>
                </p>
                <p class="dsw-review-meta">Makassar • Hemat Rp19.000</p>
              </div>
              <RatingStars rating={5} starClass="h-3.5 w-3.5 !fill-[#d97706] !text-[#d97706]" />
            </div>
            <p class="dsw-review-quote">
              "Dapet <span class="dsw-hl-rose">NAD+ plus 1% Encapsulated PDRN 10.000 PPM cuma 169 ribuan</span> itu hemat banget. <span class="dsw-hl-aqua">Flek hitam memudar dan gak perlu beli foundation lagi</span>."
            </p>
          </div>
        </div>
      </section>

      <!-- Section 7: Galeri Bukti Visual -->
      <section class="dsw-section dsw-section--tint">
        <h2 class="dsw-h2">
          Kombinasi aktif untuk <span style="color: #0b6e7d;">tampilan muda bercahaya</span>
        </h2>
        <p class="dsw-sub">Perawatan elastisitas seluler malam hari dan pencerah regeneratif di pagi hari.</p>

        <div class="dsw-photo-grid-2">
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/bukti-tekstur-nad-dan-pdrn.webp`}
              alt="Perbandingan tekstur emulsi NAD+ Serum dan krim warm-beige PDRN Day Cream di tangan"
              width="315"
              height="210"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
          </div>
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/bukti-wanita-cerah-kencang-pagi.webp`}
              alt="Potret wanita Indonesia tersenyum anggun dengan wajah cerah natural dan kencang"
              width="315"
              height="210"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
          </div>
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/bukti-kulit-mulus-tanpa-cakey.webp`}
              alt="Close-up pipi halus bercahaya satin-dewy tanpa riasan retak"
              width="315"
              height="210"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
          </div>
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/bukti-meja-rias-luminous-duo.webp`}
              alt="Kemasan Paket Luminous Duo NAD+ Serum dan PDRN Day Cream di meja rias"
              width="315"
              height="210"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
          </div>
        </div>
      </section>

