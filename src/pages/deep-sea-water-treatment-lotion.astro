---
import BaseLayout from '../layouts/BaseLayout.astro';
import GeoIpResolvedForm from '../components/storefront/forms/GeoIpResolvedForm.astro';
import MetaLandingTracker from '../components/storefront/tracking/MetaLandingTracker.astro';
import Icon from '../components/storefront/shared/Icon.astro';
import { getStorefrontProduct } from '../lib/catalog';
import { nativeLandingCanonicalPath } from '../lib/landing-pages';
import { defaultCatalogContentId } from '../lib/catalog-feed';
import { formatIdr } from '../lib/format-idr';
import '../styles/numaskin.css';
import '../styles/form-hybrid.css';
import '../styles/landing-pages/deep-sea-water-treatment-lotion.css';

export const prerender = false;

const PRODUCT_SLUG = 'deep-sea-water-treatment-lotion';
const LANDING_SLUG = 'deep-sea-water-treatment-lotion';
const PAGE_TITLE = 'Deep Sea Water Treatment Lotion — Hydrating Toner & First Essence | Numa Skin';
const PAGE_DESC =
  '2-in-1 Hydrating Toner & First Essence dengan Ulleung Island Deep Sea Water, Galactomyces, Ceramide, dan Hyaluronic Acid. Melembapkan sejak langkah pertama, menenangkan kemerahan, dan merawat skin barrier. BPOM NA18220101400.';
const HERO_IMAGE =
  '/images/landing/deep-sea-water-treatment-lotion/hero-treatment-lotion.webp';

const product = await getStorefrontProduct(Astro.locals, PRODUCT_SLUG);
if (!product) {
  return Astro.rewrite('/404');
}

const canonical = `${Astro.locals.tenant.siteUrl}${await nativeLandingCanonicalPath(Astro.locals, LANDING_SLUG)}`;

const variants = product.variants || [];
const cheapestVariant = variants.reduce(
  (min: any, v: any) => (!min || v.price < min.price ? v : min),
  variants[0]
);
const defaultVariant = cheapestVariant || {
  id: '4',
  label: '50ml',
  price: 79000,
  comparePrice: 125000,
};

const sizeMetaByLabel: Record<string, { badge: string; note: string }> = {
  '50ml': {
    badge: 'Ukuran Coba & Travel',
    note: 'Praktis dibawa bepergian (±3–4 minggu pemakaian)',
  },
  '150ml': {
    badge: 'Paling Laris · Best Value',
    note: 'Ukuran favorit untuk kompres kapas CSM (±2–3 bulan)',
  },
  '2× 150ml': {
    badge: 'Paket Stok Hemat',
    note: 'Lebih hemat Rp36.200/botol untuk pemakaian rutin pagi & malam',
  },
};
---

<BaseLayout
  title={PAGE_TITLE}
  description={PAGE_DESC}
  image={HERO_IMAGE}
  preloadImages={HERO_IMAGE}
  canonical={canonical}
  hideHeader={true}
  hideFooter={true}
>
  <MetaLandingTracker
    slug={LANDING_SLUG}
    contentId={defaultCatalogContentId(product)}
    contentName={product.contentName}
    price={defaultVariant.price}
  />

  <main class="dsw-page">
    <!-- Distraction-free Numa Skin Brand Strip -->
    <div class="dsw-top-band">
      COD tersedia untuk sebagian besar wilayah · Terdaftar BPOM <strong>NA18220101400</strong>
    </div>
    <header class="dsw-brand-header">
      <div class="dsw-brand-header-inner">
        <div class="dsw-wordmark" aria-label="Numa Skin">
          <span class="dsw-wordmark-main">NUMA·SKIN</span>
          <span class="dsw-wordmark-jp" lang="ja">ヌマスキン</span>
        </div>
        <span class="dsw-bpom-chip">
          <Icon name="lucide:shield-check" class="size-3.5 text-[#0b6e7d]" aria-hidden="true" />
          Dermatologically Tested
        </span>
      </div>
    </header>

    <div class="dsw-shell">
      <!-- SECTION 1: HERO -->
      <section class="dsw-hero">
        <div class="dsw-kicker">
          <span class="dsw-kicker-dot" aria-hidden="true"></span>
          <span>2-in-1 Hydrating Toner &amp; First Essence · pH Balance Formula</span>
        </div>

        <h1 class="dsw-hero-title">
          Kulit Terasa Ketarik Setelah Cuci Muka dan Skincare Sulit Meresap? Rawat <span class="dsw-brush">Hidrasi Skin Barrier</span> Sejak Langkah Pertama.
        </h1>

        <p class="dsw-lead">
          Kombinasi <strong>Ulleung Island Deep Sea Water</strong> yang kaya 72+ mineral alami, <strong>Galactomyces Ferment Filtrate</strong>, <strong>Ceramide</strong>, dan <strong>Hyaluronic Acid</strong> untuk membantu menjaga kelembapan kulit setelah mencuci wajah—tanpa rasa lengket, tanpa alkohol pengering, dan tanpa pewangi menyengat.
        </p>

        <figure class="dsw-hero-figure">
          <img
            src="/images/landing/deep-sea-water-treatment-lotion/hero-treatment-lotion.webp"
            alt="Botol Numa Skin Deep Sea Water Treatment Lotion di atas permukaan air mineral laut dalam yang jernih"
            width="1000"
            height="667"
            fetchpriority="high"
            loading="eager"
            decoding="async"
          />
          <figcaption class="dsw-hero-caption">
            <span><strong>Deep Sea Water Treatment Lotion</strong> · pH 5.5 Seimbang</span>
            <span>4,93/5 dari <strong>2.990+ Botol Terjual</strong></span>
          </figcaption>
        </figure>

        <div class="dsw-pill-grid" role="list" aria-label="Keunggulan utama produk">
          <div class="dsw-pill" role="listitem">
            <span class="dsw-pill-title">Ulleung Deep Sea</span>
            <span class="dsw-pill-sub">Mineral Laut Dalam</span>
          </div>
          <div class="dsw-pill" role="listitem">
            <span class="dsw-pill-title">BPOM &amp; Halal</span>
            <span class="dsw-pill-sub">NA18220101400</span>
          </div>
          <div class="dsw-pill" role="listitem">
            <span class="dsw-pill-title">Bisa COD</span>
            <span class="dsw-pill-sub">Bayar Saat Tiba</span>
          </div>
        </div>

        <aside class="dsw-callout" aria-label="Ringkasan manfaat">
          <p>
            <strong>Mengapa langkah pertama setelah cuci muka menentukan hasil skincare Anda?</strong> Sabun pembersih wajah sering kali ikut mengangkat kelembapan alami kulit. Memakai serum atau krim langsung di atas kulit yang kering dan ketarik membuat bahan aktif sulit meresap. <strong>Deep Sea Water Treatment Lotion</strong> bekerja sebagai <em>jalur pembuka hidrasi (first essence)</em> yang menyiapkan kulit agar kembali lembap, tenang, dan siap menyerap nutrisi berikutnya.
          </p>
        </aside>
      </section>

      <!-- SECTION 2: KELUHAN KULIT (PAIN POINTS) -->
      <section class="dsw-section">
        <h2 class="dsw-section-title">
          Mengapa Wajah Masih Kusam, Kemerahan, atau Bruntusan Meski Sudah Pakai Serum dan Krim?
        </h2>
        <span class="dsw-rule" aria-hidden="true"></span>
        <p class="dsw-lead">
          Banyak perempuan Indonesia berusia 25–45 tahun mengira masalah kulitnya butuh krim yang lebih mahal—padahal akar masalahnya ada pada <strong>dehidrasi lapisan permukaan (skin barrier)</strong> tepat setelah mencuci wajah:
        </p>

        <ul class="dsw-pain-list">
          <li class="dsw-pain-item">
            <div class="dsw-pain-icon" aria-hidden="true">
              <Icon name="lucide:droplets" class="size-5" />
            </div>
            <div>
              <h3 class="dsw-pain-title">Kulit Terasa Kencang Ketarik &amp; Mengelupas Halus Setelah Cuci Muka</h3>
              <p class="dsw-pain-desc">
                Saat pH kulit bergeser menjadi terlalu basa habis mencuci wajah, kelembapan menguap dengan cepat. Akibatnya area pipi dan sekitar mulut terasa kering, kasar, dan riasan mudah <em>crack</em> atau menggumpal.
              </p>
            </div>
          </li>

          <li class="dsw-pain-item">
            <div class="dsw-pain-icon" aria-hidden="true">
              <Icon name="lucide:shield-alert" class="size-5" />
            </div>
            <div>
              <h3 class="dsw-pain-title">Mudah Kemerahan, Perih di Ruangan Ber-AC, atau Reaktif Saat Ganti Cuaca</h3>
              <p class="dsw-pain-desc">
                Paparan AC seharian, terik matahari tropis, atau pemakaian bahan aktif eksfoliasi/retinol membuat <em>skin barrier</em> menipis. Kulit menjadi gampang memerah, terasa panas, dan muncul bruntusan halus akibat dehidrasi.
              </p>
            </div>
          </li>

          <li class="dsw-pain-item">
            <div class="dsw-pain-icon" aria-hidden="true">
              <Icon name="lucide:layers" class="size-5" />
            </div>
            <div>
              <h3 class="dsw-pain-title">Serum &amp; Pelembap Hanya Mengambang di Permukaan Wajah</h3>
              <p class="dsw-pain-desc">
                Ibarat meneteskan air ke atas spons yang kering kerontang, krim dan serum yang dioleskan ke kulit yang belum terhidrasi cenderung menumpuk di permukaan, terasa lengket atau berminyak di luar, namun tetap kering di bagian dalam.
              </p>
            </div>
          </li>
        </ul>
      </section>

      <!-- SECTION 3: 2x2 PHYSICAL COMPARISON GRID -->
      <section class="dsw-section">
        <h2 class="dsw-section-title">
          Perbedaan Nyata Kulit yang Langsung Diberi Krim vs Kulit yang Disiapkan dengan <span class="dsw-brush">Treatment Lotion</span>
        </h2>
        <span class="dsw-rule" aria-hidden="true"></span>
        <p class="dsw-lead">
          Perhatikan bagaimana tekstur permukaan kulit dan daya serap nutrisi berubah ketika Anda mengembalikan hidrasi mineral terlebih dahulu setelah mencuci wajah:
        </p>

        <!-- Row 1: Skin Surface Condition -->
        <div class="dsw-compare-pair">
          <figure class="dsw-compare-card dsw-compare-card--warn">
            <div class="dsw-compare-media">
              <img
                src="/images/landing/deep-sea-water-treatment-lotion/kondisi-kulit-dehidrasi-kasar.webp"
                alt="Tekstur kulit pipi yang kering, ketarik, mengelupas halus, dan kemerahan akibat dehidrasi"
                width="760"
                height="507"
                loading="lazy"
                decoding="async"
              />
              <span class="dsw-compare-tag dsw-compare-tag--warn">Tanpa First Essence</span>
            </div>
            <figcaption class="dsw-compare-body">
              <strong>Tekstur Kering, Ketarik &amp; Kemerahan</strong>
              Setelah cuci muka, kelembapan menguap. Garis dehidrasi halus terlihat jelas, pori tampak kasar, dan kulit mudah memerah saat terkena udara dingin AC atau panas matahari.
            </figcaption>
          </figure>

          <figure class="dsw-compare-card dsw-compare-card--good">
            <div class="dsw-compare-media">
              <img
                src="/images/landing/deep-sea-water-treatment-lotion/kondisi-kulit-lembap-seimbang.webp"
                alt="Tekstur kulit wajah yang lembap, kenyal, tenang, dan bercahaya sehat setelah memakai Deep Sea Water Treatment Lotion"
                width="760"
                height="507"
                loading="lazy"
                decoding="async"
              />
              <span class="dsw-compare-tag dsw-compare-tag--good">Dengan Treatment Lotion</span>
            </div>
            <figcaption class="dsw-compare-body">
              <strong>Terasa Lembap, Kenyal &amp; Tenang</strong>
              Tetesan air laut dalam Ulleung dan Ceramide membantu menenangkan kulit yang ketarik. Permukaan kulit terasa sejuk, halus, kenyal (<em>plumpy</em>), dan siap menerima perawatan berikutnya.
            </figcaption>
          </figure>
        </div>

        <!-- Row 2: Cellular Absorption Pathway -->
        <div class="dsw-compare-pair">
          <figure class="dsw-compare-card dsw-compare-card--warn">
            <div class="dsw-compare-media">
              <img
                src="/images/landing/deep-sea-water-treatment-lotion/daya-serap-tanpa-toner.webp"
                alt="Ilustrasi lapisan kulit kering di mana krim pelembap mengendap di permukaan tanpa meresap optimal"
                width="760"
                height="507"
                loading="lazy"
                decoding="async"
              />
              <span class="dsw-compare-tag dsw-compare-tag--warn">Krim Mengendap di Atas</span>
            </div>
            <figcaption class="dsw-compare-body">
              <strong>Jalur Serap Tertutup Sel Kulit Kering</strong>
              Sel epidermis yang mengering rapat membuat molekul serum dan pelembap tertahan di luar. Wajah terasa berat dan kusam, sementara lapisan dalam tetap kehausan.
            </figcaption>
          </figure>

          <figure class="dsw-compare-card dsw-compare-card--good">
            <div class="dsw-compare-media">
              <img
                src="/images/landing/deep-sea-water-treatment-lotion/daya-serap-dengan-treatment-lotion.webp"
                alt="Ilustrasi lapisan kulit terhidrasi di mana molekul mineral air laut dalam dan hyaluronic acid meresap hingga ke sela lapisan epidermis"
                width="760"
                height="507"
                loading="lazy"
                decoding="async"
              />
              <span class="dsw-compare-tag dsw-compare-tag--good">Jalur Hidrasi Terbuka</span>
            </div>
            <figcaption class="dsw-compare-body">
              <strong>Ion Mineral Membuka Jalur Penyerapan</strong>
              Ukuran molekul air mineral laut dalam yang ringan meresap tanpa rasa lengket, mengisi celah kelembapan dan membantu serum serta krim malam bekerja lebih optimal.
            </figcaption>
          </figure>
        </div>
      </section>

      <!-- SECTION 4: DARK MARINE TIMELINE (BIOLOGICAL HYDRATION SEQUENCE) -->
      <section class="dsw-marine-band" aria-labelledby="heading-fase-hidrasi">
        <h2 id="heading-fase-hidrasi" class="dsw-section-title">
          4 Tahap Kerja Formulasi Hidrasi &amp; Perawatan Skin Barrier
        </h2>
        <span class="dsw-rule" aria-hidden="true"></span>
        <p class="dsw-lead">
          Bukan sekadar penyegar biasa. Setiap tetes Numa Skin Deep Sea Water Treatment Lotion dirancang bekerja secara sinergis dari permukaan hingga ke lapisan epidermis:
        </p>

        <ol class="dsw-timeline">
          <li class="dsw-timeline-step">
            <span class="dsw-timeline-node" aria-hidden="true">1</span>
            <span class="dsw-timeline-time">Tahap 1 · Keseimbangan pH Pasca-Cuci Wajah</span>
            <h3 class="dsw-timeline-title">Menyeimbangkan Kembali pH &amp; Meredakan Sensasi Ketarik</h3>
            <p class="dsw-timeline-desc">
              Begitu ditepuk lembut ke wajah, ion mineral <em>Ulleung Island Deep Sea Water</em> dan <em>Allantoin</em> membantu mengurangi sensasi kencang ketarik pasca-cuci muka serta menjaga pH fisiologis kulit pada kisaran seimbang.
            </p>
          </li>

          <li class="dsw-timeline-step">
            <span class="dsw-timeline-node" aria-hidden="true">2</span>
            <span class="dsw-timeline-time">Tahap 2 · Fungsi First Treatment Essence</span>
            <h3 class="dsw-timeline-title">Membuka Jalur Serap untuk Serum &amp; Moisturizer</h3>
            <p class="dsw-timeline-desc">
              <em>Hyaluronic Acid</em> dan <em>Galactomyces Ferment Filtrate</em> mengikat molekul air di lapisan tanduk kulit (<em>stratum corneum</em>), menjadikan kulit lembap kenyal sehingga serum dan krim selanjutnya meresap merata tanpa meninggalkan residu lengket.
            </p>
          </li>

          <li class="dsw-timeline-step">
            <span class="dsw-timeline-node" aria-hidden="true">3</span>
            <span class="dsw-timeline-time">Tahap 3 · Kompres Hidrasi Intensif (Metode CSM)</span>
            <h3 class="dsw-timeline-title">Menyejukkan Kulit Kering &amp; Merawat Tekstur Kasar</h3>
            <p class="dsw-timeline-desc">
              Saat digunakan sebagai kompres kapas 3 menit (<em>Chizu Saeki Method</em>) pada area pipi atau dahi yang kering dan bertekstur, kombinasi ekstrak alga cokelat (<em>Sargassum Muticum</em>) dan <em>Chamomile</em> membantu menyejukkan dan melembutkan permukaan kulit.
            </p>
          </li>

          <li class="dsw-timeline-step">
            <span class="dsw-timeline-node" aria-hidden="true">4</span>
            <span class="dsw-timeline-time">Tahap 4 · Perawatan Rutin Pagi &amp; Malam</span>
            <h3 class="dsw-timeline-title">Merawat Pertahanan Skin Barrier &amp; Kecerahan Alami</h3>
            <p class="dsw-timeline-desc">
              Kandungan <em>Ceramide</em> dan <em>Niacinamide</em> merawat keutuhan barier kelembapan kulit. Kulit terjaga hidrasinya meski beraktivitas di ruang ber-AC, tampak lebih cerah merata, halus, dan terawat.
            </p>
          </li>
        </ol>

        <div class="dsw-marine-note">
          <strong>Catatan Formulasi:</strong> Tekstur <em>watery-essence</em> yang ringan dibuat khusus untuk iklim tropis Indonesia—cepat meresap di kulit berminyak/kombinasi, namun cukup kaya nutrisi untuk mengunci hidrasi pada kulit kering dan dewasa (<em>mature skin</em>).
        </div>
      </section>

      <!-- SECTION 5: SYMPTOMS & SELF-CHECK GUIDE -->
      <section class="dsw-section">
        <h2 class="dsw-section-title">
          4 Tanda Kulit Anda Sedang Mengalami Dehidrasi Lapisan Dalam
        </h2>
        <span class="dsw-rule" aria-hidden="true"></span>
        <p class="dsw-lead">
          Kulit dehidrasi berbeda dengan kulit kering biasa—bahkan kulit berminyak sekalipun sering mengalami dehidrasi tanpa disadari. Kenali tanda-tandanya:
        </p>

        <ul class="dsw-symptom-list">
          <li class="dsw-symptom-item">
            <span class="dsw-symptom-bullet" aria-hidden="true">1</span>
            <div>
              <strong>Berminyak di T-Zone tapi Terasa Kering Ketarik di Pipi:</strong> Kelenjar minyak memproduksi sebum berlebih karena kulit berusaha mengompensasi kurangnya kadar air di lapisan dalam.
            </div>
          </li>
          <li class="dsw-symptom-item">
            <span class="dsw-symptom-bullet" aria-hidden="true">2</span>
            <div>
              <strong>Garis Halus Muncul Saat Tersenyum atau Di Bawah Mata:</strong> Garis dehidrasi tampak jelas terutama di siang hari setelah berjam-jam terpapar AC ruangan.
            </div>
          </li>
          <li class="dsw-symptom-item">
            <span class="dsw-symptom-bullet" aria-hidden="true">3</span>
            <div>
              <strong>Bedak dan Cushion Mudah Pecah (Cakey/Crack):</strong> Riasan tidak mau menempel mulus di hidung, dagu, atau lipatan senyum karena permukaan kulit mengelupas halus.
            </div>
          </li>
          <li class="dsw-symptom-item">
            <span class="dsw-symptom-bullet" aria-hidden="true">4</span>
            <div>
              <strong>Kulit Terasa Perih Saat Memakai Bahan Aktif:</strong> Saat <em>skin barrier</em> kekurangan air dan Ceramide, pemakaian vitamin C, AHA/BHA, atau retinol terasa mudah menyengat dan memicu kemerahan.
            </div>
          </li>
        </ul>

        <div class="dsw-check-box">
          <p class="dsw-check-title">
            <Icon name="lucide:sparkles" class="size-4 text-[#0b6e7d]" aria-hidden="true" />
            Cara Cek Mandiri 5 Detik di Rumah (Pinch &amp; Smile Test)
          </p>
          <p class="dsw-pain-desc">
            Cuci wajah Anda dan keringkan dengan tisu lembut. Tunggu 2 menit tanpa mengoleskan apa pun, lalu dorong perlahan kulit pipi ke arah atas di depan cermin. Jika muncul <strong>garis-garis silang tipis seperti kertas krep</strong> atau kulit terasa kaku saat tersenyum, artinya kulit Anda membutuhkan hidrasi air mineral &amp; humektan sebelum memakai krim.
          </p>
        </div>
      </section>

      <!-- SECTION 6: FORMULATION & SPECIFICATIONS -->
      <section class="dsw-section">
        <h2 class="dsw-section-title">
          Formulasi <span class="dsw-brush">J-Beauty Clinical</span>: Sinergi Air Laut Dalam Ulleung &amp; 8 Bahan Aktif Pilihan
        </h2>
        <span class="dsw-rule" aria-hidden="true"></span>
        <p class="dsw-lead">
          Numa Skin memadukan kemurnian sumber air laut dalam Pulau Ulleung dengan bahan aktif teruji dermatologis untuk memberikan fungsi ganda: <strong>Hydrating Toner + First Essence</strong> dalam satu botol praktis.
        </p>

        <figure class="dsw-wide-figure">
          <img
            src="/images/landing/deep-sea-water-treatment-lotion/formulasi-ulleung-deep-sea-water.webp"
            alt="Komposisi Numa Skin Deep Sea Water Treatment Lotion dengan air mineral laut dalam Ulleung, ekstrak alga cokelat, Galactomyces, dan Hyaluronic Acid"
            width="1000"
            height="563"
            loading="lazy"
            decoding="async"
          />
          <figcaption class="dsw-wide-caption">
            Diperkaya Ulleung Island Deep Sea Water, Sargassum Muticum (Brown Algae), Galactomyces, Ceramide, Hyaluronic Acid, Niacinamide, Chamomile, dan Allantoin.
          </figcaption>
        </figure>

        <div class="dsw-ingredient-grid">
          <article class="dsw-ingredient-card">
            <span class="dsw-ingredient-badge">Hidrasi Mineral</span>
            <h3 class="dsw-ingredient-title">Ulleung Island Deep Sea Water &amp; Hyaluronic Acid</h3>
            <p class="dsw-ingredient-desc">
              Air laut dalam dari kedalaman Pulau Ulleung yang bebas polutan dan kaya 72+ ion mineral alami (Magnesium, Kalsium, Kalium), dipadukan dengan Hyaluronic Acid untuk menarik dan mengunci cadangan air di sel kulit.
            </p>
          </article>

          <article class="dsw-ingredient-card">
            <span class="dsw-ingredient-badge">First Essence &amp; Nutrisi</span>
            <h3 class="dsw-ingredient-title">Galactomyces Ferment &amp; Brown Algae Extract</h3>
            <p class="dsw-ingredient-desc">
              Fermentasi ragi Galactomyces dan ekstrak rumput laut cokelat (<em>Sargassum Muticum</em>) kaya antioksidan yang membantu menghaluskan tekstur kulit, menyamarkan tampilan pori, dan merawat elastisitas alami.
            </p>
          </article>

          <article class="dsw-ingredient-card">
            <span class="dsw-ingredient-badge">Barrier &amp; Calming</span>
            <h3 class="dsw-ingredient-title">Ceramide, Niacinamide, Chamomile &amp; Allantoin</h3>
            <p class="dsw-ingredient-desc">
              Memperkuat dinding pelindung <em>skin barrier</em>, mencerahkan warna kulit yang kusam tidak merata, sekaligus menenangkan kemerahan serta iritasi ringan dengan lembut.
            </p>
          </article>
        </div>

        <dl class="dsw-spec-dl" aria-label="Spesifikasi Produk">
          <div class="dsw-spec-row">
            <dt>Nama Produk</dt>
            <dd>Numa Skin Deep Sea Water Treatment Lotion</dd>
          </div>
          <div class="dsw-spec-row">
            <dt>Kategori &amp; Fungsi</dt>
            <dd>2-in-1 Hydrating Toner &amp; First Treatment Essence</dd>
          </div>
          <div class="dsw-spec-row">
            <dt>Nomor Izin BPOM</dt>
            <dd>NA18220101400 (Terdaftar Resmi BPOM RI)</dd>
          </div>
          <div class="dsw-spec-row">
