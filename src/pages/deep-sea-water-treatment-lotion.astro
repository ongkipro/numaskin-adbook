  <script is:inline>
    (function () {
      const formSection = document.getElementById('form-pemesanan');
      const stickyBar = document.getElementById('sticky-purchase-bar');
      const stickyLabel = document.getElementById('sticky-variant-label');
      const stickyPrice = document.getElementById('sticky-variant-price');
      const stickyCompare = document.getElementById('sticky-variant-compare');
      const sizePills = Array.from(document.querySelectorAll('[data-size-pill]'));

      function updateStickyAndPills(variantId) {
        sizePills.forEach((btn) => {
          const isMatch = String(btn.getAttribute('data-variant-id')) === String(variantId);
          btn.setAttribute('aria-pressed', isMatch ? 'true' : 'false');
          if (isMatch) {
            const label = btn.getAttribute('data-variant-label') || '';
            const price = btn.getAttribute('data-variant-price') || '';
            const compare = btn.getAttribute('data-variant-compare') || '';
            if (stickyLabel && label) stickyLabel.textContent = label;
            if (stickyPrice && price) stickyPrice.textContent = price;
            if (stickyCompare) {
              stickyCompare.textContent = compare;
              stickyCompare.style.display = compare ? '' : 'none';
            }
          }
        });
      }

      // Sync clicks on top size pills -> form radio inputs
      sizePills.forEach((btn) => {
        btn.addEventListener('click', () => {
          const variantId = btn.getAttribute('data-variant-id');
          if (!variantId) return;
          updateStickyAndPills(variantId);
          if (formSection) {
            const radio = formSection.querySelector(
              'input[name="variant"][value="' + CSS.escape(variantId) + '"]'
            );
            if (radio && !radio.checked) {
              radio.checked = true;
              radio.dispatchEvent(new Event('change', { bubbles: true }));
            }
          }
        });
      });

      // Sync clicks on form radio inputs -> top size pills & sticky bar
      if (formSection) {
        formSection.addEventListener('change', (e) => {
          const target = e.target;
          if (target && target.name === 'variant' && target.value) {
            updateStickyAndPills(target.value);
          }
        });
      }

      // Smooth scroll CTA buttons & hide sticky bar when form is visible
      document.querySelectorAll('[data-scroll-to-form]').forEach((link) => {
        link.addEventListener('click', (e) => {
          if (!formSection) return;
          e.preventDefault();
          formSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
      });

      if (formSection && stickyBar && 'IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              stickyBar.classList.toggle('is-hidden', entry.isIntersecting);
            });
          },
          { threshold: 0.12 }
        );
        observer.observe(formSection);
      }
    })();
  </script>
