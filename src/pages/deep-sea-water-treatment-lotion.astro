            <span id="sticky-variant-price" class="dsw-sticky-price">
              {formatIdr(defaultVariant.price)}
            </span>
            {
              (defaultVariant.comparePrice ?? defaultVariant.price) > defaultVariant.price && (
                <span id="sticky-variant-compare" class="dsw-sticky-compare">
                  {formatIdr(defaultVariant.comparePrice)}
                </span>
              )
            }
          </div>
        </div>

        <a href="#form-pemesanan" class="dsw-sticky-cta" data-scroll-to-form>
