---
import BaseLayout from '../layouts/BaseLayout.astro';
import GeoIpResolvedForm from '../components/storefront/forms/GeoIpResolvedForm.astro';
import MetaLandingTracker from '../components/storefront/tracking/MetaLandingTracker.astro';
import Icon from '../components/storefront/shared/Icon.astro';
import RatingStars from '../components/storefront/shared/RatingStars.astro';
import { getStorefrontProduct } from '../lib/catalog';
import { nativeLandingCanonicalPath } from '../lib/landing-pages';
import { defaultCatalogContentId } from '../lib/catalog-feed';
import { getRuntimeEnv } from '../lib/env';
import { loadStoreCodDisabledProvinceCodes } from '../lib/form-mode';
import { getStoreAdsConfig } from '../lib/store-ads';
import '../styles/form-hybrid.css';
import '../styles/landing-pages/deep-sea-water-treatment-lotion.css';

export const prerender = false;

const PRODUCT_SLUG = 'deep-sea-water-treatment-lotion';
const LANDING_SLUG = 'deep-sea-water-treatment-lotion';
const PAGE_TITLE = 'Deep Sea Water Treatment Lotion - Toner Hidrasi Air Laut Numa Skin';
const PAGE_DESC =
  'Toner-essence air laut dalam Pulau Ulleung 200m dengan 6 bahan aktif untuk melembapkan kulit kering, menenangkan kemerahan, dan menjaga skin barrier.';
const IMG_BASE = '/images/landing/deep-sea-water-treatment-lotion';
const HERO_IMAGE = `${IMG_BASE}/hero-treatment-lotion.webp`;

const database = getRuntimeEnv(Astro.locals)?.OMS_DB as D1Database | undefined;
const claimedProductSlug = Astro.request.headers.get('x-adsbook-product-page');
const [product, canonicalPath, codDisabledProvinceCodes] = await Promise.all([
  getStorefrontProduct(Astro.locals, PRODUCT_SLUG),
  claimedProductSlug
    ? Promise.resolve(`/produk/${claimedProductSlug}`)
    : nativeLandingCanonicalPath(Astro.locals, LANDING_SLUG),
  loadStoreCodDisabledProvinceCodes(database),
  getStoreAdsConfig(Astro.locals),
]);
if (!product) {
  return Astro.rewrite('/404');
}

const canonical = `${Astro.locals.tenant.siteUrl}${canonicalPath}`;

const variants = product.variants || [];
const cheapestVariant = variants.reduce(
  (min: any, v: any) => (!min || v.price < min.price ? v : min),
  variants[0]
);
const defaultVariant = cheapestVariant || {
  id: '4',
  label: '50ml',
  price: 79000,
  comparePrice: 125000,
};
---

<BaseLayout
  title={PAGE_TITLE}
  description={PAGE_DESC}
  image={HERO_IMAGE}
  preloadImages={HERO_IMAGE}
  canonical={canonical}
  hideHeader={true}
  hideFooter={true}
>
  <MetaLandingTracker
    slug={LANDING_SLUG}
    contentId={defaultCatalogContentId(product)}
    contentName={product.contentName}
    price={defaultVariant.price}
  />

  <div class="dsw-shell">
    <main class="dsw-canvas">
      <!-- Section 1: Hero -->
      <section id="hero-section" class="dsw-hero">
        <div class="dsw-hero-head">
          <h1 class="dsw-h1">
            Percuma Beli <span class="dsw-hl-tilt">Skincare Mahal</span> Kalau Kulit Masih Kering & Ketarik!
          </h1>
          <p class="dsw-sub" style="max-width: 390px; margin: 14px auto 0; font-weight: 700;">
            Kulit dehidrasi menutup rapat jalur pori.<br />
            <span class="dsw-underline-teal">Tepuk 10 detik — langsung kenyal selembut mochi!</span>
          </p>
        </div>

        <div class="dsw-hero-stage">
          <div class="dsw-hero-top-tag">
            <div class="dsw-hero-top-pill">
              <Icon name="lucide:droplets" class="size-3.5" aria-hidden="true" />
              <span>72+ Mineral Laut Dalam Ulleung</span>
            </div>
          </div>

          <img
            src={HERO_IMAGE}
            alt="Perbandingan wajah kulit kering mengelupas dan krim menumpuk vs kulit kenyal lembap bercahaya dengan Numa Skin Deep Sea Water Treatment Lotion"
            width="720"
            height="480"
            class="dsw-hero-img"
            fetchpriority="high"
            loading="eager"
            decoding="async"
          />

          <div class="dsw-hero-overlap">
            <div class="dsw-hero-overlap-inner">
              <h2 class="dsw-hero-overlap-title">Kenapa Krim & Serum Hanya Numpuk di Atas Kulit?</h2>
              <p class="dsw-hero-overlap-text">
                Saat kulit kering sehabis cuci muka, <strong style="color: #be123c;">90% krim mahal gagal meresap</strong> dan hanya menggumpal di permukaan pori.
              </p>
            </div>
          </div>
        </div>

        <div class="dsw-trust-row">
          <div class="dsw-trust-item">
            <span class="dsw-trust-icon">
              <Icon name="lucide:shield-check" class="size-4" aria-hidden="true" />
            </span>
            <div>
              <span class="dsw-trust-label">BPOM Resmi</span>
              <span class="dsw-trust-sub">NA18220101400</span>
            </div>
          </div>
          <div class="dsw-trust-item">
            <span class="dsw-trust-icon">
              <Icon name="lucide:badge-check" class="size-4" aria-hidden="true" />
            </span>
            <div>
              <span class="dsw-trust-label">Halal RI</span>
              <span class="dsw-trust-sub">0% Alkohol</span>
            </div>
          </div>
          <div class="dsw-trust-item">
            <span class="dsw-trust-icon">
              <Icon name="lucide:truck" class="size-4" aria-hidden="true" />
            </span>
            <div>
              <span class="dsw-trust-label">Bisa COD</span>
              <span class="dsw-trust-sub">Bayar di Rumah</span>
            </div>
          </div>
        </div>
      </section>

      <!-- Section 2: Solusi Singkat + Visual -->
      <section class="dsw-section">
        <h2 class="dsw-h2">
          Sekali tepuk 10 detik, <span class="dsw-hl-aqua">serum & krim langsung tersedot</span> masuk ke pori
        </h2>
        <p class="dsw-sub">Buka jalur hidrasi kulit yang terkunci rapat tanpa rasa lengket sedikit pun.</p>

        <div class="dsw-photo-stack">
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/penyerapan-cepat-meresap.webp`}
              alt="Kulit wajah tampak lembap, kenyal, dan segar saat mengaplikasikan Deep Sea Water Treatment Lotion"
              width="648"
              height="432"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
          </div>
        </div>

        <div class="dsw-list">
          <div class="dsw-list-row">
            <span class="dsw-icon-teal">
              <Icon name="lucide:droplets" class="size-4" aria-hidden="true" />
            </span>
            <p class="dsw-list-text">
              Hentikan sensasi <strong style="color: #0f172a;">kulit kaku, perih, dan ketarik</strong> tepat 10 detik sehabis cuci muka.
            </p>
          </div>
          <div class="dsw-list-row">
            <span class="dsw-icon-teal">
              <Icon name="lucide:layers" class="size-4" aria-hidden="true" />
            </span>
            <p class="dsw-list-text">
              Ubah kulit kering bak spons kaku menjadi <strong style="color: #0f172a;">lembap & siap menyerap serum 3x lebih optimal</strong>.
            </p>
          </div>
          <div class="dsw-list-row">
            <span class="dsw-icon-teal">
              <Icon name="lucide:shield-plus" class="size-4" aria-hidden="true" />
            </span>
            <p class="dsw-list-text">
              Formula <strong style="color: #0f172a;">0% alkohol & tanpa parfum</strong> — langsung adem di kulit sensitif yang sedang merah.
            </p>
          </div>
        </div>
      </section>

      <!-- Section 3: Tanda Masalah Kulit + Visual Grid -->
      <section class="dsw-section dsw-section--warn">
        <h2 class="dsw-h2">
          Awas! Ini tanda <span class="dsw-underline-warn">skin barrier rusak</span> & menolak semua skincare Anda:
        </h2>

        <div class="dsw-photo-grid-2">
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/masalah-kulit-kering.webp`}
              alt="Wajah terasa kaku, kering mengelupas, dan memerah perih setelah mencuci muka"
              width="315"
              height="210"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <p class="dsw-photo-caption">
              <strong style="color: #be123c; display: block;">Mengelupas & Ketarik</strong>
              Pipi kaku, perih, dan bersisik putih sehabis cuci muka.
            </p>
          </div>
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/masalah-kulit-kusam.webp`}
              alt="Krim dan riasan menggumpal retak di atas garis halus kulit dehidrasi"
              width="315"
              height="210"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <p class="dsw-photo-caption">
              <strong style="color: #be123c; display: block;">Krim Numpuk & Retak</strong>
              Pelembap menggumpal di luar dan memperjelas garis halus.
            </p>
          </div>
        </div>

        <div class="dsw-list">
          <div class="dsw-list-row">
            <span class="dsw-icon-warn">
              <Icon name="lucide:triangle-alert" class="size-4" aria-hidden="true" />
            </span>
            <p class="dsw-list-text">
              Wajah langsung <strong style="color: #be123c;">memerah, panas, atau perih</strong> setiap terkena udara AC maupun sinar matahari.
            </p>
          </div>
          <div class="dsw-list-row">
            <span class="dsw-icon-warn">
              <Icon name="lucide:triangle-alert" class="size-4" aria-hidden="true" />
            </span>
            <p class="dsw-list-text">
              Bagian dalam terasa <strong style="color: #be123c;">kering ketarik tapi luarnya kilap berminyak</strong> karena kulit dehidrasi berat.
            </p>
          </div>
          <div class="dsw-list-row">
            <span class="dsw-icon-warn">
              <Icon name="lucide:triangle-alert" class="size-4" aria-hidden="true" />
            </span>
            <p class="dsw-list-text">
              Sudah ganti berbagai serum dan krim ratusan ribu, namun <strong style="color: #be123c;">wajah tetap kusam dan kasar saat disentuh</strong>.
            </p>
          </div>
        </div>
      </section>

      <!-- Section 4: Perbandingan Visual Sebelum vs Sesudah -->
      <section class="dsw-section">
        <h2 class="dsw-h2">
          Bedanya kulit yang <span class="dsw-hl-aqua">menolak krim</span> vs kulit yang dikunci air laut dalam
        </h2>
        <p class="dsw-sub">Transformasi nyata tekstur kulit saat jalur hidrasinya dibuka dari dalam.</p>

        <div class="dsw-photo-stack">
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/kondisi-kulit-dehidrasi-kasar.webp`}
              alt="Tekstur kulit kering bersisik, kemerahan, dan krim menggumpal tidak meresap saat kekurangan hidrasi"
              width="648"
              height="432"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <span class="dsw-photo-badge dsw-photo-badge--before">Tanpa Treatment Lotion</span>
            <p class="dsw-photo-caption">
              Permukaan kulit bersisik, memerah, dan garis dehidrasi menganga karena krim langsung ditumpuk di atas kulit kering.
            </p>
          </div>

          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/kondisi-kulit-lembap-seimbang.webp`}
              alt="Tekstur kulit tampak bening, kenyal selembut mochi, tenang, dan bercahaya sehat setelah rutin memakai Deep Sea Water Treatment Lotion"
              width="648"
              height="432"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <span class="dsw-photo-badge dsw-photo-badge--after">Sesudah Rutin Pakai</span>
            <p class="dsw-photo-caption">
              Tekstur kulit langsung plumping, garis halus terisi penuh oleh hidrasi, dan tampak bening kenyal bak glass-mochi skin Jepang.
            </p>
          </div>
        </div>
      </section>

      <!-- Section 5: Dark Marine Section — Cara Pakai Praktis -->
      <section class="dsw-section dsw-section--dark">
        <h2 class="dsw-h2">
          2 Cara Pakai Instan: <span style="color: #99e2ec;">Tepuk 10 Detik</span> atau Kompres 3 Menit
        </h2>
        <p class="dsw-sub">Praktis setiap habis cuci muka atau jadikan masker kompres saat kulit sedang ngamuk.</p>

        <div class="dsw-photo-stack">
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/cara-pakai-tetes-tap.webp`}
              alt="Menuangkan 3 sampai 4 tetes Numa Skin Deep Sea Water Treatment Lotion ke telapak tangan"
              width="648"
              height="432"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <p class="dsw-photo-caption">
              <strong style="color: #ffffff;">Tepuk Harian (10 Detik):</strong> Tuang 3–4 tetes ke telapak tangan, tepuk lembut hingga wajah langsung terasa kenyal.
            </p>
          </div>

          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/ritual-cara-pakai-csm.webp`}
              alt="Mengompres pipi dengan kapas tipis yang dibasahi Deep Sea Water Treatment Lotion selama 3 menit"
              width="648"
              height="432"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <p class="dsw-photo-caption">
              <strong style="color: #ffffff;">Kompres Kapas CSM (3 Menit):</strong> Basahi kapas tipis dan tempel di pipi kering untuk efek tenang setara perawatan klinik.
            </p>
          </div>
        </div>

        <div class="dsw-list">
          <div class="dsw-list-row">
            <span class="dsw-step-num">1</span>
            <p class="dsw-step-text">
              Gunakan <strong style="color: #ffffff;">wajib di 10 detik pertama habis cuci muka</strong> sebelum kulit sempat mengering.
            </p>
          </div>
          <div class="dsw-list-row">
            <span class="dsw-step-num">2</span>
            <p class="dsw-step-text">
              Tepuk rata <strong style="color: #ffffff; background: #104452; padding: 1px 6px; border-radius: 4px;">3–4 tetes dengan telapak tangan</strong> agar ion mineral langsung masuk ke pori.
            </p>
          </div>
          <div class="dsw-list-row">
            <span class="dsw-step-num">3</span>
            <p class="dsw-step-text">
              Lanjutkan serum atau krim malam Anda — rasakan <strong style="color: #ffffff;">teksturnya langsung terserap habis tanpa sisa lengket</strong>.
            </p>
          </div>
        </div>
      </section>

      <!-- Section 6: Ulasan Pelanggan -->
      <section class="dsw-section">
        <h2 class="dsw-h2">
          Ribuan wanita sudah <span class="dsw-hl-aqua">bebas dari kulit kering</span> & skincare yang sia-sia
        </h2>
        <p class="dsw-sub">Bukan sekadar basah sesaat — kulit benar-benar kenyal, tenang, dan siap menerima nutrisi.</p>

        <div class="dsw-reviews-divide">
          <div class="dsw-review-row">
            <div class="dsw-review-head">
              <div>
                <p class="dsw-review-author">
                  Fitri A.
                  <span style="color: #0b6e7d; display: inline-flex;">
                    <Icon name="lucide:badge-check" class="size-4" aria-hidden="true" />
                  </span>
                </p>
                <p class="dsw-review-meta">Jakarta • Ukuran 150 ml</p>
              </div>
              <RatingStars rating={5} starClass="h-3.5 w-3.5 !fill-[#d97706] !text-[#d97706]" />
            </div>
            <p class="dsw-review-quote">
              "Dulu pakai krim mahal selalu numpuk dan bikin kusam. Sejak tepuk Numa Skin habis cuci muka, <span class="dsw-hl-aqua">pipi yang tadinya ketarik langsung kenyal kayak mochi</span> dan serum langsung meresap!"
            </p>
          </div>

          <div class="dsw-review-row">
            <div class="dsw-review-head">
              <div>
                <p class="dsw-review-author">
                  Lilyana S.
                  <span style="color: #0b6e7d; display: inline-flex;">
                    <Icon name="lucide:badge-check" class="size-4" aria-hidden="true" />
                  </span>
                </p>
                <p class="dsw-review-meta">Bandung • Kulit Sensitif & Kering</p>
              </div>
              <RatingStars rating={5} starClass="h-3.5 w-3.5 !fill-[#d97706] !text-[#d97706]" />
            </div>
            <p class="dsw-review-quote">
              "Pipiku sering <span class="dsw-hl-rose">mengelupas dan perih kalau kena AC seharian</span>. Kompres pakai lotion ini 3 menit langsung <span class="dsw-hl-aqua">adem banget karena 0% alkohol</span>, merah-merah langsung reda."
            </p>
          </div>

          <div class="dsw-review-row">
            <div class="dsw-review-head">
              <div>
                <p class="dsw-review-author">
                  Trisna K.
                  <span style="color: #0b6e7d; display: inline-flex;">
                    <Icon name="lucide:badge-check" class="size-4" aria-hidden="true" />
                  </span>
                </p>
                <p class="dsw-review-meta">Surabaya • Pembelian Botol ke-4</p>
              </div>
              <RatingStars rating={5} starClass="h-3.5 w-3.5 !fill-[#d97706] !text-[#d97706]" />
            </div>
            <p class="dsw-review-quote">
              "Sudah <span class="dsw-hl-aqua">botol keempat di meja rias</span>. Garis halus di bawah mata dan senyum yang biasanya bikin bedak retak sekarang <strong style="color: #0f172a;">halus licin seharian</strong>."
            </p>
          </div>
        </div>
      </section>

      <!-- Section 7: Galeri Bukti Visual -->
      <section class="dsw-section dsw-section--tint">
        <h2 class="dsw-h2">
          Segar seperti air murni, <span style="color: #0b6e7d;">mengunci lembap seharian</span> tanpa rasa lengket
        </h2>
        <p class="dsw-sub">Dirancang khusus untuk cuaca panas & ruang AC Indonesia — bebas sumuk dan tidak memicu komedo.</p>

        <div class="dsw-photo-grid-2">
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/bukti-wajah-lembap.webp`}
              alt="Tampilan kulit wajah wanita Indonesia yang lembap dan bercahaya sehat"
              width="315"
              height="210"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
          </div>
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/bukti-tekstur-tangan.webp`}
              alt="Tetesan tekstur cair Deep Sea Water Treatment Lotion di punggung tangan"
              width="315"
              height="210"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
          </div>
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/bukti-kulit-sehat-hijab.webp`}
              alt="Kulit wajah tampak tenang, halus, dan terhidrasi sepanjang hari"
              width="315"
              height="210"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
          </div>
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/bukti-meja-rias.webp`}
              alt="Kemasan botol Numa Skin Deep Sea Water Treatment Lotion dan kapas di meja rias"
              width="315"
              height="210"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
          </div>
        </div>
      </section>

      <!-- Section 8: Product Knowledge (Full-Bleed Figures) -->
      <section class="dsw-section dsw-section--knowledge">
        <h2 class="dsw-h2">
          Rahasia <span class="dsw-hl-aqua">Air Laut Dalam 200 Meter</span> yang tidak dimiliki toner biasa
        </h2>
        <p class="dsw-sub">
          Diperkaya 72+ ion mineral murni Pulau Ulleung dan 6 bahan aktif pengunci skin barrier.
        </p>

        <div class="dsw-figure-stack">
          <figure class="dsw-figure">
            <div class="dsw-figure-bleed">
              <img
                src={`${IMG_BASE}/formulasi-ulleung-deep-sea-water.webp`}
                alt="Formulasi air laut dalam Pulau Ulleung dan ekstrak rumput laut cokelat Numa Skin"
                width="720"
                height="480"
                class="dsw-figure-img"
                loading="lazy"
                fetchpriority="low"
                decoding="async"
              />
            </div>
            <figcaption class="dsw-figcaption">
              <h3 class="dsw-figcaption-title">Air Laut Dalam Pulau Ulleung (&gt;200 Meter)</h3>
              <p class="dsw-figcaption-desc">
                Ukuran molekul mineral mikro (Magnesium, Kalsium, Zinc) menembus pori jauh lebih cepat dibanding air suling biasa.
              </p>
            </figcaption>
          </figure>

          <figure class="dsw-figure">
            <div class="dsw-figure-bleed">
              <img
                src={`${IMG_BASE}/kandungan-6-bahan-aktif.webp`}
                alt="Kombinasi 6 bahan aktif Deep Sea Water, Brown Algae, Galactomyces, Niacinamide, Hyaluronic Acid, dan Ceramide"
                width="720"
                height="480"
                class="dsw-figure-img"
                loading="lazy"
                fetchpriority="low"
                decoding="async"
              />
            </div>
            <figcaption class="dsw-figcaption">
              <h3 class="dsw-figcaption-title">6 Bahan Aktif Pengunci Hidrasi 24 Jam</h3>
              <p class="dsw-figcaption-desc">
                Kombinasi Deep Sea Water, Brown Algae, Galactomyces, Niacinamide, Hyaluronic Acid, dan Ceramide dalam satu langkah praktis.
              </p>
            </figcaption>
          </figure>

          <figure class="dsw-figure">
            <div class="dsw-figure-bleed">
              <img
                src={`${IMG_BASE}/ukuran-50ml-dan-150ml.webp`}
                alt="Perbandingan kemasan Numa Skin Deep Sea Water Treatment Lotion ukuran 150 ml dan 50 ml"
                width="720"
                height="480"
                class="dsw-figure-img"
                loading="lazy"
                fetchpriority="low"
                decoding="async"
              />
            </div>
            <figcaption class="dsw-figcaption">
              <h3 class="dsw-figcaption-title">Tersedia Ukuran 50 ml & 150 ml (Lebih Hemat!)</h3>
              <p class="dsw-figcaption-desc">
                Pilih 50 ml untuk coba pertama kali, atau langsung 150 ml (3x lebih banyak) untuk stok rutin 6–8 minggu penuh.
              </p>
            </figcaption>
          </figure>
        </div>
      </section>

      <!-- Section 9: Garansi 100% Resmi -->
