---
import BaseLayout from '../layouts/BaseLayout.astro';
import GeoIpResolvedForm from '../components/storefront/forms/GeoIpResolvedForm.astro';
import MetaLandingTracker from '../components/storefront/tracking/MetaLandingTracker.astro';
import Icon from '../components/storefront/shared/Icon.astro';
import RatingStars from '../components/storefront/shared/RatingStars.astro';
import { getStorefrontProduct } from '../lib/catalog';
import { nativeLandingCanonicalPath } from '../lib/landing-pages';
import { defaultCatalogContentId } from '../lib/catalog-feed';
import '../styles/form-hybrid.css';
import '../styles/landing-pages/deep-sea-water-treatment-lotion.css';

export const prerender = false;

const PRODUCT_SLUG = 'deep-sea-water-treatment-lotion';
const LANDING_SLUG = 'deep-sea-water-treatment-lotion';
const PAGE_TITLE = 'Deep Sea Water Treatment Lotion - Toner Hidrasi Air Laut Numa Skin';
const PAGE_DESC =
  'Toner-essence air laut dalam Pulau Ulleung 200m dengan 6 bahan aktif untuk melembapkan kulit kering, menenangkan kemerahan, dan menjaga skin barrier.';
const IMG_BASE = '/images/landing/deep-sea-water-treatment-lotion';
const HERO_IMAGE = `${IMG_BASE}/hero-treatment-lotion.webp`;

const product = await getStorefrontProduct(Astro.locals, PRODUCT_SLUG);
if (!product) {
  return Astro.rewrite('/404');
}

const canonical = `${Astro.locals.tenant.siteUrl}${await nativeLandingCanonicalPath(Astro.locals, LANDING_SLUG)}`;

const variants = product.variants || [];
const cheapestVariant = variants.reduce(
  (min: any, v: any) => (!min || v.price < min.price ? v : min),
  variants[0]
);
const defaultVariant = cheapestVariant || {
  id: '4',
  label: '50ml',
  price: 79000,
  comparePrice: 125000,
};
---

<BaseLayout
  title={PAGE_TITLE}
  description={PAGE_DESC}
  image={HERO_IMAGE}
  preloadImages={HERO_IMAGE}
  canonical={canonical}
  hideHeader={true}
  hideFooter={true}
>
  <MetaLandingTracker
    slug={LANDING_SLUG}
    contentId={defaultCatalogContentId(product)}
    contentName={product.contentName}
    price={defaultVariant.price}
  />

  <div class="dsw-shell">
    <main class="dsw-canvas">
      <!-- Section 1: Hero -->
      <section id="hero-section" class="dsw-hero">
        <div class="dsw-hero-head">
          <h1 class="dsw-h1">
            Wajah Terasa <span class="dsw-hl-tilt">Kering & Ketarik</span> Setiap Habis Cuci Muka?
          </h1>
          <p class="dsw-sub" style="max-width: 390px; margin: 14px auto 0; font-weight: 700;">
            Jangan langsung tumpuk krim di atas kulit dehidrasi.<br />
            <span class="dsw-underline-teal">Kunci hidrasi pertama dalam 10 detik!</span>
          </p>
        </div>

        <div class="dsw-hero-stage">
          <div class="dsw-hero-top-tag">
            <div class="dsw-hero-top-pill">
              <Icon name="lucide:droplets" class="size-3.5" aria-hidden="true" />
              <span>72+ Mineral Laut Dalam Ulleung</span>
            </div>
          </div>

          <img
            src={HERO_IMAGE}
            alt="Perbandingan wajah kulit kering mengelupas dan krim menumpuk vs kulit kenyal lembap bercahaya dengan Numa Skin Deep Sea Water Treatment Lotion"
            width="720"
            height="480"
            class="dsw-hero-img"
            fetchpriority="high"
            loading="eager"
            decoding="async"
          />

          <div class="dsw-hero-overlap">
            <div class="dsw-hero-overlap-inner">
              <h2 class="dsw-hero-overlap-title">Kulit Kering Menolak Serum Mahal!</h2>
              <p class="dsw-hero-overlap-text">
                Tanpa hidrasi pembuka, <strong style="color: #be123c;">krim dan serum hanya menumpuk di permukaan</strong> tanpa meresap ke dalam kulit.
              </p>
            </div>
          </div>
        </div>

        <div class="dsw-trust-row">
          <div class="dsw-trust-item">
            <span class="dsw-trust-icon">
              <Icon name="lucide:shield-check" class="size-4" aria-hidden="true" />
            </span>
            <div>
              <span class="dsw-trust-label">BPOM Resmi</span>
              <span class="dsw-trust-sub">NA18220101400</span>
            </div>
          </div>
          <div class="dsw-trust-item">
            <span class="dsw-trust-icon">
              <Icon name="lucide:badge-check" class="size-4" aria-hidden="true" />
            </span>
            <div>
              <span class="dsw-trust-label">Halal RI</span>
              <span class="dsw-trust-sub">0% Alkohol</span>
            </div>
          </div>
          <div class="dsw-trust-item">
            <span class="dsw-trust-icon">
              <Icon name="lucide:truck" class="size-4" aria-hidden="true" />
            </span>
            <div>
              <span class="dsw-trust-label">Bisa COD</span>
              <span class="dsw-trust-sub">Bayar di Rumah</span>
            </div>
          </div>
        </div>
      </section>

      <!-- Section 2: Solusi Singkat + Visual -->
      <section class="dsw-section">
        <h2 class="dsw-h2">
          Buka <span class="dsw-hl-aqua">jalur penyerapan kulit</span> sejak tetes pertama
        </h2>
        <p class="dsw-sub">Hidrasi cair yang langsung meresap tanpa rasa lengket.</p>

        <div class="dsw-photo-stack">
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/penyerapan-cepat-meresap.webp`}
              alt="Kulit wajah tampak lembap, kenyal, dan segar saat mengaplikasikan Deep Sea Water Treatment Lotion"
              width="648"
              height="432"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
          </div>
        </div>

        <div class="dsw-list">
          <div class="dsw-list-row">
            <span class="dsw-icon-teal">
              <Icon name="lucide:droplets" class="size-4" aria-hidden="true" />
            </span>
            <p class="dsw-list-text">
              Kembalikan <strong style="color: #0f172a;">kelembapan kulit yang hilang</strong> sehabis mencuci wajah dengan sabun.
            </p>
          </div>
          <div class="dsw-list-row">
            <span class="dsw-icon-teal">
              <Icon name="lucide:layers" class="size-4" aria-hidden="true" />
            </span>
            <p class="dsw-list-text">
              Bantu <strong style="color: #0f172a;">serum dan pelembap meresap lebih dalam</strong>, bukan sekadar mengambang di pori.
            </p>
          </div>
          <div class="dsw-list-row">
            <span class="dsw-icon-teal">
              <Icon name="lucide:shield-plus" class="size-4" aria-hidden="true" />
            </span>
            <p class="dsw-list-text">
              Formula <strong style="color: #0f172a;">0% alkohol dan tanpa parfum buatan</strong> yang tenang untuk kulit sensitif.
            </p>
          </div>
        </div>
      </section>

      <!-- Section 3: Tanda Masalah Kulit + Visual Grid -->
      <section class="dsw-section dsw-section--warn">
        <h2 class="dsw-h2">
          Tanda kulit sedang <span class="dsw-underline-warn">dehidrasi berat</span> dan butuh pertolongan:
        </h2>

        <div class="dsw-photo-grid-2">
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/masalah-kulit-kering.webp`}
              alt="Wajah terasa kaku, kering, dan ketarik setelah mencuci muka"
              width="315"
              height="210"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <p class="dsw-photo-caption">
              <strong style="color: #be123c; display: block;">Kering & Ketarik</strong>
              Pipi terasa kaku sehabis cuci muka atau di ruang AC.
            </p>
          </div>
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/masalah-kulit-kusam.webp`}
              alt="Kulit tampak kusam dengan garis halus dehidrasi di area pipi dan bawah mata"
              width="315"
              height="210"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <p class="dsw-photo-caption">
              <strong style="color: #be123c; display: block;">Kusam & Garis Halus</strong>
              Riasan mudah retak dan garis lipatan makin terlihat.
            </p>
          </div>
        </div>

        <div class="dsw-list">
          <div class="dsw-list-row">
            <span class="dsw-icon-warn">
              <Icon name="lucide:triangle-alert" class="size-4" aria-hidden="true" />
            </span>
            <p class="dsw-list-text">
              Wajah terasa <strong style="color: #be123c;">kencang, perih, atau memerah</strong> setiap berganti cuaca maupun terkena AC.
            </p>
          </div>
          <div class="dsw-list-row">
            <span class="dsw-icon-warn">
              <Icon name="lucide:triangle-alert" class="size-4" aria-hidden="true" />
            </span>
            <p class="dsw-list-text">
              Permukaan kulit <strong style="color: #be123c;">kasar dari dalam namun berminyak di luar</strong> akibat kurang air.
            </p>
          </div>
          <div class="dsw-list-row">
            <span class="dsw-icon-warn">
              <Icon name="lucide:triangle-alert" class="size-4" aria-hidden="true" />
            </span>
            <p class="dsw-list-text">
              Sudah ganti berbagai krim malam, tetapi <strong style="color: #be123c;">wajah tetap tampak lelah dan kusam</strong>.
            </p>
          </div>
        </div>
      </section>

      <!-- Section 4: Perbandingan Visual Sebelum vs Sesudah -->
      <section class="dsw-section">
        <h2 class="dsw-h2">
          Perbandingan visual <span class="dsw-hl-aqua">hidrasi kulit</span>
        </h2>
        <p class="dsw-sub">Perbedaan nyata tekstur kulit saat kecukupan airnya terpenuhi.</p>

        <div class="dsw-photo-stack">
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/kondisi-kulit-dehidrasi-kasar.webp`}
              alt="Tekstur kulit kering, kemerahan, dan garis halus terlihat jelas saat kekurangan hidrasi"
              width="648"
              height="432"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <span class="dsw-photo-badge dsw-photo-badge--before">Sebelum</span>
            <p class="dsw-photo-caption">
              Kulit kering, mudah kemerahan, dan garis dehidrasi tampak jelas karena langsung memakai krim tanpa hidrasi pembuka.
            </p>
          </div>

          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/kondisi-kulit-lembap-seimbang.webp`}
              alt="Tekstur kulit tampak lembap, kenyal, tenang, dan bercahaya sehat setelah rutin memakai Deep Sea Water Treatment Lotion"
              width="648"
              height="432"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <span class="dsw-photo-badge dsw-photo-badge--after">Sesudah Rutin</span>
            <p class="dsw-photo-caption">
              Permukaan kulit tampak kenyal, tenang, dan lembap merata sehingga siap menyerap rangkaian skincare berikutnya.
            </p>
          </div>
        </div>
      </section>

      <!-- Section 5: Dark Marine Section — Cara Pakai Praktis -->
      <section class="dsw-section dsw-section--dark">
        <h2 class="dsw-h2">
          Cara Pakai <span style="color: #99e2ec;">Sangat Praktis</span>
        </h2>
        <p class="dsw-sub">Bisa ditepuk langsung 10 detik atau dikompres kapas saat kulit ekstra kering.</p>

        <div class="dsw-photo-stack">
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/cara-pakai-tetes-tap.webp`}
              alt="Menuangkan 3 sampai 4 tetes Numa Skin Deep Sea Water Treatment Lotion ke telapak tangan"
              width="648"
              height="432"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <p class="dsw-photo-caption">
              <strong style="color: #ffffff;">Metode Harian (10 Detik):</strong> Tuang 3–4 tetes ke telapak tangan lalu tepuk lembut ke wajah.
            </p>
          </div>

          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/ritual-cara-pakai-csm.webp`}
              alt="Mengompres pipi dengan kapas tipis yang dibasahi Deep Sea Water Treatment Lotion selama 3 menit"
              width="648"
              height="432"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <p class="dsw-photo-caption">
              <strong style="color: #ffffff;">Kompres Kapas CSM (3 Menit):</strong> Tempelkan kapas basah di area pipi yang kering atau kemerahan.
            </p>
          </div>
        </div>

        <div class="dsw-list">
          <div class="dsw-list-row">
            <span class="dsw-step-num">1</span>
            <p class="dsw-step-text">
              Gunakan <strong style="color: #ffffff;">segera setelah cuci muka</strong> saat kulit masih terasa sedikit lembap.
            </p>
          </div>
          <div class="dsw-list-row">
            <span class="dsw-step-num">2</span>
            <p class="dsw-step-text">
              Tepuk rata dengan <strong style="color: #ffffff; background: #104452; padding: 1px 6px; border-radius: 4px;">3–4 tetes di telapak tangan</strong> tanpa perlu digosok kasar.
            </p>
          </div>
          <div class="dsw-list-row">
            <span class="dsw-step-num">3</span>
            <p class="dsw-step-text">
              Tunggu <strong style="color: #ffffff;">5–10 detik hingga meresap</strong>, lalu lanjutkan dengan serum atau pelembap harian Anda.
            </p>
          </div>
        </div>
      </section>

      <!-- Section 6: Ulasan Pelanggan -->
      <section class="dsw-section">
        <h2 class="dsw-h2">
          Apa kata pelanggan yang <span class="dsw-hl-aqua">sudah cocok?</span>
        </h2>
        <p class="dsw-sub">Dipakai ribuan wanita Indonesia untuk menjaga kelembapan kulit setiap hari.</p>

        <div class="dsw-reviews-divide">
          <div class="dsw-review-row">
            <div class="dsw-review-head">
              <div>
                <p class="dsw-review-author">
                  Fitri A.
                  <span style="color: #0b6e7d; display: inline-flex;">
                    <Icon name="lucide:badge-check" class="size-4" aria-hidden="true" />
                  </span>
                </p>
                <p class="dsw-review-meta">Jakarta • Ukuran 150 ml</p>
              </div>
              <RatingStars rating={5} starClass="h-3.5 w-3.5 !fill-[#d97706] !text-[#d97706]" />
            </div>
            <p class="dsw-review-quote">
              "Teksturnya <span class="dsw-hl-aqua">cair segar dan cepat meresap</span> tanpa rasa berat. Dulu habis cuci muka pipi selalu ketarik, sekarang <strong style="color: #0f172a;">langsung adem dan lembap</strong>."
            </p>
          </div>

          <div class="dsw-review-row">
            <div class="dsw-review-head">
              <div>
                <p class="dsw-review-author">
                  Lilyana S.
                  <span style="color: #0b6e7d; display: inline-flex;">
                    <Icon name="lucide:badge-check" class="size-4" aria-hidden="true" />
                  </span>
                </p>
                <p class="dsw-review-meta">Bandung • Kulit Sensitif</p>
              </div>
              <RatingStars rating={5} starClass="h-3.5 w-3.5 !fill-[#d97706] !text-[#d97706]" />
            </div>
            <p class="dsw-review-quote">
              "Kulitku <span class="dsw-hl-rose">gampang merah kalau salah toner</span>. Pakai Numa Skin ini <span class="dsw-hl-aqua">tenang banget karena 0% alkohol</span> dan bikin krim malam jauh lebih gampang nempel."
            </p>
          </div>

          <div class="dsw-review-row">
            <div class="dsw-review-head">
              <div>
                <p class="dsw-review-author">
                  Trisna K.
                  <span style="color: #0b6e7d; display: inline-flex;">
                    <Icon name="lucide:badge-check" class="size-4" aria-hidden="true" />
                  </span>
                </p>
                <p class="dsw-review-meta">Surabaya • Pembelian Botol ke-4</p>
              </div>
              <RatingStars rating={5} starClass="h-3.5 w-3.5 !fill-[#d97706] !text-[#d97706]" />
            </div>
            <p class="dsw-review-quote">
              "Sudah <span class="dsw-hl-aqua">botol keempat di meja rias</span>. Paling suka dipakai kompres kapas 3 menit sebelum makeup, <strong style="color: #0f172a;">bedak langsung halus seharian</strong>."
            </p>
          </div>
        </div>
      </section>

      <!-- Section 7: Galeri Bukti Visual -->
      <section class="dsw-section dsw-section--tint">
        <h2 class="dsw-h2">
          Tekstur ringan untuk <span style="color: #0b6e7d;">kulit tropis Indonesia</span>
        </h2>
        <p class="dsw-sub">Segar seperti air, melembapkan seperti essence tanpa rasa berminyak.</p>

        <div class="dsw-photo-grid-2">
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/bukti-wajah-lembap.webp`}
              alt="Tampilan kulit wajah wanita Indonesia yang lembap dan bercahaya sehat"
              width="315"
              height="210"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
          </div>
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/bukti-tekstur-tangan.webp`}
              alt="Tetesan tekstur cair Deep Sea Water Treatment Lotion di punggung tangan"
              width="315"
              height="210"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
          </div>
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/bukti-kulit-sehat-hijab.webp`}
              alt="Kulit wajah tampak tenang, halus, dan terhidrasi sepanjang hari"
              width="315"
              height="210"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
          </div>
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/bukti-meja-rias.webp`}
              alt="Kemasan botol Numa Skin Deep Sea Water Treatment Lotion dan kapas di meja rias"
              width="315"
              height="210"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
          </div>
        </div>
      </section>

      <!-- Section 8: Product Knowledge (Full-Bleed Figures) -->
      <section class="dsw-section dsw-section--knowledge">
        <h2 class="dsw-h2">
          Mengapa <span class="dsw-hl-aqua">Deep Sea Water</span> Numa Skin berbeda?
        </h2>
        <p class="dsw-sub">
          Bukan sekadar air biasa, melainkan perpaduan air laut dalam Pulau Ulleung dengan 6 bahan aktif penjaga skin barrier.
        </p>

        <div class="dsw-figure-stack">
          <figure class="dsw-figure">
            <div class="dsw-figure-bleed">
              <img
                src={`${IMG_BASE}/formulasi-ulleung-deep-sea-water.webp`}
                alt="Formulasi air laut dalam Pulau Ulleung dan ekstrak rumput laut cokelat Numa Skin"
                width="720"
                height="480"
                class="dsw-figure-img"
                loading="lazy"
                fetchpriority="low"
                decoding="async"
              />
            </div>
            <figcaption class="dsw-figcaption">
              <h3 class="dsw-figcaption-title">Air Laut Dalam Pulau Ulleung (&gt;200 Meter)</h3>
              <p class="dsw-figcaption-desc">
                Diambil dari kedalaman laut bebas polusi yang kaya mineral alami Magnesium, Kalsium, dan Zinc untuk menenangkan kulit.
              </p>
            </figcaption>
          </figure>

          <figure class="dsw-figure">
            <div class="dsw-figure-bleed">
              <img
                src={`${IMG_BASE}/kandungan-6-bahan-aktif.webp`}
                alt="Kombinasi 6 bahan aktif Deep Sea Water, Brown Algae, Galactomyces, Niacinamide, Hyaluronic Acid, dan Ceramide"
                width="720"
                height="480"
                class="dsw-figure-img"
                loading="lazy"
                fetchpriority="low"
                decoding="async"
              />
            </div>
            <figcaption class="dsw-figcaption">
              <h3 class="dsw-figcaption-title">6 Bahan Aktif Pengunci Hidrasi</h3>
              <p class="dsw-figcaption-desc">
                Perpaduan Deep Sea Water, Brown Algae, Galactomyces, Niacinamide, Hyaluronic Acid, dan Ceramide dalam satu botol.
              </p>
            </figcaption>
          </figure>

          <figure class="dsw-figure">
            <div class="dsw-figure-bleed">
              <img
                src={`${IMG_BASE}/ukuran-50ml-dan-150ml.webp`}
                alt="Perbandingan kemasan Numa Skin Deep Sea Water Treatment Lotion ukuran 150 ml dan 50 ml"
                width="720"
                height="480"
                class="dsw-figure-img"
                loading="lazy"
                fetchpriority="low"
                decoding="async"
              />
            </div>
            <figcaption class="dsw-figcaption">
              <h3 class="dsw-figcaption-title">Tersedia Ukuran 50 ml & 150 ml</h3>
              <p class="dsw-figcaption-desc">
                Pilih ukuran 50 ml untuk coba pertama kali atau dibawa bepergian, dan ukuran 150 ml untuk pemakaian rutin 6–8 minggu.
              </p>
            </figcaption>
          </figure>
        </div>
      </section>

      <!-- Section 9: Garansi 100% Resmi -->
      <section class="dsw-section" style="text-align: center; background: #f8fafc;">
        <div style="margin: 0 auto 14px; display: flex; width: 52px; height: 52px; align-items: center; justify-content: center; color: #0b6e7d;">
          <Icon name="lucide:shield-check" class="size-12" aria-hidden="true" />
        </div>
        <h2 class="dsw-h2" style="font-size: 32px;">GARANSI RESMI 100%</h2>
        <p class="dsw-sub" style="max-width: 320px; margin: 8px auto 0;">
          Pesanan dikirim langsung dari gudang resmi Numa Skin Indonesia.
        </p>

        <div class="dsw-guarantee-list">
          <div class="dsw-guarantee-row">
            <span class="dsw-icon-teal">
              <Icon name="lucide:badge-check" class="size-5" aria-hidden="true" />
            </span>
            <p class="dsw-list-text">
              <strong style="color: #0f172a; display: block;">100% Produk Asli Tersegel</strong>
              Terdaftar resmi di BPOM (NA18220101400) dan bersertifikat Halal Indonesia.
            </p>
          </div>
          <div class="dsw-guarantee-row">
            <span class="dsw-icon-teal">
              <Icon name="lucide:truck" class="size-5" aria-hidden="true" />
            </span>
            <p class="dsw-list-text">
              <strong style="color: #0f172a; display: block;">Bisa Bayar di Tempat (COD)</strong>
              Pesan hari ini, bayar langsung ke kurir saat paket tiba di alamat Anda.
            </p>
          </div>
          <div class="dsw-guarantee-row">
            <span class="dsw-icon-teal">
              <Icon name="lucide:package-check" class="size-5" aria-hidden="true" />
            </span>
            <p class="dsw-list-text">
              <strong style="color: #0f172a; display: block;">Garansi Ganti Baru</strong>
              Kami ganti baru tanpa biaya tambahan bila botol diterima pecah atau bocor.
            </p>
          </div>
        </div>
      </section>

      <!-- Section 10: Checkout Form -->
      <section id="form-pemesanan" class="dsw-section--checkout">
        <div style="padding: 0 20px 14px; text-align: center;">
          <h2 class="dsw-h2" style="font-size: 28px;">
            Lengkapi Data <span class="dsw-hl-aqua">Pengiriman</span>
          </h2>
          <p class="dsw-sub" style="max-width: 340px; margin: 8px auto 0;">
            Pilih ukuran kemasan lalu isi data penerima di bawah ini.
          </p>
        </div>

        <GeoIpResolvedForm
          mode="hybrid"
          productSlug={product.slug}
          embedded={true}
          selectedVariantId={String(defaultVariant.id)}
        />
      </section>
    </main>

    <!-- Floating Centered Sticky Button (hidden on Hero and Form) -->
    <div id="floating-cta" data-sticky-cta class="dsw-float-wrap">
      <a
        href="#form-pemesanan"
        class="dsw-float-btn"
        data-scroll-to-form
        aria-label="Pesan Deep Sea Water Treatment Lotion"
      >
        <span>Pesan Sekarang</span>
        <span class="dsw-float-divider" aria-hidden="true"></span>
        <span class="dsw-float-sub">Mulai Rp79rb</span>
        <Icon name="lucide:arrow-down" class="size-3.5 dsw-float-arrow" aria-hidden="true" />
      </a>
    </div>
  </div>

  <script is:inline>
    (function () {
      const heroSection = document.getElementById('hero-section');
      const formSection = document.getElementById('form-pemesanan');
      const floatingCta = document.getElementById('floating-cta');

      document.querySelectorAll('[data-scroll-to-form]').forEach((link) => {
        link.addEventListener('click', (e) => {
          if (!formSection) return;
          e.preventDefault();
          formSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
      });

      if (!floatingCta || !formSection || !('IntersectionObserver' in window)) return;

      let isHeroVisible = true;
      let isFormVisible = false;

      function syncVisibility() {
        const shouldShow = !isHeroVisible && !isFormVisible;
        floatingCta.classList.toggle('is-visible', shouldShow);
      }

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.target === heroSection) {
              isHeroVisible = entry.isIntersecting;
            } else if (entry.target === formSection) {
              isFormVisible = entry.isIntersecting;
            }
          });
          syncVisibility();
        },
        { root: null, threshold: 0.05 }
      );

      if (heroSection) observer.observe(heroSection);
      observer.observe(formSection);
    })();
  </script>
</BaseLayout>
