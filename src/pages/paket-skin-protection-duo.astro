---
import BaseLayout from '../layouts/BaseLayout.astro';
import GeoIpResolvedForm from '../components/storefront/forms/GeoIpResolvedForm.astro';
import MetaLandingTracker from '../components/storefront/tracking/MetaLandingTracker.astro';
import Icon from '../components/storefront/shared/Icon.astro';
import RatingStars from '../components/storefront/shared/RatingStars.astro';
import { getStorefrontProduct } from '../lib/catalog';
import { nativeLandingCanonicalPath } from '../lib/landing-pages';
import { defaultCatalogContentId } from '../lib/catalog-feed';
import { getRuntimeEnv } from '../lib/env';
import { loadStoreCodDisabledProvinceCodes } from '../lib/form-mode';
import { getStoreAdsConfig } from '../lib/store-ads';
import '../styles/form-hybrid.css';
import '../styles/landing-pages/paket-skin-protection-duo.css';

export const prerender = false;

const PRODUCT_SLUG = 'paket-skin-protection-duo';
const LANDING_SLUG = 'paket-skin-protection-duo';
const PAGE_TITLE = 'Paket Skin Protection Duo — NAD+ Booster Serum & Oxydew Sunscreen SPF 50+ BPOM';
const PAGE_DESC = 'Kombinasi antioksidan pengencang dan proteksi matahari Numa Skin: NAD+ Booster Anti-Aging Serum 20ml (NA18262000245) dan Oxydew Sunscreen SPF 50+ PA++++ 30ml (NA18251703709).';
const IMG_BASE = '/images/landing/paket-skin-protection-duo';
const HERO_IMAGE = `${IMG_BASE}/hero-paket-skin-protection-duo.webp`;

const database = getRuntimeEnv(Astro.locals)?.OMS_DB as D1Database | undefined;
const claimedProductSlug = Astro.request.headers.get('x-adsbook-product-page');
const [product, canonicalPath, codDisabledProvinceCodes] = await Promise.all([
  getStorefrontProduct(Astro.locals, PRODUCT_SLUG),
  claimedProductSlug
    ? Promise.resolve(`/produk/${claimedProductSlug}`)
    : nativeLandingCanonicalPath(Astro.locals, LANDING_SLUG),
  loadStoreCodDisabledProvinceCodes(database),
  getStoreAdsConfig(Astro.locals),
]);
if (!product) {
  return Astro.rewrite('/404');
}

const canonical = `${Astro.locals.tenant.siteUrl}${canonicalPath}`;

const variants = product.variants || [];
const cheapestVariant = variants.reduce(
  (min: any, v: any) => (!min || v.price < min.price ? v : min),
  variants[0]
);
const defaultVariant = cheapestVariant || {
  id: '37',
  label: 'NAD+ Serum 20ml + Sunscreen 30ml',
  price: 169000,
  comparePrice: 187999,
};
---

<BaseLayout
  title={PAGE_TITLE}
  description={PAGE_DESC}
  image={HERO_IMAGE}
  preloadImages={HERO_IMAGE}
  canonical={canonical}
  hideHeader={true}
  hideFooter={true}
>
  <MetaLandingTracker
    slug={LANDING_SLUG}
    contentId={defaultCatalogContentId(product)}
    contentName={product.contentName}
    price={defaultVariant.price}
  />

  <div class="dsw-shell">
    <main class="dsw-canvas">
      <!-- Section 1: Hero -->
      <section id="hero-section" class="dsw-hero">
        <div class="dsw-hero-head">
          <h1 class="dsw-h1">
            <span class="dsw-hl-tilt">Kerutan & Flek Muncul</span> Karena Sinar UV Merusak Kolagen Wajah?
          </h1>
          <p class="dsw-sub" style="max-width: 390px; margin: 14px auto 0; font-weight: 700;">
            80% penuaan dini (photoaging) dipicu radiasi UVA/UVB yang menghancurkan serat kolagen setiap siang.<br />
            <span class="dsw-underline-teal">Bangun kolagen & kunci perisai UV dengan Paket Skin Protection Duo!</span>
          </p>
        </div>

        <div class="dsw-hero-stage">
          <div class="dsw-hero-top-tag">
            <div class="dsw-hero-top-pill">
              <Icon name="lucide:sparkles" class="size-3.5" aria-hidden="true" />
              <span>Duo Lifting & Anti-UV • Hemat Rp19.000</span>
            </div>
          </div>

          <img
            src={HERO_IMAGE}
            alt="Perbandingan wajah kendur terbakar matahari vs kulit kencang terlindungi dengan Paket Skin Protection Duo Numa Skin"
            width="720"
            height="480"
            class="dsw-hero-img"
            fetchpriority="high"
            loading="eager"
            decoding="async"
          />

          <div class="dsw-hero-ba" aria-hidden="true">
            <span class="dsw-hero-ba-pill dsw-hero-ba-pill--before">Photoaging & Kendur</span>
            <span class="dsw-hero-ba-pill dsw-hero-ba-pill--after">Kencang & Terlindungi</span>
          </div>

          <div class="dsw-hero-trust-strip" role="list" aria-label="Jaminan kualitas Numa Skin">
            <div class="dsw-trust-item" role="listitem">
              <span class="dsw-trust-icon">
                <Icon name="lucide:shield-check" class="size-3.5" aria-hidden="true" />
              </span>
              <span class="dsw-trust-text">
                <strong class="dsw-trust-label">2 BPOM Resmi</strong>
                <span class="dsw-trust-sub">NAD+ & Oxydew SPF</span>
              </span>
            </div>
            <div class="dsw-trust-item" role="listitem">
              <span class="dsw-trust-icon">
                <Icon name="lucide:sun" class="size-3.5" aria-hidden="true" />
              </span>
              <span class="dsw-trust-text">
                <strong class="dsw-trust-label">SPF 50+ PA++++</strong>
                <span class="dsw-trust-sub">2% RejuveNAD™</span>
              </span>
            </div>
            <div class="dsw-trust-item" role="listitem">
              <span class="dsw-trust-icon">
                <Icon name="lucide:award" class="size-3.5" aria-hidden="true" />
              </span>
              <span class="dsw-trust-text">
                <strong class="dsw-trust-label">Halal ID</strong>
                <span class="dsw-trust-sub">Tanpa Whitecast</span>
              </span>
            </div>
          </div>
        </div>

        <div class="dsw-hero-foot">
          <p class="dsw-hero-caption">
            Duet <strong>NAD+ Booster Anti-Aging Serum</strong> & <strong>Oxydew Sunscreen SPF 50+ PA++++</strong> untuk merawat kekencangan wajah sekaligus menangkal penuaan akibat sinar matahari.
          </p>
          <a href="#form-pemesanan" class="dsw-cta" data-scroll-to-form>
            <span>Ambil Paket Skin Protection Duo</span>
            <Icon name="lucide:arrow-right" class="size-5" aria-hidden="true" />
          </a>
        </div>
      </section>

      <!-- Section 2: Solusi Praktis -->
      <section class="dsw-section">
        <h2 class="dsw-h2">
          Pertahanan Ganda <span class="dsw-hl-aqua">Anti-Photoaging</span>
        </h2>
        <p class="dsw-sub" style="margin-top: 8px;">
          Merawat kolagen dari dalam sekaligus memproteksi permukaan kulit dari luar tanpa rasa lengket:
        </p>

        <div class="dsw-solution-box">
          <img
            src={`${IMG_BASE}/solusi-serum-nad-perisai-spf50.webp`}
            alt="Wanita Indonesia mengaplikasikan NAD+ Booster Serum dan Oxydew Sunscreen SPF 50+"
            width="648"
            height="432"
            class="dsw-solution-img"
            loading="lazy"
            fetchpriority="low"
            decoding="async"
          />

          <div class="dsw-check-list">
            <div class="dsw-check-item">
              <span class="dsw-icon-green">
                <Icon name="lucide:check" class="size-3.5" aria-hidden="true" />
              </span>
              <p class="dsw-list-text">
                <strong>Tahap 1 — NAD+ Booster Anti-Aging Serum:</strong> Mengandung 2% RejuveNAD™ (Swiss) dan 6X Biomimetic Peptide untuk merawat elastisitas kontur pipi serta menyamarkan garis senyum.
              </p>
            </div>
            <div class="dsw-check-item">
              <span class="dsw-icon-green">
                <Icon name="lucide:check" class="size-3.5" aria-hidden="true" />
              </span>
              <p class="dsw-list-text">
                <strong>Tahap 2 — Oxydew Anti-Aging Sunscreen SPF 50+ PA++++:</strong> Diperkaya 3% Luceane™ (Sederma Perancis) dan 4X UV Filter yang menjaga kolagen baru agar tidak dirusak terik matahari.
              </p>
            </div>
            <div class="dsw-check-item">
              <span class="dsw-icon-green">
                <Icon name="lucide:check" class="size-3.5" aria-hidden="true" />
              </span>
              <p class="dsw-list-text">
                <strong>Ringan & Bebas Whitecast:</strong> Kedua formula berbasis air laut dalam Ulleung yang langsung menyatu tanpa membuat wajah berminyak atau abu-abu.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- Section 3: Masalah Kulit -->
      <section class="dsw-section--tinted">
        <h2 class="dsw-h2">
          Mengapa Serum Anti-Aging <span class="dsw-hl-coral">Gagal Tanpa Sunscreen?</span>
        </h2>

        <div class="dsw-grid-2">
          <article class="dsw-card">
            <img
              src={`${IMG_BASE}/masalah-uv-rusak-kolagen-wajah.webp`}
              alt="Paparan sinar matahari siang merusak kolagen kulit dan memicu kerutan"
              width="480"
              height="320"
              class="dsw-card-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <div class="dsw-card-body">
              <span class="dsw-badge-red">Kolagen Rusak di Siang Hari</span>
              <p class="dsw-card-desc">
                Memakai serum malam hari tanpa pelindung SPF 50+ di siang hari membuat kolagen yang baru terbentuk kembali rusak oleh sinar UVA.
              </p>
            </div>
          </article>

          <article class="dsw-card">
            <img
              src={`${IMG_BASE}/masalah-sunscreen-biasa-lengket.webp`}
              alt="Sunscreen konvensional yang lengket dan membuat kulit tampak kusam berminyak"
              width="480"
              height="320"
              class="dsw-card-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <div class="dsw-card-body">
              <span class="dsw-badge-red">Sunscreen Biasa Lengket</span>
              <p class="dsw-card-desc">
                Banyak wanita enggan memakai sunscreen karena teksturnya tebal, berminyak, dan menggumpal saat ditumpuk di atas serum.
              </p>
            </div>
          </article>
        </div>

        <div class="dsw-list-box">
          <p class="dsw-list-box-title">Tanda Anda Membutuhkan Skin Protection Duo:</p>
          <div class="dsw-check-list" style="margin-top: 0;">
            <div class="dsw-check-item">
              <span class="dsw-icon-red">
                <Icon name="lucide:x" class="size-3.5" aria-hidden="true" />
              </span>
              <p class="dsw-list-text">
                Sering beraktivitas di luar ruangan atau terpapar cahaya matahari dari jendela/kendaraan
              </p>
            </div>
            <div class="dsw-check-item">
              <span class="dsw-icon-red">
                <Icon name="lucide:x" class="size-3.5" aria-hidden="true" />
              </span>
              <p class="dsw-list-text">
                Garis halus di sekitar mata dan bintik flek matahari mulai bertambah seiring usia 30+
              </p>
            </div>
            <div class="dsw-check-item">
              <span class="dsw-icon-red">
                <Icon name="lucide:x" class="size-3.5" aria-hidden="true" />
              </span>
              <p class="dsw-list-text">
                Menginginkan duet serum pengencang dan sunscreen ringan yang tidak menggumpal (zero pilling)
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- Section 4: Transformasi Nyata -->
      <section class="dsw-section">
        <h2 class="dsw-h2">
          Transformasi <span class="dsw-hl-aqua">Kencang & Terlindungi</span>
        </h2>
        <p class="dsw-sub" style="margin-top: 8px;">
          Perbandingan kulit yang terpapar UV tanpa proteksi vs rutin dirawat dengan NAD+ Booster Serum & Oxydew Sunscreen:
        </p>

        <div class="dsw-grid-2">
          <article class="dsw-card">
            <img
              src={`${IMG_BASE}/kondisi-kendur-flek-akibat-uv.webp`}
              alt="Kondisi kulit kendur dengan garis halus dan flek akibat paparan sinar UV"
              width="480"
              height="320"
              class="dsw-card-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <div class="dsw-card-body">
              <span class="dsw-badge-red">Tanpa Duet Anti-Photoaging</span>
              <p class="dsw-card-desc">
                Serat elastin melemah akibat radiasi matahari, memicu pipi tampak kendur dan bintik kecokelatan muncul kembali.
              </p>
            </div>
          </article>

          <article class="dsw-card">
            <img
              src={`${IMG_BASE}/kondisi-kencang-cerah-bebas-uv.webp`}
              alt="Kondisi kulit wajah kencang, halus, dan terlindungi dari sinar UV"
              width="480"
              height="320"
              class="dsw-card-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <div class="dsw-card-body">
              <span class="dsw-badge-green">Rutin Skin Protection Duo</span>
              <p class="dsw-card-desc">
                Kontur wajah terasa lebih kencang padat dan warna kulit tetap cerah merata meski aktif di bawah matahari.
              </p>
            </div>
          </article>
        </div>

        <div class="dsw-list-box">
          <p class="dsw-list-box-title">Hasil Pemakaian Teratur:</p>
          <div class="dsw-check-list" style="margin-top: 0;">
            <div class="dsw-check-item">
              <span class="dsw-icon-green">
                <Icon name="lucide:check" class="size-3.5" aria-hidden="true" />
              </span>
              <p class="dsw-list-text">
                <strong>Sejak Hari Pertama:</strong> Kulit terlindungi SPF 50+ PA++++ dengan tekstur ringan segar tanpa whitecast
              </p>
            </div>
            <div class="dsw-check-item">
              <span class="dsw-icon-green">
                <Icon name="lucide:check" class="size-3.5" aria-hidden="true" />
              </span>
              <p class="dsw-list-text">
                <strong>Minggu 2–3:</strong> Kulit tidak lagi mudah memerah atau menggelap saat terkena panas siang
              </p>
            </div>
            <div class="dsw-check-item">
              <span class="dsw-icon-green">
                <Icon name="lucide:check" class="size-3.5" aria-hidden="true" />
              </span>
              <p class="dsw-list-text">
                <strong>Hari ke-42:</strong> Tampilan garis senyum dan kerutan halus tampak lebih samar dan pipi terasa lebih kencang
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- Section 5: Cara Pakai 2 Langkah -->
      <section class="dsw-section--tinted">
        <h2 class="dsw-h2">
          Urutan Pakai <span class="dsw-hl-aqua">2 Langkah Pagi & Malam</span>
        </h2>
        <p class="dsw-sub" style="margin-top: 8px;">
          Layering ringan yang cepat meresap dan nyaman dipakai di bawah bedak atau riasan:
        </p>

        <div class="dsw-grid-2">
          <article class="dsw-card">
            <img
              src={`${IMG_BASE}/cara-pakai-protection-step1-nad.webp`}
              alt="Langkah 1 aplikasikan NAD+ Booster Serum pagi dan malam"
              width="480"
              height="320"
              class="dsw-card-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <div class="dsw-card-body">
              <span class="dsw-badge-teal">1. Nutrisi NAD+ (Pagi & Malam)</span>
              <p class="dsw-card-desc">
                Teteskan 3–4 tetes <strong>NAD+ Booster Serum</strong> pada wajah bersih lalu pijat lembut ke arah atas hingga meresap.
              </p>
            </div>
          </article>

          <article class="dsw-card">
            <img
              src={`${IMG_BASE}/cara-pakai-protection-step2-spf50.webp`}
              alt="Langkah 2 kunci dengan 2 ruas jari Oxydew Sunscreen SPF 50+ di pagi hari"
              width="480"
              height="320"
              class="dsw-card-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <div class="dsw-card-body">
              <span class="dsw-badge-teal">2. Perisai UV (Pagi/Siang)</span>
              <p class="dsw-card-desc">
                Pada pagi hari, kunci dengan 2 ruas jari <strong>Oxydew Sunscreen SPF 50+ PA++++</strong> secara merata di wajah dan leher.
              </p>
            </div>
          </article>
        </div>

        <div style="margin-top: 22px; text-align: center;">
          <a href="#form-pemesanan" class="dsw-cta" data-scroll-to-form>
            <span>Pesan Paket Skin Protection Duo</span>
            <Icon name="lucide:arrow-right" class="size-5" aria-hidden="true" />
          </a>
        </div>
      </section>

      <!-- Section 6: Bukti Pelanggan -->
      <section class="dsw-section">
        <h2 class="dsw-h2">
          Bukti Nyata <span class="dsw-hl-aqua">Anti-Kerutan & Anti-Gosong</span>
        </h2>
        <p class="dsw-sub" style="margin-top: 8px;">
          Pengalaman pelanggan yang memadukan NAD+ Booster Serum dengan Oxydew Sunscreen SPF 50+:
        </p>

        <div class="dsw-grid-2">
          <div class="dsw-proof-cell">
            <img
              src={`${IMG_BASE}/bukti-tekstur-nad-dan-oxydew.webp`}
              alt="Tekstur serum NAD+ dan lotion ringan Oxydew Sunscreen yang menyatu tanpa menggumpal"
              width="480"
              height="320"
              class="dsw-proof-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <p class="dsw-proof-OverlayCaption">Tidak Menggumpal Saat Ditumpuk</p>
          </div>
          <div class="dsw-proof-cell">
            <img
              src={`${IMG_BASE}/bukti-wanita-38an-outdoor-kencang.webp`}
              alt="Potret pelanggan usia 38 tahun beraktivitas di luar ruangan dengan kulit cerah kencang"
              width="480"
              height="320"
              class="dsw-proof-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <p class="dsw-proof-OverlayCaption">Aman di Bawah Matahari</p>
          </div>
          <div class="dsw-proof-cell">
            <img
              src={`${IMG_BASE}/bukti-kulit-halus-bebas-whitecast.webp`}
              alt="Close-up pipi kencang dan segar tanpa residu putih whitecast"
              width="480"
              height="320"
              class="dsw-proof-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <p class="dsw-proof-OverlayCaption">Nol Whitecast & Bebas Lengket</p>
          </div>
          <div class="dsw-proof-cell">
            <img
              src={`${IMG_BASE}/bukti-meja-rias-skin-protection.webp`}
              alt="Kemasan Paket Skin Protection Duo di meja rias pelanggan"
              width="480"
              height="320"
              class="dsw-proof-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <p class="dsw-proof-OverlayCaption">Duet Wajib Pagi Hari</p>
          </div>
        </div>

        <div class="dsw-testi-list">
          <article class="dsw-testi-card">
            <div class="dsw-testi-head">
              <div class="dsw-testi-avatar" aria-hidden="true">V</div>
              <div class="dsw-testi-meta">
                <p class="dsw-testi-name">
                  Ibu Vina Oktaviani (40 thn)
                  <span class="dsw-verified-pill">Verified Buyer</span>
                </p>
                <div class="dsw-stars">
                  <RatingStars rating={5} />
                </div>
              </div>
            </div>
            <p class="dsw-testi-body">
              "Kerjaku sering bolak-balik lapangan jadi gampang muncul flek dan kerutan halus. Pakai duet serum NAD+ sama Oxydew Sunscreen ini enak banget, nggak lengket sama sekali dan wajah berasa jauh lebih kencang."
            </p>
            <div class="dsw-testi-foot">
              <span>Tangerang</span>
              <span>•</span>
              <span>Pemakaian 4 Minggu</span>
            </div>
          </article>

          <article class="dsw-testi-card">
            <div class="dsw-testi-head">
              <div class="dsw-testi-avatar" aria-hidden="true">S</div>
              <div class="dsw-testi-meta">
                <p class="dsw-testi-name">
                  Kak Siska Amelia (35 thn)
                  <span class="dsw-verified-pill">Verified Buyer</span>
                </p>
                <div class="dsw-stars">
                  <RatingStars rating={5} />
                </div>
              </div>
            </div>
            <p class="dsw-testi-body">
              "Sunscreennya beneran bening menyatu di kulit sawo matangku, nggak bikin kusam pas sore. Ditambah serum NAD+ tiap pagi-malam, garis senyumku kelihatan lebih samar."
            </p>
            <div class="dsw-testi-foot">
              <span>Makassar</span>
              <span>•</span>
              <span>Pemakaian 3 Minggu</span>
            </div>
          </article>
        </div>
      </section>

      <!-- Section 7: Tabel Perbandingan -->
      <section class="dsw-section--tinted">
        <h2 class="dsw-h2">
          Keunggulan <span class="dsw-hl-aqua">Skin Protection Duo</span>
        </h2>
        <p class="dsw-sub" style="margin-top: 8px;">
          Mengapa kombinasi NAD+ Booster Serum + Oxydew Sunscreen jauh lebih efektif menjaga kemudaan kulit:
        </p>

        <div class="dsw-cmp-card">
          <div class="dsw-cmp-head">
            <div class="dsw-cmp-col">Aspek Perlindungan</div>
            <div class="dsw-cmp-col dsw-cmp-col--numa">Skin Protection Duo</div>
            <div class="dsw-cmp-col">Skincare Tanpa SPF</div>
          </div>

          <div class="dsw-cmp-row">
            <div class="dsw-cmp-cell dsw-cmp-cell--feature">Booster Kolagen & Energi Sel</div>
            <div class="dsw-cmp-cell dsw-cmp-cell--numa">
              <span class="dsw-icon-green" style="margin: 0 auto;">
                <Icon name="lucide:check" class="size-3.5" aria-hidden="true" />
              </span>
              <span class="dsw-cmp-sub">2% RejuveNAD™ + 6X Peptide</span>
            </div>
            <div class="dsw-cmp-cell">
              <span class="dsw-icon-red" style="margin: 0 auto;">
                <Icon name="lucide:x" class="size-3.5" aria-hidden="true" />
              </span>
              <span class="dsw-cmp-sub">Rusak kembali oleh UV</span>
            </div>
          </div>

          <div class="dsw-cmp-row">
            <div class="dsw-cmp-cell dsw-cmp-cell--feature">Proteksi Photoaging Siang</div>
            <div class="dsw-cmp-cell dsw-cmp-cell--numa">
              <span class="dsw-icon-green" style="margin: 0 auto;">
                <Icon name="lucide:check" class="size-3.5" aria-hidden="true" />
              </span>
              <span class="dsw-cmp-sub">SPF 50+ PA++++ & 3% Luceane™</span>
