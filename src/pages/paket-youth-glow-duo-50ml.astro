  <script is:inline>
    (function () {
      const heroSection = document.getElementById('hero-section');
      const formSection = document.getElementById('form-pemesanan');
      const floatingCta = document.getElementById('floating-cta');

      document.querySelectorAll('[data-scroll-to-form]').forEach((link) => {
        link.addEventListener('click', (e) => {
          if (!formSection) return;
          e.preventDefault();
          formSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
      });

      if (!floatingCta || !formSection || !('IntersectionObserver' in window)) return;

      let isHeroVisible = true;
      let isFormVisible = false;

      function syncVisibility() {
        const shouldShow = !isHeroVisible && !isFormVisible;
        floatingCta.classList.toggle('is-visible', shouldShow);
      }

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.target === heroSection) {
              isHeroVisible = entry.isIntersecting;
            } else if (entry.target === formSection) {
              isFormVisible = entry.isIntersecting;
            }
          });
          syncVisibility();
        },
        { root: null, threshold: 0.05 }
      );

      if (heroSection) observer.observe(heroSection);
      observer.observe(formSection);
    })();
  </script>
