---
import BaseLayout from '../layouts/BaseLayout.astro';
import GeoIpResolvedForm from '../components/storefront/forms/GeoIpResolvedForm.astro';
import MetaLandingTracker from '../components/storefront/tracking/MetaLandingTracker.astro';
import Icon from '../components/storefront/shared/Icon.astro';
import RatingStars from '../components/storefront/shared/RatingStars.astro';
import { getStorefrontProduct } from '../lib/catalog';
import { nativeLandingCanonicalPath } from '../lib/landing-pages';
import { defaultCatalogContentId } from '../lib/catalog-feed';
import { getRuntimeEnv } from '../lib/env';
import { loadStoreCodDisabledProvinceCodes } from '../lib/form-mode';
import { getStoreAdsConfig } from '../lib/store-ads';
import '../styles/form-hybrid.css';
import '../styles/landing-pages/paket-timeless-skin-set.css';

export const prerender = false;

const PRODUCT_SLUG = 'paket-timeless-skin-set';
const LANDING_SLUG = 'paket-timeless-skin-set';
const PAGE_TITLE = 'Paket Timeless Skin Set - Anti-Aging Kulit Sensitif & Kunci Glass Skin BPOM';
const PAGE_DESC = 'Paket bundling 2-in-1 Numa Skin: NAD+ Booster Anti-Aging Serum 20ml + Calming Barrier Gloss Gel Moisturizer 30ml untuk mengencangkan wajah tanpa perih di kulit sensitif (2 BPOM Resmi).';
const IMG_BASE = '/images/landing/paket-timeless-skin-set';
const HERO_IMAGE = `${IMG_BASE}/hero-paket-timeless-skin-set.webp`;

const database = getRuntimeEnv(Astro.locals)?.OMS_DB as D1Database | undefined;
const claimedProductSlug = Astro.request.headers.get('x-adsbook-product-page');
const [product, canonicalPath, codDisabledProvinceCodes] = await Promise.all([
  getStorefrontProduct(Astro.locals, PRODUCT_SLUG),
  claimedProductSlug
    ? Promise.resolve(`/produk/${claimedProductSlug}`)
    : nativeLandingCanonicalPath(Astro.locals, LANDING_SLUG),
  loadStoreCodDisabledProvinceCodes(database),
  getStoreAdsConfig(Astro.locals),
]);
if (!product) {
  return Astro.rewrite('/404');
}

const canonical = `${Astro.locals.tenant.siteUrl}${canonicalPath}`;

const variants = product.variants || [];
const cheapestVariant = variants.reduce(
  (min: any, v: any) => (!min || v.price < min.price ? v : min),
  variants[0]
);
const defaultVariant = cheapestVariant || {
  id: '45',
  label: 'NAD+ Serum 20ml + Gloss Gel 30ml',
  price: 169000,
  comparePrice: 187999,
};
---

<BaseLayout
  title={PAGE_TITLE}
  description={PAGE_DESC}
  image={HERO_IMAGE}
  preloadImages={HERO_IMAGE}
  canonical={canonical}
  hideHeader={true}
  hideFooter={true}
>
  <MetaLandingTracker
    slug={LANDING_SLUG}
    contentId={defaultCatalogContentId(product)}
    contentName={product.contentName}
    price={defaultVariant.price}
  />

  <div class="dsw-shell">
    <main class="dsw-canvas">
      <!-- Section 1: Hero -->
      <section id="hero-section" class="dsw-hero">
        <div class="dsw-hero-head">
          <h1 class="dsw-h1">
            <span class="dsw-hl-tilt">Ingin Wajah Kencang</span> Tapi Kulit Mudah Merah & Takut Perih?
          </h1>
          <p class="dsw-sub" style="max-width: 390px; margin: 14px auto 0; font-weight: 700;">
            Banyak serum anti-aging membuat kulit sensitif memerah mengelupas, sedangkan krim anti-aging biasa terasa berat menyumbat pori.<br />
            <span class="dsw-underline-teal">Kencangkan & tenangkan dengan Paket Timeless Skin Set Numa Skin!</span>
          </p>
        </div>

        <div class="dsw-hero-stage">
          <div class="dsw-hero-top-tag">
            <div class="dsw-hero-top-pill">
              <Icon name="lucide:award" class="size-3.5" aria-hidden="true" />
              <span>Anti-Aging Kulit Sensitif • Hemat Rp19.000</span>
            </div>
          </div>

          <img
            src={HERO_IMAGE}
            alt="Perbandingan wajah kemerahan bergaris halus vs kulit tenang kencang glass skin dengan Paket Timeless Skin Set Numa Skin"
            width="720"
            height="480"
            class="dsw-hero-img"
            fetchpriority="high"
            loading="eager"
            decoding="async"
          />

          <div class="dsw-hero-overlap">
            <div class="dsw-hero-overlap-inner">
              <h2 class="dsw-hero-overlap-title">Alternatif Nyaman Tanpa Perih Retinol</h2>
              <p class="dsw-hero-overlap-text">
                Perpaduan <strong style="color: #be123c;">2% Swiss RejuveNAD™ + 6X Peptide dengan pelembap dingin Meadowestolide® Gloss Gel</strong> merawat garis senyum sekaligus menenangkan skin barrier.
              </p>
            </div>
          </div>
        </div>

        <div class="dsw-trust-row">
          <div class="dsw-trust-item">
            <span class="dsw-trust-icon">
              <Icon name="lucide:shield-check" class="size-4" aria-hidden="true" />
            </span>
            <div>
              <span class="dsw-trust-label">BPOM Resmi</span>
              <span class="dsw-trust-sub">2 Izin Edar</span>
            </div>
          </div>
          <div class="dsw-trust-item">
            <span class="dsw-trust-icon">
              <Icon name="lucide:badge-check" class="size-4" aria-hidden="true" />
            </span>
            <div>
              <span class="dsw-trust-label">Halal RI</span>
              <span class="dsw-trust-sub">Aman Sensitif</span>
            </div>
          </div>
          <div class="dsw-trust-item">
            <span class="dsw-trust-icon">
              <Icon name="lucide:truck" class="size-4" aria-hidden="true" />
            </span>
            <div>
              <span class="dsw-trust-label">Bisa COD</span>
              <span class="dsw-trust-sub">Bayar di Rumah</span>
            </div>
          </div>
        </div>
      </section>

      <!-- Section 2: Solusi Singkat + Visual -->
      <section class="dsw-section">
        <h2 class="dsw-h2">
          Duet <span class="dsw-hl-aqua">pengencang lembut & pengunci dingin</span>
        </h2>
        <p class="dsw-sub">Dirancang khusus untuk kulit sensitif, berminyak, atau kombinasi di usia 30+.</p>

        <div class="dsw-photo-stack">
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/solusi-kencang-tanpa-perih-merah.webp`}
              alt="Wanita Indonesia usia 36 tahun mengoleskan Calming Gloss Gel di atas NAD+ Serum dengan kulit pipi tenang, kencang, dan bening"
              width="648"
              height="432"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
          </div>
        </div>

        <div class="dsw-list">
          <div class="dsw-list-row">
            <span class="dsw-icon-teal">
              <Icon name="lucide:layers" class="size-4" aria-hidden="true" />
            </span>
            <p class="dsw-list-text">
              <strong style="color: #0f172a;">NAD+ Booster Anti-Aging Serum (20 ml):</strong> Merawat kekencangan kontur wajah & garis halus dengan 2% RejuveNAD™, 6X Peptide, dan 4X Cica yang ramah kulit sensitif.
            </p>
          </div>
          <div class="dsw-list-row">
            <span class="dsw-icon-teal">
              <Icon name="lucide:droplets" class="size-4" aria-hidden="true" />
            </span>
            <p class="dsw-list-text">
              <strong style="color: #0f172a;">Calming Barrier Gloss Gel (30 ml):</strong> Pelembap water-jelly dengan Meadowestolide®, Astragalus, & Ceramide yang mengunci serum tanpa rasa berat berminyak.
            </p>
          </div>
          <div class="dsw-list-row">
            <span class="dsw-icon-teal">
              <Icon name="lucide:shield-check" class="size-4" aria-hidden="true" />
            </span>
            <p class="dsw-list-text">
              <strong style="color: #0f172a;">Double Cica & Barrier Support:</strong> Kedua produk diperkaya ekstrak Centella Asiatica sehingga wajah terasa sejuk dan bebas kemerahan.
            </p>
          </div>
        </div>
      </section>

      <!-- Section 3: Tanda Masalah Kulit + Visual Grid -->
      <section class="dsw-section dsw-section--warn">
        <h2 class="dsw-h2">
          Dilema merawat penuaan pada <span class="dsw-underline-warn">kulit tipis & sensitif</span>
        </h2>

        <div class="dsw-photo-grid-2">
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/masalah-takut-anti-aging-iritasi.webp`}
              alt="Wanita bercermin menyentuh pipi yang memerah dan perih setelah memakai produk anti-aging keras"
              width="315"
              height="210"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <p class="dsw-photo-caption">
              <strong style="color: #be123c; display: block;">Takut Perih Akibat Bahan Keras</strong>
              Bahan anti-aging agresif sering memicu rasa panas, kemerahan, dan pengelupasan.
            </p>
          </div>
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/masalah-kulit-tipis-mudah-keriput.webp`}
              alt="Close-up kulit tipis sensitif dengan kemerahan dan garis halus di sekitar mata dan pipi"
              width="315"
              height="210"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <p class="dsw-photo-caption">
              <strong style="color: #be123c; display: block;">Barrier Tipis Cepat Berkerut</strong>
              Kulit yang terus-menerus iritasi dan dehidrasi justru lebih cepat mengalami garis halus.
            </p>
          </div>
        </div>

        <div class="dsw-list">
          <div class="dsw-list-row">
            <span class="dsw-icon-warn">
              <Icon name="lucide:triangle-alert" class="size-4" aria-hidden="true" />
            </span>
            <p class="dsw-list-text">
              Ingin merawat garis senyum dan kerutan mata, tapi <strong style="color: #be123c;">kulit tidak kuat memakai retinol</strong>.
            </p>
          </div>
          <div class="dsw-list-row">
            <span class="dsw-icon-warn">
              <Icon name="lucide:triangle-alert" class="size-4" aria-hidden="true" />
            </span>
            <p class="dsw-list-text">
              Krim anti-aging biasa terasa <strong style="color: #be123c;">terlalu pekat berminyak dan memicu bruntusan</strong> di pipi.
            </p>
          </div>
          <div class="dsw-list-row">
            <span class="dsw-icon-warn">
              <Icon name="lucide:triangle-alert" class="size-4" aria-hidden="true" />
            </span>
            <p class="dsw-list-text">
              Wajah tampak <strong style="color: #be123c;">lelah, kemerahan tidak merata, dan kehilangan kekenyalan</strong>.
            </p>
          </div>
        </div>
      </section>

      <!-- Section 4: Perbandingan Visual Sebelum vs Sesudah -->
      <section class="dsw-section">
        <h2 class="dsw-h2">
          Perbandingan kulit <span class="dsw-hl-aqua">sebelum vs sesudah rutin</span>
        </h2>
        <p class="dsw-sub">Ketika peremajaan seluler NAD+ dikunci oleh pelembap penenang skin barrier.</p>

        <div class="dsw-photo-stack">
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/kondisi-penuaan-sensitif-kemerahan.webp`}
              alt="Kondisi pipi kemerahan sensitif dengan garis halus dan lipatan senyum sebelum perawatan"
              width="648"
              height="432"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <span class="dsw-photo-badge dsw-photo-badge--before">Sebelum Timeless Skin Set</span>
            <p class="dsw-photo-caption">
              Kulit tampak tipis kemerahan, garis halus terlihat jelas di sudut mata & mulut, serta mudah reaktif.
            </p>
          </div>

          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/kondisi-kencang-tenang-glassy.webp`}
              alt="Kondisi pipi tenang bebas merah, kencang, dan tampak bening glassy setelah rutin memakai Timeless Skin Set"
              width="648"
              height="432"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <span class="dsw-photo-badge dsw-photo-badge--after">Rutin Timeless Skin Set</span>
            <p class="dsw-photo-caption">
              Kemerahan mereda, kontur pipi terasa lebih padat kencang, dan permukaan kulit tampak bening sehat.
            </p>
          </div>
        </div>
      </section>

      <!-- Section 5: Dark Marine Section — Cara Pakai Praktis -->
      <section class="dsw-section dsw-section--dark">
        <h2 class="dsw-h2">
          Urutan Pakai <span style="color: #99e2ec;">2 Langkah Sejuk & Ringan</span>
        </h2>
        <p class="dsw-sub">Meresap cepat tanpa rasa lengket baik di pagi maupun malam hari.</p>

        <div class="dsw-photo-stack">
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/cara-pakai-timeless-step1-nad.webp`}
              alt="Langkah 1: Teteskan 3-4 tetes NAD+ Booster Serum dan tepuk lembut ke wajah"
              width="648"
              height="432"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <p class="dsw-photo-caption">
              <strong style="color: #ffffff;">Langkah 1 (Isi Energi & Peptida):</strong> Teteskan 3–4 tetes NAD+ Booster Serum ke wajah yang bersih, ratakan lembut ke arah atas.
            </p>
          </div>
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/cara-pakai-timeless-step2-gloss-gel.webp`}
              alt="Langkah 2: Kunci kelembapan dengan Calming Barrier Gloss Gel Moisturizer"
              width="648"
              height="432"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <p class="dsw-photo-caption">
              <strong style="color: #ffffff;">Langkah 2 (Kunci Water-Jelly Penenang):</strong> Oleskan Calming Gloss Gel merata untuk mengunci serum dan menenangkan kemerahan.
            </p>
          </div>
        </div>

        <div class="dsw-list">
          <div class="dsw-list-row">
            <span class="dsw-step-num">1</span>
            <p class="dsw-step-text">
              <strong style="color: #ffffff;">Tahap 1 — NAD+ Booster Serum (20 ml):</strong> Merawat kekencangan kulit & garis halus tanpa memicu iritasi.
            </p>
          </div>
          <div class="dsw-list-row">
            <span class="dsw-step-num">2</span>
            <p class="dsw-step-text">
              <strong style="color: #ffffff;">Tahap 2 — Calming Gloss Gel (30 ml):</strong> <strong style="color: #ffffff; background: #104452; padding: 1px 6px; border-radius: 4px;">Mengunci kelembapan</strong> dengan tekstur ringan bebas komedo.
            </p>
          </div>
          <div class="dsw-list-row">
            <span class="dsw-step-num">3</span>
            <p class="dsw-step-text">
              Aman dipakai setiap pagi (sebelum sunscreen) dan setiap malam sebelum tidur.
            </p>
          </div>
        </div>
      </section>

      <!-- Section 6: Ulasan Pelanggan -->
      <section class="dsw-section">
        <h2 class="dsw-h2">
          Cerita pelanggan <span class="dsw-hl-aqua">Timeless Skin Set</span>
        </h2>
        <p class="dsw-sub">Solusi anti-aging yang nyaman untuk kulit sensitif & kombinasi dengan hemat Rp19.000.</p>

        <div class="dsw-reviews-divide">
          <div class="dsw-review-row">
            <div class="dsw-review-head">
              <div>
                <p class="dsw-review-author">
                  Ibu Clarissa N.
                  <span style="color: #0b6e7d; display: inline-flex;">
                    <Icon name="lucide:badge-check" class="size-4" aria-hidden="true" />
                  </span>
                </p>
                <p class="dsw-review-meta">Jakarta Selatan • Usia 36 Tahun</p>
              </div>
              <RatingStars rating={5} starClass="h-3.5 w-3.5 !fill-[#d97706] !text-[#d97706]" />
            </div>
            <p class="dsw-review-quote">
              "Kulitku sensitif banget gak pernah cocok pakai retinol. <span class="dsw-hl-aqua">Pakai duet NAD+ Serum sama Gloss Gel ini adem banget</span>, gak merah sama sekali tapi pipi berasa kencang."
            </p>
          </div>
          <div class="dsw-review-row">
            <div class="dsw-review-head">
              <div>
                <p class="dsw-review-author">
                  Bunda Vania P.
                  <span style="color: #0b6e7d; display: inline-flex;">
                    <Icon name="lucide:badge-check" class="size-4" aria-hidden="true" />
                  </span>
                </p>
                <p class="dsw-review-meta">Surabaya • Usia 38 Tahun</p>
              </div>
              <RatingStars rating={5} starClass="h-3.5 w-3.5 !fill-[#d97706] !text-[#d97706]" />
            </div>
            <p class="dsw-review-quote">
              "Suka banget karena teksturnya gak berat kayak krim malam kuno. <strong style="color: #0f172a;">Gloss Gel-nya ringan berair</strong>, <span class="dsw-hl-aqua">pas bangun tidur muka glowing bening bebas bruntusan</span>."
            </p>
          </div>
          <div class="dsw-review-row">
            <div class="dsw-review-head">
              <div>
                <p class="dsw-review-author">
                  Ibu Dinda A.
                  <span style="color: #0b6e7d; display: inline-flex;">
                    <Icon name="lucide:badge-check" class="size-4" aria-hidden="true" />
                  </span>
                </p>
                <p class="dsw-review-meta">Medan • Hemat Rp19.000</p>
              </div>
              <RatingStars rating={5} starClass="h-3.5 w-3.5 !fill-[#d97706] !text-[#d97706]" />
            </div>
            <p class="dsw-review-quote">
              "Beli sepaket gini <span class="dsw-hl-rose">hemat 19 ribu daripada beli ketengan</span>. <span class="dsw-hl-aqua">Garis halus di bawah mata jauh lebih samar</span> dan kulit tenang terus."
            </p>
          </div>
        </div>
      </section>

      <!-- Section 7: Galeri Bukti Visual -->
      <section class="dsw-section dsw-section--tint">
        <h2 class="dsw-h2">
          Perpaduan <span style="color: #0b6e7d;">serum sutra & water-jelly</span>
        </h2>
        <p class="dsw-sub">Meresap seketika dengan hasil akhir bening seperti kaca (glass skin).</p>

        <div class="dsw-photo-grid-2">
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/bukti-tekstur-duo-timeless-set.webp`}
              alt="Swatch 2 tekstur Timeless Skin Set: serum emulsi lembut dan water-jelly bening"
              width="315"
              height="210"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
          </div>
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/bukti-wanita-35an-sensitif-awet-muda.webp`}
              alt="Potret wanita berhijab usia 36 tahun dengan wajah tenang, kencang, dan sehat"
              width="315"
              height="210"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
          </div>
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/bukti-pipi-kencang-adem-sehat.webp`}
              alt="Close-up pipi kencang bebas kemerahan dengan kilau glass skin"
              width="315"
              height="210"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
          </div>
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/bukti-meja-rias-timeless-skin.webp`}
              alt="Paket Timeless Skin Set Numa Skin di meja rias marmer"
              width="315"
              height="210"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
          </div>
        </div>
      </section>

      <!-- Section 8: Product Knowledge (Full-Bleed Figures) -->
      <section class="dsw-section dsw-section--knowledge">
        <h2 class="dsw-h2">
          Sains di balik <span class="dsw-hl-aqua">Timeless Skin Set</span>
        </h2>
        <p class="dsw-sub">
          Menggabungkan bioteknologi pengencang Swiss RejuveNAD™ dengan lipid biomimetik Meadowestolide®.
        </p>

        <div class="dsw-figure-stack">
          <figure class="dsw-figure">
            <div class="dsw-figure-bleed">
              <img
                src={`${IMG_BASE}/formulasi-anti-aging-kulit-sensitif.webp`}
                alt="Formulasi Ulleung Deep Sea Water dengan kecambah bunga matahari RejuveNAD, Astragalus, dan Centella"
                width="720"
                height="480"
                class="dsw-figure-img"
                loading="lazy"
                fetchpriority="low"
                decoding="async"
              />
            </div>
            <figcaption class="dsw-figcaption">
              <h3 class="dsw-figcaption-title">Sensitive-Safe Longevity & Barrier Lock</h3>
              <p class="dsw-figcaption-desc">
                Mengaktifkan energi muda seluler dengan RejuveNAD™ sekaligus memperkuat struktur pelindung kulit dengan Meadowestolide® dan Astragalus.
              </p>
            </figcaption>
          </figure>
          <figure class="dsw-figure">
            <div class="dsw-figure-bleed">
              <img
                src={`${IMG_BASE}/kandungan-rejuvenad-meadowestolide-ceramide.webp`}
                alt="Kandungan 2% RejuveNAD, 6X Peptide, 4X Cica, Meadowestolide, Ceramide NP, dan Probiotik"
                width="720"
                height="480"
                class="dsw-figure-img"
                loading="lazy"
                fetchpriority="low"
                decoding="async"
              />
            </div>
            <figcaption class="dsw-figcaption">
              <h3 class="dsw-figcaption-title">2% RejuveNAD™ + 6X Peptide + Meadowestolide® + Cica</h3>
              <p class="dsw-figcaption-desc">
                Perpaduan peptida pengencang, penenang kemerahan Cica, Ceramide NP, dan probiotik penyeimbang kulit.
              </p>
            </figcaption>
          </figure>
          <figure class="dsw-figure">
            <div class="dsw-figure-bleed">
              <img
                src={`${IMG_BASE}/kemasan-timeless-skin-set.webp`}
                alt="Kemasan resmi Paket Timeless Skin Set Numa Skin terdaftar BPOM"
                width="720"
                height="480"
                class="dsw-figure-img"
                loading="lazy"
                fetchpriority="low"
                decoding="async"
              />
            </div>
            <figcaption class="dsw-figcaption">
              <h3 class="dsw-figcaption-title">2 Produk Full-Size Resmi BPOM (Hemat Rp19.000)</h3>
              <p class="dsw-figcaption-desc">
                Berisi NAD+ Booster Serum 20ml (NA18262000245) dan Calming Barrier Gloss Gel 30ml (NA18230107056).
              </p>
            </figcaption>
