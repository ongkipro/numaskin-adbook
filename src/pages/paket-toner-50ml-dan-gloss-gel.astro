---
import BaseLayout from '../layouts/BaseLayout.astro';
import GeoIpResolvedForm from '../components/storefront/forms/GeoIpResolvedForm.astro';
import MetaLandingTracker from '../components/storefront/tracking/MetaLandingTracker.astro';
import Icon from '../components/storefront/shared/Icon.astro';
import RatingStars from '../components/storefront/shared/RatingStars.astro';
import { getStorefrontProduct } from '../lib/catalog';
import { nativeLandingCanonicalPath } from '../lib/landing-pages';
import { defaultCatalogContentId } from '../lib/catalog-feed';
import { getRuntimeEnv } from '../lib/env';
import { loadStoreCodDisabledProvinceCodes } from '../lib/form-mode';
import { getStoreAdsConfig } from '../lib/store-ads';
import '../styles/form-hybrid.css';
import '../styles/landing-pages/paket-toner-50ml-dan-gloss-gel.css';

export const prerender = false;

const PRODUCT_SLUG = 'paket-toner-50ml-dan-gloss-gel';
const LANDING_SLUG = 'paket-toner-50ml-dan-gloss-gel';
const PAGE_TITLE = 'Paket Toner 50ml & Gloss Gel - Starter Set Penenang Barrier & Bruntusan BPOM';
const PAGE_DESC = 'Paket praktis penenang kulit rewel & kemerahan: Deep Sea Water Treatment Lotion 50ml (NA18220101400) dan Calming Barrier Gloss Gel Moisturizer 30ml (NA18230107056).';
const IMG_BASE = '/images/landing/paket-toner-50ml-dan-gloss-gel';
const HERO_IMAGE = `${IMG_BASE}/hero-paket-toner-50ml-gloss-gel.webp`;

const database = getRuntimeEnv(Astro.locals)?.OMS_DB as D1Database | undefined;
const claimedProductSlug = Astro.request.headers.get('x-adsbook-product-page');
const [product, canonicalPath, codDisabledProvinceCodes] = await Promise.all([
  getStorefrontProduct(Astro.locals, PRODUCT_SLUG),
  claimedProductSlug
    ? Promise.resolve(`/produk/${claimedProductSlug}`)
    : nativeLandingCanonicalPath(Astro.locals, LANDING_SLUG),
  loadStoreCodDisabledProvinceCodes(database),
  getStoreAdsConfig(Astro.locals),
]);
if (!product) {
  return Astro.rewrite('/404');
}

const canonical = `${Astro.locals.tenant.siteUrl}${canonicalPath}`;

const variants = product.variants || [];
const cheapestVariant = variants.reduce(
  (min: any, v: any) => (!min || v.price < min.price ? v : min),
  variants[0]
);
const defaultVariant = cheapestVariant || {
  id: '47',
  label: 'Toner 50ml + Gloss Gel 30ml',
  price: 142000,
  comparePrice: 158000,
};
---

<BaseLayout
  title={PAGE_TITLE}
  description={PAGE_DESC}
  image={HERO_IMAGE}
  preloadImages={HERO_IMAGE}
  canonical={canonical}
  hideHeader={true}
  hideFooter={true}
>
  <MetaLandingTracker
    slug={LANDING_SLUG}
    contentId={defaultCatalogContentId(product)}
    contentName={product.contentName}
    price={defaultVariant.price}
  />

  <div class="dsw-shell">
    <main class="dsw-canvas">
      <!-- Section 1: Hero -->
      <section id="hero-section" class="dsw-hero">
        <div class="dsw-hero-head">
          <h1 class="dsw-h1">
            <span class="dsw-hl-tilt">Kulit Perih, Merah</span> & Muncul Bruntusan Karena Barrier Rusak?
          </h1>
          <p class="dsw-sub" style="max-width: 390px; margin: 14px auto 0; font-weight: 700;">
            Saat skin barrier sedang meradang, hentikan krim yang berat dan beri hidrasi water-jelly yang menenangkan.<br />
            <span class="dsw-underline-teal">Pulihkan ketenangan kulit dengan Paket Toner 50ml & Gloss Gel!</span>
          </p>
        </div>

        <div class="dsw-hero-stage">
          <div class="dsw-hero-top-tag">
            <div class="dsw-hero-top-pill">
              <Icon name="lucide:award" class="size-3.5" aria-hidden="true" />
              <span>Toner 50ml + Gloss Gel • Hemat Rp16rb</span>
            </div>
          </div>

          <img
            src={HERO_IMAGE}
            alt="Perbandingan kulit kemerahan bruntusan vs kulit tenang glassy dengan Paket Toner 50ml dan Gloss Gel Numa Skin"
            width="720"
            height="480"
            class="dsw-hero-img"
            fetchpriority="high"
            loading="eager"
            decoding="async"
          />

          <div class="dsw-hero-ba" aria-hidden="true">
            <span class="dsw-hero-ba-pill dsw-hero-ba-pill--before">Perih & Bruntusan</span>
            <span class="dsw-hero-ba-pill dsw-hero-ba-pill--after">Adem & Glassy</span>
          </div>

          <div class="dsw-hero-trust-strip" role="list" aria-label="Jaminan kualitas Numa Skin">
            <div class="dsw-trust-item" role="listitem">
              <span class="dsw-trust-icon">
                <Icon name="lucide:shield-check" class="size-3.5" aria-hidden="true" />
              </span>
              <span class="dsw-trust-text">
                <strong class="dsw-trust-label">2 BPOM Resmi</strong>
                <span class="dsw-trust-sub">Toner & Gloss Gel</span>
              </span>
            </div>
            <div class="dsw-trust-item" role="listitem">
              <span class="dsw-trust-icon">
                <Icon name="lucide:droplets" class="size-3.5" aria-hidden="true" />
              </span>
              <span class="dsw-trust-text">
                <strong class="dsw-trust-label">Barrier Lock</strong>
                <span class="dsw-trust-sub">Astragalus + Cica</span>
              </span>
            </div>
            <div class="dsw-trust-item" role="listitem">
              <span class="dsw-trust-icon">
                <Icon name="lucide:layers" class="size-3.5" aria-hidden="true" />
              </span>
              <span class="dsw-trust-text">
                <strong class="dsw-trust-label">76% Ulleungdo</strong>
                <span class="dsw-trust-sub">5X Ceramide + Cica</span>
              </span>
            </div>
          </div>
        </div>

        <div class="dsw-hero-foot">
          <p class="dsw-hero-caption">
            Starter set penenang barrier paling terjangkau: <strong>Deep Sea Water Treatment Lotion 50ml</strong> + <strong>Calming Barrier Gloss Gel 30ml</strong>.
          </p>
          <a href="#form-pemesanan" class="dsw-cta" data-scroll-to-form>
            <span>Ambil Paket Penenang 50ml Ini</span>
            <Icon name="lucide:arrow-right" class="size-5" aria-hidden="true" />
          </a>
        </div>
      </section>

      <!-- Section 2: Solusi Praktis -->
      <section class="dsw-section">
        <h2 class="dsw-h2">
          Pertolongan Pertama <span class="dsw-hl-aqua">Kulit Sensitif & Dehidrasi</span>
        </h2>
        <p class="dsw-sub" style="margin-top: 8px;">
          Dua langkah ringan yang langsung memberikan sensasi dingin tanpa menyumbat pori:
        </p>

        <div class="dsw-solution-box">
          <img
            src={`${IMG_BASE}/solusi-hidrasi-dingin-penenang-barrier-50ml.webp`}
            alt="Wanita Indonesia mengaplikasikan Calming Barrier Gloss Gel di kulit wajah yang tenang"
            width="648"
            height="432"
            class="dsw-solution-img"
            loading="lazy"
            fetchpriority="low"
            decoding="async"
          />

          <div class="dsw-check-list">
            <div class="dsw-check-item">
              <span class="dsw-icon-green">
                <Icon name="lucide:check" class="size-3.5" aria-hidden="true" />
              </span>
              <p class="dsw-list-text"><strong>Langkah 1 — Treatment Lotion 50ml:</strong> 76% Air Laut Dalam Ulleungdo, Centella Asiatica, dan Panthenol segera meredakan rasa ketarik sehabis cuci muka.</p>
            </div>
            <div class="dsw-check-item">
              <span class="dsw-icon-green">
                <Icon name="lucide:check" class="size-3.5" aria-hidden="true" />
              </span>
              <p class="dsw-list-text"><strong>Langkah 2 — Calming Barrier Gloss Gel 30ml:</strong> Gel bening sejuk dengan Meadowestolide, Astragalus, dan Ceramide yang mengunci air di epidermis tanpa memicu komedo.</p>
            </div>
            <div class="dsw-check-item">
              <span class="dsw-icon-green">
                <Icon name="lucide:check" class="size-3.5" aria-hidden="true" />
              </span>
              <p class="dsw-list-text"><strong>Harga Starter Set Paling Hemat:</strong> Hanya Rp142.000 untuk mendapatkan 2 produk pemulih skin barrier resmi BPOM.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- Section 3: Masalah Kulit -->
      <section class="dsw-section--tinted">
        <h2 class="dsw-h2">
          Tanda Skin Barrier Anda <span class="dsw-hl-coral">Sedang Meminta Istirahat</span>
        </h2>

        <div class="dsw-grid-2">
          <article class="dsw-card">
            <img
              src={`${IMG_BASE}/masalah-kulit-dehidrasi-kemerahan-50ml.webp`}
              alt="Kulit pipi tampak memerah dan terasa panas perih saat memakai skincare"
              width="480"
              height="320"
              class="dsw-card-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <div class="dsw-card-body">
              <span class="dsw-badge-red">Perih Saat Oles Krim</span>
              <p class="dsw-card-desc">Saat lapisan pelindung kulit menipis, produk biasa pun terasa menyengat dan membuat pipi semakin memerah.</p>
            </div>
          </article>

          <article class="dsw-card">
            <img
              src={`${IMG_BASE}/masalah-pelembap-berat-bikin-bruntusan-50ml.webp`}
              alt="Zona T berminyak berlebih disertai bintik bruntusan halus"
              width="480"
              height="320"
              class="dsw-card-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <div class="dsw-card-body">
              <span class="dsw-badge-red">Berminyak Tapi Mengelupas</span>
              <p class="dsw-card-desc">Kulit yang kekurangan air memproduksi minyak berlebih sebagai kompensasi sehingga muncul bruntusan di dahi dan pipi.</p>
            </div>
          </article>
        </div>

        <div class="dsw-list-box">
          <p class="dsw-list-box-title">Tanda Anda Membutuhkan Paket Ini:</p>
          <div class="dsw-check-list" style="margin-top: 0;">
            <div class="dsw-check-item">
              <span class="dsw-icon-red">
                <Icon name="lucide:x" class="size-3.5" aria-hidden="true" />
              </span>
              <p class="dsw-list-text">Wajah sedang kemerahan, perih, atau bruntusan akibat cuaca panas maupun ketidakcocokan skincare lama</p>
            </div>
            <div class="dsw-check-item">
              <span class="dsw-icon-red">
                <Icon name="lucide:x" class="size-3.5" aria-hidden="true" />
              </span>
              <p class="dsw-list-text">Mencari pelembap bertekstur water-jelly yang 100% ringan dan tidak membuat wajah terasa berminyak</p>
            </div>
            <div class="dsw-check-item">
              <span class="dsw-icon-red">
                <Icon name="lucide:x" class="size-3.5" aria-hidden="true" />
              </span>
              <p class="dsw-list-text">Ingin mencoba duet Treatment Lotion 50ml + Gloss Gel 30ml yang praktis dibawa ke mana saja</p>
            </div>
          </div>
        </div>
      </section>

      <!-- Section 4: Transformasi Nyata -->
      <section class="dsw-section">
        <h2 class="dsw-h2">
          Transformasi <span class="dsw-hl-aqua">Barrier Pulih & Wajah Tampak Bening</span>
        </h2>
        <p class="dsw-sub" style="margin-top: 8px;">
          Perbedaan nyata saat kulit diberi asupan air laut dalam dan pengunci water-jelly:
        </p>

        <div class="dsw-grid-2">
          <article class="dsw-card">
            <img
              src={`${IMG_BASE}/kondisi-merah-perih-bruntusan-50ml.webp`}
              alt="Kondisi kulit memerah, bruntusan, dan kering mengelupas di sekitar hidung"
              width="480"
              height="320"
              class="dsw-card-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <div class="dsw-card-body">
              <span class="dsw-badge-red">Sebelum Perawatan</span>
              <p class="dsw-card-desc">Kemerahan terlihat jelas di pipi, permukaan kulit kasar oleh bruntusan, dan terasa perih ketarik.</p>
            </div>
          </article>

          <article class="dsw-card">
            <img
              src={`${IMG_BASE}/kondisi-kalem-halus-glassy-50ml.webp`}
              alt="Kondisi kulit tampak kalem, bebas kemerahan, halus, dan glassy"
              width="480"
              height="320"
              class="dsw-card-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <div class="dsw-card-body">
              <span class="dsw-badge-green">Rutin Starter Set 50ml</span>
              <p class="dsw-card-desc">Warna kulit tampak tenang merata, bruntusan menghalus, dan wajah terasa sejuk lembap.</p>
            </div>
          </article>
        </div>

        <div class="dsw-list-box">
          <p class="dsw-list-box-title">Tahapan Hasil Pemakaian Rutin:</p>
          <div class="dsw-check-list" style="margin-top: 0;">
            <div class="dsw-check-item">
              <span class="dsw-icon-green">
                <Icon name="lucide:check" class="size-3.5" aria-hidden="true" />
              </span>
              <p class="dsw-list-text"><strong>Minggu 1:</strong> Rasa perih dan kemerahan sehabis cuci muka langsung berkurang sejak pemakaian pertama</p>
            </div>
            <div class="dsw-check-item">
              <span class="dsw-icon-green">
                <Icon name="lucide:check" class="size-3.5" aria-hidden="true" />
              </span>
              <p class="dsw-list-text"><strong>Minggu 2–3:</strong> Kadar minyak dan air lebih seimbang sehingga bruntusan halus berangsur mereda</p>
            </div>
            <div class="dsw-check-item">
              <span class="dsw-icon-green">
                <Icon name="lucide:check" class="size-3.5" aria-hidden="true" />
              </span>
              <p class="dsw-list-text"><strong>Minggu 4:</strong> Skin barrier terasa sehat kembali dan siap menerima rangkaian perawatan lanjutan</p>
            </div>
          </div>
        </div>
      </section>

      <!-- Section 5: Cara Pakai -->
      <section class="dsw-section--tinted">
        <h2 class="dsw-h2">
          Cara Pakai <span class="dsw-hl-aqua">Praktis Setiap Hari</span>
        </h2>
        <p class="dsw-sub" style="margin-top: 8px;">
          Gunakan pagi dan malam setelah mencuci wajah:
        </p>

        <div class="dsw-grid-2">
          <article class="dsw-card">
            <img
              src={`${IMG_BASE}/cara-pakai-tg50-step1-toner.webp`}
              alt="Menepukkan Deep Sea Water Treatment Lotion 50ml ke wajah"
              width="480"
              height="320"
              class="dsw-card-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <div class="dsw-card-body">
              <span class="dsw-badge-teal">1. Tepuk Toner 50ml</span>
              <p class="dsw-card-desc">Keluarkan <strong>Treatment Lotion 50ml</strong> ke telapak tangan, tepuk lembut ke wajah tanpa digosok.</p>
            </div>
          </article>

          <article class="dsw-card">
            <img
              src={`${IMG_BASE}/cara-pakai-tg50-step2-gloss-gel.webp`}
              alt="Meratakan Calming Barrier Gloss Gel Moisturizer ke pipi dan dahi"
              width="480"
              height="320"
              class="dsw-card-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <div class="dsw-card-body">
              <span class="dsw-badge-teal">2. Oleskan Gloss Gel 30ml</span>
              <p class="dsw-card-desc">Ratakan <strong>Calming Barrier Gloss Gel</strong> ke seluruh wajah untuk mengunci hidrasi dengan sensasi dingin.</p>
            </div>
          </article>
        </div>

        <div style="margin-top: 22px; text-align: center;">
          <a href="#form-pemesanan" class="dsw-cta" data-scroll-to-form>
            <span>Pesan Toner 50ml & Gloss Gel</span>
            <Icon name="lucide:arrow-right" class="size-5" aria-hidden="true" />
          </a>
        </div>
      </section>

      <!-- Section 6: Bukti Pelanggan -->
      <section class="dsw-section">
        <h2 class="dsw-h2">
          Bukti Tekstur <span class="dsw-hl-aqua">& Kepuasan Pelanggan</span>
        </h2>
        <p class="dsw-sub" style="margin-top: 8px;">
          Pengalaman pelanggan dengan kulit sensitif yang cocok memakai Paket Toner 50ml & Gloss Gel:
        </p>

        <div class="dsw-grid-2">
          <div class="dsw-proof-cell">
            <img
              src={`${IMG_BASE}/bukti-tekstur-toner-dan-jelly-50ml.webp`}
              alt="Swatch tekstur cair Treatment Lotion dan water-jelly Gloss Gel di punggung tangan"
              width="480"
              height="320"
              class="dsw-proof-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <p class="dsw-proof-OverlayCaption">Tekstur Air & Jelly Cepat Meresap</p>
          </div>
          <div class="dsw-proof-cell">
            <img
              src={`${IMG_BASE}/bukti-wanita-27an-wajah-adem-50ml.webp`}
              alt="Wanita Indonesia usia 27 tahun berhijab dengan kulit wajah tenang dan bersih"
              width="480"
              height="320"
              class="dsw-proof-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <p class="dsw-proof-OverlayCaption">Cocok untuk Kulit Sensitif & Kombinasi</p>
          </div>
          <div class="dsw-proof-cell">
            <img
              src={`${IMG_BASE}/bukti-pori-tenang-bebas-lengket-50ml.webp`}
              alt="Close-up pipi halus bebas kemerahan dan bebas lengket"
              width="480"
              height="320"
              class="dsw-proof-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <p class="dsw-proof-OverlayCaption">Adem di Pori Tanpa Menyumbat</p>
          </div>
          <div class="dsw-proof-cell">
            <img
              src={`${IMG_BASE}/bukti-meja-rias-toner-50ml-gloss.webp`}
              alt="Botol Treatment Lotion 50ml dan jar Gloss Gel 30ml di meja rias"
              width="480"
              height="320"
              class="dsw-proof-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <p class="dsw-proof-OverlayCaption">Praktis & Hemat Rp16.000</p>
          </div>
        </div>

        <div class="dsw-testi-list">
          <article class="dsw-testi-card">
            <div class="dsw-testi-head">
              <div class="dsw-testi-avatar" aria-hidden="true">A</div>
              <div class="dsw-testi-meta">
                <p class="dsw-testi-name">
                  Kak Aulia Rahma (26 thn)
                  <span class="dsw-verified-pill">Verified Buyer</span>
                </p>
                <div class="dsw-stars">
                  <RatingStars rating={5} starClass="h-3.5 w-3.5 !fill-[#d97706] !text-[#d97706]" />
                </div>
              </div>
            </div>
            <p class="dsw-testi-body">"Awalnya beli yang ukuran Toner 50ml + Gloss Gel ini buat coba dulu karena kulitku super sensitif. Ternyata beneran se-adem itu! Bruntusan di jidat dan merah-merah di pipi langsung kalem dalam seminggu."</p>
            <div class="dsw-testi-foot">
              <span>Yogyakarta</span>
              <span>•</span>
              <span>Pemakaian 3 Minggu</span>
            </div>
          </article>

          <article class="dsw-testi-card">
            <div class="dsw-testi-head">
              <div class="dsw-testi-avatar" aria-hidden="true">D</div>
              <div class="dsw-testi-meta">
                <p class="dsw-testi-name">
                  Bunda Dita Permata (31 thn)
                  <span class="dsw-verified-pill">Verified Buyer</span>
                </p>
                <div class="dsw-stars">
                  <RatingStars rating={5} starClass="h-3.5 w-3.5 !fill-[#d97706] !text-[#d97706]" />
                </div>
              </div>
            </div>
            <p class="dsw-testi-body">"Harganya terjangkau banget cuma Rp142.000 udah dapet toner sama moisturizer gel. Dipakai pagi sebelum bedak nggak bikin berminyak sama sekali."</p>
            <div class="dsw-testi-foot">
              <span>Bekasi</span>
              <span>•</span>
              <span>Pemakaian 4 Minggu</span>
            </div>
          </article>
        </div>
      </section>

      <!-- Section 7: Tabel Perbandingan -->
      <section class="dsw-section--tinted">
        <h2 class="dsw-h2">
          Keunggulan <span class="dsw-hl-aqua">Toner 50ml & Gloss Gel</span>
        </h2>
        <p class="dsw-sub" style="margin-top: 8px;">
          Mengapa memilih Paket Toner 50ml & Gloss Gel jauh lebih hemat dan efektif dibandingkan membeli produk satuan:
        </p>

        <div class="dsw-cmp-card">
          <div class="dsw-cmp-head">
            <div class="dsw-cmp-col">Karakteristik</div>
            <div class="dsw-cmp-col dsw-cmp-col--numa">Toner 50ml + Gel</div>
            <div class="dsw-cmp-col">Beli Satuan Biasa</div>
          </div>

          <div class="dsw-cmp-row">
            <div class="dsw-cmp-cell dsw-cmp-cell--feature">Kelembutan Formula</div>
            <div class="dsw-cmp-cell dsw-cmp-cell--numa">
              <span class="dsw-icon-green" style="margin: 0 auto;">
                <Icon name="lucide:check" class="size-3.5" aria-hidden="true" />
              </span>
              <span class="dsw-cmp-sub">Ramah kulit sensitif & kemerahan</span>
            </div>
            <div class="dsw-cmp-cell">
              <span class="dsw-icon-red" style="margin: 0 auto;">
                <Icon name="lucide:x" class="size-3.5" aria-hidden="true" />
              </span>
              <span class="dsw-cmp-sub">Sering memicu perih/komedo</span>
            </div>
          </div>

          <div class="dsw-cmp-row">
            <div class="dsw-cmp-cell dsw-cmp-cell--feature">Tekstur Pelembap</div>
            <div class="dsw-cmp-cell dsw-cmp-cell--numa">
              <span class="dsw-icon-green" style="margin: 0 auto;">
                <Icon name="lucide:check" class="size-3.5" aria-hidden="true" />
              </span>
              <span class="dsw-cmp-sub">Water-Jelly dingin bebas lengket</span>
            </div>
            <div class="dsw-cmp-cell">
              <span class="dsw-icon-red" style="margin: 0 auto;">
                <Icon name="lucide:x" class="size-3.5" aria-hidden="true" />
              </span>
              <span class="dsw-cmp-sub">Krim berat berminyak</span>
            </div>
          </div>

          <div class="dsw-cmp-row">
            <div class="dsw-cmp-cell dsw-cmp-cell--feature">Kandungan Aktif</div>
