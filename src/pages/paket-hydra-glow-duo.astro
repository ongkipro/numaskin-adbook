---
import BaseLayout from '../layouts/BaseLayout.astro';
import GeoIpResolvedForm from '../components/storefront/forms/GeoIpResolvedForm.astro';
import MetaLandingTracker from '../components/storefront/tracking/MetaLandingTracker.astro';
import Icon from '../components/storefront/shared/Icon.astro';
import RatingStars from '../components/storefront/shared/RatingStars.astro';
import { getStorefrontProduct } from '../lib/catalog';
import { nativeLandingCanonicalPath } from '../lib/landing-pages';
import { defaultCatalogContentId } from '../lib/catalog-feed';
import { getRuntimeEnv } from '../lib/env';
import { loadStoreCodDisabledProvinceCodes } from '../lib/form-mode';
import { getStoreAdsConfig } from '../lib/store-ads';
import '../styles/form-hybrid.css';
import '../styles/landing-pages/paket-hydra-glow-duo.css';

export const prerender = false;

const PRODUCT_SLUG = 'paket-hydra-glow-duo';
const LANDING_SLUG = 'paket-hydra-glow-duo';
const PAGE_TITLE = 'Paket Hydra Glow Duo - Duet Krim Pagi PDRN & Malam Adenosine Anti-Flek BPOM';
const PAGE_DESC = 'Paket bundling 2-in-1 Numa Skin: PDRN + Alpha-Arbutin Tone-Up Day Cream 30gr + Adenosine Moisturizer 30gr untuk wajah cerah natural di pagi hari & bebas flek di malam hari (2 BPOM Resmi).';
const IMG_BASE = '/images/landing/paket-hydra-glow-duo';
const HERO_IMAGE = `${IMG_BASE}/hero-paket-hydra-glow-duo.webp`;

const database = getRuntimeEnv(Astro.locals)?.OMS_DB as D1Database | undefined;
const claimedProductSlug = Astro.request.headers.get('x-adsbook-product-page');
const [product, canonicalPath, codDisabledProvinceCodes] = await Promise.all([
  getStorefrontProduct(Astro.locals, PRODUCT_SLUG),
  claimedProductSlug
    ? Promise.resolve(`/produk/${claimedProductSlug}`)
    : nativeLandingCanonicalPath(Astro.locals, LANDING_SLUG),
  loadStoreCodDisabledProvinceCodes(database),
  getStoreAdsConfig(Astro.locals),
]);
if (!product) {
  return Astro.rewrite('/404');
}

const canonical = `${Astro.locals.tenant.siteUrl}${canonicalPath}`;

const variants = product.variants || [];
const cheapestVariant = variants.reduce(
  (min: any, v: any) => (!min || v.price < min.price ? v : min),
  variants[0]
);
const defaultVariant = cheapestVariant || {
  id: '28',
  label: 'Day Cream 30gr + Adenosine 30gr',
  price: 142500,
  comparePrice: 158498,
};
---

<BaseLayout
  title={PAGE_TITLE}
  description={PAGE_DESC}
  image={HERO_IMAGE}
  preloadImages={HERO_IMAGE}
  canonical={canonical}
  hideHeader={true}
  hideFooter={true}
>
  <MetaLandingTracker
    slug={LANDING_SLUG}
    contentId={defaultCatalogContentId(product)}
    contentName={product.contentName}
    price={defaultVariant.price}
  />

  <div class="dsw-shell">
    <main class="dsw-canvas">
      <!-- Section 1: Hero -->
      <section id="hero-section" class="dsw-hero">
        <div class="dsw-hero-head">
          <h1 class="dsw-h1">
            <span class="dsw-hl-tilt">Muka Abu-Abu Pagi</span> & Flek Hitam Tetap Pekat di Malam Hari?
          </h1>
          <p class="dsw-sub" style="max-width: 390px; margin: 14px auto 0; font-weight: 700;">
            Krim siang pemutih biasa membuat kulit sawo matang tampak dempul, sementara malam hari kulit kekurangan pengunci kolagen.<br />
            <span class="dsw-underline-teal">Rawat siang & malam dengan Paket Hydra Glow Duo Numa Skin!</span>
          </p>
        </div>

        <div class="dsw-hero-stage">
          <div class="dsw-hero-top-tag">
            <div class="dsw-hero-top-pill">
              <Icon name="lucide:award" class="size-3.5" aria-hidden="true" />
              <span>Duet Krim Pagi & Malam • Hemat Rp16.000</span>
            </div>
          </div>

          <img
            src={HERO_IMAGE}
            alt="Perbandingan wajah berflek dan abu-abu dempul vs kulit cerah natural menyatu dengan Paket Hydra Glow Duo Numa Skin"
            width="720"
            height="480"
            class="dsw-hero-img"
            fetchpriority="high"
            loading="eager"
            decoding="async"
          />

          <div class="dsw-hero-overlap">
            <div class="dsw-hero-overlap-inner">
              <h2 class="dsw-hero-overlap-title">Duet Double Alpha-Arbutin Siang & Malam</h2>
              <p class="dsw-hero-overlap-text">
                Pagi hari <strong style="color: #be123c;">PDRN Day Cream meratakan warna kulit secara natural</strong>, malam hari <strong style="color: #be123c;">Adenosine Moisturizer mengunci hidrasi 11X HA & merawat flek</strong>.
              </p>
            </div>
          </div>
        </div>

        <div class="dsw-trust-row">
          <div class="dsw-trust-item">
            <span class="dsw-trust-icon">
              <Icon name="lucide:shield-check" class="size-4" aria-hidden="true" />
            </span>
            <div>
              <span class="dsw-trust-label">BPOM Resmi</span>
              <span class="dsw-trust-sub">2 Izin Edar</span>
            </div>
          </div>
          <div class="dsw-trust-item">
            <span class="dsw-trust-icon">
              <Icon name="lucide:badge-check" class="size-4" aria-hidden="true" />
            </span>
            <div>
              <span class="dsw-trust-label">Halal RI</span>
              <span class="dsw-trust-sub">Tanpa Merkuri</span>
            </div>
          </div>
          <div class="dsw-trust-item">
            <span class="dsw-trust-icon">
              <Icon name="lucide:truck" class="size-4" aria-hidden="true" />
            </span>
            <div>
              <span class="dsw-trust-label">Bisa COD</span>
              <span class="dsw-trust-sub">Bayar di Rumah</span>
            </div>
          </div>
        </div>
      </section>

      <!-- Section 2: Solusi Singkat + Visual -->
      <section class="dsw-section">
        <h2 class="dsw-h2">
          Pasangan <span class="dsw-hl-aqua">krim pagi & pelembap malam</span> bebas ribet
        </h2>
        <p class="dsw-sub">Dua produk yang bekerja bergantian selama 24 jam untuk mencerahkan dan menjaga kekenyalan.</p>

        <div class="dsw-photo-stack">
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/solusi-cerah-pagi-kenyal-malam.webp`}
              alt="Wanita Indonesia usia 36 tahun dengan kulit sawo matang yang cerah alami, halus, dan kenyal berkat Hydra Glow Duo"
              width="648"
              height="432"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
          </div>
        </div>

        <div class="dsw-list">
          <div class="dsw-list-row">
            <span class="dsw-icon-teal">
              <Icon name="lucide:sun-dim" class="size-4" aria-hidden="true" />
            </span>
            <p class="dsw-list-text">
              <strong style="color: #0f172a;">PDRN + Alpha-Arbutin Tone-Up Day Cream (30 gr):</strong> Krim pagi berwarna krem natural (warm beige) yang mencerahkan wajah seketika tanpa efek topeng abu-abu.
            </p>
          </div>
          <div class="dsw-list-row">
            <span class="dsw-icon-teal">
              <Icon name="lucide:droplets" class="size-4" aria-hidden="true" />
            </span>
            <p class="dsw-list-text">
              <strong style="color: #0f172a;">Adenosine Deep Sea Water Moisturizer (30 gr):</strong> Gel-cream dingin dengan Adenosine, Alpha-Arbutin, & 11X Hyaluronic Acid untuk merawat flek dan garis halus saat tidur.
            </p>
          </div>
          <div class="dsw-list-row">
            <span class="dsw-icon-teal">
              <Icon name="lucide:layers" class="size-4" aria-hidden="true" />
            </span>
            <p class="dsw-list-text">
              <strong style="color: #0f172a;">Double Alpha-Arbutin:</strong> Kedua krim sama-sama mengandung Alpha-Arbutin murni sehingga perawatan noda hitam berjalan konsisten pagi dan malam.
            </p>
          </div>
        </div>
      </section>

      <!-- Section 3: Tanda Masalah Kulit + Visual Grid -->
      <section class="dsw-section dsw-section--warn">
        <h2 class="dsw-h2">
          Mengapa memakai <span class="dsw-underline-warn">satu krim saja</span> tidak cukup untuk flek?
        </h2>

        <div class="dsw-photo-grid-2">
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/masalah-satu-krim-tak-cukup.webp`}
              alt="Wanita bercermin melihat bercak flek hitam di pipi yang sulit memudar karena hanya memakai satu krim biasa"
              width="315"
              height="210"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <p class="dsw-photo-caption">
              <strong style="color: #be123c; display: block;">Kebutuhan Pagi & Malam Berbeda</strong>
              Pagi butuh tone-up & penangkal UV, sedangkan malam butuh hidrasi dalam & regenerasi kolagen.
            </p>
          </div>
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/masalah-muka-abu-pagi-kering-malam.webp`}
              alt="Close-up kulit pipi yang tampak belang abu-abu di pagi hari dan kering bergaris halus"
              width="315"
              height="210"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <p class="dsw-photo-caption">
              <strong style="color: #be123c; display: block;">Dempul di Pagi, Kering di Malam</strong>
              Krim siang putih biasa membuat wajah keabu-abuan dan menyumbat pori.
            </p>
          </div>
        </div>

        <div class="dsw-list">
          <div class="dsw-list-row">
            <span class="dsw-icon-warn">
              <Icon name="lucide:triangle-alert" class="size-4" aria-hidden="true" />
            </span>
            <p class="dsw-list-text">
              Pagi hari ingin wajah tampak rapi cerah tanpa foundation, tapi <strong style="color: #be123c;">krim biasa bikin muka belang dengan leher</strong>.
            </p>
          </div>
          <div class="dsw-list-row">
            <span class="dsw-icon-warn">
              <Icon name="lucide:triangle-alert" class="size-4" aria-hidden="true" />
            </span>
            <p class="dsw-list-text">
              Flek hitam di tulang pipi <strong style="color: #be123c;">tampak makin jelas saat kulit sedang kering</strong>.
            </p>
          </div>
          <div class="dsw-list-row">
            <span class="dsw-icon-warn">
              <Icon name="lucide:triangle-alert" class="size-4" aria-hidden="true" />
            </span>
            <p class="dsw-list-text">
              Takut memakai krim racikan pengelupasan yang <strong style="color: #be123c;">membuat kulit tipis dan merah udang rebus</strong>.
            </p>
          </div>
        </div>
      </section>

      <!-- Section 4: Perbandingan Visual Sebelum vs Sesudah -->
      <section class="dsw-section">
        <h2 class="dsw-h2">
          Perbedaan hasil <span class="dsw-hl-aqua">sebelum vs sesudah rutin</span>
        </h2>
        <p class="dsw-sub">Tanpa pengelupasan perih, aman untuk pemakaian jangka panjang karena resmi BPOM.</p>

        <div class="dsw-photo-stack">
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/kondisi-flek-belang-kering-kasar.webp`}
              alt="Kondisi pipi dengan noda flek hitam, rona kusam belang, dan tekstur kering sebelum perawatan"
              width="648"
              height="432"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <span class="dsw-photo-badge dsw-photo-badge--before">Sebelum Hydra Glow Duo</span>
            <p class="dsw-photo-caption">
              Noda kecokelatan tampak tegas di tulang pipi, kulit kering kasar, dan warna wajah tidak merata.
            </p>
          </div>

          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/kondisi-cerah-menyatu-lembap-24jam.webp`}
              alt="Kondisi pipi sawo matang yang cerah alami, menyatu halus, dan lembap kenyal setelah rutin memakai Hydra Glow Duo"
              width="648"
              height="432"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <span class="dsw-photo-badge dsw-photo-badge--after">Rutin Hydra Glow Duo</span>
            <p class="dsw-photo-caption">
              Rona wajah tampak cerah natural bebas abu-abu di pagi hari, dan terasa kenyal lembap saat bangun tidur.
            </p>
          </div>
        </div>
      </section>

      <!-- Section 5: Dark Marine Section — Cara Pakai Praktis -->
      <section class="dsw-section dsw-section--dark">
        <h2 class="dsw-h2">
          Urutan Pakai <span style="color: #99e2ec;">Krim Pagi & Krim Malam</span>
        </h2>
        <p class="dsw-sub">Sangat simpel untuk bunda yang tidak suka tahapan skincare terlalu panjang.</p>

        <div class="dsw-photo-stack">
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/cara-pakai-hydra-pagi-pdrn.webp`}
              alt="Cara pakai pagi: totol dan baurkan PDRN Tone-Up Day Cream berwarna krem natural ke seluruh wajah"
              width="648"
              height="432"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <p class="dsw-photo-caption">
              <strong style="color: #ffffff;">Pagi Hari (PDRN Tone-Up Day Cream):</strong> Ambil seukuran biji jagung, totolkan di 5 titik wajah, lalu baurkan merata untuk hasil cerah natural instan.
            </p>
          </div>
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/cara-pakai-hydra-malam-adenosine.webp`}
              alt="Cara pakai malam: tekan 1-2 pump Adenosine Moisturizer dan pijat lembut sebelum tidur"
              width="648"
              height="432"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <p class="dsw-photo-caption">
              <strong style="color: #ffffff;">Malam Hari (Adenosine Moisturizer):</strong> Tekan 1–2 pump gel-cream ke telapak tangan, usapkan merata ke wajah dan leher sebelum tidur.
            </p>
          </div>
        </div>

        <div class="dsw-list">
          <div class="dsw-list-row">
            <span class="dsw-step-num">1</span>
            <p class="dsw-step-text">
              <strong style="color: #ffffff;">Pagi Hari:</strong> Gunakan PDRN Day Cream setelah cuci muka (wajah langsung tampak segar tanpa bedak).
            </p>
          </div>
          <div class="dsw-list-row">
            <span class="dsw-step-num">2</span>
            <p class="dsw-step-text">
              <strong style="color: #ffffff;">Malam Hari:</strong> Gunakan <strong style="color: #ffffff; background: #104452; padding: 1px 6px; border-radius: 4px;">Adenosine Moisturizer</strong> untuk mengunci kelembapan & merawat flek semalaman.
            </p>
          </div>
          <div class="dsw-list-row">
            <span class="dsw-step-num">3</span>
            <p class="dsw-step-text">
              Untuk kulit sangat kering, Adenosine Moisturizer juga bisa dioles tipis sebelum PDRN Day Cream di pagi hari.
            </p>
          </div>
        </div>
      </section>

      <!-- Section 6: Ulasan Pelanggan -->
      <section class="dsw-section">
        <h2 class="dsw-h2">
          Kata bunda tentang <span class="dsw-hl-aqua">Paket Hydra Glow Duo</span>
        </h2>
        <p class="dsw-sub">Pengganti krim siang-malam biasa yang aman BPOM dan hemat Rp16.000.</p>

        <div class="dsw-reviews-divide">
          <div class="dsw-review-row">
            <div class="dsw-review-head">
              <div>
                <p class="dsw-review-author">
                  Bunda Sri W.
                  <span style="color: #0b6e7d; display: inline-flex;">
                    <Icon name="lucide:badge-check" class="size-4" aria-hidden="true" />
                  </span>
                </p>
                <p class="dsw-review-meta">Kediri • Usia 38 Tahun</p>
              </div>
              <RatingStars rating={5} starClass="h-3.5 w-3.5 !fill-[#d97706] !text-[#d97706]" />
            </div>
            <p class="dsw-review-quote">
              "Cari paket krim siang malam yang resmi BPOM akhirnya ketemu ini. <span class="dsw-hl-aqua">Krim paginya warna beige nyatu banget di kulit sawo matang</span>, krim malamnya adem kenyal."
            </p>
          </div>
          <div class="dsw-review-row">
            <div class="dsw-review-head">
              <div>
                <p class="dsw-review-author">
                  Ibu Nurlaila H.
                  <span style="color: #0b6e7d; display: inline-flex;">
                    <Icon name="lucide:badge-check" class="size-4" aria-hidden="true" />
                  </span>
                </p>
                <p class="dsw-review-meta">Banjarmasin • Usia 43 Tahun</p>
              </div>
              <RatingStars rating={5} starClass="h-3.5 w-3.5 !fill-[#d97706] !text-[#d97706]" />
            </div>
            <p class="dsw-review-quote">
              "Gak pakai ngelupas atau perih sama sekali. <strong style="color: #0f172a;">Flek di pipi pelan-pelan memudar</strong> dan <span class="dsw-hl-aqua">tiap pagi gak usah pakai foundation lagi udah rapi</span>."
            </p>
          </div>
          <div class="dsw-review-row">
            <div class="dsw-review-head">
              <div>
                <p class="dsw-review-author">
                  Bunda Rika P.
                  <span style="color: #0b6e7d; display: inline-flex;">
                    <Icon name="lucide:badge-check" class="size-4" aria-hidden="true" />
                  </span>
                </p>
                <p class="dsw-review-meta">Lampung • Hemat Rp16.000</p>
              </div>
              <RatingStars rating={5} starClass="h-3.5 w-3.5 !fill-[#d97706] !text-[#d97706]" />
            </div>
            <p class="dsw-review-quote">
              "Harganya cuma 142.500 udah dapet dua-duanya. <span class="dsw-hl-rose">Lebih hemat 16 ribu daripada beli satuan</span> dan <span class="dsw-hl-aqua">kemasan pump Adenosine-nya higienis banget</span>."
            </p>
          </div>
        </div>
      </section>

      <!-- Section 7: Galeri Bukti Visual -->
      <section class="dsw-section dsw-section--tint">
        <h2 class="dsw-h2">
          Duet tekstur <span style="color: #0b6e7d;">warm-beige & gel-cream</span>
        </h2>
        <p class="dsw-sub">Dirancang khusus untuk warna dan karakter kulit wanita Indonesia.</p>

        <div class="dsw-photo-grid-2">
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/bukti-tekstur-duo-hydra-glow.webp`}
              alt="Swatch 2 tekstur Hydra Glow Duo: krim pagi warm-beige dan gel-cream Adenosine"
              width="315"
              height="210"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
          </div>
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/bukti-bunda-hijab-cerah-kenyal.webp`}
              alt="Potret wanita berhijab usia 36 tahun dengan wajah cerah natural dan kenyal"
              width="315"
              height="210"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
          </div>
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/bukti-kulit-halus-tanpa-bedak.webp`}
              alt="Close-up pipi halus bercahaya satin tanpa dempul"
              width="315"
              height="210"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
          </div>
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/bukti-meja-rias-hydra-glow-duo.webp`}
              alt="Paket Hydra Glow Duo Numa Skin di meja rias kayu"
              width="315"
              height="210"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
          </div>
        </div>
      </section>

      <!-- Section 8: Product Knowledge (Full-Bleed Figures) -->
      <section class="dsw-section dsw-section--knowledge">
        <h2 class="dsw-h2">
          Keunggulan ilmiah <span class="dsw-hl-aqua">Hydra Glow Duo</span>
        </h2>
        <p class="dsw-sub">
          Sinergi 1% Encapsulated PDRN di pagi hari dan Skin Communicator™ Adenosine di malam hari.
        </p>

        <div class="dsw-figure-stack">
          <figure class="dsw-figure">
            <div class="dsw-figure-bleed">
              <img
                src={`${IMG_BASE}/formulasi-duo-krim-siang-malam.webp`}
                alt="Formulasi Encapsulated PDRN, Red Algae Jania rubens, dan Ulleung Deep Sea Water"
                width="720"
                height="480"
                class="dsw-figure-img"
                loading="lazy"
                fetchpriority="low"
                decoding="async"
              />
            </div>
            <figcaption class="dsw-figcaption">
              <h3 class="dsw-figcaption-title">24-Hour Brightening & Firming Cycle</h3>
              <p class="dsw-figcaption-desc">
                PDRN + 4X UV Defense menjaga kecerahan wajah sepanjang siang, sementara Adenosine + Actiporine 8G merawat kolagen sepanjang malam.
              </p>
            </figcaption>
          </figure>
          <figure class="dsw-figure">
            <div class="dsw-figure-bleed">
              <img
                src={`${IMG_BASE}/kandungan-pdrn-arbutin-adenosine-ha.webp`}
                alt="Kandungan 1% PDRN, Double Alpha-Arbutin, Niacinamide, Adenosine, dan 11X Hyaluronic Acid"
                width="720"
                height="480"
                class="dsw-figure-img"
                loading="lazy"
                fetchpriority="low"
                decoding="async"
              />
            </div>
            <figcaption class="dsw-figcaption">
              <h3 class="dsw-figcaption-title">1% PDRN + Double Alpha-Arbutin + Adenosine + 11X HA</h3>
              <p class="dsw-figcaption-desc">
                Perpaduan pencerah noda hitam ganda dengan 11 jenis asam hialuronat tanpa merkuri maupun hidrokuinon.
              </p>
            </figcaption>
          </figure>
          <figure class="dsw-figure">
            <div class="dsw-figure-bleed">
              <img
                src={`${IMG_BASE}/kemasan-hydra-glow-duo.webp`}
                alt="Kemasan resmi Paket Hydra Glow Duo Numa Skin terdaftar BPOM"
                width="720"
                height="480"
                class="dsw-figure-img"
                loading="lazy"
                fetchpriority="low"
