---
import BaseLayout from '../layouts/BaseLayout.astro';
import GeoIpResolvedForm from '../components/storefront/forms/GeoIpResolvedForm.astro';
import MetaLandingTracker from '../components/storefront/tracking/MetaLandingTracker.astro';
import Icon from '../components/storefront/shared/Icon.astro';
import RatingStars from '../components/storefront/shared/RatingStars.astro';
import { getStorefrontProduct } from '../lib/catalog';
import { nativeLandingCanonicalPath } from '../lib/landing-pages';
import { defaultCatalogContentId } from '../lib/catalog-feed';
import { getRuntimeEnv } from '../lib/env';
import { loadStoreCodDisabledProvinceCodes } from '../lib/form-mode';
import { getStoreAdsConfig } from '../lib/store-ads';
import '../styles/form-hybrid.css';
import '../styles/landing-pages/paket-twin-pack-toner-2x150ml.css';

export const prerender = false;

const PRODUCT_SLUG = 'paket-twin-pack-toner-2x150ml';
const LANDING_SLUG = 'paket-twin-pack-toner-2x150ml';
const PAGE_TITLE = 'Paket Twin Pack Toner 2x150ml - Stok Hemat 300ml Deep Sea Water Treatment Lotion BPOM';
const PAGE_DESC = 'Paket super hemat 2 botol besar (2 x 150ml = 300ml) Numa Skin Deep Sea Water Treatment Lotion (BPOM NA18220101400). Diskon Rp66.400 untuk stok hidrasi & kompres CSM.';
const IMG_BASE = '/images/landing/paket-twin-pack-toner-2x150ml';
const HERO_IMAGE = `${IMG_BASE}/hero-paket-twin-pack-toner-2x150ml.webp`;

const database = getRuntimeEnv(Astro.locals)?.OMS_DB as D1Database | undefined;
const claimedProductSlug = Astro.request.headers.get('x-adsbook-product-page');
const [product, canonicalPath, codDisabledProvinceCodes] = await Promise.all([
  getStorefrontProduct(Astro.locals, PRODUCT_SLUG),
  claimedProductSlug
    ? Promise.resolve(`/produk/${claimedProductSlug}`)
    : nativeLandingCanonicalPath(Astro.locals, LANDING_SLUG),
  loadStoreCodDisabledProvinceCodes(database),
  getStoreAdsConfig(Astro.locals),
]);
if (!product) {
  return Astro.rewrite('/404');
}

const canonical = `${Astro.locals.tenant.siteUrl}${canonicalPath}`;

const variants = product.variants || [];
const cheapestVariant = variants.reduce(
  (min: any, v: any) => (!min || v.price < min.price ? v : min),
  variants[0]
);
const defaultVariant = cheapestVariant || {
  id: '49',
  label: '2× Toner 150ml',
  price: 151600,
  comparePrice: 218000,
};
---

<BaseLayout
  title={PAGE_TITLE}
  description={PAGE_DESC}
  image={HERO_IMAGE}
  preloadImages={HERO_IMAGE}
  canonical={canonical}
  hideHeader={true}
  hideFooter={true}
>
  <MetaLandingTracker
    slug={LANDING_SLUG}
    contentId={defaultCatalogContentId(product)}
    contentName={product.contentName}
    price={defaultVariant.price}
  />

  <div class="dsw-shell">
    <main class="dsw-canvas">
      <!-- Section 1: Hero -->
      <section id="hero-section" class="dsw-hero">
        <div class="dsw-hero-head">
          <h1 class="dsw-h1">
            <span class="dsw-hl-tilt">Suka Kompres Toner</span> Tapi Sayang Kalau Cepat Habis?
          </h1>
          <p class="dsw-sub" style="max-width: 390px; margin: 14px auto 0; font-weight: 700;">
            Metode kompres kapas (CSM) dan layer toner pagi-malam membutuhkan stok hidrasi yang melimpah.<br />
            <span class="dsw-underline-teal">Amankan 2 Botol Jumbo (Total 300ml) & hemat Rp66.400 hari ini!</span>
          </p>
        </div>

        <div class="dsw-hero-stage">
          <div class="dsw-hero-top-tag">
            <div class="dsw-hero-top-pill">
              <Icon name="lucide:award" class="size-3.5" aria-hidden="true" />
              <span>Twin Pack 2x150ml • Hemat Rp66.400</span>
            </div>
          </div>

          <img
            src={HERO_IMAGE}
            alt="Perbandingan kulit kasar dehidrasi vs kulit kenyal glass skin dengan Paket Twin Pack Toner 2x150ml Numa Skin"
            width="720"
            height="480"
            class="dsw-hero-img"
            fetchpriority="high"
            loading="eager"
            decoding="async"
          />

          <div class="dsw-hero-ba" aria-hidden="true">
            <span class="dsw-hero-ba-pill dsw-hero-ba-pill--before">Kasar & Dehidrasi</span>
            <span class="dsw-hero-ba-pill dsw-hero-ba-pill--after">Kenyal Glass Skin</span>
          </div>

          <div class="dsw-hero-trust-strip" role="list" aria-label="Jaminan kualitas Numa Skin">
            <div class="dsw-trust-item" role="listitem">
              <span class="dsw-trust-icon">
                <Icon name="lucide:shield-check" class="size-3.5" aria-hidden="true" />
              </span>
              <span class="dsw-trust-text">
                <strong class="dsw-trust-label">BPOM Resmi</strong>
                <span class="dsw-trust-sub">NA18220101400</span>
              </span>
            </div>
            <div class="dsw-trust-item" role="listitem">
              <span class="dsw-trust-icon">
                <Icon name="lucide:droplets" class="size-3.5" aria-hidden="true" />
              </span>
              <span class="dsw-trust-text">
                <strong class="dsw-trust-label">Total 300ml</strong>
                <span class="dsw-trust-sub">2 Botol Full-Size</span>
              </span>
            </div>
            <div class="dsw-trust-item" role="listitem">
              <span class="dsw-trust-icon">
                <Icon name="lucide:layers" class="size-3.5" aria-hidden="true" />
              </span>
              <span class="dsw-trust-text">
                <strong class="dsw-trust-label">Hemat Rp66.400</strong>
                <span class="dsw-trust-sub">Rp75.800 / Botol</span>
              </span>
            </div>
          </div>
        </div>

        <div class="dsw-hero-foot">
          <p class="dsw-hero-caption">
            Paket stok paling hemat: <strong>2× Botol Full-Size Deep Sea Water Treatment Lotion 150ml</strong> (Total 300ml) hanya <strong>Rp151.600</strong> (Rp75.800/botol!).
          </p>
          <a href="#form-pemesanan" class="dsw-cta" data-scroll-to-form>
            <span>Ambil Twin Pack 2x150ml Ini</span>
            <Icon name="lucide:arrow-right" class="size-5" aria-hidden="true" />
          </a>
        </div>
      </section>

      <!-- Section 2: Solusi Praktis -->
      <section class="dsw-section">
        <h2 class="dsw-h2">
          Puas Kompres CSM <span class="dsw-hl-aqua">Tanpa Takut Cepat Habis</span>
        </h2>
        <p class="dsw-sub" style="margin-top: 8px;">
          Kenapa Twin Pack 2x150ml menjadi incaran utama pelanggan setia Numa Skin:
        </p>

        <div class="dsw-solution-box">
          <img
            src={`${IMG_BASE}/solusi-stok-hidrasi-kompres-CSM.webp`}
            alt="Wanita Indonesia menikmati kulit wajah yang lembap kenyal berkat pemakaian rutin Treatment Lotion 150ml"
            width="648"
            height="432"
            class="dsw-solution-img"
            loading="lazy"
            fetchpriority="low"
            decoding="async"
          />

          <div class="dsw-check-list">
            <div class="dsw-check-item">
              <span class="dsw-icon-green">
                <Icon name="lucide:check" class="size-3.5" aria-hidden="true" />
              </span>
              <p class="dsw-list-text"><strong>Harga Per Ml Paling Ekonomis:</strong> Jatuhnya hanya Rp75.800 per botol besar 150ml (lebih murah dari harga botol kecil 50ml satuan Rp79.000!).</p>
            </div>
            <div class="dsw-check-item">
              <span class="dsw-icon-green">
                <Icon name="lucide:check" class="size-3.5" aria-hidden="true" />
              </span>
              <p class="dsw-list-text"><strong>Bebas Pakai 3–5 Layer & Kompres Kapas:</strong> Dengan stok 300ml, Anda leluasa melakukan kompres CSM di pipi yang kering atau kemerahan setiap malam.</p>
            </div>
            <div class="dsw-check-item">
              <span class="dsw-icon-green">
                <Icon name="lucide:check" class="size-3.5" aria-hidden="true" />
              </span>
              <p class="dsw-list-text"><strong>4-in-1 First Essence Korea:</strong> 76% Air Laut Dalam Ulleungdo, Galactomyces, 5X Ceramide, dan 4D Hyaluronic Acid dalam satu langkah.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- Section 3: Masalah Kulit -->
      <section class="dsw-section--tinted">
        <h2 class="dsw-h2">
          Kenapa Kulit Masih Terasa <span class="dsw-hl-coral">Kurang Lembap & Kusam?</span>
        </h2>

        <div class="dsw-grid-2">
          <article class="dsw-card">
            <img
              src={`${IMG_BASE}/masalah-cepat-habis-pakai-rutin.webp`}
              alt="Wanita ragu menuangkan toner karena takut botol cepat habis"
              width="480"
              height="320"
              class="dsw-card-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <div class="dsw-card-body">
              <span class="dsw-badge-red">Pakai Terlalu Irit</span>
              <p class="dsw-card-desc">Takut toner cepat habis membuat pemakaian terlalu sedikit (hanya 1–2 tetes) sehingga hidrasi belum menjangkau seluruh pori.</p>
            </div>
          </article>

          <article class="dsw-card">
            <img
              src={`${IMG_BASE}/masalah-kulit-kusam-kurang-hidrasi.webp`}
              alt="Tekstur kulit kusam, kasar, dan pori tampak besar karena kurang asupan air"
              width="480"
              height="320"
              class="dsw-card-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <div class="dsw-card-body">
              <span class="dsw-badge-red">Dehidrasi Kronis</span>
              <p class="dsw-card-desc">Kulit yang sudah bertahun-tahun dehidrasi membutuhkan terapi kompres hidrasi rutin selama 4–8 minggu tanpa terputus.</p>
            </div>
          </article>
        </div>

        <div class="dsw-list-box">
          <p class="dsw-list-box-title">Tanda Anda Membutuhkan Paket Ini:</p>
          <div class="dsw-check-list" style="margin-top: 0;">
            <div class="dsw-check-item">
              <span class="dsw-icon-red">
                <Icon name="lucide:x" class="size-3.5" aria-hidden="true" />
              </span>
              <p class="dsw-list-text">Sudah merasakan cocoknya Deep Sea Water Treatment Lotion dan ingin stok 2 botol besar sekaligus dengan diskon terbesar</p>
            </div>
            <div class="dsw-check-item">
              <span class="dsw-icon-red">
                <Icon name="lucide:x" class="size-3.5" aria-hidden="true" />
              </span>
              <p class="dsw-list-text">Senang mengompres wajah dengan kapas (CSM) atau berbagi pemakaian bersama suami/anak di rumah</p>
            </div>
            <div class="dsw-check-item">
              <span class="dsw-icon-red">
                <Icon name="lucide:x" class="size-3.5" aria-hidden="true" />
              </span>
              <p class="dsw-list-text">Ingin mendapatkan harga terbaik Rp151.600 untuk 2 botol 150ml (hemat Rp66.400 dari harga normal Rp218.000)</p>
            </div>
          </div>
        </div>
      </section>

      <!-- Section 4: Transformasi Nyata -->
      <section class="dsw-section">
        <h2 class="dsw-h2">
          Transformasi <span class="dsw-hl-aqua">Dari Dehidrasi Kronis ke Glass Skin</span>
        </h2>
        <p class="dsw-sub" style="margin-top: 8px;">
          Hasil nyata pemakaian rutin tanpa jeda dengan stok Twin Pack 2x150ml:
        </p>

        <div class="dsw-grid-2">
          <article class="dsw-card">
            <img
              src={`${IMG_BASE}/kondisi-kulit-kasar-dehidrasi-kronis.webp`}
              alt="Kondisi kulit kasar, kering mengelupas, dan tampak kusam sebelum kompres rutin"
              width="480"
              height="320"
              class="dsw-card-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <div class="dsw-card-body">
              <span class="dsw-badge-red">Sebelum Perawatan</span>
              <p class="dsw-card-desc">Permukaan kulit terasa kasar seperti kulit jeruk, kusam tidak bercahaya, dan krim malam sulit meresap.</p>
            </div>
          </article>

          <article class="dsw-card">
            <img
              src={`${IMG_BASE}/kondisi-kulit-kenyal-glass-skin-rutin.webp`}
              alt="Kondisi kulit kenyal membal, pori tampak rapat, dan berkilau sehat"
              width="480"
              height="320"
              class="dsw-card-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <div class="dsw-card-body">
              <span class="dsw-badge-green">Rutin Twin Pack</span>
              <p class="dsw-card-desc">Cadangan air epidermis penuh kembali, pori-pori tampak lebih halus, dan wajah memantulkan kilau glass skin.</p>
            </div>
          </article>
        </div>

        <div class="dsw-list-box">
          <p class="dsw-list-box-title">Tahapan Hasil Pemakaian Rutin:</p>
          <div class="dsw-check-list" style="margin-top: 0;">
            <div class="dsw-check-item">
              <span class="dsw-icon-green">
                <Icon name="lucide:check" class="size-3.5" aria-hidden="true" />
              </span>
              <p class="dsw-list-text"><strong>Minggu 1–2:</strong> Kulit terasa adem membal setiap selesai kompres dan tidak lagi ketarik sehabis cuci muka</p>
            </div>
            <div class="dsw-check-item">
              <span class="dsw-icon-green">
                <Icon name="lucide:check" class="size-3.5" aria-hidden="true" />
              </span>
              <p class="dsw-list-text"><strong>Minggu 3–4:</strong> Tekstur kasar di pipi dan dahi melunak, membuat riasan pagi menempel jauh lebih mulus</p>
            </div>
            <div class="dsw-check-item">
              <span class="dsw-icon-green">
                <Icon name="lucide:check" class="size-3.5" aria-hidden="true" />
              </span>
              <p class="dsw-list-text"><strong>Minggu 5–8:</strong> Dengan stok botol kedua, hasil hidrasi dan kecerahan alami kulit terjaga stabil jangka panjang</p>
            </div>
          </div>
        </div>
      </section>

      <!-- Section 5: Cara Pakai -->
      <section class="dsw-section--tinted">
        <h2 class="dsw-h2">
          Cara Pakai <span class="dsw-hl-aqua">Praktis Setiap Hari</span>
        </h2>
        <p class="dsw-sub" style="margin-top: 8px;">
          Gunakan secara royal setiap pagi dan malam:
        </p>

        <div class="dsw-grid-2">
          <article class="dsw-card">
            <img
              src={`${IMG_BASE}/cara-pakai-twin-tuang-telapak.webp`}
              alt="Menuangkan Treatment Lotion 150ml ke telapak tangan untuk 2-3 layer tepuk wajah"
              width="480"
              height="320"
              class="dsw-card-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <div class="dsw-card-body">
              <span class="dsw-badge-teal">1. Teknik 3-Layer Tepuk</span>
              <p class="dsw-card-desc">Tuang ke telapak tangan, tepuk lembut ke seluruh wajah dan leher. Ulangi 2–3 lapis pada area pipi yang kering.</p>
            </div>
          </article>

          <article class="dsw-card">
            <img
              src={`${IMG_BASE}/cara-pakai-twin-kompres-wajah.webp`}
              alt="Mengompres pipi dengan kapas tipis yang dibasahi Treatment Lotion"
              width="480"
              height="320"
              class="dsw-card-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <div class="dsw-card-body">
              <span class="dsw-badge-teal">2. Masker Kompres CSM 5 Menit</span>
              <p class="dsw-card-desc">Basahi 3 lembar kapas tipis dengan <strong>Treatment Lotion 150ml</strong>, tempelkan di kedua pipi dan dahi selama 5 menit.</p>
            </div>
          </article>
        </div>

        <div style="margin-top: 22px; text-align: center;">
          <a href="#form-pemesanan" class="dsw-cta" data-scroll-to-form>
            <span>Pesan Twin Pack 2x150ml Sekarang</span>
            <Icon name="lucide:arrow-right" class="size-5" aria-hidden="true" />
          </a>
        </div>
      </section>

      <!-- Section 6: Bukti Pelanggan -->
      <section class="dsw-section">
        <h2 class="dsw-h2">
          Bukti Tekstur <span class="dsw-hl-aqua">& Kepuasan Pelanggan</span>
        </h2>
        <p class="dsw-sub" style="margin-top: 8px;">
          Testimoni pelanggan setia yang selalu repeat order Twin Pack 2x150ml:
        </p>

        <div class="dsw-grid-2">
          <div class="dsw-proof-cell">
            <img
              src={`${IMG_BASE}/bukti-tekstur-essence-cair-segar.webp`}
              alt="Tekstur watery essence Deep Sea Water Treatment Lotion di tangan"
              width="480"
              height="320"
              class="dsw-proof-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <p class="dsw-proof-OverlayCaption">Watery Essence Murni Tanpa Lengket</p>
          </div>
          <div class="dsw-proof-cell">
            <img
              src={`${IMG_BASE}/bukti-bunda-setia-twin-pack.webp`}
              alt="Wanita Indonesia berhijab tersenyum dengan kulit wajah lembap bercahaya"
              width="480"
              height="320"
              class="dsw-proof-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <p class="dsw-proof-OverlayCaption">Andalan Pelanggan Repeat Order</p>
          </div>
          <div class="dsw-proof-cell">
            <img
              src={`${IMG_BASE}/bukti-kulit-lembap-membal-pagi.webp`}
              alt="Close-up pipi kenyal dan halus di pagi hari"
              width="480"
              height="320"
              class="dsw-proof-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <p class="dsw-proof-OverlayCaption">Kulit Tetap Kenyal Sampai Pagi</p>
          </div>
          <div class="dsw-proof-cell">
            <img
              src={`${IMG_BASE}/bukti-meja-rias-twin-pack-toner.webp`}
              alt="Dua botol besar Deep Sea Water Treatment Lotion 150ml di meja rias"
              width="480"
              height="320"
              class="dsw-proof-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <p class="dsw-proof-OverlayCaption">2 Botol Jumbo 150ml (Total 300ml)</p>
          </div>
        </div>

        <div class="dsw-testi-list">
          <article class="dsw-testi-card">
            <div class="dsw-testi-head">
              <div class="dsw-testi-avatar" aria-hidden="true">E</div>
              <div class="dsw-testi-meta">
                <p class="dsw-testi-name">
                  Bunda Erna Wijaya (40 thn)
                  <span class="dsw-verified-pill">Verified Buyer</span>
                </p>
                <div class="dsw-stars">
                  <RatingStars rating={5} starClass="h-3.5 w-3.5 !fill-[#d97706] !text-[#d97706]" />
                </div>
              </div>
            </div>
            <p class="dsw-testi-body">"Hitungannya jauh lebih murah beli Twin Pack 2x150ml ini! Cuma Rp151.600 dapet 2 botol gede, padahal beli botol kecil 50ml aja 79 ribu. Aku pakai kompres kapas tiap malam bareng anak gadisku, kulit kami berdua jadi lembap dan jarang banget bruntusan."</p>
            <div class="dsw-testi-foot">
              <span>Medan</span>
              <span>•</span>
              <span>Repeat Order ke-3</span>
            </div>
          </article>

          <article class="dsw-testi-card">
            <div class="dsw-testi-head">
              <div class="dsw-testi-avatar" aria-hidden="true">T</div>
              <div class="dsw-testi-meta">
                <p class="dsw-testi-name">
                  Ibu Tuti Handayani (37 thn)
                  <span class="dsw-verified-pill">Verified Buyer</span>
                </p>
                <div class="dsw-stars">
                  <RatingStars rating={5} starClass="h-3.5 w-3.5 !fill-[#d97706] !text-[#d97706]" />
                </div>
              </div>
            </div>
            <p class="dsw-testi-body">"Tonernya Numa Skin ini emang nggak tergantikan buat kulit keringku. Beli langsung 2 botol 150ml hematnya 66 ribu lebih, awet banget buat stok 3 bulan penuh."</p>
            <div class="dsw-testi-foot">
              <span>Solo</span>
              <span>•</span>
              <span>Pemakaian 8 Minggu</span>
            </div>
          </article>
        </div>
      </section>

      <!-- Section 7: Tabel Perbandingan -->
      <section class="dsw-section--tinted">
        <h2 class="dsw-h2">
          Keunggulan <span class="dsw-hl-aqua">Twin Pack Toner (2x150ml)</span>
        </h2>
        <p class="dsw-sub" style="margin-top: 8px;">
          Mengapa memilih Paket Twin Pack Toner (2x150ml) jauh lebih hemat dan efektif dibandingkan membeli produk satuan:
        </p>

        <div class="dsw-cmp-card">
          <div class="dsw-cmp-head">
            <div class="dsw-cmp-col">Karakteristik</div>
            <div class="dsw-cmp-col dsw-cmp-col--numa">Twin Pack 2x150ml</div>
            <div class="dsw-cmp-col">Beli Satuan Biasa</div>
          </div>

          <div class="dsw-cmp-row">
            <div class="dsw-cmp-cell dsw-cmp-cell--feature">Total Volume Produk</div>
            <div class="dsw-cmp-cell dsw-cmp-cell--numa">
              <span class="dsw-icon-green" style="margin: 0 auto;">
                <Icon name="lucide:check" class="size-3.5" aria-hidden="true" />
              </span>
              <span class="dsw-cmp-sub">300ml (2 × Botol Jumbo 150ml)</span>
            </div>
            <div class="dsw-cmp-cell">
              <span class="dsw-icon-red" style="margin: 0 auto;">
                <Icon name="lucide:x" class="size-3.5" aria-hidden="true" />
              </span>
              <span class="dsw-cmp-sub">Hanya 150ml (1 botol)</span>
            </div>
          </div>

          <div class="dsw-cmp-row">
            <div class="dsw-cmp-cell dsw-cmp-cell--feature">Harga Per Botol 150ml</div>
            <div class="dsw-cmp-cell dsw-cmp-cell--numa">
              <span class="dsw-icon-green" style="margin: 0 auto;">
                <Icon name="lucide:check" class="size-3.5" aria-hidden="true" />
              </span>
              <span class="dsw-cmp-sub">Hanya Rp75.800 / botol 150ml</span>
            </div>
            <div class="dsw-cmp-cell">
              <span class="dsw-icon-red" style="margin: 0 auto;">
                <Icon name="lucide:x" class="size-3.5" aria-hidden="true" />
              </span>
