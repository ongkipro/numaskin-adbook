---
import BaseLayout from '../layouts/BaseLayout.astro';
import GeoIpResolvedForm from '../components/storefront/forms/GeoIpResolvedForm.astro';
import MetaLandingTracker from '../components/storefront/tracking/MetaLandingTracker.astro';
import Icon from '../components/storefront/shared/Icon.astro';
import RatingStars from '../components/storefront/shared/RatingStars.astro';
import LpHeroOffer from '../components/storefront/landing-pages/LpHeroOffer.astro';
import LpBundleValueSection, {
  type BundleTierSpec,
} from '../components/storefront/landing-pages/LpBundleValueSection.astro';
import LpFloatingCta from '../components/storefront/landing-pages/LpFloatingCta.astro';
import { getStorefrontProduct } from '../lib/catalog';
import { nativeLandingCanonicalPath } from '../lib/landing-pages';
import { defaultCatalogContentId } from '../lib/catalog-feed';
import { getRuntimeEnv } from '../lib/env';
import { loadStoreCodDisabledProvinceCodes } from '../lib/form-mode';
import { getStoreAdsConfig } from '../lib/store-ads';
import '../styles/form-hybrid.css';
import '../styles/landing-pages/lp-meta-ads.css';

export const prerender = false;

const PRODUCT_SLUG = 'paket-protection-duo-pdrn';
const LANDING_SLUG = 'lp-paket-pagi-anti-uv';
const PAGE_TITLE =
  'Paket Pagi Anti-UV (Protection Duo PDRN) — Cerah Natural Tanpa Dempul + Tameng SPF 50+ BPOM';
const PAGE_DESC =
  'Paket pagi praktis Numa Skin: PDRN + Alpha Arbutin Tone-Up Day Cream 30g (10.000 PPM Encapsulated PDRN) & Oxydew Sunscreen 3% Luceane SPF 50+ PA++++ 30ml bebas whitecast (BPOM Resmi).';
const IMG_BASE = '/images/landing/paket-protection-duo-pdrn';
const HERO_IMAGE = `${IMG_BASE}/hero-paket-protection-pdrn.webp`;

const database = getRuntimeEnv(Astro.locals)?.OMS_DB as D1Database | undefined;
const claimedProductSlug = Astro.request.headers.get('x-adsbook-product-page');
const [product, canonicalPath, codDisabledProvinceCodes] = await Promise.all([
  getStorefrontProduct(Astro.locals, PRODUCT_SLUG),
  claimedProductSlug
    ? Promise.resolve(`/produk/${claimedProductSlug}`)
    : nativeLandingCanonicalPath(Astro.locals, LANDING_SLUG),
  loadStoreCodDisabledProvinceCodes(database),
  getStoreAdsConfig(Astro.locals),
]);
if (!product) {
  return Astro.rewrite('/404');
}

const canonical = `${Astro.locals.tenant.siteUrl}${canonicalPath}`;

const variants = product.variants || [];
const cheapestVariant = variants.reduce(
  (min: any, v: any) => (!min || v.price < min.price ? v : min),
  variants[0]
);
const defaultVariant = cheapestVariant || {
  id: '34',
  label: 'Day Cream 30gr + Sunscreen 30ml',
  price: 142500,
  comparePrice: 158499,
};

const BUNDLE_TIERS: BundleTierSpec[] = [
  {
    productSlug: 'paket-protection-duo-pdrn',
    badge: 'Paket Utama • Duo Cerah Pagi Anti-UV',
    featured: true,
    image: `${IMG_BASE}/kemasan-duo-pdrn-oxydew.webp`,
    imageAlt: 'Paket Protection Duo PDRN Day Cream 30gr dan Oxydew Sunscreen 30ml',
    benefit: 'PDRN Tone-Up Day Cream 30gr (Natural Beige) + Oxydew Sunscreen 3% Luceane SPF 50+ PA++++ 30ml.',
    ctaLabel: 'Ambil Paket Duo',
  },
  {
    productSlug: 'paket-age-defense-trio',
    badge: 'Upgrade 24 Jam + Pelembap Malam Adenosine',
    image: '/images/landing/paket-age-defense-trio/kemasan-age-defense-trio.webp',
    imageAlt: 'Paket Age Defense Trio 3-in-1 Numa Skin',
    benefit: 'Lengkapi perawatan malam hari dengan Adenosine Moisturizer 30gr (11X Hyaluronic Acid) hemat Rp24.000.',
    ctaLabel: 'Upgrade ke Trio',
  },
  {
    productSlug: 'oxydew-sunscreen-luceane-spf50-pa',
    badge: 'Opsi Sunscreen SPF 50+ Saja',
    image: '/images/landing/oxydew-sunscreen-luceane-spf50-pa/kemasan-oxydew-30ml.webp',
    imageAlt: 'Oxydew Sunscreen 3% Luceane SPF 50+ PA++++ 30ml',
    benefit: '1 Tube Oxydew Sunscreen 3% Luceane SPF 50+ PA++++ 30ml ringan transparan bebas whitecast.',
    ctaLabel: 'Pilih Sunscreen',
  },
];
---

<BaseLayout
  title={PAGE_TITLE}
  description={PAGE_DESC}
  image={HERO_IMAGE}
  preloadImages={HERO_IMAGE}
  canonical={canonical}
  noindex={true}
  hideHeader={true}
  hideFooter={true}
>
  <MetaLandingTracker
    slug={LANDING_SLUG}
    contentId={defaultCatalogContentId(product)}
    contentName={product.contentName}
    price={defaultVariant.price}
  />

  <div class="dsw-shell">
    <main class="dsw-canvas">
      <!-- Section 1: Hero -->
      <section id="hero-section" class="dsw-hero">
        <div class="dsw-hero-head">
          <h1 class="dsw-h1">
            Bedak Luntur Jadi Abu-Abu & <span class="dsw-hl-tilt">Flek Makin Hitam Terbakar UV?</span> Kunci Cerah Pagi + SPF 50+ PA++++!
          </h1>
          <p class="dsw-sub" style="max-width: 390px; margin: 14px auto 0; font-weight: 700;">
            Krim pagi biasa langsung pecah dempul saat berkeringat dan gagal menahan sengatan UV.<br />
            <span class="dsw-underline-teal">Ratakan warna kulit & kunci SPF 50+ dengan Protection Duo PDRN!</span>
          </p>
        </div>

        <div class="dsw-hero-stage">
          <div class="dsw-hero-top-tag">
            <div class="dsw-hero-top-pill">
              <Icon name="lucide:sun-dim" class="size-3.5" aria-hidden="true" />
              <span>Duo Cerah Pagi Anti-UV • Hemat Rp16.000</span>
            </div>
          </div>

          <img
            src={HERO_IMAGE}
            alt="Perbandingan wajah dempul abu-abu terbakar UV vs kulit cerah natural terlindungi SPF 50+ dengan Paket Protection Duo PDRN Numa Skin"
            width="720"
            height="480"
            class="dsw-hero-img"
            fetchpriority="high"
            loading="eager"
            decoding="async"
          />

          <div class="dsw-hero-ba" aria-hidden="true">
            <span class="dsw-hero-ba-pill dsw-hero-ba-pill--before">SEBELUM — Dempul Luntur & Flek UV</span>
            <span class="dsw-hero-ba-pill dsw-hero-ba-pill--after">SESUDAH — Cerah Menyatu SPF 50+</span>
          </div>

          <div class="dsw-hero-overlap">
            <div class="dsw-hero-overlap-inner">
              <h2 class="dsw-hero-overlap-title">Krim Siang Biasa Bikin Flek Makin Gosong Kena UV!</h2>
              <p class="dsw-hero-overlap-text">
                Krim tone-up putih biasa <strong style="color: #be123c;">membuat kulit sawo matang belang abu-abu dan membiarkan sinar UVA membakar flek hitam makin pekat</strong>.
              </p>
            </div>
          </div>
        </div>

        <div class="dsw-trust-row">
          <div class="dsw-trust-item">
            <span class="dsw-trust-icon">
              <Icon name="lucide:shield-check" class="size-4" aria-hidden="true" />
            </span>
            <div>
              <span class="dsw-trust-label">2 BPOM Resmi</span>
              <span class="dsw-trust-sub">NA1826.. & NA1825..</span>
            </div>
          </div>
          <div class="dsw-trust-item">
            <span class="dsw-trust-icon">
              <Icon name="lucide:badge-check" class="size-4" aria-hidden="true" />
            </span>
            <div>
              <span class="dsw-trust-label">Halal RI</span>
              <span class="dsw-trust-sub">0% Abu-Abu</span>
            </div>
          </div>
          <div class="dsw-trust-item">
            <span class="dsw-trust-icon">
              <Icon name="lucide:truck" class="size-4" aria-hidden="true" />
            </span>
            <div>
              <span class="dsw-trust-label">Bisa COD</span>
              <span class="dsw-trust-sub">Bayar di Rumah</span>
            </div>
          </div>
        </div>

        <LpHeroOffer
          price={defaultVariant.price}
          comparePrice={defaultVariant.comparePrice}
          eyebrow="Paket Pagi Cerah Natural + SPF 50+ PA++++"
          ctaText="Ambil Paket Hemat Sekarang"
        />
      </section>

      <!-- Section 2: Solusi Singkat + Visual -->
      <section class="dsw-section">
        <h2 class="dsw-h2">
          Siap keluar rumah dalam 3 menit <span class="dsw-hl-aqua">tanpa bedak tebal</span>
        </h2>
        <p class="dsw-sub">Kombinasi rona Natural Beige yang menyatu di kulit sawo matang + perisai UV SPF 50+ PA++++.</p>

        <div class="dsw-photo-stack">
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/solusi-cerah-instan-anti-uv.webp`}
              alt="Wanita Indonesia dengan kulit sawo matang yang tampak cerah natural bebas dempul di bawah sinar matahari pagi"
              width="648"
              height="432"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
          </div>
        </div>

        <div class="dsw-list">
          <div class="dsw-list-row">
            <span class="dsw-icon-teal">
              <Icon name="lucide:layers" class="size-4" aria-hidden="true" />
            </span>
            <p class="dsw-list-text">
              <strong style="color: #0f172a;">PDRN + Alpha Arbutin Day Cream (30 gr):</strong> Rona hangat Natural Beige menyamarkan kusam & flek hitam seketika sambil menutrisi dengan 1% Encapsulated PDRN.
            </p>
          </div>
          <div class="dsw-list-row">
            <span class="dsw-icon-teal">
              <Icon name="lucide:sun-dim" class="size-4" aria-hidden="true" />
            </span>
            <p class="dsw-list-text">
              <strong style="color: #0f172a;">Oxydew Sunscreen SPF 50+ PA++++ (30 ml):</strong> Mengunci perlindungan UVA/UVB & polusi dengan 3% Luceane™ tanpa merusak rona tone-up di bawahnya.
            </p>
          </div>
          <div class="dsw-list-row">
            <span class="dsw-icon-teal">
              <Icon name="lucide:droplets" class="size-4" aria-hidden="true" />
            </span>
            <p class="dsw-list-text">
              <strong style="color: #0f172a;">Hemat Rp15.999:</strong> Dapatkan kedua produk ukuran penuh seharga Rp142.500 (harga satuan Rp158.499).
            </p>
          </div>
        </div>
      </section>

      <!-- Section 3: Tanda Masalah Kulit + Visual Grid -->
      <section class="dsw-section dsw-section--warn">
        <h2 class="dsw-h2">
          Masalah riasan pagi di <span class="dsw-underline-warn">cuaca panas & lembap</span>:
        </h2>

        <div class="dsw-photo-grid-2">
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/masalah-bedak-luntur-keringat.webp`}
              alt="Foundation dan bedak tebal yang pecah menggumpal di pori-pori saat berkeringat"
              width="315"
              height="210"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <p class="dsw-photo-caption">
              <strong style="color: #be123c; display: block;">Dempul & Pecah di Pori</strong>
              Foundation tebal mudah luntur dan memperjelas garis senyum.
            </p>
          </div>
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/masalah-wajah-abu-terbakar-uv.webp`}
              alt="Wajah tampak belang abu-abu dan memerah saat terkena matahari siang"
              width="315"
              height="210"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <p class="dsw-photo-caption">
              <strong style="color: #be123c; display: block;">Abu-Abu & Belang Hijab</strong>
              Krim pemutih instan putih kapur bikin wajah belang dengan leher.
            </p>
          </div>
        </div>

        <div class="dsw-list">
          <div class="dsw-list-row">
            <span class="dsw-icon-warn">
              <Icon name="lucide:triangle-alert" class="size-4" aria-hidden="true" />
            </span>
            <p class="dsw-list-text">
              Malu keluar rumah tanpa bedak tebal karena <strong style="color: #be123c;">flek hitam di tulang pipi dan noda bekas jerawat tampak jelas</strong>.
            </p>
          </div>
          <div class="dsw-list-row">
            <span class="dsw-icon-warn">
              <Icon name="lucide:triangle-alert" class="size-4" aria-hidden="true" />
            </span>
            <p class="dsw-list-text">
              Saat dipaksa pakai cushion/foundation setiap hari, <strong style="color: #be123c;">bedak pecah masuk ke garis senyum dan memicu bruntusan</strong>.
            </p>
          </div>
          <div class="dsw-list-row">
            <span class="dsw-icon-warn">
              <Icon name="lucide:triangle-alert" class="size-4" aria-hidden="true" />
            </span>
            <p class="dsw-list-text">
              Krim siang biasa <strong style="color: #be123c;">tidak punya tameng SPF 50+ PA++++</strong> sehingga flek hitam makin gosong terbakar matahari.
            </p>
          </div>
        </div>
      </section>

      <!-- Section 4: Ilustrasi Perawatan Rutin -->
      <section class="dsw-section">
        <h2 class="dsw-h2">
          Perbandingan nyata <span class="dsw-hl-aqua">sebelum vs sesudah rutin</span>
        </h2>
        <p class="dsw-sub">Efek cerah menyatu di menit pertama sekaligus tameng anti-flek sepanjang siang.</p>

        <div class="dsw-photo-stack">
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/kondisi-kusam-belang-matahari.webp`}
              alt="Kondisi pipi tampak kusam, flek hitam terlihat jelas, dan residu bedak menggumpal"
              width="648"
              height="432"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <span class="dsw-photo-badge dsw-photo-badge--before">SEBELUM — Flek & Dempul Belang</span>
            <p class="dsw-photo-caption">
              Flek hitam kecokelatan tampak kontras di tulang pipi dan krim putih biasa meninggalkan bercak abu-abu di pori.
            </p>
          </div>

          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/kondisi-glowing-natural-seharian.webp`}
              alt="Kondisi pipi sawo matang tampak cerah menyatu alami dan glowing sehat dengan Protection Duo PDRN"
              width="648"
              height="432"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <span class="dsw-photo-badge dsw-photo-badge--after">SESUDAH RUTIN — Cerah & Terlindungi UV</span>
            <p class="dsw-photo-caption">
              Rona kulit langsung setingkat lebih cerah merata secara alami, bebas dempul, dan terlindungi penuh dari sinar UV.
            </p>
          </div>
        </div>
      </section>

      <!-- Section 5: Dark Marine Section — Cara Pakai Praktis -->
      <section class="dsw-section dsw-section--dark">
        <h2 class="dsw-h2">
          Urutan Pakai Pagi <span style="color: #99e2ec;">Cerah & Terlindungi</span>
        </h2>
        <p class="dsw-sub">Cukup 2 tahap di pagi hari untuk menggantikan krim pagi, primer, dan sunscreen.</p>

        <div class="dsw-photo-stack">
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/cara-pakai-step1-oles-pdrn-beige.webp`}
              alt="Langkah 1 mengambil krim warna Natural Beige dari jar PDRN + Alpha Arbutin Tone-Up Day Cream"
              width="648"
              height="432"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <p class="dsw-photo-caption">
              <strong style="color: #ffffff;">Langkah 1 (Tone-Up & Nutrisi — PDRN Cream):</strong> Totolkan tipis di 5 titik wajah lalu baurkan merata hingga menyatu dengan warna kulit.
            </p>
          </div>

          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/cara-pakai-step2-lapis-oxydew.webp`}
              alt="Langkah 2 melapisi wajah dengan 2 ruas jari Oxydew Sunscreen SPF 50+ PA++++"
              width="648"
              height="432"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <p class="dsw-photo-caption">
              <strong style="color: #ffffff;">Langkah 2 (Perisai UV — Oxydew SPF 50+):</strong> Lapisi dengan Oxydew Sunscreen yang bening ringan untuk mengunci efek glowing seharian.
            </p>
          </div>
        </div>

        <div class="dsw-list">
          <div class="dsw-list-row">
            <span class="dsw-step-num">1</span>
            <p class="dsw-step-text">
              Oleskan <strong style="color: #ffffff;">PDRN Tone-Up Day Cream tipis-tipis dulu</strong> agar pigmen Natural Beige menyatu halus tanpa menumpuk.
            </p>
          </div>
          <div class="dsw-list-row">
            <span class="dsw-step-num">2</span>
            <p class="dsw-step-text">
              Tunggu 30 detik hingga set, lalu aplikasikan <strong style="color: #ffffff; background: #104452; padding: 1px 6px; border-radius: 4px;">Oxydew Sunscreen dengan cara ditepuk lembut</strong>.
            </p>
          </div>
          <div class="dsw-list-row">
            <span class="dsw-step-num">3</span>
            <p class="dsw-step-text">
              Wajah langsung tampak <strong style="color: #ffffff;">segar bercahaya seperti habis memakai cushion mahal</strong>, namun pori tetap bebas bernapas.
            </p>
          </div>
        </div>
      </section>

      <!-- Section 6: Ulasan Pelanggan -->
      <section class="dsw-section">
        <h2 class="dsw-h2">
          Kata mereka yang <span class="dsw-hl-aqua">sudah pensiun dari bedak tebal</span>
        </h2>
        <p class="dsw-sub">Andalan pagi hari bagi Ibu bekerja, pengajar, hingga aktivitas luar ruangan.</p>

        <div class="dsw-reviews-divide">
          <div class="dsw-review-row">
            <div class="dsw-review-head">
              <div>
                <p class="dsw-review-author">
                  Kak Rissa A.
                  <span style="color: #0b6e7d; display: inline-flex;">
                    <Icon name="lucide:badge-check" class="size-4" aria-hidden="true" />
                  </span>
                </p>
                <p class="dsw-review-meta">Bekasi • Kulit Sawo Matang</p>
              </div>
              <RatingStars rating={5} starClass="h-3.5 w-3.5 !fill-[#d97706] !text-[#d97706]" />
            </div>
            <p class="dsw-review-quote">
              "Kulitku sawo matang jadi paling takut pakai tone-up cream. Tapi PDRN Day Cream Numa Skin ini <span class="dsw-hl-aqua">warnanya krem beige natural, begitu ditimpa Oxydew Sunscreen hasilnya glowing menyatu banget</span> tanpa abu-abu!"
            </p>
          </div>

          <div class="dsw-review-row">
            <div class="dsw-review-head">
              <div>
                <p class="dsw-review-author">
                  Ibu Nurlaila
                  <span style="color: #0b6e7d; display: inline-flex;">
                    <Icon name="lucide:badge-check" class="size-4" aria-hidden="true" />
                  </span>
                </p>
                <p class="dsw-review-meta">Surabaya • Guru SD (Usia 37 Tahun)</p>
              </div>
              <RatingStars rating={5} starClass="h-3.5 w-3.5 !fill-[#d97706] !text-[#d97706]" />
            </div>
            <p class="dsw-review-quote">
              "Tiap pagi buru-buru berangkat ngajar sekarang <strong style="color: #0f172a;">cukup pakai dua produk ini aja gak perlu foundation lagi</strong>. <span class="dsw-hl-aqua">Sampai siang kena panas di sekolah wajah tetap cerah segar gak luntur</span>."
            </p>
          </div>

          <div class="dsw-review-row">
            <div class="dsw-review-head">
              <div>
                <p class="dsw-review-author">
                  Ibu Fenny W.
                  <span style="color: #0b6e7d; display: inline-flex;">
                    <Icon name="lucide:badge-check" class="size-4" aria-hidden="true" />
                  </span>
                </p>
                <p class="dsw-review-meta">Makassar • Paket Hemat Pagi</p>
              </div>
              <RatingStars rating={5} starClass="h-3.5 w-3.5 !fill-[#d97706] !text-[#d97706]" />
            </div>
            <p class="dsw-review-quote">
              "Bukan cuma bikin cerah instan pas dipakai, tapi karena <span class="dsw-hl-rose">ada 1% Encapsulated PDRN sama Arbutin-nya</span>, <span class="dsw-hl-aqua">noda bekas jerawat dan flek hitam tipis di pipi ikut memudar beneran</span>."
            </p>
          </div>
        </div>
      </section>

      <!-- Section 7: Galeri Bukti Visual -->
      <section class="dsw-section dsw-section--tint">
        <h2 class="dsw-h2">
          Rona Natural Beige + <span style="color: #0b6e7d;">Transparan SPF 50+</span>
        </h2>
        <p class="dsw-sub">Dirancang khusus untuk warna kulit wanita Indonesia dari kuning langsat hingga sawo matang.</p>

        <div class="dsw-photo-grid-2">
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/bukti-swatch-duo-beige-lotion.webp`}
              alt="Swatch krim warna Natural Beige PDRN Day Cream dan lotion transparan Oxydew Sunscreen di tangan sawo matang"
              width="315"
              height="210"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
          </div>
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/bukti-wanita-aktif-glowing-pagi.webp`}
              alt="Potret wanita karier berhijab dengan wajah cerah natural di pagi hari"
              width="315"
              height="210"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
          </div>
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/bukti-bebas-dempul-tahan-panas.webp`}
              alt="Close-up tekstur kulit pipi yang halus satin-dewy bebas dempul"
              width="315"
              height="210"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
          </div>
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/bukti-meja-rias-protection-duo.webp`}
              alt="Kemasan Paket Protection Duo PDRN di meja rias pagi hari"
              width="315"
              height="210"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
          </div>
        </div>
      </section>

