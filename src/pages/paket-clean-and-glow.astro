---
import BaseLayout from '../layouts/BaseLayout.astro';
import GeoIpResolvedForm from '../components/storefront/forms/GeoIpResolvedForm.astro';
import MetaLandingTracker from '../components/storefront/tracking/MetaLandingTracker.astro';
import Icon from '../components/storefront/shared/Icon.astro';
import RatingStars from '../components/storefront/shared/RatingStars.astro';
import { getStorefrontProduct } from '../lib/catalog';
import { nativeLandingCanonicalPath } from '../lib/landing-pages';
import { defaultCatalogContentId } from '../lib/catalog-feed';
import { getRuntimeEnv } from '../lib/env';
import { loadStoreCodDisabledProvinceCodes } from '../lib/form-mode';
import { getStoreAdsConfig } from '../lib/store-ads';
import '../styles/form-hybrid.css';
import '../styles/landing-pages/paket-clean-and-glow.css';

export const prerender = false;

const PRODUCT_SLUG = 'paket-clean-and-glow';
const LANDING_SLUG = 'paket-clean-and-glow';
const PAGE_TITLE = 'Paket Clean & Glow Duo - Bersihkan Pori & Kencangkan Garis Senyum BPOM';
const PAGE_DESC = 'Paket bundling 2-in-1 Numa Skin: Deep Sea Water Facial Wash Gel 100ml + NAD+ Booster Anti-Aging Serum 20ml untuk pori bersih cerah & kontur wajah kencang (2 BPOM Resmi).';
const IMG_BASE = '/images/landing/paket-clean-and-glow';
const HERO_IMAGE = `${IMG_BASE}/hero-paket-clean-and-glow.webp`;

const database = getRuntimeEnv(Astro.locals)?.OMS_DB as D1Database | undefined;
const claimedProductSlug = Astro.request.headers.get('x-adsbook-product-page');
const [product, canonicalPath, codDisabledProvinceCodes] = await Promise.all([
  getStorefrontProduct(Astro.locals, PRODUCT_SLUG),
  claimedProductSlug
    ? Promise.resolve(`/produk/${claimedProductSlug}`)
    : nativeLandingCanonicalPath(Astro.locals, LANDING_SLUG),
  loadStoreCodDisabledProvinceCodes(database),
  getStoreAdsConfig(Astro.locals),
]);
if (!product) {
  return Astro.rewrite('/404');
}

const canonical = `${Astro.locals.tenant.siteUrl}${canonicalPath}`;

const variants = product.variants || [];
const cheapestVariant = variants.reduce(
  (min: any, v: any) => (!min || v.price < min.price ? v : min),
  variants[0]
);
const defaultVariant = cheapestVariant || {
  id: '13',
  label: 'Facial Wash 100ml + NAD+ Serum 20ml',
  price: 160000,
  comparePrice: 177998,
};
---

<BaseLayout
  title={PAGE_TITLE}
  description={PAGE_DESC}
  image={HERO_IMAGE}
  preloadImages={HERO_IMAGE}
  canonical={canonical}
  hideHeader={true}
  hideFooter={true}
>
  <MetaLandingTracker
    slug={LANDING_SLUG}
    contentId={defaultCatalogContentId(product)}
    contentName={product.contentName}
    price={defaultVariant.price}
  />

  <div class="dsw-shell">
    <main class="dsw-canvas">
      <!-- Section 1: Hero -->
      <section id="hero-section" class="dsw-hero">
        <div class="dsw-hero-head">
          <h1 class="dsw-h1">
            <span class="dsw-hl-tilt">Pakai Serum Mahal</span> Tapi Pori Kusam & Pipi Tetap Kendur?
          </h1>
          <p class="dsw-sub" style="max-width: 390px; margin: 14px auto 0; font-weight: 700;">
            Serum pengencang terbaik tidak akan menembus pori yang masih tertutup sumbatan minyak dan residu sabun keras.<br />
            <span class="dsw-underline-teal">Bersihkan pori & kencangkan kontur dengan Paket Clean & Glow Duo!</span>
          </p>
        </div>

        <div class="dsw-hero-stage">
          <div class="dsw-hero-top-tag">
            <div class="dsw-hero-top-pill">
              <Icon name="lucide:award" class="size-3.5" aria-hidden="true" />
              <span>Duo Pori Bersih & Lifting • Hemat Rp18.000</span>
            </div>
          </div>

          <img
            src={HERO_IMAGE}
            alt="Perbandingan wajah kusam berpori kotor dan garis senyum dalam vs kulit bersih kencang bercahaya dengan Paket Clean & Glow Duo"
            width="720"
            height="480"
            class="dsw-hero-img"
            fetchpriority="high"
            loading="eager"
            decoding="async"
          />

          <div class="dsw-hero-overlap">
            <div class="dsw-hero-overlap-inner">
              <h2 class="dsw-hero-overlap-title">Kunci Penyerapan Serum Anti-Aging</h2>
              <p class="dsw-hero-overlap-text">
                Saat pori dibersihkan dengan <strong style="color: #be123c;">Facial Wash 5% Niacinamide ber-pH seimbang, tetesan 2% RejuveNAD™ & 6X Peptide</strong> meresap langsung ke lapisan target.
              </p>
            </div>
          </div>
        </div>

        <div class="dsw-trust-row">
          <div class="dsw-trust-item">
            <span class="dsw-trust-icon">
              <Icon name="lucide:shield-check" class="size-4" aria-hidden="true" />
            </span>
            <div>
              <span class="dsw-trust-label">BPOM Resmi</span>
              <span class="dsw-trust-sub">2 Izin Edar</span>
            </div>
          </div>
          <div class="dsw-trust-item">
            <span class="dsw-trust-icon">
              <Icon name="lucide:badge-check" class="size-4" aria-hidden="true" />
            </span>
            <div>
              <span class="dsw-trust-label">Halal RI</span>
              <span class="dsw-trust-sub">Aman Bumil</span>
            </div>
          </div>
          <div class="dsw-trust-item">
            <span class="dsw-trust-icon">
              <Icon name="lucide:truck" class="size-4" aria-hidden="true" />
            </span>
            <div>
              <span class="dsw-trust-label">Bisa COD</span>
              <span class="dsw-trust-sub">Bayar di Rumah</span>
            </div>
          </div>
        </div>
      </section>

      <!-- Section 2: Solusi Singkat + Visual -->
      <section class="dsw-section">
        <h2 class="dsw-h2">
          Sinergi <span class="dsw-hl-aqua">pembersih pencerah & serum pengencang</span>
        </h2>
        <p class="dsw-sub">Dua langkah praktis untuk membuka pori yang bersih lalu mengisi ulang elastisitas wajah.</p>

        <div class="dsw-photo-stack">
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/solusi-pori-bersih-serum-meresap.webp`}
              alt="Wanita Indonesia usia 39 tahun meneteskan NAD+ Booster Serum pada pipi yang bersih segar sehabis mencuci muka"
              width="648"
              height="432"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
          </div>
        </div>

        <div class="dsw-list">
          <div class="dsw-list-row">
            <span class="dsw-icon-teal">
              <Icon name="lucide:droplets" class="size-4" aria-hidden="true" />
            </span>
            <p class="dsw-list-text">
              <strong style="color: #0f172a;">Deep Sea Water Facial Wash Gel (100 ml):</strong> Gel pembersih lembut dengan Ulleung Deep Sea Water & 5% Niacinamide yang membersihkan pori tanpa rasa ketarik.
            </p>
          </div>
          <div class="dsw-list-row">
            <span class="dsw-icon-teal">
              <Icon name="lucide:layers" class="size-4" aria-hidden="true" />
            </span>
            <p class="dsw-list-text">
              <strong style="color: #0f172a;">NAD+ Booster Anti-Aging Serum (20 ml):</strong> Serum bioteknologi 2% Swiss RejuveNAD™ + 6X Peptide Complex untuk merawat kekencangan pipi dan garis senyum.
            </p>
          </div>
          <div class="dsw-list-row">
            <span class="dsw-icon-teal">
              <Icon name="lucide:shield-check" class="size-4" aria-hidden="true" />
            </span>
            <p class="dsw-list-text">
              <strong style="color: #0f172a;">Penyerapan Maksimal:</strong> Pori yang bersih dan lembap sehabis cuci muka membuat molekul peptida meresap cepat tanpa lengket.
            </p>
          </div>
        </div>
      </section>

      <!-- Section 3: Tanda Masalah Kulit + Visual Grid -->
      <section class="dsw-section dsw-section--warn">
        <h2 class="dsw-h2">
          Mengapa serum anti-aging <span class="dsw-underline-warn">kurang terasa hasilnya</span>?
        </h2>

        <div class="dsw-photo-grid-2">
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/masalah-pakai-serum-tapi-pori-kotor.webp`}
              alt="Wanita bercermin melihat kulit pipi yang kusam di mana serum tertahan oleh sumbatan pori"
              width="315"
              height="210"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <p class="dsw-photo-caption">
              <strong style="color: #be123c; display: block;">Sumbatan Sebum Menghalangi Serum</strong>
              Tumpukan minyak dan sel kulit mati membuat serum mahal hanya mengendap di luar pori.
            </p>
          </div>
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/masalah-garis-senyum-wajah-kusam.webp`}
              alt="Close-up wajah lelah dengan garis senyum dalam dan pori tampak besar kusam"
              width="315"
              height="210"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <p class="dsw-photo-caption">
              <strong style="color: #be123c; display: block;">Sabun Keras Mempercepat Kerutan</strong>
              Sabun cuci muka yang membuat wajah kesat ketarik justru merusak kolagen di sekitar mulut & mata.
            </p>
          </div>
        </div>

        <div class="dsw-list">
          <div class="dsw-list-row">
            <span class="dsw-icon-warn">
              <Icon name="lucide:triangle-alert" class="size-4" aria-hidden="true" />
            </span>
            <p class="dsw-list-text">
              Serum terasa <strong style="color: #be123c;">lama meresap dan meninggalkan rasa lengket</strong> di permukaan wajah.
            </p>
          </div>
          <div class="dsw-list-row">
            <span class="dsw-icon-warn">
              <Icon name="lucide:triangle-alert" class="size-4" aria-hidden="true" />
            </span>
            <p class="dsw-list-text">
              Garis senyum dan kerutan halus <strong style="color: #be123c;">makin terlihat tegas sehabis mencuci muka</strong>.
            </p>
          </div>
          <div class="dsw-list-row">
            <span class="dsw-icon-warn">
              <Icon name="lucide:triangle-alert" class="size-4" aria-hidden="true" />
            </span>
            <p class="dsw-list-text">
              Wajah tampak <strong style="color: #be123c;">kusam keabu-abuan dan kurang bercahaya</strong> meski sudah istirahat cukup.
            </p>
          </div>
        </div>
      </section>

      <!-- Section 4: Perbandingan Visual Sebelum vs Sesudah -->
      <section class="dsw-section">
        <h2 class="dsw-h2">
          Perbandingan kulit <span class="dsw-hl-aqua">sebelum vs sesudah rutin</span>
        </h2>
        <p class="dsw-sub">Ketika pembersihan pori lembut dipadukan langsung dengan booster energi seluler NAD+.</p>

        <div class="dsw-photo-stack">
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/kondisi-kusam-pori-tersumbat-kendur.webp`}
              alt="Kondisi pipi dengan pori tersumbat kusam dan garis senyum tegas sebelum perawatan"
              width="648"
              height="432"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <span class="dsw-photo-badge dsw-photo-badge--before">Sebelum Clean & Glow Duo</span>
            <p class="dsw-photo-caption">
              Pori tampak kusam tersumbat, kontur pipi mulai turun, dan lipatan garis senyum terlihat jelas.
            </p>
          </div>

          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/kondisi-bersih-kencang-bercahaya.webp`}
              alt="Kondisi pipi bersih, pori tampak halus, dan kontur wajah terasa kencang setelah rutin memakai Clean & Glow Duo"
              width="648"
              height="432"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <span class="dsw-photo-badge dsw-photo-badge--after">Rutin Clean & Glow Duo</span>
            <p class="dsw-photo-caption">
              Pori tampak bersih segar, kulit terasa lebih kencang padat, dan wajah tampak cerah bercahaya.
            </p>
          </div>
        </div>
      </section>

      <!-- Section 5: Dark Marine Section — Cara Pakai Praktis -->
      <section class="dsw-section dsw-section--dark">
        <h2 class="dsw-h2">
          Urutan Pakai <span style="color: #99e2ec;">2 Langkah Pagi & Malam</span>
        </h2>
        <p class="dsw-sub">Sangat praktis untuk memulai perawatan pengencangan wajah harian.</p>

        <div class="dsw-photo-stack">
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/cara-pakai-clean-step1-wash.webp`}
              alt="Langkah 1: Cuci wajah dengan Deep Sea Water Facial Wash Gel 100ml"
              width="648"
              height="432"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <p class="dsw-photo-caption">
              <strong style="color: #ffffff;">Langkah 1 (Bersihkan Pori Tanpa Ketarik):</strong> Pijat lembut busa halus Facial Wash Gel ke wajah yang basah selama 30 detik, lalu bilas bersih.
            </p>
          </div>
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/cara-pakai-clean-step2-nad-serum.webp`}
              alt="Langkah 2: Teteskan dan pijat NAD+ Booster Serum ke arah atas"
              width="648"
              height="432"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <p class="dsw-photo-caption">
              <strong style="color: #ffffff;">Langkah 2 (Kencangkan Kontur Wajah):</strong> Teteskan 3–4 tetes NAD+ Booster Serum dan pijat lembut ke arah atas mengikuti garis rahang & tulang pipi.
            </p>
          </div>
        </div>

        <div class="dsw-list">
          <div class="dsw-list-row">
            <span class="dsw-step-num">1</span>
            <p class="dsw-step-text">
              <strong style="color: #ffffff;">Tahap 1 — Facial Wash Gel (100 ml):</strong> Membuka pori yang bersih dan segar dengan 5% Niacinamide.
            </p>
          </div>
          <div class="dsw-list-row">
            <span class="dsw-step-num">2</span>
            <p class="dsw-step-text">
              <strong style="color: #ffffff;">Tahap 2 — NAD+ Booster Serum (20 ml):</strong> <strong style="color: #ffffff; background: #104452; padding: 1px 6px; border-radius: 4px;">Mengencangkan garis halus</strong> saat pori sedang siap menyerap nutrisi.
            </p>
          </div>
          <div class="dsw-list-row">
            <span class="dsw-step-num">3</span>
            <p class="dsw-step-text">
              Dapat langsung dilanjutkan dengan pelembap atau sunscreen yang sudah Anda miliki di rumah.
            </p>
          </div>
        </div>
      </section>

      <!-- Section 6: Ulasan Pelanggan -->
      <section class="dsw-section">
        <h2 class="dsw-h2">
          Pengalaman pelanggan <span class="dsw-hl-aqua">Paket Clean & Glow Duo</span>
        </h2>
        <p class="dsw-sub">Paket starter anti-aging favorit dengan harga hemat Rp18.000.</p>

        <div class="dsw-reviews-divide">
          <div class="dsw-review-row">
            <div class="dsw-review-head">
              <div>
                <p class="dsw-review-author">
                  Ibu Maya R.
                  <span style="color: #0b6e7d; display: inline-flex;">
                    <Icon name="lucide:badge-check" class="size-4" aria-hidden="true" />
                  </span>
                </p>
                <p class="dsw-review-meta">Jakarta Pusat • Usia 39 Tahun</p>
              </div>
              <RatingStars rating={5} starClass="h-3.5 w-3.5 !fill-[#d97706] !text-[#d97706]" />
            </div>
            <p class="dsw-review-quote">
              "Sabunnya lembut banget gak bikin kesat, terus langsung dipakein NAD+ Serum <span class="dsw-hl-aqua">nyerepnya cepet luar biasa dan bikin pipi berasa kencang</span>."
            </p>
          </div>
          <div class="dsw-review-row">
            <div class="dsw-review-head">
              <div>
                <p class="dsw-review-author">
                  Bunda Eka N.
                  <span style="color: #0b6e7d; display: inline-flex;">
                    <Icon name="lucide:badge-check" class="size-4" aria-hidden="true" />
                  </span>
                </p>
                <p class="dsw-review-meta">Tangerang • Usia 41 Tahun</p>
              </div>
              <RatingStars rating={5} starClass="h-3.5 w-3.5 !fill-[#d97706] !text-[#d97706]" />
            </div>
            <p class="dsw-review-quote">
              "Cocok buat yang udah punya pelembap di rumah tapi pengen upgrade sabun sama serum anti-aging. <strong style="color: #0f172a;">Garis senyum saya jauh lebih halus</strong> dan <span class="dsw-hl-aqua">muka cerah gak kusam lagi</span>."
            </p>
          </div>
          <div class="dsw-review-row">
            <div class="dsw-review-head">
              <div>
                <p class="dsw-review-author">
                  Ibu Lia S.
                  <span style="color: #0b6e7d; display: inline-flex;">
                    <Icon name="lucide:badge-check" class="size-4" aria-hidden="true" />
                  </span>
                </p>
                <p class="dsw-review-meta">Bandung • Hemat Rp18.000</p>
              </div>
              <RatingStars rating={5} starClass="h-3.5 w-3.5 !fill-[#d97706] !text-[#d97706]" />
            </div>
            <p class="dsw-review-quote">
              "Cuma 160 ribu udah dapet Facial Wash 100ml sama NAD+ Serum. <span class="dsw-hl-rose">Hemat 18 ribu daripada beli pisah</span> dan <span class="dsw-hl-aqua">kualitasnya berasa klinik mahal</span>."
            </p>
          </div>
        </div>
      </section>

      <!-- Section 7: Galeri Bukti Visual -->
      <section class="dsw-section dsw-section--tint">
        <h2 class="dsw-h2">
          Duo praktis untuk <span style="color: #0b6e7d;">wajah bersih & kencang</span>
        </h2>
        <p class="dsw-sub">Bebas rasa ketarik setelah mencuci muka dan bebas lengket saat memakai serum.</p>

        <div class="dsw-photo-grid-2">
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/bukti-tekstur-duo-clean-glow.webp`}
              alt="Swatch 2 tekstur Clean & Glow Duo: gel pembersih jernih dan serum emulsi lembut"
              width="315"
              height="210"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
          </div>
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/bukti-wanita-38an-segar-kencang.webp`}
              alt="Potret wanita berhijab usia 39 tahun dengan wajah bersih, segar, dan kencang"
              width="315"
              height="210"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
          </div>
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/bukti-pipi-bersih-elastis.webp`}
              alt="Close-up pipi bersih berpori halus dan tampak elastis"
              width="315"
              height="210"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
          </div>
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/bukti-meja-rias-clean-and-glow.webp`}
              alt="Paket Clean & Glow Duo Numa Skin di meja wastafel marmer"
              width="315"
              height="210"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
          </div>
        </div>
      </section>

      <!-- Section 8: Product Knowledge (Full-Bleed Figures) -->
      <section class="dsw-section dsw-section--knowledge">
        <h2 class="dsw-h2">
          Sains di balik <span class="dsw-hl-aqua">Clean & Glow Duo</span>
        </h2>
        <p class="dsw-sub">
          Memadukan pembersih pencerah 5% Niacinamide dengan teknologi Swiss RejuveNAD™ dan 6X Peptide.
        </p>

        <div class="dsw-figure-stack">
          <figure class="dsw-figure">
            <div class="dsw-figure-bleed">
              <img
                src={`${IMG_BASE}/formulasi-bersih-pori-nad-booster.webp`}
                alt="Formulasi Ulleung Deep Sea Water dengan kecambah bunga matahari RejuveNAD dan Centella"
                width="720"
                height="480"
                class="dsw-figure-img"
                loading="lazy"
                fetchpriority="low"
                decoding="async"
              />
            </div>
            <figcaption class="dsw-figcaption">
              <h3 class="dsw-figcaption-title">Low-pH Pore Prep + Cellular NAD+ Revival</h3>
              <p class="dsw-figcaption-desc">
                Pembersihan lembut menjaga pH alami kulit sehingga 2% RejuveNAD™ dapat langsung bekerja memulihkan vitalitas seluler.
              </p>
            </figcaption>
          </figure>
          <figure class="dsw-figure">
            <div class="dsw-figure-bleed">
              <img
                src={`${IMG_BASE}/kandungan-niacinamide-rejuvenad-peptide.webp`}
                alt="Kandungan 5% Niacinamide, 2% RejuveNAD, 6X Peptide Complex, dan 4X Centella"
                width="720"
                height="480"
                class="dsw-figure-img"
                loading="lazy"
                fetchpriority="low"
                decoding="async"
              />
            </div>
            <figcaption class="dsw-figcaption">
              <h3 class="dsw-figcaption-title">5% Niacinamide + 2% RejuveNAD™ + 6X Peptide</h3>
              <p class="dsw-figcaption-desc">
                Sinergi pencerah kusam dan pengontrol sebum di tahap cuci muka dengan 6 peptida pengencang di tahap serum.
              </p>
            </figcaption>
          </figure>
          <figure class="dsw-figure">
            <div class="dsw-figure-bleed">
              <img
                src={`${IMG_BASE}/kemasan-clean-and-glow-duo.webp`}
                alt="Kemasan resmi Paket Clean & Glow Duo Numa Skin terdaftar BPOM"
                width="720"
                height="480"
                class="dsw-figure-img"
                loading="lazy"
                fetchpriority="low"
                decoding="async"
              />
            </div>
            <figcaption class="dsw-figcaption">
              <h3 class="dsw-figcaption-title">2 Produk Full-Size Resmi BPOM (Hemat Rp18.000)</h3>
              <p class="dsw-figcaption-desc">
