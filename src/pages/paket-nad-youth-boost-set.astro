---
import BaseLayout from '../layouts/BaseLayout.astro';
import GeoIpResolvedForm from '../components/storefront/forms/GeoIpResolvedForm.astro';
import MetaLandingTracker from '../components/storefront/tracking/MetaLandingTracker.astro';
import Icon from '../components/storefront/shared/Icon.astro';
import RatingStars from '../components/storefront/shared/RatingStars.astro';
import { getStorefrontProduct } from '../lib/catalog';
import { nativeLandingCanonicalPath } from '../lib/landing-pages';
import { defaultCatalogContentId } from '../lib/catalog-feed';
import { getRuntimeEnv } from '../lib/env';
import { loadStoreCodDisabledProvinceCodes } from '../lib/form-mode';
import { getStoreAdsConfig } from '../lib/store-ads';
import '../styles/form-hybrid.css';
import '../styles/landing-pages/paket-nad-youth-boost-set.css';

export const prerender = false;

const PRODUCT_SLUG = 'paket-nad-youth-boost-set';
const LANDING_SLUG = 'paket-nad-youth-boost-set';
const PAGE_TITLE =
  'Paket NAD+ Youth Boost Set — Duo Anti-Aging Pengencang & Anti-Kerutan BPOM';
const PAGE_DESC =
  'Paket intensif anti-penuaan Numa Skin: NAD+ Booster Serum (2% RejuveNAD + 6X Peptide) & Adenosine Moisturizer (11X Hyaluronic Acid) untuk merawat kerutan dalam dan pipi kendur (BPOM Resmi).';
const IMG_BASE = '/images/landing/paket-nad-youth-boost-set';
const HERO_IMAGE = `${IMG_BASE}/hero-paket-nad-youth-boost.webp`;

const database = getRuntimeEnv(Astro.locals)?.OMS_DB as D1Database | undefined;
const claimedProductSlug = Astro.request.headers.get('x-adsbook-product-page');
const [product, canonicalPath, codDisabledProvinceCodes] = await Promise.all([
  getStorefrontProduct(Astro.locals, PRODUCT_SLUG),
  claimedProductSlug
    ? Promise.resolve(`/produk/${claimedProductSlug}`)
    : nativeLandingCanonicalPath(Astro.locals, LANDING_SLUG),
  loadStoreCodDisabledProvinceCodes(database),
  getStoreAdsConfig(Astro.locals),
]);
if (!product) {
  return Astro.rewrite('/404');
}

const canonical = `${Astro.locals.tenant.siteUrl}${canonicalPath}`;

const variants = product.variants || [];
const cheapestVariant = variants.reduce(
  (min: any, v: any) => (!min || v.price < min.price ? v : min),
  variants[0]
);
const defaultVariant = cheapestVariant || {
  id: '33',
  label: 'NAD+ Serum 20ml + Adenosine 30gr',
  price: 169000,
  comparePrice: 187998,
};
---

<BaseLayout
  title={PAGE_TITLE}
  description={PAGE_DESC}
  image={HERO_IMAGE}
  preloadImages={HERO_IMAGE}
  canonical={canonical}
  hideHeader={true}
  hideFooter={true}
>
  <MetaLandingTracker
    slug={LANDING_SLUG}
    contentId={defaultCatalogContentId(product)}
    contentName={product.contentName}
    price={defaultVariant.price}
  />

  <div class="dsw-shell">
    <main class="dsw-canvas">
      <!-- Section 1: Hero -->
      <section id="hero-section" class="dsw-hero">
        <div class="dsw-hero-head">
          <h1 class="dsw-h1">
            <span class="dsw-hl-tilt">Pipi Mulai Turun</span> & Lipatan Senyum Makin Dalam di Usia 35–50 Tahun?
          </h1>
          <p class="dsw-sub" style="max-width: 390px; margin: 14px auto 0; font-weight: 700;">
            Memakai serum pengencang tanpa dikunci pelembap membuat nutrisi menguap.<br />
            <span class="dsw-underline-teal">Padatkan kontur wajah dengan Duo 2% NAD+ Peptide & Adenosine!</span>
          </p>
        </div>

        <div class="dsw-hero-stage">
          <div class="dsw-hero-top-tag">
            <div class="dsw-hero-top-pill">
              <Icon name="lucide:award" class="size-3.5" aria-hidden="true" />
              <span>Duo Intensif Anti-Kerutan • Hemat Rp19.000</span>
            </div>
          </div>

          <img
            src={HERO_IMAGE}
            alt="Perbandingan wajah kendur dan garis senyum dalam vs kontur pipi kencang kenyal dengan Paket NAD+ Youth Boost Set Numa Skin"
            width="720"
            height="480"
            class="dsw-hero-img"
            fetchpriority="high"
            loading="eager"
            decoding="async"
          />

          <div class="dsw-hero-overlap">
            <div class="dsw-hero-overlap-inner">
              <h2 class="dsw-hero-overlap-title">Jangan Biarkan Serum Mahal Anda Menguap!</h2>
              <p class="dsw-hero-overlap-text">
                Di usia 35+, <strong style="color: #be123c;">energi seluler NAD+ anjlok 50% dan penguapan air kulit meningkat drastis</strong> sehingga serum tunggal tidak cukup menahan gravitasi pipi.
              </p>
            </div>
          </div>
        </div>

        <div class="dsw-trust-row">
          <div class="dsw-trust-item">
            <span class="dsw-trust-icon">
              <Icon name="lucide:shield-check" class="size-4" aria-hidden="true" />
            </span>
            <div>
              <span class="dsw-trust-label">BPOM Resmi</span>
              <span class="dsw-trust-sub">2 Izin Edar</span>
            </div>
          </div>
          <div class="dsw-trust-item">
            <span class="dsw-trust-icon">
              <Icon name="lucide:badge-check" class="size-4" aria-hidden="true" />
            </span>
            <div>
              <span class="dsw-trust-label">Halal RI</span>
              <span class="dsw-trust-sub">Aman Bumil</span>
            </div>
          </div>
          <div class="dsw-trust-item">
            <span class="dsw-trust-icon">
              <Icon name="lucide:truck" class="size-4" aria-hidden="true" />
            </span>
            <div>
              <span class="dsw-trust-label">Bisa COD</span>
              <span class="dsw-trust-sub">Bayar Kurir</span>
            </div>
          </div>
        </div>
      </section>

      <!-- Section 2: Solusi Singkat + Visual -->
      <section class="dsw-section">
        <h2 class="dsw-h2">
          Teknik <span class="dsw-hl-aqua">Double Anti-Aging Lock</span> tanpa prosedur suntik
        </h2>
        <p class="dsw-sub">Serum membangkitkan energi kolagen di dalam, pelembap mengunci elastisitas di luar.</p>

        <div class="dsw-photo-stack">
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/solusi-lifting-kunci-kelembapan.webp`}
              alt="Wanita Indonesia usia 41 tahun dengan kulit pipi yang kencang, padat, dan bercahaya sehat"
              width="648"
              height="432"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
          </div>
        </div>

        <div class="dsw-list">
          <div class="dsw-list-row">
            <span class="dsw-icon-teal">
              <Icon name="lucide:layers" class="size-4" aria-hidden="true" />
            </span>
            <p class="dsw-list-text">
              <strong style="color: #0f172a;">NAD+ Booster Serum:</strong> Mengandung 2% RejuveNAD™ (Mibelle Swiss), 6X Peptide Complex, & 4% Niacinamide untuk merawat kekencangan kontur wajah.
            </p>
          </div>
          <div class="dsw-list-row">
            <span class="dsw-icon-teal">
              <Icon name="lucide:droplets" class="size-4" aria-hidden="true" />
            </span>
            <p class="dsw-list-text">
              <strong style="color: #0f172a;">Adenosine Moisturizer (30 gr):</strong> Mengunci serum dengan 0.04% Adenosine, 1% Skin Communicator™, Alpha-Arbutin, dan 11X Hyaluronic Acid.
            </p>
          </div>
          <div class="dsw-list-row">
            <span class="dsw-icon-teal">
              <Icon name="lucide:shield-check" class="size-4" aria-hidden="true" />
            </span>
            <p class="dsw-list-text">
              <strong style="color: #0f172a;">Hemat Rp18.998:</strong> Harga normal satuan Rp187.998, kini cukup Rp169.000 untuk paket intensif pagi & malam.
            </p>
          </div>
        </div>
      </section>

      <!-- Section 3: Tanda Masalah Kulit + Visual Grid -->
      <section class="dsw-section dsw-section--warn">
        <h2 class="dsw-h2">
          Tanda kulit usia 35+ butuh <span class="dsw-underline-warn">kombinasi Serum + Moisturizer</span>:
        </h2>

        <div class="dsw-photo-grid-2">
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/masalah-serum-menguap-kering.webp`}
              alt="Kulit pipi tetap terasa kering dan berkerut karena serum tidak dikunci dengan pelembap"
              width="315"
              height="210"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <p class="dsw-photo-caption">
              <strong style="color: #be123c; display: block;">Serum Menguap di AC</strong>
              Tanpa pelembap pengunci, hidrasi serum hilang dalam 2 jam.
            </p>
          </div>
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/masalah-garis-senyum-40an.webp`}
              alt="Lipatan garis senyum nasolabial dan kerutan sudut mata yang makin tegas di usia 40-an"
              width="315"
              height="210"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <p class="dsw-photo-caption">
              <strong style="color: #be123c; display: block;">Kontur Pipi Kendur</strong>
              Garis senyum dan bawah mata tampak cekung membuat wajah terlihat lelah.
            </p>
          </div>
        </div>

        <div class="dsw-list">
          <div class="dsw-list-row">
            <span class="dsw-icon-warn">
              <Icon name="lucide:triangle-alert" class="size-4" aria-hidden="true" />
            </span>
            <p class="dsw-list-text">
              Sudah pakai serum tapi <strong style="color: #be123c;">kulit kembali terasa kering kaku</strong> saat bangun pagi atau berada di ruang ber-AC.
            </p>
          </div>
          <div class="dsw-list-row">
            <span class="dsw-icon-warn">
              <Icon name="lucide:triangle-alert" class="size-4" aria-hidden="true" />
            </span>
            <p class="dsw-list-text">
              Garis lipatan dari hidung ke bibir (<strong style="color: #be123c;">smile lines</strong>) dan kerutan ekor mata semakin dalam saat tersenyum.
            </p>
          </div>
          <div class="dsw-list-row">
            <span class="dsw-icon-warn">
              <Icon name="lucide:triangle-alert" class="size-4" aria-hidden="true" />
            </span>
            <p class="dsw-list-text">
              Muncul <strong style="color: #be123c;">flek penuaan kecokelatan di tulang pipi</strong> yang disertai berkurangnya kekenyalan kulit.
            </p>
          </div>
        </div>
      </section>

      <!-- Section 4: Perbandingan Visual Sebelum vs Sesudah -->
      <section class="dsw-section">
        <h2 class="dsw-h2">
          Perbandingan visual <span class="dsw-hl-aqua">perawatan 42 hari</span>
        </h2>
        <p class="dsw-sub">Transformasi kepadatan kulit, garis halus, dan kecerahan dengan pemakaian teratur.</p>

        <div class="dsw-photo-stack">
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/kondisi-kerutan-dalam-kendur.webp`}
              alt="Kondisi kulit usia 40-an dengan garis senyum tegas, kerutan sudut mata, dan flek sebelum perawatan"
              width="648"
              height="432"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <span class="dsw-photo-badge dsw-photo-badge--before">Sebelum</span>
            <p class="dsw-photo-caption">
              Elastisitas menurun, garis lipatan senyum tampak dalam, dan bercak penuaan membuat wajah tampak lebih tua dari usia asli.
            </p>
          </div>

          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/kondisi-wajah-kencang-membal.webp`}
              alt="Kondisi kulit pipi tampak padat kencang, garis halus tersamarkan, dan bercahaya setelah rutin memakai Youth Boost Set"
              width="648"
              height="432"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <span class="dsw-photo-badge dsw-photo-badge--after">Sesudah Rutin</span>
            <p class="dsw-photo-caption">
              Kontur pipi terasa jauh lebih padat membal, garis senyum & kerutan mata tersamarkan, serta rona kulit tampak cerah segar.
            </p>
          </div>
        </div>
      </section>

      <!-- Section 5: Dark Marine Section — Cara Pakai Praktis -->
      <section class="dsw-section dsw-section--dark">
        <h2 class="dsw-h2">
          Ritual <span style="color: #99e2ec;">2-Step Youth Lock</span> Pagi & Malam
        </h2>
        <p class="dsw-sub">Cukup 2 menit untuk menutrisi kolagen sekaligus mengunci kelembapan 24 jam.</p>

        <div class="dsw-photo-stack">
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/cara-pakai-step1-tetes-nad.webp`}
              alt="Langkah 1 meneteskan NAD+ Booster Serum ke telapak tangan dan memijat ke arah atas"
              width="648"
              height="432"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <p class="dsw-photo-caption">
              <strong style="color: #ffffff;">Langkah 1 (Nutrisi Inti — NAD+ Serum):</strong> Teteskan 3–4 tetes serum, pijat lembut ke arah atas di garis rahang & pipi.
            </p>
          </div>

          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/cara-pakai-step2-kunci-adenosine.webp`}
              alt="Langkah 2 mengunci nutrisi serum dengan Adenosine Deep Sea Water Moisturizer"
              width="648"
              height="432"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <p class="dsw-photo-caption">
              <strong style="color: #ffffff;">Langkah 2 (Kunci Hidrasi — Adenosine):</strong> Tekan 1–2 pump pelembap gel-cream untuk menyegel seluruh bahan aktif.
            </p>
          </div>
        </div>

        <div class="dsw-list">
          <div class="dsw-list-row">
            <span class="dsw-step-num">1</span>
            <p class="dsw-step-text">
              Gunakan berurutan <strong style="color: #ffffff;">setiap pagi dan malam hari</strong> setelah wajah dibersihkan.
            </p>
          </div>
          <div class="dsw-list-row">
            <span class="dsw-step-num">2</span>
            <p class="dsw-step-text">
              Beri jeda <strong style="color: #ffffff; background: #104452; padding: 1px 6px; border-radius: 4px;">15–20 detik setelah serum</strong> sebelum mengoleskan Adenosine Moisturizer.
            </p>
          </div>
          <div class="dsw-list-row">
            <span class="dsw-step-num">3</span>
            <p class="dsw-step-text">
              Bebas retinol keras dan bebas asam pengelupas sehingga <strong style="color: #ffffff;">nyaman dipakai tiap hari tanpa rasa perih</strong>.
            </p>
          </div>
        </div>
      </section>

      <!-- Section 6: Ulasan Pelanggan -->
      <section class="dsw-section">
        <h2 class="dsw-h2">
          Kisah Bunda usia 35–55 tahun <span class="dsw-hl-aqua">setelah rutin memakai</span>
        </h2>
        <p class="dsw-sub">Kombinasi favorit untuk merawat elastisitas kulit matang secara aman.</p>

        <div class="dsw-reviews-divide">
          <div class="dsw-review-row">
            <div class="dsw-review-head">
              <div>
                <p class="dsw-review-author">
                  Ibu Hendrawati
                  <span style="color: #0b6e7d; display: inline-flex;">
                    <Icon name="lucide:badge-check" class="size-4" aria-hidden="true" />
                  </span>
                </p>
                <p class="dsw-review-meta">Jakarta Barat • Usia 46 Tahun</p>
              </div>
              <RatingStars rating={5} starClass="h-3.5 w-3.5 !fill-[#d97706] !text-[#d97706]" />
            </div>
            <p class="dsw-review-quote">
              "Masuk umur 45 pipi mulai kelihatan turun dan garis senyum dalam banget. Pakai paket NAD+ sama Adenosine ini rutin sebulan, <span class="dsw-hl-aqua">kulit berasa lebih padat kencang dan bangun pagi muka kenyal banget</span>."
            </p>
          </div>

          <div class="dsw-review-row">
            <div class="dsw-review-head">
              <div>
                <p class="dsw-review-author">
                  Ibu Yuniarti S.
                  <span style="color: #0b6e7d; display: inline-flex;">
                    <Icon name="lucide:badge-check" class="size-4" aria-hidden="true" />
                  </span>
                </p>
                <p class="dsw-review-meta">Bandung • Kulit Sensitif Tidak Kuat Retinol</p>
              </div>
              <RatingStars rating={5} starClass="h-3.5 w-3.5 !fill-[#d97706] !text-[#d97706]" />
            </div>
            <p class="dsw-review-quote">
              "Kulit saya gak kuat pakai retinol karena langsung merah mengelupas. <strong style="color: #0f172a;">Duo NAD+ dan Adenosine ini penyelamat banget</strong>, <span class="dsw-hl-aqua">kerutan halus sekitar mata memudar tanpa iritasi sedikitpun</span>."
            </p>
          </div>

          <div class="dsw-review-row">
            <div class="dsw-review-head">
              <div>
                <p class="dsw-review-author">
                  Ibu Melani T.
                  <span style="color: #0b6e7d; display: inline-flex;">
                    <Icon name="lucide:badge-check" class="size-4" aria-hidden="true" />
                  </span>
                </p>
                <p class="dsw-review-meta">Medan • Repeat Order Paket ke-2</p>
              </div>
              <RatingStars rating={5} starClass="h-3.5 w-3.5 !fill-[#d97706] !text-[#d97706]" />
            </div>
            <p class="dsw-review-quote">
              "Serumnya cepat meresap, terus langsung dikunci pakai gel Adenosine yang dingin. <span class="dsw-hl-rose">Flek hitam memudar dan pori-pori pipi jadi rapet</span>. <span class="dsw-hl-aqua">Teman-teman arisan sampai nanya pakai perawatan apa</span>."
            </p>
          </div>
        </div>
      </section>

      <!-- Section 7: Galeri Bukti Visual -->
      <section class="dsw-section dsw-section--tint">
        <h2 class="dsw-h2">
          Perpaduan tekstur <span style="color: #0b6e7d;">silky serum & cooling gel-cream</span>
        </h2>
        <p class="dsw-sub">Meresap cepat ke lapisan epidermis tanpa meninggalkan rasa berminyak di bantal.</p>

        <div class="dsw-photo-grid-2">
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/bukti-tekstur-layering-serum-gel.webp`}
              alt="Tekstur milky-watery NAD+ Booster Serum dan cooling gel-cream Adenosine Moisturizer di kulit"
              width="315"
              height="210"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
          </div>
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/bukti-ibu-40an-tampak-muda.webp`}
              alt="Potret wanita Indonesia usia 42 tahun berhijab dengan wajah kencang awet muda"
              width="315"
              height="210"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
          </div>
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/bukti-pipi-padat-garis-halus.webp`}
              alt="Close-up kontur tulang pipi yang padat kenyal dan area mata yang halus"
              width="315"
              height="210"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
          </div>
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/bukti-meja-rias-youth-boost.webp`}
              alt="Kemasan Paket NAD+ Youth Boost Set di atas meja rias marmer"
              width="315"
              height="210"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
          </div>
        </div>
      </section>

      <!-- Section 8: Product Knowledge (Full-Bleed Figures) -->
      <section class="dsw-section dsw-section--knowledge">
        <h2 class="dsw-h2">
          Sains di balik <span class="dsw-hl-aqua">NAD+ Youth Boost Set</span>
        </h2>
        <p class="dsw-sub">
          Menggabungkan bioteknologi peremajaan seluler Swiss dengan molekul anti-kerut berstandar KFDA Korea.
        </p>

        <div class="dsw-figure-stack">
          <figure class="dsw-figure">
            <div class="dsw-figure-bleed">
              <img
                src={`${IMG_BASE}/formulasi-sinergi-nad-adenosine.webp`}
                alt="Sinergi bioteknologi kecambah bunga matahari Swiss RejuveNAD, alga merah, dan Ulleung Deep Sea Water"
                width="720"
                height="480"
                class="dsw-figure-img"
                loading="lazy"
                fetchpriority="low"
                decoding="async"
              />
            </div>
            <figcaption class="dsw-figcaption">
              <h3 class="dsw-figcaption-title">2% Swiss RejuveNAD™ & 1% Skin Communicator™</h3>
              <p class="dsw-figcaption-desc">
                Mengaktifkan kembali enzim umur panjang seluler (Sirtuin/NAMPT) sekaligus memulihkan komunikasi antar-sel untuk menjaga kepadatan matriks kolagen.
              </p>
            </figcaption>
          </figure>

          <figure class="dsw-figure">
            <div class="dsw-figure-bleed">
              <img
                src={`${IMG_BASE}/kandungan-rejuvenad-peptide-ha.webp`}
                alt="Kombinasi 6X Peptide Complex, 0.04% Adenosine, 15X Hyaluronic Acid, dan Alpha-Arbutin"
                width="720"
                height="480"
                class="dsw-figure-img"
                loading="lazy"
                fetchpriority="low"
                decoding="async"
              />
            </div>
            <figcaption class="dsw-figcaption">
              <h3 class="dsw-figcaption-title">6X Peptide + Adenosine + Multi-Molecular Hyaluronic</h3>
              <p class="dsw-figcaption-desc">
                Enam jenis peptida biomimetik bekerja bersama Adenosine untuk merilekskan kerutan ekspresi, sementara kombinasi 4D + 11X Hyaluronic Acid mengisi cekungan garis halus.
              </p>
            </figcaption>
          </figure>

          <figure class="dsw-figure">
            <div class="dsw-figure-bleed">
              <img
                src={`${IMG_BASE}/kemasan-duo-nad-adenosine.webp`}
                alt="Kemasan resmi Paket NAD+ Booster Serum dan Adenosine Deep Sea Water Moisturizer 30g"
                width="720"
                height="480"
                class="dsw-figure-img"
                loading="lazy"
                fetchpriority="low"
                decoding="async"
              />
            </div>
