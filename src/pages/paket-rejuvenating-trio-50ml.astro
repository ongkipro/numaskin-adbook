---
import BaseLayout from '../layouts/BaseLayout.astro';
import GeoIpResolvedForm from '../components/storefront/forms/GeoIpResolvedForm.astro';
import MetaLandingTracker from '../components/storefront/tracking/MetaLandingTracker.astro';
import Icon from '../components/storefront/shared/Icon.astro';
import RatingStars from '../components/storefront/shared/RatingStars.astro';
import { getStorefrontProduct } from '../lib/catalog';
import { nativeLandingCanonicalPath } from '../lib/landing-pages';
import { defaultCatalogContentId } from '../lib/catalog-feed';
import { getRuntimeEnv } from '../lib/env';
import { loadStoreCodDisabledProvinceCodes } from '../lib/form-mode';
import { getStoreAdsConfig } from '../lib/store-ads';
import '../styles/form-hybrid.css';
import '../styles/landing-pages/paket-rejuvenating-trio-50ml.css';

export const prerender = false;

const PRODUCT_SLUG = 'paket-rejuvenating-trio-50ml';
const LANDING_SLUG = 'paket-rejuvenating-trio-50ml';
const PAGE_TITLE = 'Paket Rejuvenating Trio 50ml - Trio Regenerasi Malam Toner, NAD+ & Adenosine BPOM';
const PAGE_DESC = 'Rangkaian 3 langkah peremajaan kulit ukuran praktis: Deep Sea Water Treatment Lotion 50ml (NA18220101400), NAD+ Booster Serum 20ml (NA18262000245), dan Adenosine Moisturizer 30gr (NA18250109281).';
const IMG_BASE = '/images/landing/paket-rejuvenating-trio-50ml';
const HERO_IMAGE = `${IMG_BASE}/hero-paket-rejuvenating-50ml.webp`;

const database = getRuntimeEnv(Astro.locals)?.OMS_DB as D1Database | undefined;
const claimedProductSlug = Astro.request.headers.get('x-adsbook-product-page');
const [product, canonicalPath, codDisabledProvinceCodes] = await Promise.all([
  getStorefrontProduct(Astro.locals, PRODUCT_SLUG),
  claimedProductSlug
    ? Promise.resolve(`/produk/${claimedProductSlug}`)
    : nativeLandingCanonicalPath(Astro.locals, LANDING_SLUG),
  loadStoreCodDisabledProvinceCodes(database),
  getStoreAdsConfig(Astro.locals),
]);
if (!product) {
  return Astro.rewrite('/404');
}

const canonical = `${Astro.locals.tenant.siteUrl}${canonicalPath}`;

const variants = product.variants || [];
const cheapestVariant = variants.reduce(
  (min: any, v: any) => (!min || v.price < min.price ? v : min),
  variants[0]
);
const defaultVariant = cheapestVariant || {
  id: '36',
  label: 'Toner 50ml + NAD+ Serum 20ml + Adenosine 30gr',
  price: 240000,
  comparePrice: 266998,
};
---

<BaseLayout
  title={PAGE_TITLE}
  description={PAGE_DESC}
  image={HERO_IMAGE}
  preloadImages={HERO_IMAGE}
  canonical={canonical}
  hideHeader={true}
  hideFooter={true}
>
  <MetaLandingTracker
    slug={LANDING_SLUG}
    contentId={defaultCatalogContentId(product)}
    contentName={product.contentName}
    price={defaultVariant.price}
  />

  <div class="dsw-shell">
    <main class="dsw-canvas">
      <!-- Section 1: Hero -->
      <section id="hero-section" class="dsw-hero">
        <div class="dsw-hero-head">
          <h1 class="dsw-h1">
            <span class="dsw-hl-tilt">Bangun Pagi Wajah Kusam</span> & Garis Senyum Makin Terlihat Jelas?
          </h1>
          <p class="dsw-sub" style="max-width: 390px; margin: 14px auto 0; font-weight: 700;">
            Malam hari adalah waktu emas regenerasi sel kulit jika didukung hidrasi pembuka, NAD+ booster, dan pengunci Adenosine.<br />
            <span class="dsw-underline-teal">Aktifkan peremajaan kulit malam dengan Rejuvenating Trio 50ml!</span>
          </p>
        </div>

        <div class="dsw-hero-stage">
          <div class="dsw-hero-top-tag">
            <div class="dsw-hero-top-pill">
              <Icon name="lucide:award" class="size-3.5" aria-hidden="true" />
              <span>Rejuvenating Trio 50ml • Hemat Rp27rb</span>
            </div>
          </div>

          <img
            src={HERO_IMAGE}
            alt="Perbandingan kulit kering bergaris senyum vs kulit kenyal padat dengan Paket Rejuvenating Trio 50ml Numa Skin"
            width="720"
            height="480"
            class="dsw-hero-img"
            fetchpriority="high"
            loading="eager"
            decoding="async"
          />

          <div class="dsw-hero-ba" aria-hidden="true">
            <span class="dsw-hero-ba-pill dsw-hero-ba-pill--before">Garis Dalam & Kering</span>
            <span class="dsw-hero-ba-pill dsw-hero-ba-pill--after">Kenyal & Padat Pagi</span>
          </div>

          <div class="dsw-hero-trust-strip" role="list" aria-label="Jaminan kualitas Numa Skin">
            <div class="dsw-trust-item" role="listitem">
              <span class="dsw-trust-icon">
                <Icon name="lucide:shield-check" class="size-3.5" aria-hidden="true" />
              </span>
              <span class="dsw-trust-text">
                <strong class="dsw-trust-label">3 BPOM Resmi</strong>
                <span class="dsw-trust-sub">Toner, Serum & Krim</span>
              </span>
            </div>
            <div class="dsw-trust-item" role="listitem">
              <span class="dsw-trust-icon">
                <Icon name="lucide:droplets" class="size-3.5" aria-hidden="true" />
              </span>
              <span class="dsw-trust-text">
                <strong class="dsw-trust-label">RejuveNAD™</strong>
                <span class="dsw-trust-sub">6X Peptide Complex</span>
              </span>
            </div>
            <div class="dsw-trust-item" role="listitem">
              <span class="dsw-trust-icon">
                <Icon name="lucide:layers" class="size-3.5" aria-hidden="true" />
              </span>
              <span class="dsw-trust-text">
                <strong class="dsw-trust-label">Adenosine</strong>
                <span class="dsw-trust-sub">11X Hyaluronic Acid</span>
              </span>
            </div>
          </div>
        </div>

        <div class="dsw-hero-foot">
          <p class="dsw-hero-caption">
            Trio regenerasi intensif: <strong>Treatment Lotion 50ml</strong> + <strong>NAD+ Booster Serum</strong> + <strong>Adenosine Deep Sea Water Moisturizer 30gr</strong>.
          </p>
          <a href="#form-pemesanan" class="dsw-cta" data-scroll-to-form>
            <span>Ambil Rejuvenating Trio 50ml</span>
            <Icon name="lucide:arrow-right" class="size-5" aria-hidden="true" />
          </a>
        </div>
      </section>

      <!-- Section 2: Solusi Praktis -->
      <section class="dsw-section">
        <h2 class="dsw-h2">
          3 Langkah Regenerasi <span class="dsw-hl-aqua">Kompres, Angkat & Kunci</span>
        </h2>
        <p class="dsw-sub" style="margin-top: 8px;">
          Sistem 3 tahap yang memastikan nutrisi anti-aging bekerja penuh sepanjang Anda tidur:
        </p>

        <div class="dsw-solution-box">
          <img
            src={`${IMG_BASE}/solusi-tiga-tahap-regenerasi-50ml.webp`}
            alt="Wanita Indonesia usia 38 tahun dengan kulit wajah kenyal membal di pagi hari"
            width="648"
            height="432"
            class="dsw-solution-img"
            loading="lazy"
            fetchpriority="low"
            decoding="async"
          />

          <div class="dsw-check-list">
            <div class="dsw-check-item">
              <span class="dsw-icon-green">
                <Icon name="lucide:check" class="size-3.5" aria-hidden="true" />
              </span>
              <p class="dsw-list-text"><strong>Tahap 1 — Treatment Lotion 50ml:</strong> 76% Air Laut Dalam Ulleungdo dan Galactomyces melembutkan pori agar bahan aktif berikutnya terserap sempurna.</p>
            </div>
            <div class="dsw-check-item">
              <span class="dsw-icon-green">
                <Icon name="lucide:check" class="size-3.5" aria-hidden="true" />
              </span>
              <p class="dsw-list-text"><strong>Tahap 2 — NAD+ Booster Anti-Aging Serum:</strong> Swiss RejuveNAD™ dan 6X Peptide Complex merawat kekencangan kontur pipi serta lipatan garis senyum.</p>
            </div>
            <div class="dsw-check-item">
              <span class="dsw-icon-green">
                <Icon name="lucide:check" class="size-3.5" aria-hidden="true" />
              </span>
              <p class="dsw-list-text"><strong>Tahap 3 — Adenosine Moisturizer 30gr:</strong> Cooling gel-cream dengan Adenosine, Jania Rubens, dan 11X Hyaluronic Acid yang mengunci serum agar tidak menguap semalaman.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- Section 3: Masalah Kulit -->
      <section class="dsw-section--tinted">
        <h2 class="dsw-h2">
          Kenapa Perawatan Malam <span class="dsw-hl-coral">Kurang Terasa Hasilnya?</span>
        </h2>

        <div class="dsw-grid-2">
          <article class="dsw-card">
            <img
              src={`${IMG_BASE}/masalah-serum-mahal-tak-meresap-50ml.webp`}
              alt="Serum tidak meresap maksimal karena kulit tidak dipersiapkan dengan toner dan tidak dikunci pelembap"
              width="480"
              height="320"
              class="dsw-card-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <div class="dsw-card-body">
              <span class="dsw-badge-red">Serum Menguap di AC</span>
              <p class="dsw-card-desc">Memakai serum tanpa dibuka oleh toner dan tanpa dikunci pelembap membuat kelembapan tersedot udara AC kamar tidur.</p>
            </div>
          </article>

          <article class="dsw-card">
            <img
              src={`${IMG_BASE}/masalah-wajah-lelah-kendur-malam-50ml.webp`}
              alt="Wajah tampak lelah dengan garis senyum dan kerutan sudut mata"
              width="480"
              height="320"
              class="dsw-card-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <div class="dsw-card-body">
              <span class="dsw-badge-red">Regenerasi Melambat</span>
              <p class="dsw-card-desc">Di usia 35+, pembaruan kolagen malam hari melambat drastis bila kulit kekurangan NAD+ dan Adenosine.</p>
            </div>
          </article>
        </div>

        <div class="dsw-list-box">
          <p class="dsw-list-box-title">Tanda Anda Membutuhkan Paket Ini:</p>
          <div class="dsw-check-list" style="margin-top: 0;">
            <div class="dsw-check-item">
              <span class="dsw-icon-red">
                <Icon name="lucide:x" class="size-3.5" aria-hidden="true" />
              </span>
              <p class="dsw-list-text">Saat bangun pagi kulit wajah sering terasa kering, kusam, atau bantal meninggalkan bekas lipatan yang lama hilang</p>
            </div>
            <div class="dsw-check-item">
              <span class="dsw-icon-red">
                <Icon name="lucide:x" class="size-3.5" aria-hidden="true" />
              </span>
              <p class="dsw-list-text">Garis senyum, kerutan bawah mata, dan noda hitam bekas penuaan mulai tampak semakin nyata</p>
            </div>
            <div class="dsw-check-item">
              <span class="dsw-icon-red">
                <Icon name="lucide:x" class="size-3.5" aria-hidden="true" />
              </span>
              <p class="dsw-list-text">Ingin mendapatkan 3 produk inti peremajaan Numa Skin dengan ukuran Toner 50ml yang hemat Rp27.000</p>
            </div>
          </div>
        </div>
      </section>

      <!-- Section 4: Transformasi Nyata -->
      <section class="dsw-section">
        <h2 class="dsw-h2">
          Transformasi <span class="dsw-hl-aqua">Bangun Pagi dengan Kulit Membal</span>
        </h2>
        <p class="dsw-sub" style="margin-top: 8px;">
          Perbedaan elastisitas dan kehalusan kulit sebelum dan sesudah rutin memakai Rejuvenating Trio 50ml:
        </p>

        <div class="dsw-grid-2">
          <article class="dsw-card">
            <img
              src={`${IMG_BASE}/kondisi-kulit-kering-garis-dalam-50ml.webp`}
              alt="Kondisi kulit kering kasar dengan garis senyum dan kerutan halus sebelum perawatan"
              width="480"
              height="320"
              class="dsw-card-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <div class="dsw-card-body">
              <span class="dsw-badge-red">Sebelum Perawatan</span>
              <p class="dsw-card-desc">Tekstur pipi terasa kering kaku, garis ekspresi tampak jelas, dan wajah terlihat lebih tua dari usia asli.</p>
            </div>
          </article>

          <article class="dsw-card">
            <img
              src={`${IMG_BASE}/kondisi-bangun-pagi-kenyal-padat-50ml.webp`}
              alt="Kondisi kulit tampak kenyal, padat, halus, dan bercahaya saat bangun tidur"
              width="480"
              height="320"
              class="dsw-card-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <div class="dsw-card-body">
              <span class="dsw-badge-green">Rutin Trio 50ml</span>
              <p class="dsw-card-desc">Kulit terasa kenyal membal saat disentuh pagi hari, garis halus tampak lebih rata, dan rona wajah cerah.</p>
            </div>
          </article>
        </div>

        <div class="dsw-list-box">
          <p class="dsw-list-box-title">Tahapan Hasil Pemakaian Rutin:</p>
          <div class="dsw-check-list" style="margin-top: 0;">
            <div class="dsw-check-item">
              <span class="dsw-icon-green">
                <Icon name="lucide:check" class="size-3.5" aria-hidden="true" />
              </span>
              <p class="dsw-list-text"><strong>Minggu 1:</strong> Wajah terasa lembap kenyal setiap bangun tidur meskipun tidur di ruangan ber-AC</p>
            </div>
            <div class="dsw-check-item">
              <span class="dsw-icon-green">
                <Icon name="lucide:check" class="size-3.5" aria-hidden="true" />
              </span>
              <p class="dsw-list-text"><strong>Minggu 2–3:</strong> Tekstur kulit terasa lebih halus rapat dan tampilan kusam lelah berkurang</p>
            </div>
            <div class="dsw-check-item">
              <span class="dsw-icon-green">
                <Icon name="lucide:check" class="size-3.5" aria-hidden="true" />
              </span>
              <p class="dsw-list-text"><strong>Minggu 4–6:</strong> Garis senyum serta noda hitam tampak lebih samar dan pipi terasa lebih kencang elastis</p>
            </div>
          </div>
        </div>
      </section>

      <!-- Section 5: Cara Pakai -->
      <section class="dsw-section--tinted">
        <h2 class="dsw-h2">
          Cara Pakai <span class="dsw-hl-aqua">Praktis Setiap Hari</span>
        </h2>
        <p class="dsw-sub" style="margin-top: 8px;">
          Urutan 3 langkah setiap malam (dan pagi sebelum sunscreen):
        </p>

        <div class="dsw-grid-2">
          <article class="dsw-card">
            <img
              src={`${IMG_BASE}/cara-pakai-rejuve-50ml-step1-toner.webp`}
              alt="Menepukkan Deep Sea Water Treatment Lotion 50ml ke wajah"
              width="480"
              height="320"
              class="dsw-card-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <div class="dsw-card-body">
              <span class="dsw-badge-teal">1. Buka Jalur dengan Toner 50ml</span>
              <p class="dsw-card-desc">Tepuk lembut <strong>Treatment Lotion 50ml</strong> ke wajah bersih hingga terasa lembap sejuk.</p>
            </div>
          </article>

          <article class="dsw-card">
            <img
              src={`${IMG_BASE}/cara-pakai-rejuve-50ml-step2-serum-krim.webp`}
              alt="Mengaplikasikan NAD+ Booster Serum lalu mengunci dengan Adenosine Moisturizer"
              width="480"
              height="320"
              class="dsw-card-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <div class="dsw-card-body">
              <span class="dsw-badge-teal">2. NAD+ Serum + Kunci Adenosine</span>
              <p class="dsw-card-desc">Ratakan 3 tetes <strong>NAD+ Booster Serum</strong>, lalu kunci kelembapannya dengan <strong>Adenosine Moisturizer 30gr</strong>.</p>
            </div>
          </article>
        </div>

        <div style="margin-top: 22px; text-align: center;">
          <a href="#form-pemesanan" class="dsw-cta" data-scroll-to-form>
            <span>Pesan Rejuvenating Trio 50ml</span>
            <Icon name="lucide:arrow-right" class="size-5" aria-hidden="true" />
          </a>
        </div>
      </section>

      <!-- Section 6: Bukti Pelanggan -->
      <section class="dsw-section">
        <h2 class="dsw-h2">
          Bukti Tekstur <span class="dsw-hl-aqua">& Kepuasan Pelanggan</span>
        </h2>
        <p class="dsw-sub" style="margin-top: 8px;">
          Cerita pelanggan yang merasakan perubahan kulit saat bangun pagi dengan Rejuvenating Trio 50ml:
        </p>

        <div class="dsw-grid-2">
          <div class="dsw-proof-cell">
            <img
              src={`${IMG_BASE}/bukti-tekstur-trio-rejuvenating-50ml.webp`}
              alt="Swatch 3 tekstur Treatment Lotion, NAD+ Serum, dan Adenosine Gel-Cream di tangan"
              width="480"
              height="320"
              class="dsw-proof-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <p class="dsw-proof-OverlayCaption">3 Lapisan Lembut Cepat Meresap</p>
          </div>
          <div class="dsw-proof-cell">
            <img
              src={`${IMG_BASE}/bukti-wanita-38an-kulit-membal-50ml.webp`}
              alt="Wanita Indonesia usia 38 tahun berhijab dengan kulit wajah kenyal bercahaya"
              width="480"
              height="320"
              class="dsw-proof-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <p class="dsw-proof-OverlayCaption">Wajah Segar & Kencang di Usia 35+</p>
          </div>
          <div class="dsw-proof-cell">
            <img
              src={`${IMG_BASE}/bukti-pipi-halus-bangun-tidur-50ml.webp`}
              alt="Close-up pipi halus dan membal di pagi hari"
              width="480"
              height="320"
              class="dsw-proof-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <p class="dsw-proof-OverlayCaption">Bebas Kering Walau Tidur Ber-AC</p>
          </div>
          <div class="dsw-proof-cell">
            <img
              src={`${IMG_BASE}/bukti-meja-rias-rejuvenating-50ml.webp`}
              alt="Tiga produk Paket Rejuvenating Trio 50ml di meja rias kamar tidur"
              width="480"
              height="320"
              class="dsw-proof-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <p class="dsw-proof-OverlayCaption">Trio Malam Praktis & Hemat</p>
          </div>
        </div>

        <div class="dsw-testi-list">
          <article class="dsw-testi-card">
            <div class="dsw-testi-head">
              <div class="dsw-testi-avatar" aria-hidden="true">W</div>
              <div class="dsw-testi-meta">
                <p class="dsw-testi-name">
                  Bunda Wulan Sari (39 thn)
                  <span class="dsw-verified-pill">Verified Buyer</span>
                </p>
                <div class="dsw-stars">
                  <RatingStars rating={5} starClass="h-3.5 w-3.5 !fill-[#d97706] !text-[#d97706]" />
                </div>
              </div>
            </div>
            <p class="dsw-testi-body">"Kombinasi 3 produk ini beneran juara buat perawatan malam! Dulu pakai serum doang bangun pagi mukaku masih kering karena AC. Sekarang dibuka pakai Toner 50ml, lanjut NAD+ Serum, terus dikunci Adenosine, bangun pagi pipi berasa membal banget."</p>
            <div class="dsw-testi-foot">
              <span>Jakarta Barat</span>
              <span>•</span>
              <span>Pemakaian 5 Minggu</span>
            </div>
          </article>

          <article class="dsw-testi-card">
            <div class="dsw-testi-head">
              <div class="dsw-testi-avatar" aria-hidden="true">I</div>
              <div class="dsw-testi-meta">
                <p class="dsw-testi-name">
                  Ibu Indriani Kusuma (42 thn)
                  <span class="dsw-verified-pill">Verified Buyer</span>
                </p>
                <div class="dsw-stars">
                  <RatingStars rating={5} starClass="h-3.5 w-3.5 !fill-[#d97706] !text-[#d97706]" />
                </div>
              </div>
            </div>
            <p class="dsw-testi-body">"Garis halus di bawah mata dan lipatan senyumku jauh lebih samar sejak rutin pakai Trio ini. Harganya juga pas di kantong karena dapet 3 produk lengkap cuma Rp240.000."</p>
            <div class="dsw-testi-foot">
              <span>Palembang</span>
              <span>•</span>
              <span>Pemakaian 6 Minggu</span>
            </div>
          </article>
        </div>
      </section>

      <!-- Section 7: Tabel Perbandingan -->
      <section class="dsw-section--tinted">
        <h2 class="dsw-h2">
          Keunggulan <span class="dsw-hl-aqua">Rejuvenating Trio (50ml)</span>
        </h2>
        <p class="dsw-sub" style="margin-top: 8px;">
          Mengapa memilih Paket Rejuvenating Trio (50ml) jauh lebih hemat dan efektif dibandingkan membeli produk satuan:
        </p>

        <div class="dsw-cmp-card">
          <div class="dsw-cmp-head">
            <div class="dsw-cmp-col">Karakteristik</div>
            <div class="dsw-cmp-col dsw-cmp-col--numa">Rejuve Trio 50ml</div>
            <div class="dsw-cmp-col">Beli Satuan Biasa</div>
          </div>

          <div class="dsw-cmp-row">
            <div class="dsw-cmp-cell dsw-cmp-cell--feature">Sistem Penyerapan</div>
            <div class="dsw-cmp-cell dsw-cmp-cell--numa">
              <span class="dsw-icon-green" style="margin: 0 auto;">
                <Icon name="lucide:check" class="size-3.5" aria-hidden="true" />
              </span>
              <span class="dsw-cmp-sub">Toner Pembuka + Serum + Krim Pengunci</span>
            </div>
            <div class="dsw-cmp-cell">
              <span class="dsw-icon-red" style="margin: 0 auto;">
                <Icon name="lucide:x" class="size-3.5" aria-hidden="true" />
              </span>
              <span class="dsw-cmp-sub">Hanya 1 produk tanpa pengunci</span>
            </div>
          </div>

          <div class="dsw-cmp-row">
            <div class="dsw-cmp-cell dsw-cmp-cell--feature">Kombinasi Aktif</div>
            <div class="dsw-cmp-cell dsw-cmp-cell--numa">
              <span class="dsw-icon-green" style="margin: 0 auto;">
                <Icon name="lucide:check" class="size-3.5" aria-hidden="true" />
              </span>
