---
import BaseLayout from '../layouts/BaseLayout.astro';
import GeoIpResolvedForm from '../components/storefront/forms/GeoIpResolvedForm.astro';
import MetaLandingTracker from '../components/storefront/tracking/MetaLandingTracker.astro';
import Icon from '../components/storefront/shared/Icon.astro';
import RatingStars from '../components/storefront/shared/RatingStars.astro';
import { getStorefrontProduct } from '../lib/catalog';
import { nativeLandingCanonicalPath } from '../lib/landing-pages';
import { defaultCatalogContentId } from '../lib/catalog-feed';
import { getRuntimeEnv } from '../lib/env';
import { loadStoreCodDisabledProvinceCodes } from '../lib/form-mode';
import { getStoreAdsConfig } from '../lib/store-ads';
import '../styles/form-hybrid.css';
import '../styles/landing-pages/paket-lengkap-6-in-1-routine.css';

export const prerender = false;

const PRODUCT_SLUG = 'paket-lengkap-6-in-1-routine';
const LANDING_SLUG = 'paket-lengkap-6-in-1-routine';
const PAGE_TITLE = 'Paket Lengkap 6-in-1 Routine — Seluruh Rangkaian Anti-Aging & Pencerah Numa Skin BPOM';
const PAGE_DESC = 'Paket VIP terlengkap Numa Skin (6 Produk Full Routine): Facial Wash 100ml + Toner (50ml/150ml) + NAD+ Serum 20ml + PDRN Day Cream 30g + Adenosine Moisturizer 30g + Oxydew Sunscreen SPF 50+ 30ml (6 BPOM Resmi).';
const IMG_BASE = '/images/landing/paket-lengkap-6-in-1-routine';
const HERO_IMAGE = `${IMG_BASE}/hero-paket-lengkap-6in1.webp`;

const database = getRuntimeEnv(Astro.locals)?.OMS_DB as D1Database | undefined;
const claimedProductSlug = Astro.request.headers.get('x-adsbook-product-page');
const [product, canonicalPath, codDisabledProvinceCodes] = await Promise.all([
  getStorefrontProduct(Astro.locals, PRODUCT_SLUG),
  claimedProductSlug
    ? Promise.resolve(`/produk/${claimedProductSlug}`)
    : nativeLandingCanonicalPath(Astro.locals, LANDING_SLUG),
  loadStoreCodDisabledProvinceCodes(database),
  getStoreAdsConfig(Astro.locals),
]);
if (!product) {
  return Astro.rewrite('/404');
}

const canonical = `${Astro.locals.tenant.siteUrl}${canonicalPath}`;

const variants = product.variants || [];
const cheapestVariant = variants.reduce(
  (min: any, v: any) => (!min || v.price < min.price ? v : min),
  variants[0]
);
const defaultVariant = cheapestVariant || {
  id: '29',
  label: '6-in-1 Routine (Toner 50ml)',
  price: 445000,
  comparePrice: 494496,
};
---

<BaseLayout
  title={PAGE_TITLE}
  description={PAGE_DESC}
  image={HERO_IMAGE}
  preloadImages={HERO_IMAGE}
  canonical={canonical}
  hideHeader={true}
  hideFooter={true}
>
  <MetaLandingTracker
    slug={LANDING_SLUG}
    contentId={defaultCatalogContentId(product)}
    contentName={product.contentName}
    price={defaultVariant.price}
  />

  <div class="dsw-shell">
    <main class="dsw-canvas">
      <!-- Section 1: Hero -->
      <section id="hero-section" class="dsw-hero">
        <div class="dsw-hero-head">
          <h1 class="dsw-h1">
            <span class="dsw-hl-tilt">Wajah Glowing</span> Bebas Flek Tanpa Pusing Urutan Skincare Pagi & Malam?
          </h1>
          <p class="dsw-sub" style="max-width: 390px; margin: 14px auto 0; font-weight: 700;">
            Miliki seluruh koleksi klinik Numa Skin dalam 1 paket terpadu yang 100% harmonis.<br />
            <span class="dsw-underline-teal">Tuntaskan kusam, flek, & kerutan dengan VIP 6-in-1 Complete Routine!</span>
          </p>
        </div>

        <div class="dsw-hero-stage">
          <div class="dsw-hero-top-tag">
            <div class="dsw-hero-top-pill">
              <Icon name="lucide:crown" class="size-3.5" aria-hidden="true" />
              <span>Koleksi VIP 6-in-1 • Hemat Rp52.500</span>
            </div>
          </div>

          <img
            src={HERO_IMAGE}
            alt="Perbandingan wajah kusam berflek dan berkerut vs kulit glowing kencang terawat penuh dengan Paket Lengkap 6-in-1 Routine Numa Skin"
            width="720"
            height="480"
            class="dsw-hero-img"
            fetchpriority="high"
            loading="eager"
            decoding="async"
          />

          <div class="dsw-hero-overlap">
            <div class="dsw-hero-overlap-inner">
              <h2 class="dsw-hero-overlap-title">Solusi Pamungkas Tanpa Celah dari Cuci Muka Hingga Proteksi UV!</h2>
              <p class="dsw-hero-overlap-text">
                Keenam produk diformulasikan di atas <strong style="color: #be123c;">pelarut 72+ Mineral Ulleung Deep Sea Water yang sama sehingga setiap tetes bekerja saling melipatgandakan hasil</strong>.
              </p>
            </div>
          </div>
        </div>

        <div class="dsw-trust-row">
          <div class="dsw-trust-item">
            <span class="dsw-trust-icon">
              <Icon name="lucide:shield-check" class="size-4" aria-hidden="true" />
            </span>
            <div>
              <span class="dsw-trust-label">BPOM Resmi</span>
              <span class="dsw-trust-sub">6 Izin Edar</span>
            </div>
          </div>
          <div class="dsw-trust-item">
            <span class="dsw-trust-icon">
              <Icon name="lucide:badge-check" class="size-4" aria-hidden="true" />
            </span>
            <div>
              <span class="dsw-trust-label">Halal RI</span>
              <span class="dsw-trust-sub">Koleksi Lengkap</span>
            </div>
          </div>
          <div class="dsw-trust-item">
            <span class="dsw-trust-icon">
              <Icon name="lucide:truck" class="size-4" aria-hidden="true" />
            </span>
            <div>
              <span class="dsw-trust-label">Bisa COD</span>
              <span class="dsw-trust-sub">Bayar di Rumah</span>
            </div>
          </div>
        </div>
      </section>

      <!-- Section 2: Solusi Singkat + Visual -->
      <section class="dsw-section">
        <h2 class="dsw-h2">
          Seluruh <span class="dsw-hl-aqua">6 tahapan klinik pagi & malam</span> dalam 1 kotak
        </h2>
        <p class="dsw-sub">Dari pembersihan pH 5.5, hidrasi mineral, serum NAD+, krim PDRN, pelembap Adenosine, hingga SPF 50+.</p>

        <div class="dsw-photo-stack">
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/solusi-enam-langkah-paripurna.webp`}
              alt="Wanita Indonesia usia 40 tahun dengan kulit wajah tampak sangat sehat, kencang, dan glowing merata berkat rangkaian lengkap 6-in-1 Numa Skin"
              width="648"
              height="432"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
          </div>
        </div>

        <div class="dsw-list">
          <div class="dsw-list-row">
            <span class="dsw-icon-teal">
              <Icon name="lucide:droplets" class="size-4" aria-hidden="true" />
            </span>
            <p class="dsw-list-text">
              <strong style="color: #0f172a;">Tahap Persiapan (Facial Wash 100ml + Toner 50ml/150ml):</strong> Membersihkan pori dengan lembut (5% Niacinamide) dan membuka jalur penyerapan lewat 72+ mineral laut dalam Pulau Ulleung.
            </p>
          </div>
          <div class="dsw-list-row">
            <span class="dsw-icon-teal">
              <Icon name="lucide:sparkles" class="size-4" aria-hidden="true" />
            </span>
            <p class="dsw-list-text">
              <strong style="color: #0f172a;">Tahap Inti & Malam (NAD+ Serum 20ml + Adenosine 30gr):</strong> Mengencangkan kontur wajah (2% RejuveNAD™ + 6X Peptide) dan mengunci perbaikan kolagen & flek sepanjang malam.
            </p>
          </div>
          <div class="dsw-list-row">
            <span class="dsw-icon-teal">
              <Icon name="lucide:sun-dim" class="size-4" aria-hidden="true" />
            </span>
            <p class="dsw-list-text">
              <strong style="color: #0f172a;">Tahap Cerah & Tameng Pagi (PDRN Day Cream 30gr + Oxydew SPF 50+ 30ml):</strong> Memberikan rona cerah Warm Beige (10.000 PPM PDRN) sekaligus memblokir radiasi UVA/UVB (3% Luceane™).
            </p>
          </div>
        </div>
      </section>

      <!-- Section 3: Tanda Masalah Kulit + Visual Grid -->
      <section class="dsw-section dsw-section--warn">
        <h2 class="dsw-h2">
          Mengapa membeli <span class="dsw-underline-warn">skincare sepotong-sepotong</span> sering membuang waktu & uang?
        </h2>

        <div class="dsw-photo-grid-2">
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/masalah-skincare-setengah-jalan.webp`}
              alt="Wanita tampak kecewa bercermin karena hasil skincare tidak maksimal akibat tahapan yang bolong-bolong"
              width="315"
              height="210"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <p class="dsw-photo-caption">
              <strong style="color: #be123c; display: block;">Tahapan yang Bolong</strong>
              Punya serum bagus tapi sabunnya keras atau tidak pakai sunscreen membuat hasil jalan di tempat.
            </p>
          </div>
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/masalah-biaya-klinik-mahal.webp`}
              alt="Ilustrasi perbandingan biaya perawatan klinik jutaan rupiah vs perawatan rutin di rumah"
              width="315"
              height="210"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <p class="dsw-photo-caption">
              <strong style="color: #be123c; display: block;">Biaya Klinik Jutaan Rupiah</strong>
              Sekali tindakan di klinik menghabiskan ratusan ribu hingga jutaan tanpa perawatan harian di rumah.
            </p>
          </div>
        </div>

        <div class="dsw-list">
          <div class="dsw-list-row">
            <span class="dsw-icon-warn">
              <Icon name="lucide:triangle-alert" class="size-4" aria-hidden="true" />
            </span>
            <p class="dsw-list-text">
              Sering bingung <strong style="color: #be123c;">produk mana yang harus dipakai pagi hari dan mana yang khusus malam hari</strong>.
            </p>
          </div>
          <div class="dsw-list-row">
            <span class="dsw-icon-warn">
              <Icon name="lucide:triangle-alert" class="size-4" aria-hidden="true" />
            </span>
            <p class="dsw-list-text">
              Beli satuan satu per satu membuat <strong style="color: #be123c;">total belanja membengkak dan ongkos kirim berkali-kali lipat</strong>.
            </p>
          </div>
          <div class="dsw-list-row">
            <span class="dsw-icon-warn">
              <Icon name="lucide:triangle-alert" class="size-4" aria-hidden="true" />
            </span>
            <p class="dsw-list-text">
              Khawatir bahan aktif <strong style="color: #be123c;">saling bertabrakan atau menggumpal</strong> jika memakai produk dari berbagai merek berbeda.
            </p>
          </div>
        </div>
      </section>

      <!-- Section 4: Perbandingan Visual Sebelum vs Sesudah -->
      <section class="dsw-section">
        <h2 class="dsw-h2">
          Perbandingan hasil <span class="dsw-hl-aqua">ekosistem 6-in-1 paripurna</span>
        </h2>
        <p class="dsw-sub">Perubahan menyeluruh pada tekstur, kecerahan, noda hitam, dan kekencangan kontur wajah.</p>

        <div class="dsw-photo-stack">
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/kondisi-masalah-kompleks-penuaan.webp`}
              alt="Kondisi wajah dengan masalah kombinasi: kusam, flek hitam di pipi, pori kasar, dan garis senyum dalam"
              width="648"
              height="432"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <span class="dsw-photo-badge dsw-photo-badge--before">Sebelum 6-in-1 Routine</span>
            <p class="dsw-photo-caption">
              Kulit mengalami kombinasi masalah sekaligus: kusam dehidrasi, bercak flek melasma, pori tampak besar, dan garis senyum mengendur.
            </p>
          </div>

          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/kondisi-transformasi-glowing-lengkap.webp`}
              alt="Kondisi wajah tampak kencang, mulus, cerah merata, dan glowing sehat setelah pemakaian rutin Paket Lengkap 6-in-1"
              width="648"
              height="432"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <span class="dsw-photo-badge dsw-photo-badge--after">Rutin 6-in-1 Pagi & Malam</span>
            <p class="dsw-photo-caption">
              Setiap lapisan masalah kulit tertangani secara terpadu: pori bersih lembap, flek memudar, kontur kencang, dan wajah cerah terlindungi.
            </p>
          </div>
        </div>
      </section>

      <!-- Section 5: Dark Marine Section — Cara Pakai Praktis -->
      <section class="dsw-section dsw-section--dark">
        <h2 class="dsw-h2">
          Panduan Pakai <span style="color: #99e2ec;">Pagi vs Malam yang Sangat Mudah</span>
        </h2>
        <p class="dsw-sub">Tidak perlu dipakai sekaligus 6 botol — cukup bagi menjadi ritual pagi dan ritual malam.</p>

        <div class="dsw-photo-stack">
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/cara-pakai-6in1-ritual-pagi.webp`}
              alt="Ritual Pagi Paket 6-in-1: Facial Wash, Toner, NAD+ Serum, PDRN Day Cream, dan Oxydew Sunscreen"
              width="648"
              height="432"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <p class="dsw-photo-caption">
              <strong style="color: #ffffff;">Ritual Pagi (Cerah & Terlindungi Seharian):</strong> Facial Wash → Toner → NAD+ Serum → PDRN Day Cream → kunci dengan Oxydew Sunscreen SPF 50+.
            </p>
          </div>
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/cara-pakai-6in1-ritual-malam.webp`}
              alt="Ritual Malam Paket 6-in-1: Facial Wash, Toner, NAD+ Serum, dan Adenosine Moisturizer"
              width="648"
              height="432"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
            <p class="dsw-photo-caption">
              <strong style="color: #ffffff;">Ritual Malam (Regenerasi & Pengencangan Tidur):</strong> Facial Wash → Toner → NAD+ Serum → kunci dengan Adenosine Moisturizer.
            </p>
          </div>
        </div>

        <div class="dsw-list">
          <div class="dsw-list-row">
            <span class="dsw-step-num">1</span>
            <p class="dsw-step-text">
              <strong style="color: #ffffff;">Siang Hari:</strong> PDRN Day Cream + Oxydew SPF 50+ membuat wajah tampak cerah segar tanpa bedak dan bebas gosong UV.
            </p>
          </div>
          <div class="dsw-list-row">
            <span class="dsw-step-num">2</span>
            <p class="dsw-step-text">
              <strong style="color: #ffffff;">Malam Hari:</strong> NAD+ Serum + <strong style="color: #ffffff; background: #104452; padding: 1px 6px; border-radius: 4px;">Adenosine Moisturizer</strong> memperbaiki kolagen & memudarkan flek saat Anda tidur.
            </p>
          </div>
          <div class="dsw-list-row">
            <span class="dsw-step-num">3</span>
            <p class="dsw-step-text">
              Tersedia pilihan paket dengan <strong>Toner 50 ml (Rp445.000)</strong> atau <strong>Toner 150 ml Full Size (Rp472.000)</strong>.
            </p>
          </div>
        </div>
      </section>

      <!-- Section 6: Ulasan Pelanggan -->
      <section class="dsw-section">
        <h2 class="dsw-h2">
          Alasan ratusan pelanggan <span class="dsw-hl-aqua">langsung memilih Paket 6-in-1</span>
        </h2>
        <p class="dsw-sub">Sekali pesan langsung tenang untuk 1,5 hingga 2 bulan perawatan lengkap.</p>

        <div class="dsw-reviews-divide">
          <div class="dsw-review-row">
            <div class="dsw-review-head">
              <div>
                <p class="dsw-review-author">
                  Ibu Hj. Kartika
                  <span style="color: #0b6e7d; display: inline-flex;">
                    <Icon name="lucide:badge-check" class="size-4" aria-hidden="true" />
                  </span>
                </p>
                <p class="dsw-review-meta">Bandung • Ambil Varian 150ml (Rp472.000)</p>
              </div>
              <RatingStars rating={5} starClass="h-3.5 w-3.5 !fill-[#d97706] !text-[#d97706]" />
            </div>
            <p class="dsw-review-quote">
              "Daripada pusing nyicil satu-satu, saya langsung ambil paket 6-in-1 yang Toner 150ml. <span class="dsw-hl-aqua">Lengkap banget dari sabun sampai sunscreen, dalam sebulan teman-teman arisan pada nanya perawatan di klinik mana!</span>"
            </p>
          </div>
          <div class="dsw-review-row">
            <div class="dsw-review-head">
              <div>
                <p class="dsw-review-author">
                  Ibu Meilani S.
                  <span style="color: #0b6e7d; display: inline-flex;">
                    <Icon name="lucide:badge-check" class="size-4" aria-hidden="true" />
                  </span>
                </p>
                <p class="dsw-review-meta">Surabaya • Usia 45 Tahun</p>
              </div>
              <RatingStars rating={5} starClass="h-3.5 w-3.5 !fill-[#d97706] !text-[#d97706]" />
            </div>
            <p class="dsw-review-quote">
              "Enaknya satu merek gini <strong style="color: #0f172a;">teksturnya nyambung semua, gak ada yang lengket atau menggumpal</strong>. <span class="dsw-hl-aqua">Pagi pakai Day Cream + Sunscreen udah glowing, malam pakai NAD+ + Adenosine bangun tidur kenyal</span>."
            </p>
          </div>
          <div class="dsw-review-row">
            <div class="dsw-review-head">
              <div>
                <p class="dsw-review-author">
                  Bunda Lilis W.
                  <span style="color: #0b6e7d; display: inline-flex;">
                    <Icon name="lucide:badge-check" class="size-4" aria-hidden="true" />
                  </span>
                </p>
                <p class="dsw-review-meta">Bekasi • Hemat s/d Rp52.500</p>
              </div>
              <RatingStars rating={5} starClass="h-3.5 w-3.5 !fill-[#d97706] !text-[#d97706]" />
            </div>
            <p class="dsw-review-quote">
              "Hitung-hitung <span class="dsw-hl-rose">hemat sekitar 50 ribuan dibanding beli eceran</span>. <span class="dsw-hl-aqua">Semua 6 botol ada segel BPOM resminya dan bisa COD</span>, puas banget!"
            </p>
          </div>
        </div>
      </section>

      <!-- Section 7: Galeri Bukti Visual -->
      <section class="dsw-section dsw-section--tint">
        <h2 class="dsw-h2">
          Koleksi paripurna untuk <span style="color: #0b6e7d;">investasi kulit jangka panjang</span>
        </h2>
        <p class="dsw-sub">Enam formula klinis yang bekerja harmonis merawat kulit wanita Indonesia.</p>

        <div class="dsw-photo-grid-2">
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/bukti-tekstur-enam-produk.webp`}
              alt="Harmoni tekstur lembut rangkaian 6 produk Numa Skin yang mudah meresap"
              width="315"
              height="210"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
          </div>
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/bukti-ibu-45an-transformasi.webp`}
              alt="Potret wanita berhijab usia 45 tahun dengan kulit wajah tampak sangat cerah, kencang, dan awet muda"
              width="315"
              height="210"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
          </div>
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/bukti-kulit-bening-paripurna.webp`}
              alt="Close-up kulit pipi yang tampak sehat, kenyal, dan bebas noda"
              width="315"
              height="210"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
          </div>
          <div class="dsw-photo-card">
            <img
              src={`${IMG_BASE}/bukti-meja-rias-koleksi-6in1.webp`}
              alt="Koleksi lengkap 6 produk Numa Skin tertata rapi di meja rias"
              width="315"
              height="210"
              class="dsw-photo-img"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
          </div>
        </div>
      </section>

      <!-- Section 8: Product Knowledge (Full-Bleed Figures) -->
      <section class="dsw-section dsw-section--knowledge">
        <h2 class="dsw-h2">
          Apa saja <span class="dsw-hl-aqua">6 produk resmi BPOM</span> yang Anda dapatkan?
        </h2>
        <p class="dsw-sub">
          Seluruh bahan aktif unggulan Numa Skin hadir lengkap tanpa ada yang terlewat.
        </p>

        <div class="dsw-figure-stack">
          <figure class="dsw-figure">
            <div class="dsw-figure-bleed">
              <img
                src={`${IMG_BASE}/formulasi-ekosistem-ulleung-6in1.webp`}
                alt="Ekosistem air laut dalam Pulau Ulleung bersama RejuveNAD, PDRN, Adenosine, dan Luceane"
                width="720"
                height="480"
                class="dsw-figure-img"
                loading="lazy"
                fetchpriority="low"
                decoding="async"
              />
            </div>
            <figcaption class="dsw-figcaption">
              <h3 class="dsw-figcaption-title">Complete 6-Stage Ulleung Marine Biotech System</h3>
              <p class="dsw-figcaption-desc">
                Menggabungkan 72+ mineral laut dalam, 2% Swiss RejuveNAD™, 10.000 PPM Salmon DNA PDRN, Adenosine Skin Communicator™, dan 3% Luceane™.
              </p>
            </figcaption>
          </figure>
          <figure class="dsw-figure">
            <div class="dsw-figure-bleed">
              <img
                src={`${IMG_BASE}/kandungan-aktif-lengkap-6in1.webp`}
                alt="Sinergi bahan aktif pencerah, pengencang, penghidrasi, dan pelindung UV dalam 6-in-1 Routine"
                width="720"
                height="480"
                class="dsw-figure-img"
                loading="lazy"
                fetchpriority="low"
                decoding="async"
              />
            </div>
            <figcaption class="dsw-figcaption">
